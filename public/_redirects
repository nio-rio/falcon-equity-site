# Retired inner-page routes. In-app hrefs use home hashes; HTTP redirects
# send bookmarks to / or /apply. Fragments in Location are best-effort.
/contact                             /#contact               301
/partners                            /                       301
/privacy-policy                      /                       301
/terms-conditions                    /                       301
/how-it-works                        /#why-choose-us         301
/services                            /#services              301
/services/decentralized-business-financing  /#services       301
/blog/category/getting-approved      /blog                   301
/blog/category/compare-options       /blog                   301
/blog/category/costs-and-rates       /blog                   301
/blog/category/cash-flow-and-debt    /blog                   301
/resources/loan-calculator           /apply                  301
/resources/credit-repair-loan-prep   /apply                  301
/resources/business-loan-calculator  /apply                  301
/resources/*                         /apply                  301

# Pretty URLs 301 /path/ → /path with a 98-byte "Document moved" body.
# Crawlers that do not follow that (or resolve Location against /) then see
# the home <title>. Force a 200 rewrite so /apply/ serves apply.html.
/*/  /:splat  200!
