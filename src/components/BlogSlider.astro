---
/**
 * Blog slider — GLOBAL COMPONENT.
 *
 * The one place the "From the blog" band is defined. Service pages and
 * /industries/retail all render this; nothing about the slider's markup,
 * layout or navigation lives in a page anymore.
 *
 * Props carry page identity only — the posts to show, the carousel's
 * accessible name, and the band classes the page's own stylesheet needs for
 * its padding/rhythm. Anything visual belongs in blog-slider.css.
 */
import Eyebrow from '@/components/Eyebrow.astro';
import Media from '@/components/Media.astro';
import type { Post } from '@/lib/blog';
import '@/styles/blog-slider.css';

interface Props {
  /** Published posts, in the order they should slide. */
  posts: Post[];
  /** Accessible name for the carousel region, e.g. "Retail funding articles". */
  label: string;
  /** Page band classes — padding and theme hooks only. */
  bandClass?: string;
  /** Section hook for the page's data attributes, e.g. "mca" → data-mca-section. */
  sectionKey?: string;
}

const { posts, label, bandClass = '', sectionKey } = Astro.props;

const sectionAttrs = sectionKey ? { [`data-${sectionKey}-section`]: 'blog' } : {};

/* Arrow and dot geometry is copied verbatim from the reference so the icons
   are the same shapes, not look-alikes. 40-unit canvas for the arrows,
   24-unit for the dot ring. */
const ARROW_LINE =
  'M29 20c0-.2 0-.4-.2-.6l-4.4-4.6a1 1 0 0 0-1.2 0c-.3.3-.3.8 0 1.1l3.1 3.3H11.8a.8.8 0 1 0 0 1.6h14.5l-3 3.3c-.4.3-.4.8 0 1.2.3.3.8.2 1.1 0l4.4-4.7.2-.6Z';
const ARROW_DISC =
  'M20 0a20 20 0 1 1 0 40 20 20 0 0 1 0-40Zm3.2 14.8c-.3.3-.3.8 0 1.1l3.1 3.3H11.8a.8.8 0 1 0 0 1.6h14.5l-3 3.3c-.4.3-.4.8 0 1.2.3.3.8.2 1.1 0l4.4-4.7.2-.6c0-.2 0-.4-.2-.6l-4.4-4.6a1 1 0 0 0-1.2 0Z';
const ARROW_RING =
  'M20 0a20 20 0 1 0 0 40 20 20 0 0 0 0-40Zm0 1.5a18.5 18.5 0 1 1 0 37 18.5 18.5 0 0 1 0-37Z';

/* Dot ring: r 11.25 in a 24 canvas → circumference 70.686. The ring is
   DRAWN clockwise from 12 o'clock when a slide becomes active (0.9s ease-out,
   measured off the reference recording), so the circle needs a dasharray plus
   a -90° rotation to start at the top. No-JS state stays correct: the active
   dot ships with offset 0 (full ring), the rest with a full offset (none). */
const RING_C = Number((2 * Math.PI * 11.25).toFixed(3));

const showNav = posts.length > 1;
---

<section
  class:list={['blog-band', bandClass]}
  aria-label="From the blog"
  data-band="light"
  {...sectionAttrs}
  data-reveal-root
>
  <div class="container-site">
    <div
      class="blog-slider"
      data-blog-slider
      data-autoplay="true"
      data-autoplay-duration="5000"
      data-reveal
      role="region"
      aria-roledescription="carousel"
      aria-label={label}
      tabindex="0"
    >
      <div class="blog-split">
        <div class="blog-copy">
          <Eyebrow>From the blog</Eyebrow>
          <div class="blog-copy-slides">
            {
              posts.map((post, i) => (
                <div
                  class:list={['blog-copy-slide', i === 0 && 'is-active']}
                  data-blog-copy-slide
                  role="group"
                  aria-roledescription="slide"
                  aria-label={`${i + 1} of ${posts.length}`}
                  aria-hidden={i === 0 ? 'false' : 'true'}
                >
                  <h2 class="blog-title" data-blog-title>
                    {post.data.title}
                  </h2>
                  <a class="blog-link" href={`/blog/${post.id}`} data-blog-link>
                    <span class="blog-link-label">Read the article</span>
                    <span class="blog-link-icon" aria-hidden="true">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                      >
                        <path
                          d="M14 19L21 12L14 5"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-miterlimit="10"
                        />
                        <path
                          d="M21 12H2"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-miterlimit="10"
                        />
                      </svg>
                    </span>
                  </a>
                </div>
              ))
            }
          </div>

          {
            showNav && (
              <div class="blog-nav">
                <button
                  type="button"
                  class="blog-nav-arrow blog-nav-arrow--prev"
                  data-blog-prev
                  aria-label="Previous article"
                >
                  <svg
                    class="blog-nav-arrow-icon"
                    width="40"
                    height="40"
                    viewBox="0 0 40 40"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path class="blog-nav-arrow-line" d={ARROW_LINE} fill="currentColor" />
                    <path class="blog-nav-arrow-fill" d={ARROW_DISC} fill="currentColor" />
                    <path class="blog-nav-arrow-ring" d={ARROW_RING} fill="currentColor" />
                  </svg>
                </button>

                <ul class="blog-nav-dots">
                  {posts.map((post, i) => (
                    <li class:list={['blog-nav-dot-item', i === 0 && 'is-active']}>
                      <button
                        type="button"
                        class="blog-nav-dot"
                        data-blog-dot={i}
                        aria-label={`Go to article ${i + 1} of ${posts.length}: ${post.data.title}`}
                        aria-current={i === 0 ? 'true' : undefined}
                      >
                        <svg
                          class="blog-nav-dot-ring"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                          focusable="false"
                        >
                          <circle
                            cx="12"
                            cy="12"
                            r="11.25"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-dasharray={String(RING_C)}
                            stroke-dashoffset={i === 0 ? '0' : String(RING_C)}
                            transform="rotate(-90 12 12)"
                            data-circumference={String(RING_C)}
                          />
                        </svg>
                      </button>
                    </li>
                  ))}
                </ul>

                <button
                  type="button"
                  class="blog-nav-arrow blog-nav-arrow--next"
                  data-blog-next
                  aria-label="Next article"
                >
                  <svg
                    class="blog-nav-arrow-icon"
                    width="40"
                    height="40"
                    viewBox="0 0 40 40"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path class="blog-nav-arrow-line" d={ARROW_LINE} fill="currentColor" />
                    <path class="blog-nav-arrow-fill" d={ARROW_DISC} fill="currentColor" />
                    <path class="blog-nav-arrow-ring" d={ARROW_RING} fill="currentColor" />
                  </svg>
                </button>
              </div>
            )
          }
        </div>

        <div class="blog-media">
          {
            posts.map((post, i) => (
              <div
                class:list={['blog-media-slide', i === 0 && 'is-active']}
                data-blog-media-slide
                aria-hidden={i === 0 ? 'false' : 'true'}
                data-blog-img
              >
                <Media
                  image={post.data.cover}
                  alt={post.data.coverAlt || post.data.title}
                  intent={post.data.coverAlt || post.data.title}
                  labeled={!post.data.cover}
                  ratio="16 / 9"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  sizes="(min-width: 90em) 704px, (min-width: 80em) 632px, (min-width: 48em) 688px, 100vw"
                />
              </div>
            ))
          }
        </div>
      </div>
      <p class="sr-only" aria-live="polite" data-blog-live></p>
    </div>
  </div>
</section>

<script>
  import { bindBlogSlider } from '@/scripts/blog-slider';

  bindBlogSlider();
</script>
