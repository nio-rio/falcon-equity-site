---
import ResponsiveTable, { type TableCell } from './ResponsiveTable.astro';

export type ChartBar = {
  label: string;
  value: number;
  display: string;
};

interface Props {
  caption?: string;
  labelledBy?: string;
  headers: string[];
  rows: TableCell[][];
  chart: {
    title: string;
    note?: string;
    series: ChartBar[];
  };
  defaultView?: 'chart' | 'table';
  class?: string;
}

const {
  caption,
  labelledBy,
  headers,
  rows,
  chart,
  defaultView = 'chart',
  class: className,
} = Astro.props;

const max = Math.max(...chart.series.map((s) => s.value), 1);
const tabId = labelledBy || 'chart-table';
---

<div class:list={['chart-table', className]} data-chart-table>
  <div class="chart-table-tabs" role="tablist" aria-label="Chart or table">
    <button
      type="button"
      class="chart-table-tab"
      id={`${tabId}-tab-chart`}
      role="tab"
      aria-selected={defaultView === 'chart' ? 'true' : 'false'}
      aria-controls={`${tabId}-panel-chart`}
      data-tab="chart">Chart</button
    >
    <button
      type="button"
      class="chart-table-tab"
      id={`${tabId}-tab-table`}
      role="tab"
      aria-selected={defaultView === 'table' ? 'true' : 'false'}
      aria-controls={`${tabId}-panel-table`}
      data-tab="table">Table</button
    >
  </div>

  <div
    id={`${tabId}-panel-chart`}
    role="tabpanel"
    aria-labelledby={`${tabId}-tab-chart`}
    data-panel="chart"
    hidden={defaultView !== 'chart'}
  >
    <p class="sr-only">{chart.title}</p>
    <dl class="chart-bars">
      {
        chart.series.map((bar) => (
          <div class="chart-bar-row">
            <dt class="chart-bar-label">{bar.label}</dt>
            <dd class="chart-bar-track">
              <div class="chart-bar-fill" style={`width: ${(bar.value / max) * 100}%`}></div>
            </dd>
            <dd class="chart-bar-value">{bar.display}</dd>
          </div>
        ))
      }
    </dl>
    {chart.note && <p class="mt-4 text-sm text-muted">{chart.note}</p>}
  </div>

  <div
    id={`${tabId}-panel-table`}
    role="tabpanel"
    aria-labelledby={`${tabId}-tab-table`}
    data-panel="table"
    hidden={defaultView !== 'table'}
  >
    <ResponsiveTable caption={caption} labelledBy={labelledBy} headers={headers} rows={rows} />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-chart-table]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const show = (name: string) => {
      tabs.forEach((tab) => {
        const on = tab.dataset.tab === name;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== name;
      });
    };
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => show(tab.dataset.tab ?? 'table'));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const i = tabs.indexOf(tab);
        const next = event.key === 'ArrowRight' ? tabs[(i + 1) % tabs.length] : tabs[(i - 1 + tabs.length) % tabs.length];
        next?.focus();
        show(next?.dataset.tab ?? 'table');
      });
    });
  });
</script>
