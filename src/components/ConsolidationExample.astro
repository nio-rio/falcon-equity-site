---
import ChartTable from './ChartTable.astro';

const positions = [
  { name: 'Position A', daily: 450 },
  { name: 'Position B', daily: 380 },
  { name: 'Position C', daily: 240 },
];
const before = positions.reduce((sum, p) => sum + p.daily, 0);
const after = 640;
const saved = before - after;
const pct = Math.round((saved / before) * 100);
const usd = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
---

<figure aria-labelledby="consolidation-example-title">
  <h3 id="consolidation-example-title">Hypothetical daily payments</h3>
  <div class="mt-8">
    <ChartTable
      labelledBy="consolidation-example-title"
      caption="Daily payments before and after a hypothetical consolidation"
      headers={['Position', 'Daily payment']}
      rows={[
        ...positions.map((p) => [p.name, `${usd(p.daily)} / day`]),
        ['Three-position total', `${usd(before)} / day`],
        ['One position', `${usd(after)} / day`],
        ['Difference', `${usd(saved)} / day less (${pct}%)`],
      ]}
      chart={{
        title: 'Hypothetical daily payments',
        note: 'Illustration only. Not an offer or a client result.',
        series: [
          ...positions.map((p) => ({ label: p.name, value: p.daily, display: `${usd(p.daily)} / day` })),
          { label: 'One position', value: after, display: `${usd(after)} / day` },
        ],
      }}
    />
  </div>
  <figcaption class="mt-5 text-sm text-muted">
    Illustration only. Not an offer or a client result. A lower daily payment may extend the term; review total cost before you sign.
  </figcaption>
</figure>
