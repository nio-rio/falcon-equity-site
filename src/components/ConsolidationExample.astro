---
const positions = [
  { name: 'Position A', daily: 450 },
  { name: 'Position B', daily: 380 },
  { name: 'Position C', daily: 240 },
];
const before = positions.reduce((sum, p) => sum + p.daily, 0);
const after = 640;
const saved = before - after;
const pct = Math.round((saved / before) * 100);
const usd = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
---

<figure class="card" aria-labelledby="consolidation-example-title">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h3 id="consolidation-example-title" class="text-2xl font-semibold text-brand">Savings example</h3>
    <span class="rounded-full bg-lilac px-3 py-1 text-xs font-semibold text-brand">Illustrative example</span>
  </div>
  <div class="mt-6 grid gap-6 md:grid-cols-2">
    <div class="rounded-2xl bg-lilac p-5">
      <p class="eyebrow text-muted">Before: 3 positions</p>
      <table class="mt-3 w-full text-[15px]">
        <caption class="sr-only">Daily payments before consolidation</caption>
        <tbody>
          {
            positions.map((p) => (
              <tr>
                <th scope="row" class="py-1.5 text-left font-normal text-muted">{p.name}</th>
                <td class="py-1.5 text-right font-semibold">{usd(p.daily)} / day</td>
              </tr>
            ))
          }
          <tr class="border-t border-lilac-200">
            <th scope="row" class="pt-3 text-left font-semibold">Total daily payment</th>
            <td class="pt-3 text-right font-serif text-2xl font-semibold text-brand">{usd(before)}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="on-dark rounded-2xl bg-brand p-5 text-white">
      <p class="eyebrow text-lilac-deep">After: 1 position</p>
      <p class="mt-3 text-[15px] text-lilac-200">New consolidated daily payment</p>
      <p class="font-serif text-4xl font-semibold">{usd(after)} <span class="text-lg font-normal text-lilac-200">/ day</span></p>
      <div class="mt-5 rounded-xl bg-white/10 p-4">
        <p class="text-sm text-lilac-200">Daily savings</p>
        <p class="font-serif text-2xl font-semibold text-lilac-deep">{usd(saved)} / day · {pct}% less</p>
      </div>
    </div>
  </div>
  <figcaption class="mt-5 text-xs leading-relaxed text-muted">
    Hypothetical figures for illustration only. This is not an offer, a quote or a real client result. Actual savings depend
    on your existing positions, revenue, terms and underwriting. A lower daily payment may extend the repayment period;
    review total cost before you sign.
  </figcaption>
</figure>
