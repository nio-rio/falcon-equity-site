---
import Icon from './Icon.astro';
import { SITE } from '@/data/site';

const phones = [SITE.phones.office, SITE.phones.direct, SITE.phones.fax];
---

<div class="bx-grid">
  <div class="bx-span-4 lg:bx-span-4">
    <span class="contact-tile">
      <Icon name="mail" size={22} />
    </span>
    <h3 class="mt-5">Email</h3>
    <p class="mt-2">
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </p>
  </div>
  <div class="bx-span-4 lg:bx-span-4">
    <span class="contact-tile">
      <Icon name="phone" size={22} />
    </span>
    <h3 class="mt-5">Phone</h3>
    <ul class="mt-2 space-y-1">
      {
        phones.map((p) => (
          <li>
            <a href={p.href}>
              {p.label} {p.display}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="bx-span-4 lg:bx-span-4">
    <span class="contact-tile">
      <Icon name="map-pin" size={22} />
    </span>
    <h3 class="mt-5">Office</h3>
    <p class="mt-2">
      <a href={SITE.address.mapUrl} target="_blank" rel="noopener">
        {SITE.address.street}<br />
        {SITE.address.city}, {SITE.address.region} {SITE.address.postalCode}
        <span class="sr-only"> (opens Google Maps in a new tab)</span>
      </a>
    </p>
  </div>
</div>
