---
import { PRIMARY_PHONE } from '@/data/site';

interface Props {
  title?: string;
  body?: string;
  ctaLabel?: string;
}

const {
  title = 'Get funding today',
  body = 'One short application. A specialist reviews your file promptly. Many products fund within 24-48 hours of approval.',
  ctaLabel = 'Get Funding Today',
} = Astro.props;
---

<section class="bg-tint py-16 md:py-20" aria-labelledby="cta-heading">
  <div class="container-site flex flex-col items-start gap-8 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-2xl">
      <h2 id="cta-heading">{title}</h2>
      <p class="mt-4 text-ink-soft">{body}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href="/apply" class="btn-primary">{ctaLabel}</a>
      <a href={PRIMARY_PHONE.href} class="btn-outline-dark">{PRIMARY_PHONE.display}</a>
    </div>
  </div>
</section>
