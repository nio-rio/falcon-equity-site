---
import { PRIMARY_PHONE } from '@/data/site';

interface Props {
  title?: string;
  body?: string;
}

const {
  title = 'Your next victory starts with one application.',
  body = 'Apply in minutes. A Falcon specialist reviews your file and lays out your options, with funding in as little as 24–48 hours.',
} = Astro.props;
---

<section class="border-t border-line bg-white py-20 sm:py-24" aria-labelledby="cta-heading">
  <div class="container-site flex flex-col items-start gap-10 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-2xl">
      <h2 id="cta-heading" class="text-3xl leading-tight font-semibold sm:text-5xl">{title}</h2>
      <p class="mt-4 text-lg text-muted">{body}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href="/apply" class="btn-primary px-8! py-3.5!">Start your application</a>
      <a href={PRIMARY_PHONE.href} class="btn-outline-dark px-8! py-3.5!">{PRIMARY_PHONE.display}</a>
    </div>
  </div>
</section>
