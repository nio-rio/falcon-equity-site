---
import Icon from './Icon.astro';
import { PRIMARY_PHONE } from '@/data/site';

interface Props {
  title?: string;
  body?: string;
}

const {
  title = 'Your next victory starts with one application.',
  body = 'Apply in minutes. A Falcon specialist reviews your file and lays out your options, with funding in as little as 24–48 hours.',
} = Astro.props;
---

<section class="on-dark relative overflow-hidden bg-brand py-20 text-white sm:py-24" aria-labelledby="cta-heading">
  <div
    class="pointer-events-none absolute -top-24 -right-24 h-96 w-96 rounded-full bg-lilac-deep/20 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div class="container-site relative flex flex-col items-start gap-8 xl:flex-row xl:items-center xl:justify-between">
    <div class="max-w-2xl">
      <h2 id="cta-heading" class="text-3xl leading-tight font-semibold sm:text-5xl">{title}</h2>
      <p class="mt-4 text-lg text-lilac-200">{body}</p>
    </div>
    <div class="flex w-full max-w-md shrink-0 flex-col gap-3 sm:max-w-none sm:flex-row xl:max-w-sm xl:flex-col">
      <a href="/apply" class="btn-accent whitespace-nowrap px-8! py-4! text-lg!">
        Start your application <Icon name="arrow-right" size={20} />
      </a>
      <a href={PRIMARY_PHONE.href} class="btn-outline-light whitespace-nowrap px-8! py-4! text-lg!">
        <Icon name="phone" size={20} /> {PRIMARY_PHONE.display}
      </a>
    </div>
  </div>
</section>
