---
import CircleArrow from './CircleArrow.astro';
import Eyebrow from './Eyebrow.astro';

export type ExploreItem = {
  href: string;
  title: string;
  meta?: string;
};

interface Props {
  heading?: string;
  headingId?: string;
  eyebrow?: string;
  items: ExploreItem[];
  class?: string;
}

const {
  heading = 'Explore more',
  headingId = 'explore-heading',
  eyebrow = 'More',
  items,
  class: className,
} = Astro.props;
---

{
  items.length > 0 && (
    <section class:list={['section bg-white', className]} aria-labelledby={headingId}>
      <div class="container-site">
        <div class="bx-grid">
          <div class="bx-full">
            <Eyebrow>{eyebrow}</Eyebrow>
            <h2 id={headingId} class="mt-4">
              {heading}
            </h2>
          </div>
          <ul class="explore-list bx-span-4 bx-lg-span-12">
            {items.map((item) => (
              <li>
                <a class="explore-row" href={item.href}>
                  <span class="explore-row-copy">
                    <span class="explore-row-title">{item.title}</span>
                    {item.meta && <span class="explore-row-meta">{item.meta}</span>}
                  </span>
                  <CircleArrow />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )
}
