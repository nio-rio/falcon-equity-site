---
import Icon from './Icon.astro';

interface Props {
  faqs: readonly { q: string; a: string }[];
  headingLevel?: 'h3' | 'h2';
  idPrefix?: string;
}

const { faqs, headingLevel = 'h3', idPrefix = 'faq' } = Astro.props;
const Heading = headingLevel;

const escapeHtml = (value: string) =>
  value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

const answerHtml = (text: string) =>
  escapeHtml(text).replace(
    /\[([^\]]+)\]\(([^)]+)\)/g,
    (_, label: string, href: string) => `<a class="link" href="${href}">${label}</a>`,
  );
---

<div class="bx-accordion" data-accordion>
  {
    faqs.map((f, i) => (
      <div class="bx-acc-item">
        <Heading>
          <button
            type="button"
            class="bx-acc-trigger"
            aria-expanded="false"
            aria-controls={`${idPrefix}-panel-${i}`}
            id={`${idPrefix}-trigger-${i}`}
            data-acc-trigger
          >
            <span>{f.q}</span>
            <span class="bx-acc-icon" aria-hidden="true">
              <Icon name="chevron-down" size={16} />
            </span>
          </button>
        </Heading>
        <div class="bx-acc-panel" id={`${idPrefix}-panel-${i}`} role="region" aria-labelledby={`${idPrefix}-trigger-${i}`}>
          <div class="bx-acc-panel-inner">
            <p set:html={answerHtml(f.a)} />
          </div>
        </div>
      </div>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((root) => {
    root.querySelectorAll<HTMLButtonElement>('[data-acc-trigger]').forEach((btn) => {
      const item = btn.closest('.bx-acc-item');
      if (!item) return;
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', String(open));
        item.classList.toggle('is-open', open);
      });
    });
  });
</script>
