---
interface Props {
  faqs: readonly { q: string; a: string }[];
  headingLevel?: 'h3' | 'h2';
}

const { faqs } = Astro.props;

const escapeHtml = (value: string) =>
  value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

const answerHtml = (text: string) =>
  escapeHtml(text).replace(
    /\[([^\]]+)\]\(([^)]+)\)/g,
    (_, label: string, href: string) => `<a class="link" href="${href}">${label}</a>`,
  );
---

<div class="faq-list">
  {
    faqs.map((f) => (
      <details class="group [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-left text-lg font-semibold text-ink">
          <span>{f.q}</span>
          <span class="shrink-0 text-muted transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 max-w-3xl leading-relaxed text-muted" set:html={answerHtml(f.a)} />
      </details>
    ))
  }
</div>

<style>
  .faq-list details {
    border-bottom: 1px solid var(--color-line);
    padding-block: 1.25rem;
  }

  .faq-list details:first-child {
    border-top: 1px solid var(--color-line);
  }
</style>
