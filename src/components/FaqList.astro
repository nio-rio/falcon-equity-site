---
import Icon from './Icon.astro';

interface Props {
  faqs: readonly { q: string; a: string }[];
  headingLevel?: 'h3' | 'h2';
}

const { faqs } = Astro.props;
---

<div class="divide-y divide-lilac-200 rounded-3xl border border-lilac-200 bg-white">
  {
    faqs.map((f) => (
      <details class="group px-6 py-5 sm:px-8 [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-left text-lg font-semibold text-brand">
          <span>{f.q}</span>
          <span class="shrink-0 rounded-full bg-lilac p-1.5 text-brand transition-transform group-open:rotate-180">
            <Icon name="chevron-down" size={18} />
          </span>
        </summary>
        <p class="mt-3 max-w-3xl leading-relaxed text-muted">{f.a}</p>
      </details>
    ))
  }
</div>
