---
import type { ImageMetadata } from 'astro';
import Media from './Media.astro';
import Eyebrow from './Eyebrow.astro';

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  image?: ImageMetadata;
  imageAlt?: string;
  intent?: string;
  labeled?: boolean;
  reverse?: boolean;
}

const {
  id = 'feature-heading',
  eyebrow,
  title,
  image,
  imageAlt = '',
  intent = 'workspace table and documents, even daylight, empty of people',
  labeled = false,
  reverse = false,
} = Astro.props;
const showMedia = Boolean(image) || labeled;
---

<section class="section bg-white" aria-labelledby={id}>
  <div class="container-site">
    {
      showMedia ? (
        <div class="bx-grid items-center">
          <div class:list={['bx-span-4 bx-lg-span-6', reverse && 'bx-lg-start-7']}>
            <Media
              image={image}
              alt={imageAlt}
              intent={intent}
              labeled={labeled && !image}
              ratio="16 / 9"
              sizes="(min-width: 1024px) 50vw, 100vw"
            />
          </div>
          <div class:list={['section-stack bx-span-4 bx-lg-span-5', !reverse && 'bx-lg-start-8']}>
            <div class="section-head">
              {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
              <h2 id={id}>{title}</h2>
            </div>
            <div class="section-body">
              <slot />
            </div>
          </div>
        </div>
      ) : (
        <div class="bx-grid">
          <div class="section-head bx-span-4 bx-lg-span-10">
            {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
            <h2 id={id}>{title}</h2>
          </div>
          <div class="section-body bx-span-4 bx-lg-span-6 bx-lg-start-7">
            <slot />
          </div>
        </div>
      )
    }
  </div>
</section>
