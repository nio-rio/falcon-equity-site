---
import Icon from './Icon.astro';
import { FLIGHT_PATH } from '@/data/content';

const icons = ['file-text', 'eye', 'badge-check', 'zap'];
const notes = ['Application received', 'Specialist reviewing', 'Offer ready to sign', 'Funds sent'];
---

<figure
  class="flight-card relative w-full max-w-sm rounded-3xl border border-white/15 bg-ink/80 p-6 text-white shadow-2xl backdrop-blur-md"
  aria-labelledby="flight-caption"
>
  <div class="flex items-center justify-between">
    <p class="eyebrow text-accent">Your flight path</p>
    <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-2.5 py-1 text-xs">
      <span class="pulse-dot h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span> Live
    </span>
  </div>
  <figcaption id="flight-caption" class="sr-only">
    Illustration of the Falcon funding process: Apply, Review, Approved, Funded.
  </figcaption>
  <div class="relative mt-5" aria-hidden="true">
  <span class="absolute top-4 bottom-4 left-[19px] w-0.5 bg-white/10"></span>
  <span class="track absolute top-4 left-[19px] w-0.5 bg-accent"></span>
  <ol class="relative space-y-4">
    {
      FLIGHT_PATH.map((step, i) => (
        <li class="step relative flex items-center gap-4" style={`--i:${i}`}>
          <span class="dot relative z-10 grid h-10 w-10 place-items-center rounded-full border border-white/20 bg-brand-dark">
            <Icon name={icons[i]} size={18} />
          </span>
          <span class="flex-1">
            <span class="block font-semibold">{step}</span>
            <span class="block text-xs text-muted">{notes[i]}</span>
          </span>
          <span class="check text-accent">
            <Icon name="check" size={18} strokeWidth={2.5} />
          </span>
        </li>
      ))
    }
  </ol>
  </div>
  <div class="mt-6 rounded-2xl bg-white/5 p-4">
    <p class="text-xs text-muted">Typical time to funding</p>
    <p class="mt-1 font-display text-2xl font-semibold">24–48 hours</p>
  </div>
</figure>

<style>
  .flight-card {
    --cycle: 8s;
  }
  .track {
    height: 0;
    animation: track var(--cycle) cubic-bezier(0.6, 0, 0.3, 1) infinite;
  }
  .step .dot,
  .step .check {
    animation: step var(--cycle) ease infinite;
    animation-delay: calc(var(--i) * 1.2s);
  }
  .step .check {
    opacity: 0;
    animation-name: check;
  }
  .pulse-dot {
    animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes track {
    0% {
      height: 0;
    }
    55%,
    85% {
      height: calc(100% - 2rem);
    }
    100% {
      height: calc(100% - 2rem);
      opacity: 0;
    }
  }
  @keyframes step {
    0% {
      background: var(--color-brand-dark);
      color: white;
    }
    6%,
    70% {
      background: var(--color-accent);
      color: white;
      border-color: transparent;
    }
    85%,
    100% {
      background: var(--color-brand-dark);
      color: white;
    }
  }
  @keyframes check {
    0% {
      opacity: 0;
      transform: scale(0.6);
    }
    6%,
    70% {
      opacity: 1;
      transform: scale(1);
    }
    85%,
    100% {
      opacity: 0;
    }
  }
  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      height: calc(100% - 2rem);
      animation: none;
    }
    .step .dot {
      animation: none;
      background: var(--color-accent);
      color: white;
    }
    .step .check {
      animation: none;
      opacity: 1;
    }
    .pulse-dot {
      animation: none;
    }
  }
</style>
