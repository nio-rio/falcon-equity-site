---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SERVICES } from '@/data/services';
import { PRIMARY_PHONE, RESOURCE_LINKS } from '@/data/site';
import { cleanPath } from '@/lib/paths';

const path = cleanPath(Astro.url.pathname);
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));

const simpleLinks = [
  { label: 'Industries', href: '/industries' },
  { label: 'About', href: '/about' },
  { label: 'Partners', href: '/partners' },
  { label: 'Contact', href: '/contact' },
];
const resourcesActive = RESOURCE_LINKS.some((l) => isActive(l.href)) || path.startsWith('/resources');
const navLink = 'inline-flex items-center gap-1 px-3 py-2 text-base font-normal';
---

<header class="site-header sticky top-0 z-50 border-b" data-header>
  <div class="container-site flex h-14 items-center justify-between gap-6 md:h-16">
    <a href="/" class="header-logo shrink-0" aria-label="Falcon Equity Group home">
      <Logo class="h-5 w-auto sm:h-6" />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center text-[13px] font-medium">
        <li class="relative" data-dropdown>
          <button
            type="button"
            class:list={[navLink, isActive('/services') && 'is-active']}
            aria-expanded="false"
            aria-controls="menu-services"
            data-dropdown-trigger
          >
            Services <Icon name="chevron-down" size={14} class="transition-transform" />
          </button>
          <div
            id="menu-services"
            class="absolute top-full left-0 mt-0 hidden w-[32rem] border border-line bg-white p-2 text-ink"
            data-dropdown-menu
          >
            <ul class="grid grid-cols-2">
              {
                SERVICES.map((s) => (
                  <li>
                    <a
                      href={`/services/${s.slug}`}
                      class="block px-3 py-2.5 hover:bg-ink/5"
                      aria-current={isActive(`/services/${s.slug}`) ? 'page' : undefined}
                    >
                      <span class="block text-sm font-semibold text-ink">{s.name}</span>
                      <span class="block text-xs text-muted">{s.amountsShort ?? s.amounts}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a href="/services" class="mt-1 block border-t border-line px-3 py-3 text-sm font-semibold text-accent">
              Compare all funding options
            </a>
          </div>
        </li>
        {
          simpleLinks.slice(0, 1).map((l) => (
            <li>
              <a
                href={l.href}
                class:list={[navLink, isActive(l.href) && 'is-active']}
                aria-current={isActive(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
        <li class="relative" data-dropdown>
          <button
            type="button"
            class:list={[navLink, resourcesActive && 'is-active']}
            aria-expanded="false"
            aria-controls="menu-resources"
            data-dropdown-trigger
          >
            Resources <Icon name="chevron-down" size={14} class="transition-transform" />
          </button>
          <div
            id="menu-resources"
            class="absolute top-full left-0 mt-0 hidden w-72 border border-line bg-white p-2 text-ink"
            data-dropdown-menu
          >
            <ul>
              {
                RESOURCE_LINKS.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      class="block px-3 py-2.5 hover:bg-ink/5"
                      aria-current={isActive(l.href) ? 'page' : undefined}
                    >
                      <span class="block text-sm font-semibold text-ink">{l.label}</span>
                      <span class="block text-xs text-muted">{l.description}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        {
          simpleLinks.slice(1).map((l) => (
            <li>
              <a
                href={l.href}
                class:list={[navLink, isActive(l.href) && 'is-active']}
                aria-current={isActive(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      <a href={PRIMARY_PHONE.href} class="header-phone inline-flex items-center gap-2 text-base hover:underline">
        <Icon name="phone" size={16} />
        <span class="sr-only">Call </span>{PRIMARY_PHONE.display}
      </a>
      <a href="/apply" class="header-cta">Apply Now</a>
    </div>

    <button
      type="button"
      class="header-toggle inline-flex items-center justify-center p-2 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-mobile-toggle
    >
      <span class="sr-only" data-mobile-label>Open menu</span>
      <span data-icon-open><Icon name="menu" size={24} /></span>
      <span data-icon-close class="hidden"><Icon name="x" size={24} /></span>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Mobile" class="hidden max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-line bg-white text-ink lg:hidden">
    <div class="container-site py-6">
      <p class="eyebrow">Services</p>
      <ul class="mt-2 grid gap-1 sm:grid-cols-2">
        <li><a href="/services" class="block py-2.5 font-semibold text-accent">All funding options</a></li>
        {
          SERVICES.map((s) => (
            <li>
              <a href={`/services/${s.slug}`} class="block py-2.5">
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="eyebrow mt-6">Resources</p>
      <ul class="mt-2 grid gap-1 sm:grid-cols-2">
        {
          RESOURCE_LINKS.map((l) => (
            <li>
              <a href={l.href} class="block py-2.5">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="eyebrow mt-6">Company</p>
      <ul class="mt-2 grid gap-1 sm:grid-cols-2">
        {
          simpleLinks.map((l) => (
            <li>
              <a href={l.href} class="block py-2.5">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a href="/apply" class="btn-primary">Apply Now</a>
        <a href={PRIMARY_PHONE.href} class="btn-outline-dark">{PRIMARY_PHONE.display}</a>
      </div>
    </div>
  </nav>
</header>

<style>
  .site-header {
    background: #fff;
    border-color: var(--color-line);
    color: var(--color-ink);
  }

  .header-logo,
  .header-phone,
  .header-toggle {
    color: inherit;
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 9px 14px;
    font-size: 16px;
    line-height: 20px;
    font-weight: 500;
    white-space: nowrap;
    background: var(--color-accent);
    color: #fff;
  }

  .header-cta:hover {
    background: var(--color-accent-hover);
  }

  .site-header a.is-active,
  .site-header button.is-active {
    color: var(--color-accent);
  }

  .site-header nav a:hover,
  .site-header nav button:hover {
    background: var(--color-tint);
  }

  .header-cta:hover {
    background: var(--color-accent-hover);
    color: #fff;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]');

  const closeAll = (except?: HTMLElement) => {
    dropdowns.forEach((dd) => {
      if (dd === except) return;
      const trigger = dd.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
      const menu = dd.querySelector<HTMLElement>('[data-dropdown-menu]');
      trigger?.setAttribute('aria-expanded', 'false');
      trigger?.querySelector('svg')?.classList.remove('rotate-180');
      menu?.classList.add('hidden');
    });
  };

  dropdowns.forEach((dd) => {
    const trigger = dd.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
    const menu = dd.querySelector<HTMLElement>('[data-dropdown-menu]');
    if (!trigger || !menu) return;

    trigger.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') === 'true';
      closeAll(dd);
      trigger.setAttribute('aria-expanded', String(!open));
      trigger.querySelector('svg')?.classList.toggle('rotate-180', !open);
      menu.classList.toggle('hidden', open);
    });

    dd.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        closeAll();
        trigger.focus();
      }
    });

    dd.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !dd.contains(next)) closeAll();
    });
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (![...dropdowns].some((dd) => dd.contains(target))) closeAll();
  });

  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const mobileMenu = document.getElementById('mobile-menu');
  if (toggle && mobileMenu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      mobileMenu.classList.toggle('hidden', !open);
      toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
      header?.classList.toggle('is-open', open);
      const label = toggle.querySelector('[data-mobile-label]');
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
