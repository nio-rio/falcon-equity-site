---
import { Picture } from 'astro:assets';
import Logo from './Logo.astro';
import CircleArrow from './CircleArrow.astro';
import Button040 from './Button040.astro';
import { SERVICES } from '@/data/services';
import { INDUSTRIES } from '@/data/industries';
import { FIRM_LINKS, PRIMARY_PHONE, RESOURCE_LINKS } from '@/data/site';
import { cleanPath } from '@/lib/paths';
import applyStill from '@/assets/services/merchant-cash-advance.jpg';

const path = cleanPath(Astro.url.pathname);
const isHome = path === '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));

type NavLink = { label: string; href: string };
type NavColumn = { heading: string; links: NavLink[]; twoCol?: boolean };

const nav = [
  {
    id: 'services',
    label: 'Services',
    active: isActive('/services'),
    columns: [
      {
        heading: 'Services',
        twoCol: true,
        links: [{ label: 'Overview', href: '/services' }, ...SERVICES.map((s) => ({ label: s.name, href: `/services/${s.slug}` }))],
      },
    ] satisfies NavColumn[],
    featured: false,
  },
  {
    id: 'industries',
    label: 'Industries',
    active: isActive('/industries'),
    columns: [
      {
        heading: 'Industries',
        twoCol: true,
        links: [
          { label: 'Overview', href: '/industries' },
          ...INDUSTRIES.map((i) => ({ label: i.name, href: `/industries/${i.slug}` })),
        ],
      },
    ] satisfies NavColumn[],
    featured: false,
  },
  {
    id: 'resources',
    label: 'Resources',
    active: RESOURCE_LINKS.some((l) => isActive(l.href)) || path.startsWith('/resources'),
    columns: [
      { heading: 'Blog', links: [{ label: 'View all', href: '/blog' }] },
      {
        heading: 'Tools',
        links: [
          { label: 'Loan Calculator', href: '/resources/loan-calculator' },
          { label: 'Credit Repair & Loan Prep', href: '/resources/credit-repair-loan-prep' },
        ],
      },
      { heading: 'Help', links: [{ label: 'FAQ', href: '/faq' }] },
    ] satisfies NavColumn[],
    featured: true,
  },
  {
    id: 'firm',
    label: 'Our Firm',
    active: FIRM_LINKS.some((l) => isActive(l.href)),
    columns: [
      {
        heading: 'Our Firm',
        links: [
          { label: 'About', href: '/about' },
          { label: 'Partners', href: '/partners' },
        ],
      },
      { heading: 'Contact', links: [{ label: 'Contact', href: '/contact' }] },
    ] satisfies NavColumn[],
    featured: false,
  },
];
---

<header
  class:list={['site-header', isHome && 'is-color-theme-dark']}
  data-header
  data-home={isHome ? '' : undefined}
>
  <div class="site-header__container" data-header-bar>
    <div class="site-header__inner container-site">
      <a href="/" class="site-header__logo" aria-label="Falcon Equity Group">
        <Logo variant="nav" />
      </a>

      <nav class="site-header__nav primary-nav" aria-label="Main">
        <div id="primary-nav-inner" class="primary-nav__inner" data-nav-inner>
          <ul class="primary-nav__list">
            {
              nav.map((item) => (
                <li class:list={['primary-nav__list-item', 'has-children', item.active && 'is-current']} data-nav-item>
                  <button
                    type="button"
                    class="primary-nav__list-item-link"
                    aria-expanded="false"
                    aria-controls={`menu-${item.id}`}
                    aria-haspopup="true"
                    data-nav-trigger
                  >
                    <span class="primary-nav__list-item-label">{item.label}</span>
                    <svg class="primary-nav__list-item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
                      <path fill="currentColor" d="m8.7 12.4 7-6.8a1 1 0 0 0 0-1.4 1 1 0 0 0-1.4 0L8 10.3 1.7 4.2a1 1 0 0 0-1.4 0 1 1 0 0 0 0 1.4l7 6.8c.4.3 1 .3 1.4 0Z"></path>
                    </svg>
                  </button>
                  <div id={`menu-${item.id}`} class="primary-nav__lvl-2-wrap" aria-hidden="true" data-nav-panel>
                    <ul class="primary-nav__list-lvl-2" data-nav-panel-list>
                      {item.columns.map((col) => (
                        <li class:list={['primary-nav__list-lvl-2-item', col.twoCol && 'has-two-column-list']}>
                          <span class="primary-nav__list-lvl-2-link">{col.heading}</span>
                          <ul class:list={['primary-nav__list-lvl-3', col.twoCol && 'primary-nav__list-lvl-3--two']}>
                            {col.links.map((l) => (
                              <li class="primary-nav__list-lvl-3-item">
                                <a
                                  href={l.href}
                                  class="primary-nav__list-lvl-3-link"
                                  aria-current={isActive(l.href) ? 'page' : undefined}
                                >
                                  {l.label}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </li>
                      ))}
                      {item.featured && (
                        <li class="primary-nav__list-lvl-2-item has-nav-widget">
                          <div class="primary-nav-widget">
                            <div class="primary-nav-widget__content">
                              <div class="primary-nav-widget__content-inner">
                                <h2 class="primary-nav-widget__title">Apply for funding</h2>
                                <p>
                                  One short application. A specialist reviews your file promptly. Many products fund
                                  within 24-48 hours of approval.
                                </p>
                              </div>
                              <div class="primary-nav-widget__cta">
                                <a href="/apply" class="arrow-cta">
                                  <span class="arrow-cta-label">Learn More</span>
                                  <CircleArrow />
                                </a>
                              </div>
                            </div>
                            <div class="primary-nav-widget__media">
                              <Picture
                                src={applyStill}
                                alt=""
                                widths={[320, 480, 640]}
                                sizes="(min-width: 90em) 14rem, 12.5rem"
                                formats={['avif', 'webp']}
                                class="primary-nav-widget__img"
                              />
                            </div>
                          </div>
                        </li>
                      )}
                    </ul>
                  </div>
                </li>
              ))
            }
          </ul>
          <div class="site-header__cta site-header__cta--menu">
            <a class="site-header__tel" href={PRIMARY_PHONE.href}
              ><span class="site-header__tel-label">{PRIMARY_PHONE.display}</span></a
            >
            <Button040 class="site-header__apply" href="/apply" label="Apply for funding" variant="dark" />
          </div>
        </div>
      </nav>

      <div class="site-header__tools">
        <a class="site-header__tel site-header__tel--bar" href={PRIMARY_PHONE.href}
          ><span class="site-header__tel-label">{PRIMARY_PHONE.display}</span></a
        >
        <Button040
          class="site-header__apply site-header__apply--bar"
          href="/apply"
          label="Apply for funding"
          variant="dark"
        />
        <button
          type="button"
          class="primary-nav__toggle"
          aria-expanded="false"
          aria-controls="primary-nav-inner"
          data-mobile-toggle
        >
          <span class="sr-only" data-mobile-label>Open menu</span>
          <svg class="primary-nav__toggle-lines" width="34" height="24" viewBox="0 0 34 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M1.71 0a1.71 1.71 0 1 0 0 3.43H32.3a1.71 1.71 0 0 0 0-3.43H1.7Zm0 10.29a1.71 1.71 0 0 0 0 3.42H32.3a1.71 1.71 0 0 0 0-3.42H1.7Zm0 10.28a1.71 1.71 0 0 0 0 3.43H32.3a1.71 1.71 0 0 0 0-3.43H1.7Z"></path>
          </svg>
          <svg class="primary-nav__toggle-cross" width="34" height="24" viewBox="0 0 34 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M28.57 2.53c.57-.57.57-1.5 0-2.08l-.02-.02a1.47 1.47 0 0 0-2.08 0l-8.43 8.42a1.47 1.47 0 0 1-2.08 0L7.53.43a1.47 1.47 0 0 0-2.08 0l-.02.02a1.47 1.47 0 0 0 0 2.08l8.42 8.43a1.47 1.47 0 0 1 0 2.08l-8.42 8.43c-.57.57-.57 1.5 0 2.08l.02.02a1.47 1.47 0 0 0 2.08 0l8.43-8.42a1.47 1.47 0 0 1 2.08 0l8.43 8.42c.57.57 1.5.57 2.08 0l.02-.02a1.47 1.47 0 0 0 0-2.08l-8.42-8.43a1.47 1.47 0 0 1 0-2.08l8.42-8.43Z"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>
<div class="site-header-spacer" aria-hidden="true"></div>
<div
  class="primary-nav__backdrop primary-nav__backdrop--hidden"
  data-nav-backdrop
  hidden
  style="-webkit-backdrop-filter: blur(5px); backdrop-filter: blur(5px)"
></div>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-nav-item]')];
  const backdrop = document.querySelector<HTMLElement>('[data-nav-backdrop]');
  if (backdrop) document.body.appendChild(backdrop);
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const inner = document.querySelector<HTMLElement>('[data-nav-inner]');
  const desktopMq = window.matchMedia('(min-width: 80em)');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isHomeHeader = header?.hasAttribute('data-home') ?? false;
  const CLOSE_MS = reduceMotion ? 0 : 160;

  const isDesktop = () => desktopMq.matches;

  let closeTimer = 0;
  let lockY = 0;
  const cancelClose = () => window.clearTimeout(closeTimer);

  const eventInMobileDrawer = (target: EventTarget | null) =>
    !isDesktop() && target instanceof Element && !!target.closest('[data-nav-inner]');

  const preventScroll = (e: Event) => {
    if (eventInMobileDrawer(e.target)) return;
    e.preventDefault();
  };

  const preventScrollKeys = (e: KeyboardEvent) => {
    if (!['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' ', 'Spacebar'].includes(e.key)) return;
    if (e.target instanceof HTMLElement && /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName)) return;
    if (eventInMobileDrawer(e.target)) return;
    e.preventDefault();
  };

  const holdScroll = () => {
    if (window.scrollY === lockY) return;
    window.scrollTo({ top: lockY, left: 0, behavior: 'auto' });
  };

  const setScrollLock = (lock: boolean) => {
    const root = document.documentElement;
    if (lock) {
      if (root.classList.contains('has-scroll-lock')) return;
      lockY = window.scrollY;
      root.classList.add('has-scroll-lock');
      window.addEventListener('wheel', preventScroll, { passive: false });
      window.addEventListener('touchmove', preventScroll, { passive: false });
      window.addEventListener('keydown', preventScrollKeys);
      window.addEventListener('scroll', holdScroll);
      return;
    }
    root.classList.remove('has-scroll-lock');
    window.removeEventListener('wheel', preventScroll);
    window.removeEventListener('touchmove', preventScroll);
    window.removeEventListener('keydown', preventScrollKeys);
    window.removeEventListener('scroll', holdScroll);
  };

  const setBackdrop = (on: boolean) => {
    if (!backdrop) return;
    backdrop.classList.toggle('primary-nav__backdrop--hidden', !on);
    backdrop.hidden = !on;
  };

  const setItemOpen = (item: HTMLElement, open: boolean) => {
    const trigger = item.querySelector<HTMLElement>('[data-nav-trigger]');
    const panel = item.querySelector<HTMLElement>('[data-nav-panel]');
    item.classList.toggle('is-open', open);
    if (open) item.classList.remove('is-escaped');
    trigger?.setAttribute('aria-expanded', String(open));
    if (panel) panel.setAttribute('aria-hidden', String(!open));
  };

  const closeAll = (except?: HTMLElement) => {
    items.forEach((item) => {
      if (item !== except) setItemOpen(item, false);
    });
  };

  const anyOpen = () => items.some((item) => item.classList.contains('is-open'));

  const syncChrome = () => {
    const mobileOpen = toggle?.getAttribute('aria-expanded') === 'true';
    const open = (isDesktop() && anyOpen()) || (!isDesktop() && mobileOpen);
    header?.classList.toggle('is-open', open);
    setBackdrop(open);
    setScrollLock(open);
  };

  const openItem = (item: HTMLElement) => {
    cancelClose();
    closeAll(item);
    setItemOpen(item, true);
    syncChrome();
  };

  const closeMenus = (escaped = false) => {
    cancelClose();
    if (escaped) {
      items.forEach((item) => {
        if (item.classList.contains('is-open')) item.classList.add('is-escaped');
      });
    }
    closeAll();
    syncChrome();
  };

  const scheduleClose = () => {
    cancelClose();
    closeTimer = window.setTimeout(() => {
      closeAll();
      syncChrome();
    }, CLOSE_MS);
  };

  items.forEach((item) => {
    const trigger = item.querySelector<HTMLElement>('[data-nav-trigger]');
    if (!trigger) return;

    item.addEventListener('mouseenter', (e) => {
      if (!isDesktop()) return;
      if (item.classList.contains('is-escaped')) {
        const from = e.relatedTarget as Node | null;
        if (from && item.contains(from)) return;
        item.classList.remove('is-escaped');
      }
      openItem(item);
    });
    item.addEventListener('mouseleave', () => {
      item.classList.remove('is-escaped');
    });
    item.querySelector<HTMLElement>('[data-nav-panel]')?.addEventListener('mouseenter', () => {
      if (!isDesktop()) return;
      cancelClose();
    });

    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      if (isDesktop()) {
        if (!expanded) openItem(item);
        return;
      }
      if (expanded) {
        setItemOpen(item, false);
        syncChrome();
      } else openItem(item);
    });
  });

  header?.addEventListener('mouseenter', cancelClose);
  header?.addEventListener('mouseleave', (e) => {
    if (!isDesktop()) return;
    const next = e.relatedTarget as HTMLElement | null;
    if (next?.closest('[data-nav-panel], [data-header]')) return;
    scheduleClose();
  });

  header?.addEventListener('focusin', cancelClose);
  header?.addEventListener('focusout', (e) => {
    if (!isDesktop()) return;
    const next = e.relatedTarget as Node | null;
    if (!next || !header.contains(next)) scheduleClose();
  });

  document.addEventListener('pointerdown', (e) => {
    const target = e.target as Node;
    if (header?.contains(target)) return;
    closeMenus();
    if (!isDesktop()) setMobile(false);
  });

  backdrop?.addEventListener('click', () => {
    closeMenus();
    if (!isDesktop()) setMobile(false);
  });

  const setMobile = (open: boolean) => {
    if (!toggle || !inner) return;
    toggle.setAttribute('aria-expanded', String(open));
    inner.classList.toggle('is-open', open);
    header?.classList.toggle('is-open', open);
    const label = toggle.querySelector('[data-mobile-label]');
    if (label) label.textContent = open ? 'Close menu' : 'Open menu';
    if (!open) closeAll();
    syncChrome();
  };

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    setMobile(open);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (toggle?.getAttribute('aria-expanded') === 'true') {
      setMobile(false);
      toggle.focus();
      return;
    }
    if (!anyOpen()) return;
    const openItemEl = items.find((item) => item.classList.contains('is-open'));
    closeMenus(true);
    openItemEl?.querySelector<HTMLElement>('[data-nav-trigger]')?.focus();
  });

  const onBreakpoint = () => {
    closeMenus();
    setMobile(false);
  };
  desktopMq.addEventListener('change', onBreakpoint);

  const setCompact = () => {
    const scrolled = window.scrollY > 24;
    header?.classList.toggle('is-compact', scrolled);
    if (isHomeHeader) header?.classList.toggle('is-color-theme-dark', !scrolled);
    items.forEach((item) => item.classList.remove('is-escaped'));
  };
  setCompact();
  window.addEventListener('scroll', setCompact, { passive: true });
</script>
