---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SERVICES } from '@/data/services';
import { INDUSTRIES } from '@/data/industries';
import { FIRM_LINKS, PRIMARY_PHONE, RESOURCE_LINKS } from '@/data/site';
import { cleanPath } from '@/lib/paths';

const path = cleanPath(Astro.url.pathname);
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));

const resourcesActive = RESOURCE_LINKS.some((l) => isActive(l.href)) || path.startsWith('/resources');
const firmActive = FIRM_LINKS.some((l) => isActive(l.href));
const industriesActive = isActive('/industries');

const mobileSections = [
  {
    id: 'services',
    label: 'Services',
    links: [{ label: 'All funding options', href: '/services' }, ...SERVICES.map((s) => ({ label: s.name, href: `/services/${s.slug}` }))],
  },
  { id: 'firm', label: 'Our Firm', links: FIRM_LINKS.map((l) => ({ label: l.label, href: l.href })) },
  { id: 'resources', label: 'Resources', links: RESOURCE_LINKS.map((l) => ({ label: l.label, href: l.href })) },
  {
    id: 'industries',
    label: 'Industries',
    links: [{ label: 'All industries', href: '/industries' }, ...INDUSTRIES.map((i) => ({ label: i.name, href: `/industries/${i.slug}` }))],
  },
];
const navLink = 'inline-flex items-center gap-1 px-3 py-2 text-base font-normal';
const dropdownItem = 'nav-dropdown-item';
---

<header class="site-header sticky top-0 z-50" data-header>
  <div class="header-bar container-site flex h-14 items-center justify-between gap-6 md:h-[4.25rem]">
    <a href="/" class="header-logo shrink-0" aria-label="Falcon Equity Group home">
      <Logo class="h-6 w-auto md:h-[1.8rem]" />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center text-[13px] font-medium">
        <li class="nav-dropdown relative" data-dropdown>
          <a
            href="/services"
            class:list={[navLink, isActive('/services') && 'is-active']}
            aria-current={path === '/services' ? 'page' : undefined}
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="menu-services"
            data-dropdown-trigger
          >
            Services <Icon name="chevron-down" size={14} class="transition-transform" />
          </a>
          <div
            id="menu-services"
            class="nav-dropdown-menu absolute top-full left-0 z-10 w-[32rem] bg-white text-ink shadow-md"
            data-dropdown-menu
          >
            <ul class="grid grid-cols-2">
              {
                SERVICES.map((s) => (
                  <li>
                    <a
                      href={`/services/${s.slug}`}
                      class={dropdownItem}
                      aria-current={isActive(`/services/${s.slug}`) ? 'page' : undefined}
                    >
                      <span class="nav-item-title text-sm font-semibold text-ink">{s.name}</span>
                      <span class="nav-item-desc text-xs text-muted">{s.amountsShort ?? s.amounts}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a href="/services" class="nav-dropdown-footer text-sm font-semibold text-ink">
              Compare all funding options
            </a>
          </div>
        </li>
        <li class="nav-dropdown relative" data-dropdown>
          <button
            type="button"
            class:list={[navLink, firmActive && 'is-active']}
            aria-expanded="false"
            aria-controls="menu-firm"
            data-dropdown-trigger
          >
            Our Firm <Icon name="chevron-down" size={14} class="transition-transform" />
          </button>
          <div
            id="menu-firm"
            class="nav-dropdown-menu absolute top-full left-0 z-10 w-72 bg-white text-ink shadow-md"
            data-dropdown-menu
          >
            <ul>
              {
                FIRM_LINKS.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      class={dropdownItem}
                      aria-current={isActive(l.href) ? 'page' : undefined}
                    >
                      <span class="nav-item-title text-sm font-semibold text-ink">{l.label}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        <li class="nav-dropdown relative" data-dropdown>
          <button
            type="button"
            class:list={[navLink, resourcesActive && 'is-active']}
            aria-expanded="false"
            aria-controls="menu-resources"
            data-dropdown-trigger
          >
            Resources <Icon name="chevron-down" size={14} class="transition-transform" />
          </button>
          <div
            id="menu-resources"
            class="nav-dropdown-menu absolute top-full left-0 z-10 w-72 bg-white text-ink shadow-md"
            data-dropdown-menu
          >
            <ul>
              {
                RESOURCE_LINKS.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      class={dropdownItem}
                      aria-current={isActive(l.href) ? 'page' : undefined}
                    >
                      <span class="nav-item-title text-sm font-semibold text-ink">{l.label}</span>
                      <span class="nav-item-desc text-xs text-muted">{l.description}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        <li class="nav-dropdown relative" data-dropdown>
          <button
            type="button"
            class:list={[navLink, industriesActive && 'is-active']}
            aria-expanded="false"
            aria-controls="menu-industries"
            data-dropdown-trigger
          >
            Industries <Icon name="chevron-down" size={14} class="transition-transform" />
          </button>
          <div
            id="menu-industries"
            class="nav-dropdown-menu absolute top-full right-0 z-10 w-[32rem] bg-white text-ink shadow-md"
            data-dropdown-menu
          >
            <ul class="grid grid-cols-2">
              {
                INDUSTRIES.map((i) => (
                  <li>
                    <a
                      href={`/industries/${i.slug}`}
                      class={dropdownItem}
                      aria-current={isActive(`/industries/${i.slug}`) ? 'page' : undefined}
                    >
                      <span class="nav-item-title text-sm font-semibold text-ink">{i.name}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a href="/industries" class="nav-dropdown-footer text-sm font-semibold text-ink">
              View all industries
            </a>
          </div>
        </li>
      </ul>
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      <a href={PRIMARY_PHONE.href} class="header-phone inline-flex items-center gap-2 text-base">
        <Icon name="phone" size={16} />
        <span class="sr-only">Call </span>{PRIMARY_PHONE.display}
      </a>
      <a href="/apply" class="btn-primary">Get Funding Today</a>
    </div>

    <button
      type="button"
      class="header-toggle inline-flex items-center justify-center p-2 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-mobile-toggle
    >
      <span class="sr-only" data-mobile-label>Open menu</span>
      <span data-icon-open><Icon name="menu" size={24} /></span>
      <span data-icon-close class="hidden"><Icon name="x" size={24} /></span>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Mobile" class="mobile-menu hidden text-ink lg:hidden">
    <div class="container-site py-4">
      <ul class="mobile-sections">
        {
          mobileSections.map((section) => (
            <li class="mobile-section" data-mobile-section>
              <button
                type="button"
                class="mobile-section-toggle"
                aria-expanded="false"
                aria-controls={`mobile-menu-${section.id}`}
                data-mobile-section-toggle
              >
                <span>{section.label}</span>
                <Icon name="chevron-down" size={18} class="transition-transform" />
              </button>
              <ul id={`mobile-menu-${section.id}`} class="mobile-section-panel grid gap-1 pb-3 sm:grid-cols-2" hidden>
                {section.links.map((l) => (
                  <li>
                    <a href={l.href} class="block py-2.5" aria-current={path === l.href ? 'page' : undefined}>
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a href="/apply" class="btn-primary">Get Funding Today</a>
        <a href={PRIMARY_PHONE.href} class="btn-outline-dark">{PRIMARY_PHONE.display}</a>
      </div>
    </div>
  </nav>
</header>

<style>
  .site-header {
    background: #fff;
    color: var(--color-ink);
  }

  .header-bar {
    position: relative;
    z-index: 2;
  }

  .header-logo,
  .header-toggle {
    color: inherit;
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    width: 100vw;
    height: 100dvh;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-tint);
    padding-top: 3.5rem;
    -webkit-overflow-scrolling: touch;
  }

  @media (min-width: 768px) {
    .mobile-menu {
      padding-top: 4.25rem;
    }
  }

  .site-header.is-open {
    background: var(--color-tint);
  }

  .header-phone {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .header-phone:hover,
  .header-phone:focus-visible {
    color: inherit;
    opacity: 0.7;
    text-decoration: none;
  }

  .site-header a.is-active,
  .site-header button.is-active {
    color: inherit;
    font-weight: 600;
  }

  .mobile-section-toggle {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 0;
    font-size: 1.125rem;
    font-weight: 500;
    color: inherit;
    text-align: left;
  }

  .mobile-section-toggle[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }

  .site-header nav a:hover,
  .site-header nav button:hover {
    background: var(--color-tint);
  }

  .site-header nav :global(a.btn-primary:hover) {
    background: var(--color-accent-hover);
    color: #fff;
  }

  .site-header nav :global(a.btn-outline-dark:hover) {
    background: var(--color-ink);
    color: #fff;
  }

  .nav-dropdown-menu {
    display: none;
    padding: 1rem;
  }

  .nav-dropdown-menu ul {
    display: grid;
    gap: 0.5rem;
  }

  .nav-dropdown-item,
  .nav-dropdown-footer {
    display: block;
    padding: 13px 16px;
  }

  .nav-dropdown-footer {
    margin-top: 0.5rem;
  }

  .nav-item-title,
  .nav-item-desc {
    display: block;
  }

  .nav-item-desc {
    margin-top: 5px;
    line-height: 1.45;
  }

  .nav-dropdown:hover > .nav-dropdown-menu,
  .nav-dropdown:focus-within > .nav-dropdown-menu,
  .nav-dropdown.is-open > .nav-dropdown-menu {
    display: block;
  }

  .nav-dropdown:hover [data-dropdown-trigger] svg,
  .nav-dropdown:focus-within [data-dropdown-trigger] svg,
  .nav-dropdown.is-open [data-dropdown-trigger] svg {
    transform: rotate(180deg);
  }

  .nav-dropdown.is-escaped > .nav-dropdown-menu {
    display: none;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]');

  const setOpen = (dd: HTMLElement, open: boolean) => {
    const trigger = dd.querySelector<HTMLElement>('[data-dropdown-trigger]');
    dd.classList.toggle('is-open', open);
    trigger?.setAttribute('aria-expanded', String(open));
  };

  const closeAll = (except?: HTMLElement) => {
    dropdowns.forEach((dd) => {
      if (dd !== except) setOpen(dd, false);
    });
  };

  dropdowns.forEach((dd) => {
    const trigger = dd.querySelector<HTMLElement>('[data-dropdown-trigger]');
    const menu = dd.querySelector<HTMLElement>('[data-dropdown-menu]');
    if (!trigger || !menu) return;

    dd.addEventListener('mouseenter', () => {
      dd.classList.remove('is-escaped');
      closeAll(dd);
      setOpen(dd, true);
    });
    dd.addEventListener('mouseleave', () => {
      dd.classList.remove('is-escaped');
      setOpen(dd, false);
    });

    trigger.addEventListener('click', (e) => {
      if (trigger.tagName === 'A') return;
      e.preventDefault();
      dd.classList.remove('is-escaped');
      const open = trigger.getAttribute('aria-expanded') !== 'true';
      closeAll(dd);
      setOpen(dd, open);
    });

    dd.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && (dd.classList.contains('is-open') || dd.contains(document.activeElement))) {
        e.preventDefault();
        dd.classList.add('is-escaped');
        closeAll();
        trigger.focus();
      }
    });

    dd.addEventListener('focusin', () => {
      if (dd.classList.contains('is-escaped')) return;
      closeAll(dd);
      setOpen(dd, true);
    });

    dd.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (!next || !dd.contains(next)) {
        dd.classList.remove('is-escaped');
        setOpen(dd, false);
      }
    });
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (![...dropdowns].some((dd) => dd.contains(target))) closeAll();
  });

  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const mobileMenu = document.getElementById('mobile-menu');
  if (toggle && mobileMenu) {
    const setScrollLock = (lock: boolean) => {
      document.documentElement.style.overflow = lock ? 'hidden' : '';
      document.body.style.overflow = lock ? 'hidden' : '';
    };
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      mobileMenu.classList.toggle('hidden', !open);
      toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', open);
      header?.classList.toggle('is-open', open);
      setScrollLock(open);
      const label = toggle.querySelector('[data-mobile-label]');
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';
    };
    const sectionToggles = mobileMenu.querySelectorAll<HTMLButtonElement>('[data-mobile-section-toggle]');
    const setSection = (btn: HTMLButtonElement, open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      const panel = document.getElementById(btn.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !open;
    };
    sectionToggles.forEach((btn) => {
      btn.addEventListener('click', () => setSection(btn, btn.getAttribute('aria-expanded') !== 'true'));
    });
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      // Every time the menu opens, show only the collapsed top-level items.
      if (open) sectionToggles.forEach((btn) => setSection(btn, false));
      setOpen(open);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
