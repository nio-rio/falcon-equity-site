---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SERVICES } from '@/data/services';
import { PRIMARY_PHONE, RESOURCE_LINKS } from '@/data/site';
import { cleanPath } from '@/lib/paths';

const path = cleanPath(Astro.url.pathname);
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));

const simpleLinks = [
  { label: 'Industries', href: '/industries' },
  { label: 'About', href: '/about' },
  { label: 'Partners', href: '/partners' },
  { label: 'Contact', href: '/contact' },
];
const resourcesActive = RESOURCE_LINKS.some((l) => isActive(l.href)) || path.startsWith('/resources');
---

<header class="on-light sticky top-0 z-50 border-b border-lilac-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/85">
  <div class="container-site flex h-18 items-center justify-between gap-6">
    <a href="/" class="shrink-0 text-brand" aria-label="Falcon Equity Group home">
      <Logo class="h-6 w-auto sm:h-7" />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1 text-[15px] font-medium text-ink">
        <li class="relative" data-dropdown>
          <button
            type="button"
            class:list={[
              'inline-flex items-center gap-1 rounded-full px-3 py-2 hover:bg-lilac',
              isActive('/services') && 'text-brand underline decoration-lilac-deep decoration-2 underline-offset-8',
            ]}
            aria-expanded="false"
            aria-controls="menu-services"
            data-dropdown-trigger
          >
            Services <Icon name="chevron-down" size={16} class="transition-transform" />
          </button>
          <div
            id="menu-services"
            class="absolute top-full left-0 mt-2 hidden w-[34rem] rounded-2xl border border-lilac-200 bg-white p-3 shadow-xl"
            data-dropdown-menu
          >
            <ul class="grid grid-cols-2 gap-1">
              {
                SERVICES.map((s) => (
                  <li>
                    <a
                      href={`/services/${s.slug}`}
                      class="flex items-start gap-3 rounded-xl p-3 hover:bg-lilac"
                      aria-current={isActive(`/services/${s.slug}`) ? 'page' : undefined}
                    >
                      <span class="mt-0.5 rounded-lg bg-lilac p-1.5 text-brand">
                        <Icon name={s.icon} size={18} />
                      </span>
                      <span>
                        <span class="block text-sm font-semibold text-ink">{s.name}</span>
                        <span class="block text-xs text-muted">{s.amountsShort ?? s.amounts}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a href="/services" class="mt-2 block rounded-xl bg-lilac px-4 py-3 text-sm font-semibold text-brand hover:bg-lilac-200">
              Compare all funding options →
            </a>
          </div>
        </li>
        {
          simpleLinks.slice(0, 1).map((l) => (
            <li>
              <a
                href={l.href}
                class="rounded-full px-3 py-2 hover:bg-lilac"
                aria-current={isActive(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
        <li class="relative" data-dropdown>
          <button
            type="button"
            class:list={[
              'inline-flex items-center gap-1 rounded-full px-3 py-2 hover:bg-lilac',
              resourcesActive && 'text-brand underline decoration-lilac-deep decoration-2 underline-offset-8',
            ]}
            aria-expanded="false"
            aria-controls="menu-resources"
            data-dropdown-trigger
          >
            Resources <Icon name="chevron-down" size={16} class="transition-transform" />
          </button>
          <div
            id="menu-resources"
            class="absolute top-full left-0 mt-2 hidden w-72 rounded-2xl border border-lilac-200 bg-white p-2 shadow-xl"
            data-dropdown-menu
          >
            <ul>
              {
                RESOURCE_LINKS.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      class="block rounded-xl px-3 py-2.5 hover:bg-lilac"
                      aria-current={isActive(l.href) ? 'page' : undefined}
                    >
                      <span class="block text-sm font-semibold text-ink">{l.label}</span>
                      <span class="block text-xs text-muted">{l.description}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        {
          simpleLinks.slice(1).map((l) => (
            <li>
              <a
                href={l.href}
                class="rounded-full px-3 py-2 hover:bg-lilac"
                aria-current={isActive(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={PRIMARY_PHONE.href} class="inline-flex items-center gap-2 text-sm font-semibold text-brand hover:underline">
        <Icon name="phone" size={16} />
        <span><span class="sr-only">Call </span>{PRIMARY_PHONE.display}</span>
      </a>
      <a href="/apply" class="btn-primary px-5! py-2.5! text-sm!">Apply Now</a>
    </div>

    <button
      type="button"
      class="inline-flex items-center justify-center rounded-full p-2 text-brand hover:bg-lilac lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-mobile-toggle
    >
      <span class="sr-only" data-mobile-label>Open menu</span>
      <span data-icon-open><Icon name="menu" size={26} /></span>
      <span data-icon-close class="hidden"><Icon name="x" size={26} /></span>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Mobile" class="hidden max-h-[calc(100dvh-4.5rem)] overflow-y-auto border-t border-lilac-200 bg-white lg:hidden">
    <div class="container-site py-6">
      <p class="eyebrow text-muted">Services</p>
      <ul class="mt-2 grid gap-1 sm:grid-cols-2">
        <li><a href="/services" class="block rounded-xl px-3 py-2.5 font-semibold text-brand hover:bg-lilac">All funding options</a></li>
        {
          SERVICES.map((s) => (
            <li>
              <a href={`/services/${s.slug}`} class="block rounded-xl px-3 py-2.5 hover:bg-lilac">
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="eyebrow mt-6 text-muted">Resources</p>
      <ul class="mt-2 grid gap-1 sm:grid-cols-2">
        {
          RESOURCE_LINKS.map((l) => (
            <li>
              <a href={l.href} class="block rounded-xl px-3 py-2.5 hover:bg-lilac">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="eyebrow mt-6 text-muted">Company</p>
      <ul class="mt-2 grid gap-1 sm:grid-cols-2">
        {
          simpleLinks.map((l) => (
            <li>
              <a href={l.href} class="block rounded-xl px-3 py-2.5 hover:bg-lilac">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a href="/apply" class="btn-primary">Apply Now</a>
        <a href={PRIMARY_PHONE.href} class="btn-outline-dark"><Icon name="phone" size={18} /> {PRIMARY_PHONE.display}</a>
      </div>
    </div>
  </nav>
</header>

<script>
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]');

  const closeAll = (except?: HTMLElement) => {
    dropdowns.forEach((dd) => {
      if (dd === except) return;
      const trigger = dd.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
      const menu = dd.querySelector<HTMLElement>('[data-dropdown-menu]');
      trigger?.setAttribute('aria-expanded', 'false');
      trigger?.querySelector('svg')?.classList.remove('rotate-180');
      menu?.classList.add('hidden');
    });
  };

  dropdowns.forEach((dd) => {
    const trigger = dd.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
    const menu = dd.querySelector<HTMLElement>('[data-dropdown-menu]');
    if (!trigger || !menu) return;

    trigger.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') === 'true';
      closeAll(dd);
      trigger.setAttribute('aria-expanded', String(!open));
      trigger.querySelector('svg')?.classList.toggle('rotate-180', !open);
      menu.classList.toggle('hidden', open);
    });

    dd.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        closeAll();
        trigger.focus();
      }
    });

    dd.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !dd.contains(next)) closeAll();
    });
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (![...dropdowns].some((dd) => dd.contains(target))) closeAll();
  });

  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const mobileMenu = document.getElementById('mobile-menu');
  if (toggle && mobileMenu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      mobileMenu.classList.toggle('hidden', !open);
      toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
      const label = toggle.querySelector('[data-mobile-label]');
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
