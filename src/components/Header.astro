---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Logo from './Logo.astro';
import CircleArrow from './CircleArrow.astro';
import Button040 from './Button040.astro';
import { SERVICES } from '@/data/services';
import { INDUSTRIES } from '@/data/industries';
import { PRIMARY_PHONE } from '@/data/site';
import { cleanPath } from '@/lib/paths';
import blogStill from '@/assets/blog/merchant-cash-advance-vs-business-term-loan.jpg';
import servicesOverviewStill from '@/assets/services/business-term-loan.jpg';
import industriesOverviewStill from '@/assets/services/consolidation-of-positions.jpg';

const path = cleanPath(Astro.url.pathname);
const isHome = path === '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));

type NavLink = { label: string; href: string; contact?: boolean };
type NavColumn = { heading: string; links: NavLink[]; twoCol?: boolean };
type NavCard = {
  title: string;
  body: string;
  href: string;
  ctaLabel: string;
  ctaAria: string;
  image: ImageMetadata;
  alt: string;
};
type NavDropdown = {
  id: string;
  label: string;
  active: boolean;
  href?: undefined;
  columns: NavColumn[];
  widget?: NavCard;
};
type NavPlain = {
  id: string;
  label: string;
  active: boolean;
  href: string;
  columns?: undefined;
  widget?: undefined;
};
type NavItem = NavDropdown | NavPlain;

const nav: NavItem[] = [
  {
    id: 'services',
    label: 'Services',
    active: isActive('/services'),
    columns: [
      {
        heading: 'Services',
        twoCol: true,
        links: [
          ...SERVICES.map((s) => ({
            label: s.name,
            href: s.slug === 'decentralized-business-financing' ? '/#services' : `/services/${s.slug}`,
          })),
        ],
      },
    ],
    widget: {
      title: 'Services overview',
      body: 'Every product we fund, from $5,000 to $5,000,000, at a 0% agreement fee. One application, and a specialist matches the product to the need.',
      href: '/#services',
      ctaLabel: 'Learn More',
      ctaAria: 'Go to the services overview',
      image: servicesOverviewStill,
      alt: 'Abstract render of a sphere rising on a set of steps.',
    },
  },
  {
    id: 'industries',
    label: 'Industries',
    active: isActive('/industries'),
    columns: [
      {
        heading: 'Industries',
        twoCol: true,
        links: [
          ...INDUSTRIES.map((i) => ({ label: i.name, href: i.href ?? '/industries' })),
        ],
      },
    ],
    widget: {
      title: 'Industries overview',
      body: 'Twelve industries, twelve cash-flow rhythms. See how capital is shaped around the way your sector earns and spends.',
      href: '/industries',
      ctaLabel: 'Learn More',
      ctaAria: 'Go to the industries overview',
      image: industriesOverviewStill,
      alt: 'Abstract render of connected nodes branching from a single point.',
    },
  },
  {
    id: 'resources',
    label: 'Resources',
    active: isActive('/resources'),
    columns: [
      { heading: 'Blog', links: [{ label: 'Read our insights', href: '/blog' }] },
      {
        heading: 'Tools',
        links: [
          { label: 'Loan Calculator', href: '/resources/business-loan-calculator' },
          { label: 'Credit Repair & Loan Prep', href: '/resources/credit-repair-loan-prep' },
        ],
      },
      { heading: 'Help', links: [{ label: 'FAQ', href: '/faq' }] },
    ] satisfies NavColumn[],
    widget: {
      title: 'Guides for getting funded',
      body: 'Short, practical guides to getting approved, comparing products and managing cash flow.',
      href: '/blog',
      ctaLabel: 'Learn More',
      ctaAria: 'Go to the blog',
      image: blogStill,
      alt: 'Abstract render of two overlapping purple spheres.',
    },
  },
  {
    id: 'firm',
    label: 'Our Firm',
    active: false,
    columns: [
      {
        heading: 'Our Firm',
        links: [
          { label: 'About', href: '/about' },
          { label: 'Partners', href: '/#main' },
        ],
      },
      { heading: 'Contact', links: [{ label: 'Contact', href: '/contact', contact: true }] },
    ] satisfies NavColumn[],
  },
];
---

<header
  class:list={['site-header', isHome && 'is-color-theme-dark']}
  data-header
  data-menu-wrap
  data-menu-open="false"
  data-home={isHome ? '' : undefined}
>
  <div class="site-header__container" data-header-bar data-nav-bar>
    <div class="site-header__inner container-site">
      <div class="site-header__brand">
        <a href="/" class="site-header__logo" aria-label="Falcon Equity Group" data-menu-logo>
          <Logo variant="nav" />
        </a>
        <button type="button" class="site-header__back" data-mobile-back aria-label="Back to menu">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M11.3 1.7a1 1 0 0 1 0 1.4L5.4 9l5.9 5.9a1 1 0 1 1-1.4 1.4l-6.6-6.6a1 1 0 0 1 0-1.4l6.6-6.6a1 1 0 0 1 1.4 0Z"></path>
          </svg>
          <span>Back</span>
        </button>
      </div>

      <nav class="site-header__nav primary-nav" aria-label="Main">
        <div id="primary-nav-inner" class="primary-nav__inner" data-nav-inner>
          <div class="site-header__cta site-header__cta--menu" data-nav-list-item>
            <Button040 class="site-header__apply" href="/apply" label="Apply for funding" variant="dark" />
            <a class="site-header__tel" href={PRIMARY_PHONE.href}
              ><span class="site-header__tel-label">{PRIMARY_PHONE.display}</span></a
            >
          </div>
          <ul class="primary-nav__list" data-nav-list>
            {
              nav.map((item) =>
                item.href ? (
                  <li class:list={['primary-nav__list-item', item.active && 'is-current']} data-nav-list-item>
                    <a
                      href={item.href}
                      class="primary-nav__list-item-link"
                      aria-current={item.active ? 'page' : undefined}
                      data-nav-plain
                    >
                      <span class="primary-nav__list-item-label">{item.label}</span>
                    </a>
                  </li>
                ) : (
                  <li class:list={['primary-nav__list-item', 'has-children', item.active && 'is-current']} data-nav-item data-nav-list-item>
                    <button
                      type="button"
                      class="primary-nav__list-item-link"
                      aria-expanded="false"
                      aria-controls={`menu-${item.id}`}
                      aria-haspopup="true"
                      data-nav-trigger
                      data-dropdown-toggle={item.id}
                    >
                      <span class="primary-nav__list-item-label">{item.label}</span>
                      <svg class="primary-nav__list-item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
                        <path fill="currentColor" d="m8.7 12.4 7-6.8a1 1 0 0 0 0-1.4 1 1 0 0 0-1.4 0L8 10.3 1.7 4.2a1 1 0 0 0-1.4 0 1 1 0 0 0 0 1.4l7 6.8c.4.3 1 .3 1.4 0Z"></path>
                      </svg>
                    </button>
                  </li>
                ),
              )
            }
          </ul>
          <div class="primary-nav__dropdown" data-dropdown-wrapper>
            <div class="primary-nav__dropdown-container" data-dropdown-container>
              <div class="primary-nav__dropdown-bg" data-dropdown-bg></div>
              {
                nav.map((item) =>
                  item.columns ? (
                  <div
                    id={`menu-${item.id}`}
                    class="primary-nav__lvl-2-wrap"
                    aria-hidden="true"
                    data-nav-panel
                    data-nav-content={item.id}
                    data-panel-state=""
                    role="region"
                    aria-label={`${item.label} menu`}
                  >
                    <ul class="primary-nav__list-lvl-2" data-nav-panel-list>
                      {item.columns.map((col) => (
                        <li class:list={['primary-nav__list-lvl-2-item', col.twoCol && 'has-two-column-list']} data-menu-fade>
                          <span class="primary-nav__list-lvl-2-link">{col.heading}</span>
                          <ul class:list={['primary-nav__list-lvl-3', col.twoCol && 'primary-nav__list-lvl-3--two']}>
                            {col.links.map((l) => (
                              <li class="primary-nav__list-lvl-3-item">
                                {l.contact ? (
                                  <button
                                    type="button"
                                    class="primary-nav__list-lvl-3-link"
                                    data-contact-open
                                    aria-haspopup="dialog"
                                  >
                                    {l.label}
                                  </button>
                                ) : (
                                  <a
                                    href={l.href}
                                    class="primary-nav__list-lvl-3-link"
                                    aria-current={isActive(l.href) ? 'page' : undefined}
                                  >
                                    {l.label}
                                  </a>
                                )}
                              </li>
                            ))}
                          </ul>
                        </li>
                      ))}
                      {item.widget && (
                        <li class="primary-nav__list-lvl-2-item has-nav-widget" data-menu-fade>
                          {/* The whole card is the link; the "Learn More" row is its
                              affordance, not a second door to the same page. */}
                          <a
                            class="primary-nav-widget"
                            href={item.widget.href}
                            aria-label={item.widget.ctaAria}
                          >
                            <div class="primary-nav-widget__content">
                              <div class="primary-nav-widget__content-inner">
                                <p class="primary-nav-widget__title">{item.widget.title}</p>
                                <p>{item.widget.body}</p>
                              </div>
                              <div class="primary-nav-widget__cta">
                                <span class="arrow-cta">
                                  <span class="arrow-cta-label">{item.widget.ctaLabel}</span>
                                  <CircleArrow />
                                </span>
                              </div>
                            </div>
                            <div class="primary-nav-widget__media">
                              <Picture
                                src={item.widget.image}
                                alt={item.widget.alt}
                                widths={[320, 480, 640]}
                                sizes="(min-width: 90em) 14rem, 12.5rem"
                                formats={['avif', 'webp']}
                                fallbackFormat="webp"
                                quality={80}
                                loading="lazy"
                                class="primary-nav-widget__img"
                              />
                            </div>
                          </a>
                        </li>
                      )}
                    </ul>
                  </div>
                  ) : null,
                )
              }
            </div>
          </div>
        </div>
      </nav>

      <div class="site-header__tools">
        <a class="site-header__tel site-header__tel--bar" href={PRIMARY_PHONE.href}
          ><span class="site-header__tel-label">{PRIMARY_PHONE.display}</span></a
        >
        <Button040
          class="site-header__apply site-header__apply--bar"
          href="/apply"
          label="Apply for funding"
          compactLabel="Apply"
          variant="dark"
        />
        <button
          type="button"
          class="primary-nav__toggle"
          aria-expanded="false"
          aria-controls="primary-nav-inner"
          data-mobile-toggle
          data-burger-toggle
        >
          <span class="sr-only" data-mobile-label>Open menu</span>
          <svg class="primary-nav__toggle-lines" width="34" height="24" viewBox="0 0 34 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M1.71 0a1.71 1.71 0 1 0 0 3.43H32.3a1.71 1.71 0 0 0 0-3.43H1.7Zm0 10.29a1.71 1.71 0 0 0 0 3.42H32.3a1.71 1.71 0 0 0 0-3.42H1.7Zm0 10.28a1.71 1.71 0 0 0 0 3.43H32.3a1.71 1.71 0 0 0 0-3.43H1.7Z"></path>
          </svg>
          <svg class="primary-nav__toggle-cross" width="34" height="24" viewBox="0 0 34 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M28.57 2.53c.57-.57.57-1.5 0-2.08l-.02-.02a1.47 1.47 0 0 0-2.08 0l-8.43 8.42a1.47 1.47 0 0 1-2.08 0L7.53.43a1.47 1.47 0 0 0-2.08 0l-.02.02a1.47 1.47 0 0 0 0 2.08l8.42 8.43a1.47 1.47 0 0 1 0 2.08l-8.42 8.43c-.57.57-.57 1.5 0 2.08l.02.02a1.47 1.47 0 0 0 2.08 0l8.43-8.42a1.47 1.47 0 0 1 2.08 0l8.43 8.42c.57.57 1.5.57 2.08 0l.02-.02a1.47 1.47 0 0 0 0-2.08l-8.42-8.43a1.47 1.47 0 0 1 0-2.08l8.42-8.43Z"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>
<div
  class="primary-nav__backdrop primary-nav__backdrop--hidden"
  data-nav-backdrop
  data-menu-backdrop
  hidden
  style="-webkit-backdrop-filter: blur(5px); backdrop-filter: blur(5px)"
></div>

<script>
  import '@/scripts/nav';
</script>
