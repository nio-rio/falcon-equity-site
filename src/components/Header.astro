---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SERVICES } from '@/data/services';
import { INDUSTRIES } from '@/data/industries';
import { FIRM_LINKS, PRIMARY_PHONE, RESOURCE_LINKS } from '@/data/site';
import { cleanPath } from '@/lib/paths';

const path = cleanPath(Astro.url.pathname);
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));

const resourcesActive = RESOURCE_LINKS.some((l) => isActive(l.href)) || path.startsWith('/resources');
const firmActive = FIRM_LINKS.some((l) => isActive(l.href));
const industriesActive = isActive('/industries');

const mobileSections = [
  {
    id: 'services',
    label: 'Services',
    links: [{ label: 'All funding options', href: '/services' }, ...SERVICES.map((s) => ({ label: s.name, href: `/services/${s.slug}` }))],
  },
  { id: 'firm', label: 'Our Firm', links: FIRM_LINKS.map((l) => ({ label: l.label, href: l.href })) },
  { id: 'resources', label: 'Resources', links: RESOURCE_LINKS.map((l) => ({ label: l.label, href: l.href })) },
  {
    id: 'industries',
    label: 'Industries',
    links: [{ label: 'All industries', href: '/industries' }, ...INDUSTRIES.map((i) => ({ label: i.name, href: `/industries/${i.slug}` }))],
  },
];
---

<header class="site-header" data-header>
  <div class="header-bar container-site">
    <a href="/" class="header-logo" aria-label="Falcon Equity Group home">
      <Logo class="h-6 w-auto md:h-[1.8rem]" />
    </a>

    <nav aria-label="Main" class="header-nav">
      <ul>
        <li class="nav-dropdown" data-dropdown>
          <a
            href="/services"
            class:list={['header-nav-link', isActive('/services') && 'is-active']}
            aria-current={path === '/services' ? 'page' : undefined}
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="menu-services"
            data-dropdown-trigger
          >
            Services <Icon name="chevron-down" size={14} />
          </a>
          <div id="menu-services" class="nav-dropdown-menu nav-dropdown-menu--wide" data-dropdown-menu>
            <ul>
              {
                SERVICES.map((s) => (
                  <li>
                    <a
                      href={`/services/${s.slug}`}
                      class="nav-dropdown-item"
                      aria-current={isActive(`/services/${s.slug}`) ? 'page' : undefined}
                    >
                      <span class="nav-item-title">{s.name}</span>
                      <span class="nav-item-desc">{s.amountsShort ?? s.amounts}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a href="/services" class="nav-dropdown-footer">Compare all funding options</a>
          </div>
        </li>
        <li class="nav-dropdown" data-dropdown>
          <button
            type="button"
            class:list={['header-nav-link', firmActive && 'is-active']}
            aria-expanded="false"
            aria-controls="menu-firm"
            data-dropdown-trigger
          >
            Our Firm <Icon name="chevron-down" size={14} />
          </button>
          <div id="menu-firm" class="nav-dropdown-menu" data-dropdown-menu>
            <ul>
              {
                FIRM_LINKS.map((l) => (
                  <li>
                    <a href={l.href} class="nav-dropdown-item" aria-current={isActive(l.href) ? 'page' : undefined}>
                      <span class="nav-item-title">{l.label}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        <li class="nav-dropdown" data-dropdown>
          <button
            type="button"
            class:list={['header-nav-link', resourcesActive && 'is-active']}
            aria-expanded="false"
            aria-controls="menu-resources"
            data-dropdown-trigger
          >
            Resources <Icon name="chevron-down" size={14} />
          </button>
          <div id="menu-resources" class="nav-dropdown-menu" data-dropdown-menu>
            <ul>
              {
                RESOURCE_LINKS.map((l) => (
                  <li>
                    <a href={l.href} class="nav-dropdown-item" aria-current={isActive(l.href) ? 'page' : undefined}>
                      <span class="nav-item-title">{l.label}</span>
                      <span class="nav-item-desc">{l.description}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        <li class="nav-dropdown" data-dropdown>
          <button
            type="button"
            class:list={['header-nav-link', industriesActive && 'is-active']}
            aria-expanded="false"
            aria-controls="menu-industries"
            data-dropdown-trigger
          >
            Industries <Icon name="chevron-down" size={14} />
          </button>
          <div id="menu-industries" class="nav-dropdown-menu nav-dropdown-menu--wide nav-dropdown-menu--end" data-dropdown-menu>
            <ul>
              {
                INDUSTRIES.map((i) => (
                  <li>
                    <a
                      href={`/industries/${i.slug}`}
                      class="nav-dropdown-item"
                      aria-current={isActive(`/industries/${i.slug}`) ? 'page' : undefined}
                    >
                      <span class="nav-item-title">{i.name}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a href="/industries" class="nav-dropdown-footer">View all industries</a>
          </div>
        </li>
      </ul>
    </nav>

    <div class="header-actions">
      <a href={PRIMARY_PHONE.href} class="header-phone">
        <Icon name="phone" size={16} />
        <span class="sr-only">Call </span>{PRIMARY_PHONE.display}
      </a>
      <a href="/apply" class="btn-primary">Get Funding Today</a>
    </div>

    <button
      type="button"
      class="header-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-mobile-toggle
    >
      <span class="sr-only" data-mobile-label>Open menu</span>
      <span data-icon-open><Icon name="menu" size={24} /></span>
      <span data-icon-close class="hidden"><Icon name="x" size={24} /></span>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Mobile" class="mobile-menu">
    <div class="container-site mobile-menu-inner">
      <ul class="mobile-sections">
        {
          mobileSections.map((section) => (
            <li class="mobile-section" data-mobile-section>
              <button
                type="button"
                class="mobile-section-toggle"
                aria-expanded="false"
                aria-controls={`mobile-menu-${section.id}`}
                data-mobile-section-toggle
              >
                <span>{section.label}</span>
                <Icon name="chevron-down" size={18} />
              </button>
              <ul id={`mobile-menu-${section.id}`} class="mobile-section-panel" hidden>
                {section.links.map((l) => (
                  <li>
                    <a href={l.href} class="mobile-section-link" aria-current={path === l.href ? 'page' : undefined}>
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
      <div class="mobile-cta-row">
        <a href="/apply" class="btn-primary">Get Funding Today</a>
        <a href={PRIMARY_PHONE.href} class="btn-outline-dark">{PRIMARY_PHONE.display}</a>
      </div>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]');

  const setOpen = (dd: HTMLElement, open: boolean) => {
    const trigger = dd.querySelector<HTMLElement>('[data-dropdown-trigger]');
    dd.classList.toggle('is-open', open);
    trigger?.setAttribute('aria-expanded', String(open));
  };

  const closeAll = (except?: HTMLElement) => {
    dropdowns.forEach((dd) => {
      if (dd !== except) setOpen(dd, false);
    });
  };

  dropdowns.forEach((dd) => {
    const trigger = dd.querySelector<HTMLElement>('[data-dropdown-trigger]');
    const menu = dd.querySelector<HTMLElement>('[data-dropdown-menu]');
    if (!trigger || !menu) return;

    dd.addEventListener('mouseenter', () => {
      dd.classList.remove('is-escaped');
      closeAll(dd);
      setOpen(dd, true);
    });
    dd.addEventListener('mouseleave', () => {
      dd.classList.remove('is-escaped');
      setOpen(dd, false);
    });

    trigger.addEventListener('click', (e) => {
      if (trigger.tagName === 'A') return;
      e.preventDefault();
      dd.classList.remove('is-escaped');
      const open = trigger.getAttribute('aria-expanded') !== 'true';
      closeAll(dd);
      setOpen(dd, open);
    });

    dd.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && (dd.classList.contains('is-open') || dd.contains(document.activeElement))) {
        e.preventDefault();
        dd.classList.add('is-escaped');
        closeAll();
        trigger.focus();
      }
    });

    dd.addEventListener('focusin', () => {
      if (dd.classList.contains('is-escaped')) return;
      closeAll(dd);
      setOpen(dd, true);
    });

    dd.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (!next || !dd.contains(next)) {
        dd.classList.remove('is-escaped');
        setOpen(dd, false);
      }
    });
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (![...dropdowns].some((dd) => dd.contains(target))) closeAll();
  });

  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const mobileMenu = document.getElementById('mobile-menu');
  if (toggle && mobileMenu) {
    const setScrollLock = (lock: boolean) => {
      document.documentElement.style.overflow = lock ? 'hidden' : '';
      document.body.style.overflow = lock ? 'hidden' : '';
    };
    const setMenuOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      mobileMenu.classList.toggle('is-open', open);
      toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', open);
      header?.classList.toggle('is-open', open);
      setScrollLock(open);
      const label = toggle.querySelector('[data-mobile-label]');
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';
    };
    const sectionToggles = mobileMenu.querySelectorAll<HTMLButtonElement>('[data-mobile-section-toggle]');
    const setSection = (btn: HTMLButtonElement, open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      const panel = document.getElementById(btn.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !open;
    };
    sectionToggles.forEach((btn) => {
      btn.addEventListener('click', () => setSection(btn, btn.getAttribute('aria-expanded') !== 'true'));
    });
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      if (open) sectionToggles.forEach((btn) => setSection(btn, false));
      setMenuOpen(open);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setMenuOpen(false);
        toggle.focus();
      }
    });
  }
</script>
