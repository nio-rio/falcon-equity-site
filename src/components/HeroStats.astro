---
import { compactStatValue } from '@/lib/statDisplay';

export type HeroStat = {
  label: string;
  value: string;
};

interface Props {
  featured: HeroStat;
  side: HeroStat[];
}

const { featured, side } = Astro.props;
const featuredValue = compactStatValue(featured.label, featured.value);
const sideStats = side.slice(0, 2).map((stat) => ({
  label: stat.label,
  value: compactStatValue(stat.label, stat.value),
}));
---

<section class="stats-bx" aria-label="Published figures">
  <div class="stats-bx__inner">
    <div class="stats-bx__featured">
      <p class="stats-bx__label stats-bx__label--featured">{featured.label}</p>
      <p class="stats-bx__value stats-bx__value--featured">{featuredValue}</p>
    </div>
    {
      sideStats.length > 0 && (
        <div class="stats-bx__side">
          {sideStats.map((stat) => (
            <div class="stats-bx__field">
              <p class="stats-bx__label">{stat.label}</p>
              <p class="stats-bx__value">{stat.value}</p>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  /* BXCI `.bx-stat-featured` — sizes from blackstone-v2 Wayback 20260925104209.
     Scoped to this component so global type/grid changes cannot restyle it. */
  .stats-bx {
    box-sizing: border-box;
    width: 100%;
    max-width: calc(var(--bx-max) + 2 * var(--bx-margin));
    margin-inline: auto;
    padding-block: var(--bx-section);
    padding-inline: var(--bx-margin);
    overflow-x: clip;
    color: var(--bx-black);
    background: #fff;
  }

  .stats-bx__inner {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 2.5rem;
  }

  .stats-bx__featured,
  .stats-bx__field,
  .stats-bx__side {
    min-width: 0;
  }

  .stats-bx__featured,
  .stats-bx__field {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .stats-bx__label,
  .stats-bx__value {
    margin: 0;
  }

  .stats-bx__label {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 1rem; /* --fs-16 */
    line-height: 1.25;
    color: var(--bx-black);
  }

  .stats-bx__label--featured {
    font-size: 1.5rem; /* --fs-24 */
    line-height: 1.25;
  }

  .stats-bx__value {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 2.5rem; /* --fs-40 */
    line-height: 1.1;
    color: var(--bx-black);
    padding-bottom: 1rem; /* --spacing-16 */
  }

  .stats-bx__value--featured {
    margin-top: var(--bx-space-12); /* BX 40 minus 3rem, floored */
    padding-bottom: 3rem; /* --spacing-48 */
    font-size: 5rem; /* --fs-80 */
    line-height: 1;
    letter-spacing: -0.03em;
    white-space: nowrap;
    max-width: 100%;
  }

  .stats-bx__side {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .stats-bx__field {
    padding-bottom: 0;
    border-bottom: 0.0625rem solid var(--bx-black);
  }

  .stats-bx__label:not(.stats-bx__label--featured) {
    margin-bottom: var(--bx-space-12); /* BX 32 minus 3rem, floored */
  }

  @media (min-width: 768px) {
    .stats-bx__label--featured {
      font-size: 2rem; /* --fs-32 */
    }

    .stats-bx__value--featured {
      margin-top: var(--bx-space-12);
      padding-bottom: 3.5rem;
      font-size: 11rem; /* --fs-176 */
    }

    .stats-bx__value:not(.stats-bx__value--featured) {
      font-size: 2rem; /* --fs-32 at 48em */
    }

    .stats-bx__side {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 1.5rem;
      align-items: end;
    }

    .stats-bx__side:has(:only-child) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .stats-bx__inner {
      grid-template-columns: minmax(0, 35rem) minmax(0, 1fr);
      column-gap: 1.5rem;
      align-items: end;
      row-gap: 0;
    }

    .stats-bx__value--featured {
      margin-top: var(--bx-space-12);
      padding-bottom: 0;
      font-size: 9rem;
    }

    .stats-bx__value:not(.stats-bx__value--featured) {
      font-size: 2.5rem; /* --fs-40 */
      line-height: 1.1;
    }
  }

  @media (min-width: 1440px) {
    .stats-bx__inner {
      grid-template-columns: minmax(0, 39rem) minmax(0, 1fr);
    }

    .stats-bx__value--featured {
      margin-top: var(--bx-space-12);
      font-size: 10rem;
    }

    .stats-bx__value:not(.stats-bx__value--featured) {
      font-size: 3rem; /* --fs-48 */
    }
  }
</style>
