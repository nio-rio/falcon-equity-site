---
import Media from './Media.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  intent: string;
  image?: ImageMetadata;
  ratio?: string;
  class?: string;
  labeled?: boolean;
  alt?: string;
  priority?: boolean;
  sizes?: string;
}

const props = Astro.props;
---

<Media {...props} />
