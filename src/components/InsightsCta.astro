---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArrowCta from './ArrowCta.astro';
import ImageSlot from './ImageSlot.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  ctaLabel?: string;
  href?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  intent?: string;
}

const {
  eyebrow = 'Apply for funding',
  title = 'Get funding today',
  ctaLabel = 'Apply',
  href = '/apply',
  image,
  imageAlt,
  intent = 'quiet office desk and statements, even daylight, empty of people',
} = Astro.props;
---

<section class="insights-cta on-dark" aria-labelledby="insights-cta-heading">
  <div class="container-site insights-cta-grid">
    <div class="insights-cta-copy">
      <p class="eyebrow eyebrow--line text-white/70">{eyebrow}</p>
      <h2 id="insights-cta-heading">{title}</h2>
      <ArrowCta href={href} label={ctaLabel} tone="light" />
    </div>
    <div class="insights-cta-media">
      {
        image ? (
          <Image
            src={image}
            alt={imageAlt ?? ''}
            widths={[720, 1100]}
            sizes="(min-width: 900px) 42vw, 100vw"
            class="h-full w-full object-cover"
          />
        ) : (
          <ImageSlot labeled intent={intent} ratio="4 / 5" />
        )
      }
    </div>
  </div>
</section>
