---
import type { ImageMetadata } from 'astro';
import ArrowCta from './ArrowCta.astro';
import Eyebrow from './Eyebrow.astro';
import Media from './Media.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  ctaLabel?: string;
  href?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  intent?: string;
}

const {
  eyebrow = 'Apply for funding',
  title = 'Get funding today',
  ctaLabel = 'Apply',
  href = '/apply',
  image,
  imageAlt,
  intent = 'quiet office desk and statements, even daylight, empty of people',
} = Astro.props;
---

<section class="insights-cta on-dark" id="insights-cta" aria-labelledby="insights-cta-heading">
  <div class="container-site">
    <div class="bx-grid">
      <div class="insights-cta-copy section-stack bx-span-4 bx-lg-span-6">
        <div class="section-head">
          <Eyebrow>{eyebrow}</Eyebrow>
          <h2 id="insights-cta-heading">{title}</h2>
        </div>
        <div class="section-cta">
          <ArrowCta href={href} label={ctaLabel} tone="light" />
        </div>
      </div>
      <div class="insights-cta-media bx-span-4 bx-lg-span-6">
        <Media
          image={image}
          alt={imageAlt}
          intent={intent}
          labeled={!image}
          ratio="3 / 4"
          sizes="(min-width: 1024px) 42vw, 100vw"
        />
      </div>
    </div>
  </div>
</section>
