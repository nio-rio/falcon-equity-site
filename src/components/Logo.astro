---
import logoSvg from '@/assets/brand/falcon-logo-full.svg?raw';

interface Props {
  class?: string;
}

const { class: className = 'h-7 w-auto' } = Astro.props;

// The official file ships with a fixed #332A4E fill; currentColor lets the same lockup work on light and dark backgrounds.
const svg = logoSvg
  .replace(/fill="#332A4E"/gi, 'fill="currentColor"')
  .replace(/\s(width|height)="\d+"/g, '')
  .replace('<svg', `<svg class="${className}" aria-hidden="true" focusable="false"`);
---

<Fragment set:html={svg} />
