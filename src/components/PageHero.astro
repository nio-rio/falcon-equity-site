---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="bg-white">
  <div class="container-site py-12 md:py-16 lg:py-20">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class:list={['max-w-4xl', eyebrow && 'mt-3']}>{title}</h1>
    {lead && <p class="mt-6 max-w-2xl text-ink-soft">{lead}</p>}
    <slot />
  </div>
</section>
