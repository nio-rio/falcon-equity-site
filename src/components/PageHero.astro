---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  breadcrumbs?: { name: string; path: string }[];
}

const { eyebrow, title, lead, breadcrumbs } = Astro.props;
---

<section class="on-dark relative overflow-hidden bg-brand-dark text-white">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(60rem_30rem_at_85%_-10%,rgba(185,176,232,0.28),transparent_60%)]"
    aria-hidden="true"
  >
  </div>
  <div class="container-site relative py-16 sm:py-20 lg:py-24">
    {
      breadcrumbs && breadcrumbs.length > 1 && (
        <nav aria-label="Breadcrumb" class="mb-6 text-sm text-lilac-200">
          <ol class="flex flex-wrap items-center gap-2">
            {breadcrumbs.map((b, i) => (
              <li class="flex items-center gap-2">
                {i < breadcrumbs.length - 1 ? (
                  <>
                    <a href={b.path} class="hover:text-white hover:underline">
                      {b.name}
                    </a>
                    <span aria-hidden="true">/</span>
                  </>
                ) : (
                  <span aria-current="page" class="text-white">
                    {b.name}
                  </span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    {eyebrow && <p class="eyebrow text-lilac-deep">{eyebrow}</p>}
    <h1 class="mt-3 max-w-4xl text-4xl leading-[1.08] font-semibold sm:text-6xl">{title}</h1>
    {lead && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-lilac-200 sm:text-xl">{lead}</p>}
    <slot />
  </div>
</section>
