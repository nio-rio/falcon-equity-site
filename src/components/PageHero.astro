---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  breadcrumbs?: { name: string; path: string }[];
}

const { eyebrow, title, lead, breadcrumbs } = Astro.props;
---

<section class="border-b border-line bg-white">
  <div class="container-site py-16 sm:py-20 lg:py-24">
    {
      breadcrumbs && breadcrumbs.length > 1 && (
        <nav aria-label="Breadcrumb" class="mb-8 text-sm text-muted">
          <ol class="flex flex-wrap items-center gap-2">
            {breadcrumbs.map((b, i) => (
              <li class="flex items-center gap-2">
                {i < breadcrumbs.length - 1 ? (
                  <>
                    <a href={b.path} class="hover:text-ink hover:underline">
                      {b.name}
                    </a>
                    <span aria-hidden="true">/</span>
                  </>
                ) : (
                  <span aria-current="page" class="text-ink">
                    {b.name}
                  </span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-3 max-w-4xl text-4xl leading-[1.08] font-semibold sm:text-6xl">{title}</h1>
    {lead && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">{lead}</p>}
    <slot />
  </div>
</section>
