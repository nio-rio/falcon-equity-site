---
import { Image } from 'astro:assets';
import type { Post } from '@/lib/blog';
import { formatDate } from '@/lib/blog';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, category, excerpt, cover, coverAlt, draft } = post.data;
---

<article class="group relative flex h-full flex-col overflow-hidden border-t border-line pt-6">
  {
    cover && (
      <Image
        src={cover}
        alt={coverAlt}
        widths={[480, 800]}
        sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
        class="aspect-[16/9] w-full object-cover"
      />
    )
  }
  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <p class="flex flex-wrap items-center gap-2 text-sm text-muted">
      <span class="font-semibold text-accent">{category}</span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {draft && <span class="font-semibold text-accent">Draft</span>}
    </p>
    <h3 class="mt-4 text-xl leading-snug font-semibold">
      <a href={`/blog/${post.id}`} class="after:absolute after:inset-0 focus-visible:outline-none">{title}</a>
    </h3>
    <p class="mt-3 flex-1 leading-relaxed text-muted">{excerpt}</p>
  </div>
</article>

<style>
  article:has(a:focus-visible) {
    outline: 3px solid var(--color-brand);
    outline-offset: 3px;
  }
</style>
