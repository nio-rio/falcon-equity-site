---
import { Image } from 'astro:assets';
import type { Post } from '@/lib/blog';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, category, cover, coverAlt, draft } = post.data;
---

<article class="group relative">
  {
    cover && (
      <Image
        src={cover}
        alt={coverAlt}
        widths={[480, 800]}
        sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
        class="aspect-[16/9] w-full object-cover"
      />
    )
  }
  <p class="eyebrow mt-4">{category}{draft && ' · Draft'}</p>
  <h3 class="mt-2">
    <a href={`/blog/${post.id}`} class="after:absolute after:inset-0 group-hover:underline focus-visible:outline-none">{title}</a>
  </h3>
</article>

<style>
  article:has(a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
  }
</style>
