---
import Media from './Media.astro';
import type { Post } from '@/lib/blog';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, category, cover, coverAlt, draft } = post.data;
---

<article class="post-card group relative">
  <div class="post-card-media media-zoom">
    <Media
      image={cover}
      alt={coverAlt}
      intent={coverAlt || 'editorial photograph for this article'}
      labeled={!cover}
      ratio="16 / 9"
      sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
    />
  </div>
  <p class="post-card-cat eyebrow">{category}{draft && ' · Draft'}</p>
  <h3 class="post-card-title">
    <a href={`/blog/${post.id}`} class="after:absolute after:inset-0">
      <span class="link-draw">{title}</span>
    </a>
  </h3>
</article>
