---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  quote: string;
  name: string;
  role: string;
  image: ImageMetadata;
  imageAlt: string;
}

const { quote, name, role, image, imageAlt } = Astro.props;
---

<figure class="quote-split">
  <div class="quote-split-photo">
    <Image
      src={image}
      alt={imageAlt}
      widths={[640, 960, 1280]}
      sizes="(min-width: 768px) 42vw, 100vw"
      loading="eager"
    />
  </div>
  <blockquote>
    <p class="quote-split-text">{quote}</p>
  </blockquote>
  <figcaption class="quote-split-attr">
    <span class="quote-split-name">{name}</span>
    <span class="quote-split-role">{role}</span>
  </figcaption>
</figure>
