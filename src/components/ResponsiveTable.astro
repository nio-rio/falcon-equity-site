---
export type TableCell = string | { href: string; text: string };

interface Props {
  caption?: string;
  labelledBy?: string;
  headers: string[];
  rows: TableCell[][];
  class?: string;
}

const { caption, labelledBy, headers, rows, class: className } = Astro.props;
---

<div class:list={['r-table-wrap r-table-scroll', className]} data-table-scroll role="region" aria-labelledby={labelledBy}>
  <div class="r-table-scroll-view">
    <table class="r-table">
      {caption && <caption class="sr-only">{caption}</caption>}
      <thead>
        <tr>
          {
            headers.map((header) => (
              <th scope="col">
                {header ? header : <span class="sr-only">Details</span>}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              {row.map((cell, i) => {
                const Tag = i === 0 ? 'th' : 'td';
                const label = i > 0 ? headers[i]?.trim() : '';
                return (
                  <Tag scope={i === 0 ? 'row' : undefined} data-label={label || undefined}>
                    {typeof cell === 'string' ? cell : <a class="link" href={cell.href}>{cell.text}</a>}
                  </Tag>
                );
              })}
            </tr>
          ))}
      </tbody>
    </table>
  </div>
  <div class="r-table-progress" aria-hidden="true">
    <div class="r-table-progress-thumb" data-table-thumb></div>
  </div>
</div>

<script>
  const sync = (root: HTMLElement) => {
    const view = root.querySelector<HTMLElement>('.r-table-scroll-view');
    const thumb = root.querySelector<HTMLElement>('[data-table-thumb]');
    if (!view || !thumb) return;
    const overflow = view.scrollWidth - view.clientWidth;
    root.classList.toggle('is-scrollable', overflow > 8);
    const ratio = view.clientWidth / Math.max(view.scrollWidth, 1);
    const left = overflow > 0 ? view.scrollLeft / overflow : 0;
    thumb.style.width = `${Math.min(1, ratio) * 100}%`;
    thumb.style.transform = `translateX(${left * ((1 / Math.min(1, ratio) - 1) * 100)}%)`;
  };

  const bind = (root: HTMLElement) => {
    const view = root.querySelector<HTMLElement>('.r-table-scroll-view');
    if (!view) return;
    const run = () => sync(root);
    view.addEventListener('scroll', run, { passive: true });
    window.addEventListener('resize', run);
    run();
  };

  document.querySelectorAll<HTMLElement>('[data-table-scroll]').forEach(bind);
</script>
