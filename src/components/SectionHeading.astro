---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
}

const { id, eyebrow, title, lead, align = 'left' } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} class:list={[eyebrow && 'mt-3']}>{title}</h2>
  {lead && <p class="mt-4 text-ink-soft">{lead}</p>}
</div>
