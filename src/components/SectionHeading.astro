---
import Eyebrow from './Eyebrow.astro';

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { id, eyebrow, title, lead, align = 'left', class: className } = Astro.props;
---

<div class:list={['section-head', align === 'center' && 'text-center', className]}>
  {eyebrow && <Eyebrow align={align}>{eyebrow}</Eyebrow>}
  <h2 id={id}>{title}</h2>
  {lead && <p class="section-lead section-cta">{lead}</p>}
</div>
