---
import { Image } from 'astro:assets';
import ServiceSpec from './ServiceSpec.astro';
import ArrowCta from './ArrowCta.astro';
import type { Service } from '@/data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="service-row">
  <div class="service-row-top">
    <div class="service-row-media media-zoom">
      <Image
        src={service.image}
        alt=""
        widths={[480, 720, 960]}
        sizes="(min-width: 768px) 22.5rem, 100vw"
        class="h-full w-full object-cover"
      />
    </div>
    <div class="service-row-copy">
      <h3>{service.name}</h3>
      <p class="mt-3 text-ink-soft">{service.summary}</p>
    </div>
  </div>
  {
    service.spec ? (
      <ServiceSpec spec={service.spec} class="service-row-spec" />
    ) : (
      <p class="service-row-range">{service.rangeLine}</p>
    )
  }
  <p class="service-row-actions">
    <ArrowCta href={`/services/${service.slug}`} label="Learn more" />
    <a class="btn-primary" href="/apply">Apply now</a>
  </p>
</article>

<style>
  .service-row {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block: 2.5rem;
    background: none;
    width: 100%;
    min-width: 0;
  }

  .service-row-top {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .service-row-top {
      flex-direction: row;
      align-items: center;
      gap: 3rem;
    }
  }

  .service-row-media {
    flex: none;
    width: 100%;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  @media (min-width: 768px) {
    .service-row-media {
      width: 22.5rem;
    }
  }

  .service-row-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  .service-row-copy {
    min-width: 0;
    flex: 1;
  }

  .service-row h3 {
    font-size: 1.75rem;
    line-height: 1.15;
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .service-row h3 {
      font-size: 2rem;
    }
  }

  .service-row-range {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .service-row-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
    margin: 0;
  }

  .service-row :global(.service-row-spec) {
    width: 100%;
    min-width: 0;
  }
</style>
