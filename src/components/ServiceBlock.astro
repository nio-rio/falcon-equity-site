---
import Icon from './Icon.astro';
import type { Service } from '@/data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="service-card group relative">
  <h3 class="flex items-start gap-3">
    <Icon name={service.icon} size={32} class="mt-1.5 shrink-0 text-accent" />
    <a href={`/services/${service.slug}`} class="service-card-link">
      {service.name}
    </a>
  </h3>
  <p class="mt-3 max-w-3xl text-ink-soft">{service.summary}</p>
  <dl class="mt-8 grid gap-8 sm:grid-cols-3">
    <div>
      <dt class="text-sm text-muted">Who it is for</dt>
      <dd class="mt-1 text-ink">{service.whoFor}</dd>
    </div>
    <div>
      <dt class="text-sm text-muted">Amounts</dt>
      <dd class="mt-1 text-ink">{service.amounts}</dd>
    </div>
    <div>
      <dt class="text-sm text-muted">Terms</dt>
      <dd class="mt-1 text-ink">{service.terms}</dd>
    </div>
  </dl>
  <p class="mt-6 text-sm text-muted">Requirements</p>
  <ul class="mt-2 flex flex-wrap gap-x-8 gap-y-2">
    {
      service.requirements.map((r) => (
        <li class="flex items-start gap-2 text-[15px] text-ink">
          <Icon name="check" size={16} class="mt-1 shrink-0 text-accent" />
          {r}
        </li>
      ))
    }
  </ul>
</article>

<style>
  .service-card {
    isolation: isolate;
    background: var(--color-tint);
    padding: 2rem;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  @media (min-width: 768px) {
    .service-card {
      padding: 2.5rem;
    }
  }

  .service-card:hover {
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-tint));
  }

  .service-card h3 {
    font-size: 30px;
    line-height: 36px;
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .service-card h3 {
      font-size: 33px;
      line-height: 40px;
    }
  }

  @media (min-width: 1024px) {
    .service-card h3 {
      font-size: 39px;
      line-height: 46px;
    }
  }

  .service-card-link {
    color: inherit;
    text-decoration: none;
  }

  .service-card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .service-card:hover .service-card-link {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .service-card-link:focus {
    outline: none;
  }

  .service-card-link:focus-visible {
    outline: none;
  }

  .service-card:has(.service-card-link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
