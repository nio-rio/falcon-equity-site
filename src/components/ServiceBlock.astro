---
import Icon from './Icon.astro';
import type { Service } from '@/data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="group relative py-10 first:pt-0 last:pb-0">
  <h3 class="flex items-start gap-3">
    <Icon name={service.icon} size={28} class="mt-1 shrink-0 text-accent" />
    <a href={`/services/${service.slug}`} class="after:absolute after:inset-0 group-hover:underline">
      {service.name}
    </a>
  </h3>
  <p class="mt-3 max-w-3xl text-ink-soft">{service.summary}</p>
  <dl class="mt-8 grid gap-8 sm:grid-cols-3">
    <div>
      <dt class="text-sm text-muted">Who it is for</dt>
      <dd class="mt-1 text-ink">{service.whoFor}</dd>
    </div>
    <div>
      <dt class="text-sm text-muted">Amounts</dt>
      <dd class="mt-1 text-ink">{service.amounts}</dd>
    </div>
    <div>
      <dt class="text-sm text-muted">Terms</dt>
      <dd class="mt-1 text-ink">{service.terms}</dd>
    </div>
  </dl>
  <p class="mt-6 text-sm text-muted">Requirements</p>
  <ul class="mt-2 flex flex-wrap gap-x-8 gap-y-2">
    {
      service.requirements.map((r) => (
        <li class="flex items-start gap-2 text-[15px] text-ink">
          <Icon name="check" size={16} class="mt-1 shrink-0 text-accent" />
          {r}
        </li>
      ))
    }
  </ul>
</article>
