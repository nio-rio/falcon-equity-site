---
import { Image } from 'astro:assets';
import type { Service } from '@/data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="service-row">
  <div class="service-row-media">
    <Image
      src={service.image}
      alt=""
      widths={[480, 720, 960]}
      sizes="(min-width: 768px) 22.5rem, 100vw"
      class="h-full w-full object-cover"
    />
  </div>
  <div class="service-row-copy">
    <h3>{service.name}</h3>
    <p class="mt-3 text-ink-soft">{service.summary}</p>
    <p class="mt-3 text-[16px] leading-6 text-muted">{service.rangeLine}</p>
    <p class="service-row-actions mt-6">
      <a class="btn-outline-dark" href={`/services/${service.slug}`}>Learn more</a>
      <a class="btn-primary" href="/apply">Apply now</a>
    </p>
  </div>
</article>

<style>
  .service-row {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block: 2.5rem;
    background: none;
  }

  @media (min-width: 768px) {
    .service-row {
      flex-direction: row;
      align-items: center;
      gap: 3rem;
    }
  }

  .service-row-media {
    flex: none;
    width: 100%;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  @media (min-width: 768px) {
    .service-row-media {
      width: 22.5rem;
    }
  }

  .service-row-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  .service-row-copy {
    min-width: 0;
    flex: 1;
  }

  .service-row h3 {
    font-size: 1.75rem;
    line-height: 1.15;
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .service-row h3 {
      font-size: 2rem;
    }
  }

  .service-row-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
