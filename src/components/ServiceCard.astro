---
import Icon from './Icon.astro';
import type { Service } from '@/data/services';

interface Props {
  service: Service;
  headingLevel?: 'h2' | 'h3';
}

const { service, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class="card group relative flex h-full flex-col transition-shadow hover:shadow-xl">
  <span class="grid h-12 w-12 place-items-center rounded-2xl bg-lilac text-brand">
    <Icon name={service.icon} />
  </span>
  <Heading class="mt-5 text-xl font-semibold text-brand">
    <a href={`/services/${service.slug}`} class="after:absolute after:inset-0 after:rounded-3xl focus-visible:outline-none">
      {service.name}
    </a>
  </Heading>
  <p class="mt-3 flex-1 text-[15px] leading-relaxed text-muted">{service.summary}</p>
  <dl class="mt-6 grid grid-cols-2 gap-4 border-t border-lilac-200 pt-5 text-sm">
    <div class="col-span-2">
      <dt class="text-muted">Amounts</dt>
      <dd class="mt-0.5 font-semibold text-ink">{service.amounts}</dd>
    </div>
    <div>
      <dt class="text-muted">Terms</dt>
      <dd class="mt-0.5 font-semibold text-ink">{service.terms}</dd>
    </div>
    {
      service.speed && (
        <div>
          <dt class="text-muted">Speed</dt>
          <dd class="mt-0.5 font-semibold text-ink">{service.speed}</dd>
        </div>
      )
    }
  </dl>
  <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand" aria-hidden="true">
    Learn more <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" />
  </span>
</article>

<style>
  article:has(a:focus-visible) {
    outline: 3px solid var(--color-brand);
    outline-offset: 3px;
  }
</style>
