---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  name: string;
  teaser: string;
  rangeLine: string;
  image: ImageMetadata;
  featured?: 1 | 2;
}

const { href, name, teaser, rangeLine, image, featured } = Astro.props;

const featuredSrc =
  featured === 1 ? '/images/featured-1.jpg' : featured === 2 ? '/images/featured-2.jpg' : undefined;
---

<a
  href={href}
  class:list={[
    'bento-card group',
    featured && 'bento-card--featured',
  ]}
>
  {
    !featured && (
      <div class="bento-card-thumb media-zoom">
        <Image
          src={image}
          alt=""
          widths={[480, 800]}
          sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
          class="h-full w-full object-cover"
        />
      </div>
    )
  }
  <div class="bento-card-copy">
    <h3><span class="link-draw">{name}</span></h3>
    <p class="bento-range">{rangeLine}</p>
    <p>{teaser}</p>
    <span class="bento-cta">
      <span class:list={[featured ? 'btn-outline-light' : 'btn-outline-dark']}>Learn more</span>
    </span>
  </div>
  {
    featuredSrc && (
      <div class="bento-card-media media-zoom">
        <img src={featuredSrc} alt="" width="1600" height="900" />
      </div>
    )
  }
</a>

<style>
  .bento-card {
    isolation: isolate;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    padding: 0;
    color: inherit;
    text-decoration: none;
    overflow: hidden;
  }

  .bento-card:hover,
  .bento-card:focus,
  .bento-card:focus-visible {
    text-decoration: none;
  }

  .bento-card-thumb {
    aspect-ratio: 16 / 9;
  }

  .bento-card-copy {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    padding: 1.75rem 1.75rem 1.5rem;
  }

  .bento-cta {
    display: flex;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .bento-card h3 {
    font-size: 1.75rem;
    line-height: 1.15;
    font-weight: 500;
    color: var(--color-ink);
  }

  @media (min-width: 1024px) {
    .bento-card h3 {
      font-size: 2rem;
      line-height: 1.15;
    }
  }

  .bento-card p {
    margin-top: 0.75rem;
    color: var(--color-ink-soft);
  }

  .bento-card p.bento-range {
    margin-top: 0.5rem;
    font-size: 16px;
    line-height: 24px;
    color: var(--color-muted);
  }

  .bento-card--featured {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--color-featured);
    color: #fff;
    padding: 0;
    min-height: 16rem;
  }

  @media (min-width: 640px) {
    .bento-card--featured {
      grid-template-columns: 1.05fr 0.95fr;
      min-height: 18rem;
    }
  }

  .bento-card--featured .bento-card-copy {
    padding: 1.75rem 1.75rem 1.5rem;
  }

  @media (min-width: 768px) {
    .bento-card--featured .bento-card-copy {
      padding: 2rem 2rem 1.75rem;
    }
  }

  .bento-card--featured h3 {
    color: #fff;
  }

  @media (min-width: 1024px) {
    .bento-card--featured h3 {
      font-size: 2.25rem;
      line-height: 1.12;
    }
  }

  .bento-card--featured p {
    color: rgb(255 255 255 / 0.92);
  }

  .bento-card--featured p.bento-range {
    color: rgb(255 255 255 / 0.9);
  }

  .bento-card-media {
    position: relative;
    min-height: 11rem;
    overflow: hidden;
  }

  .bento-card-media::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(to bottom, var(--color-featured) 0%, transparent 40%);
  }

  .bento-card-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }

  @media (min-width: 640px) {
    .bento-card-media::before {
      background: linear-gradient(to right, var(--color-featured) 0%, transparent 40%);
    }
  }
</style>
