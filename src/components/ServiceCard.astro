---
import Icon from './Icon.astro';
import type { Service } from '@/data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="service-teaser group relative">
  <Icon name={service.icon} size={28} class="text-accent" />
  <h3 class="mt-5">
    <a href={`/services/${service.slug}`} class="service-teaser-link">
      {service.name}
    </a>
  </h3>
  <p class="mt-3 text-ink-soft">{service.summary}</p>
</article>

<style>
  .service-teaser {
    isolation: isolate;
    height: 100%;
    background: var(--color-tint);
    padding: 2rem;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .service-teaser:hover {
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-tint));
  }

  .service-teaser h3 {
    font-size: 30px;
    line-height: 36px;
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .service-teaser h3 {
      font-size: 33px;
      line-height: 40px;
    }
  }

  @media (min-width: 1024px) {
    .service-teaser h3 {
      font-size: 39px;
      line-height: 46px;
    }
  }

  .service-teaser-link {
    color: inherit;
    text-decoration: none;
  }

  .service-teaser-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .service-teaser:hover .service-teaser-link {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .service-teaser-link:focus,
  .service-teaser-link:focus-visible {
    outline: none;
  }

  .service-teaser:has(.service-teaser-link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
