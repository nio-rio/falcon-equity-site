---
import type { Service } from '@/data/services';

interface Props {
  service: Service;
  headingLevel?: 'h2' | 'h3';
}

const { service, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class="group relative border-t border-line pt-6">
  <Heading>
    <a href={`/services/${service.slug}`} class="after:absolute after:inset-0 group-hover:underline focus-visible:outline-none">
      {service.name}
    </a>
  </Heading>
  <p class="mt-3 text-ink-soft">{service.summary}</p>
  <p class="mt-4 text-sm text-muted">{service.amountsShort ?? service.amounts}</p>
</article>

<style>
  article:has(a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
  }
</style>
