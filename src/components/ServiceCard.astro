---
import type { Service } from '@/data/services';

interface Props {
  service: Service;
  headingLevel?: 'h2' | 'h3';
}

const { service, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class="group relative flex h-full flex-col border-t border-line pt-8">
  <Heading class="text-xl font-semibold">
    <a href={`/services/${service.slug}`} class="after:absolute after:inset-0 focus-visible:outline-none">
      {service.name}
    </a>
  </Heading>
  <p class="mt-3 flex-1 text-[15px] leading-relaxed text-muted">{service.summary}</p>
  <dl class="mt-6 grid grid-cols-2 gap-4 text-sm">
    <div class="col-span-2">
      <dt class="text-muted">Amounts</dt>
      <dd class="mt-0.5 font-semibold text-ink">{service.amounts}</dd>
    </div>
    <div>
      <dt class="text-muted">Terms</dt>
      <dd class="mt-0.5 font-semibold text-ink">{service.terms}</dd>
    </div>
    {
      service.speed && (
        <div>
          <dt class="text-muted">Speed</dt>
          <dd class="mt-0.5 font-semibold text-ink">{service.speed}</dd>
        </div>
      )
    }
  </dl>
  <span class="mt-5 inline-flex text-sm font-semibold text-accent" aria-hidden="true">Learn more</span>
</article>

<style>
  article:has(a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
  }
</style>
