---
import type { ServiceSpec as Spec } from '@/data/services';

interface Props {
  spec: Spec;
  class?: string;
}

const { spec, class: className } = Astro.props;
---

<dl class:list={['service-spec', className]}>
  <div>
    <dt>Who it's for</dt>
    <dd>{spec.whoFor}</dd>
  </div>
  <div>
    <dt>Amounts</dt>
    <dd>{spec.amounts}</dd>
  </div>
  <div>
    <dt>Terms</dt>
    <dd>{spec.terms}</dd>
  </div>
  <div class="service-spec-req">
    <dt>Requirements</dt>
    <dd>
      <ul>
        {spec.requirements.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </dd>
  </div>
</dl>

<style>
  .service-spec {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin: 0;
    width: 100%;
    min-width: 0;
  }

  .service-spec > div {
    min-width: 0;
    max-width: 100%;
  }

  @media (min-width: 640px) {
    .service-spec {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem 2rem;
    }

    .service-spec-req {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .service-spec {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .service-spec-req {
      grid-column: auto;
    }
  }

  .service-spec dt {
    font-size: 0.75rem;
    line-height: 1.25;
    color: var(--color-muted);
  }

  .service-spec dd {
    margin: 0.5rem 0 0;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .service-spec ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.25rem;
  }

  .service-spec li {
    overflow-wrap: anywhere;
    word-break: break-word;
  }
</style>
