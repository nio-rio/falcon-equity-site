---
/**
 * Share row for a guide — behaviour learned from Osmo's "Social Share Buttons"
 * resource (demo measured 23 Oct 2026 at 1440: 128px circles, 40px apart,
 * ~32px marks, hover scales the circle ~1.25, and the copy button swaps to a
 * tick for a couple of seconds). Their code page is behind the Vault login, so
 * this is an equivalent built to the behaviour, not a copy of their file.
 *
 * Two deliberate adaptations to our system:
 *  - one colour, not brand colours. Osmo runs full-colour logos on white; our
 *    palette is white + Martinique + Lilac only (CLAUDE.md), so the marks are
 *    ink and the hover inverts the circle to Martinique.
 *  - the success tick is ink, not green, for the same reason.
 *
 * Sizes are scaled to the 304px rail: six 44px circles, 6px apart = 294px.
 * Print is a quiet text button under the row, because a seventh circle breaks
 * that fit. The rail stacks under the article below 80em, so this one instance
 * is also the mobile row.
 */
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;

const u = encodeURIComponent(url);
const t = encodeURIComponent(title);

/* Real endpoints, no third-party script. WhatsApp takes one blob of text. */
const targets = [
  {
    key: 'linkedin',
    label: 'Share on LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
  },
  {
    key: 'x',
    label: 'Share on X',
    href: `https://x.com/intent/post?url=${u}&text=${t}`,
  },
  {
    key: 'facebook',
    label: 'Share on Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
  },
  {
    key: 'whatsapp',
    label: 'Share on WhatsApp',
    href: `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}`,
  },
  {
    key: 'email',
    label: 'Share by email',
    href: `mailto:?subject=${t}&body=${encodeURIComponent(url)}`,
  },
] as const;
---

<div class="share">
  <div class="share-row">
  <button
    type="button"
    class="share-btn share-btn--copy"
    data-share-copy={url}
    aria-label="Copy link to this guide"
  >
    <span class="share-ico share-ico--link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
      </svg>
    </span>
    <span class="share-ico share-ico--check">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
    </span>
  </button>

  {
    targets.map((target) => (
      <a
        class="share-btn"
        href={target.href}
        aria-label={target.label}
        target="_blank"
        rel="noopener noreferrer"
      >
        {target.key === 'linkedin' && (
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
          </svg>
        )}
        {target.key === 'x' && (
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.59-6.64 7.59H.47l8.6-9.83L0 1.15h7.59l5.25 6.93 6.06-6.93zm-1.29 19.49h2.04L6.49 3.24H4.3l13.31 17.4z" />
          </svg>
        )}
        {target.key === 'facebook' && (
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M24 12.07C24 5.44 18.63.07 12 .07S0 5.44 0 12.07c0 5.99 4.39 10.95 10.13 11.85v-8.38H7.08v-3.47h3.05V9.43c0-3.01 1.79-4.67 4.53-4.67 1.31 0 2.69.24 2.69.24v2.95h-1.51c-1.49 0-1.96.93-1.96 1.87v2.25h3.33l-.53 3.47h-2.8v8.38C19.61 23.02 24 18.06 24 12.07z" />
          </svg>
        )}
        {target.key === 'whatsapp' && (
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.49-.9-.8-1.5-1.79-1.68-2.09-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.48-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.87 1.21 3.07c.15.2 2.09 3.2 5.07 4.48.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35z" />
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.13h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.36c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24z" />
          </svg>
        )}
        {target.key === 'email' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2.75" y="5" width="18.5" height="14" rx="1.5"></rect>
            <path d="m3.6 6.6 8.4 5.9 8.4-5.9"></path>
          </svg>
        )}
      </a>
    ))
  }
  </div>

  <p class="share-status" role="status" aria-live="polite" data-share-status></p>
</div>

<button type="button" class="share-print" data-share-print>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M7 9V3.75h10V9"></path>
    <path d="M7 18H5.25A2.25 2.25 0 0 1 3 15.75v-4.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v4.5A2.25 2.25 0 0 1 18.75 18H17"></path>
    <rect x="7" y="13.75" width="10" height="6.5" rx="0.8"></rect>
  </svg>
  <span>Print this guide</span>
</button>

<script>
  /* Copy link: clipboard API, a textarea fallback for contexts where it is
     blocked, then a 2s tick plus a polite announcement for screen readers. */
  const COPIED_MS = 2000;

  document.querySelectorAll<HTMLElement>('[data-share-copy]').forEach((copy) => {
    const row = copy.closest('.share');
    const status = row?.querySelector<HTMLElement>('[data-share-status]');
    const label = copy.getAttribute('aria-label') ?? 'Copy link';
    let timer: number | undefined;

    copy.addEventListener('click', async () => {
      const url = copy.dataset.shareCopy || window.location.href;

      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const field = document.createElement('textarea');
        field.value = url;
        field.setAttribute('readonly', '');
        field.style.position = 'fixed';
        field.style.top = '-9999px';
        document.body.appendChild(field);
        field.select();
        try {
          document.execCommand('copy');
        } catch {
          /* Nothing else to try; the address bar still has the URL. */
        }
        field.remove();
      }

      copy.dataset.copied = 'true';
      copy.setAttribute('aria-label', 'Link copied');
      if (status) status.textContent = 'Link copied to clipboard';

      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        delete copy.dataset.copied;
        copy.setAttribute('aria-label', label);
        if (status) status.textContent = '';
      }, COPIED_MS);
    });
  });

  document.querySelectorAll<HTMLElement>('[data-share-print]').forEach((button) => {
    button.addEventListener('click', () => window.print());
  });
</script>

<style>
  .share-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 6px;
  }

  .share-btn {
    position: relative;
    display: grid;
    place-items: center;
    /* Six circles share the rail exactly: (100% - 5 gaps) / 6, capped at 44.
       The rail is 272px at 1280 and 304px at 1440, so a fixed 44 wrapped. */
    flex: 0 0 auto;
    width: clamp(32px, calc((100% - 30px) / 6), 44px);
    aspect-ratio: 1 / 1;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-white);
    color: var(--color-ink);
    cursor: pointer;
    appearance: none;
    transition:
      transform 260ms cubic-bezier(0.22, 0.61, 0.36, 1),
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
    will-change: transform;
  }

  .share-btn svg {
    display: block;
    width: 18px;
    height: 18px;
  }

  .share-btn:hover,
  .share-btn:focus-visible {
    background: var(--color-martinique);
    border-color: var(--color-martinique);
    color: var(--color-white);
    transform: scale(1.14);
  }

  .share-btn:active {
    transform: scale(0.96);
  }

  .share-btn:focus-visible {
    outline: 2px solid var(--color-martinique);
    outline-offset: 3px;
  }

  /* The copy button stacks both marks in one cell and cross-fades them. */
  .share-btn--copy .share-ico {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    transition:
      opacity 180ms ease,
      transform 240ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .share-btn--copy .share-ico--check {
    opacity: 0;
    transform: scale(0.55);
  }

  .share-btn--copy[data-copied] .share-ico--link {
    opacity: 0;
    transform: scale(0.55);
  }

  .share-btn--copy[data-copied] .share-ico--check {
    opacity: 1;
    transform: scale(1);
  }

  /* Announced by assistive tech, never drawn. */
  .share-status:empty {
    display: none;
  }

  .share-status {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.4;
  }

  .share-print {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.4;
    cursor: pointer;
    appearance: none;
  }

  .share-print svg {
    width: 16px;
    height: 16px;
  }

  .share-print span {
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease;
  }

  .share-print:hover span,
  .share-print:focus-visible span {
    border-bottom-color: currentColor;
  }

  .share-print:focus-visible {
    outline: 2px solid var(--color-martinique);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .share-btn,
    .share-btn--copy .share-ico,
    .share-print span {
      transition: none;
    }

    .share-btn:hover,
    .share-btn:focus-visible,
    .share-btn:active {
      transform: none;
    }
  }

  /* Below the rail's 1280px breakpoint the row sits full-width under the
     article: a thumb-sized target with a little more air between circles. */
  @media (max-width: 79.99em) {
    .share-row {
      gap: 10px;
    }

    .share-btn {
      width: clamp(36px, calc((100% - 50px) / 6), 48px);
    }

    .share-btn svg {
      width: 19px;
      height: 19px;
    }
  }
</style>
