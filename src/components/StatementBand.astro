---
import type { ImageMetadata } from 'astro';
import Media from './Media.astro';

export type StatementItem = {
  title: string;
  body?: string;
};

interface Props {
  items: readonly StatementItem[];
  image?: ImageMetadata;
  imageAlt?: string;
  intent?: string;
}

const { items, image, imageAlt = '', intent = 'quiet office interior, even daylight, empty of people' } = Astro.props;
---

{
  items.length > 0 && (
    <section class="statement-band on-dark">
      <div class="container-site">
        <div class="bx-grid items-center">
          <div class="statement-media bx-span-4 bx-lg-span-6">
            <Media
              image={image}
              alt={imageAlt}
              intent={intent}
              labeled={!image}
              ratio="4 / 3"
              sizes="(min-width: 1024px) 50vw, 100vw"
            />
          </div>
          <div class="bx-span-4 bx-lg-span-5 bx-lg-start-8">
            <ul class="statement-list">
              {items.map((item) => (
                <li>
                  <h3>{item.title}</h3>
                  {item.body && <p class="mt-3">{item.body}</p>}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )
}
