---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ImageSlot from './ImageSlot.astro';

export type StatementItem = {
  title: string;
  body?: string;
};

interface Props {
  items: readonly StatementItem[];
  image?: ImageMetadata;
  imageAlt?: string;
  intent?: string;
}

const { items, image, imageAlt = '', intent = 'quiet office interior, even daylight, empty of people' } = Astro.props;
---

{
  items.length > 0 && (
    <section class="statement-band on-dark">
      <div class="container-site">
        <div class="bx-grid items-center">
          <div class="statement-media bx-span-4 lg:bx-span-6">
            {image ? (
              <Image
                src={image}
                alt={imageAlt}
                widths={[720, 1100, 1600]}
                sizes="(min-width: 1024px) 50vw, 100vw"
                class="h-full w-full object-cover"
              />
            ) : (
              <ImageSlot labeled intent={intent} ratio="4 / 3" />
            )}
          </div>
          <div class="bx-span-4 lg:bx-span-5 lg:bx-start-8">
            <ul class="statement-list">
              {items.map((item) => (
                <li>
                  <h3>{item.title}</h3>
                  {item.body && <p class="mt-3">{item.body}</p>}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )
}
