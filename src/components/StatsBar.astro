---
import { STATS } from '@/data/site';
---

<section aria-label="Falcon Equity Group by the numbers" class="border-y border-line bg-white">
  <div class="container-site py-14 sm:py-16">
    <dl class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 lg:grid-cols-5">
      {
        STATS.map((s) => (
          <div>
            <dd class="font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">{s.value}</dd>
            <dt class="mt-2 text-sm leading-snug text-muted">{s.label}</dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>
