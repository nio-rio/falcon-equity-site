---
import { STATS } from '@/data/site';
---

<section aria-label="Falcon Equity Group by the numbers" class="bg-tint">
  <div class="container-site py-12 md:py-16">
    <dl class="stats-grid">
      {
        STATS.map((s) => (
          <div class="stat-cell">
            <dd>{s.value}</dd>
            <dt>{s.label}</dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>
