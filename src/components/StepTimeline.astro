---
interface Props {
  steps: readonly { title: string; body: string }[];
}

const { steps } = Astro.props;
---

<div class="step-timeline" data-step-timeline>
  <div class="step-timeline-line" aria-hidden="true">
    <div class="step-timeline-fill" data-step-fill></div>
  </div>
  <ol class="step-timeline-list">
    {
      steps.map((s, i) => (
        <li class="step-timeline-item" data-step-item>
          <span class="step-timeline-marker" aria-hidden="true">
            {i + 1}
          </span>
          <div class="step-timeline-content">
            <h3>
              <span class="sr-only">Step {i + 1}: </span>
              {s.title}
            </h3>
            <p class="mt-3 text-ink-soft">{s.body}</p>
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .step-timeline {
    position: relative;
    max-width: 33em;
    margin-inline: auto;
  }

  .step-timeline-list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step-timeline-line {
    position: absolute;
    top: 1.5rem;
    bottom: 1.5rem;
    left: 1.5rem;
    width: 2px;
    background: var(--color-tint);
    pointer-events: none;
  }

  .step-timeline-fill {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    transform: scaleY(0);
    transform-origin: 50% 0;
  }

  .step-timeline-item {
    display: flex;
    align-items: flex-start;
    gap: 3rem;
    position: relative;
  }

  .step-timeline-marker {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    background: var(--color-tint);
    color: var(--color-ink);
    font-size: 1rem;
    font-weight: 500;
    z-index: 1;
    transition: background-color 0.4s cubic-bezier(0.645, 0.045, 0.355, 1), color 0.4s cubic-bezier(0.645, 0.045, 0.355, 1);
  }

  .step-timeline-content {
    padding-top: 0.4em;
    max-width: 28em;
    opacity: 0.25;
    transition: opacity 0.25s;
  }

  .step-timeline-item.is-active .step-timeline-content {
    opacity: 0.5;
  }

  .step-timeline-item.is-current .step-timeline-marker {
    background: var(--color-ink);
    color: #fff;
  }

  .step-timeline-item.is-current .step-timeline-content {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .step-timeline-fill {
      transform: none;
    }

    .step-timeline-content,
    .step-timeline-item.is-active .step-timeline-content {
      opacity: 1;
      transition: none;
    }

    .step-timeline-marker {
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-step-timeline]');
  const fill = root?.querySelector<HTMLElement>('[data-step-fill]');
  const items = root ? [...root.querySelectorAll<HTMLElement>('[data-step-item]')] : [];
  if (!root || !fill || items.length === 0) {
    // no-op
  } else {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const setState = (progress: number) => {
      fill.style.transform = `scaleY(${progress})`;
      const last = items.length - 1;
      items.forEach((item, i) => {
        const start = i / Math.max(last, 1);
        const next = (i + 1) / Math.max(last, 1);
        const active = progress >= start;
        const current = last === 0 ? progress > 0 : progress >= start && progress < next || (i === last && progress >= start);
        item.classList.toggle('is-active', active);
        item.classList.toggle('is-current', current || (progress >= 1 && i === last));
      });
    };

    if (reduce) {
      setState(1);
    } else {
      const update = () => {
        const rect = root.getBoundingClientRect();
        const anchor = window.innerHeight * 0.5;
        const progress = Math.min(1, Math.max(0, (anchor - rect.top) / rect.height));
        setState(progress);
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
    }
  }
</script>
