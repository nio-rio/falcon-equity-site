---
import Eyebrow from './Eyebrow.astro';
import { TESTIMONIALS } from '@/data/content';
---

<section class="section bg-white" aria-labelledby="testimonials-heading">
  <div class="container-site">
    <div class="bx-grid">
      <div class="bx-span-4 lg:bx-span-6">
        <Eyebrow>Testimonials</Eyebrow>
        <h2 id="testimonials-heading" class="mt-4">When our customers succeed, so do we.</h2>
      </div>
      {
        TESTIMONIALS.map((t) => (
          <div class="bx-span-4 lg:bx-span-4">
            <blockquote>
              <p class="font-display text-[1.375rem] font-light leading-snug text-ink">{t.quote}</p>
            </blockquote>
            <p class="mt-6 font-medium text-ink">{t.amount}</p>
            <p class="mt-2 text-ink">{t.business}</p>
            <p class="mt-1 text-sm text-muted">{t.owner}</p>
            <p class="mt-1 text-sm text-muted">{t.industry}</p>
            <p class="mt-1 text-sm text-muted">Product: {t.product}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
