---
import Eyebrow from './Eyebrow.astro';

export type UseCase = {
  title: string;
  body: string;
  industry: string;
  product: string;
  intent: string;
};

interface Props {
  headingId?: string;
  cases: readonly UseCase[];
}

const { headingId = 'use-cases-heading', cases } = Astro.props;
const shown = cases.slice(0, 3);
---

{
  shown.length > 0 && (
    <section class="section bg-white" aria-labelledby={headingId}>
      <div class="container-site">
        <div class="bx-grid">
          <div class="section-head bx-span-4 bx-lg-span-10">
            <Eyebrow>Use cases</Eyebrow>
            <h2 id={headingId}>Situations owners bring to Falcon.</h2>
          </div>
          <p class="section-body bx-span-4 bx-lg-span-6 bx-lg-start-7">Generic situations. Not real clients or results.</p>
          {shown.map((s) => (
            <div class="bx-span-4 bx-lg-span-4">
              <h3>{s.title}</h3>
              <p class="mt-3 text-ink-soft">{s.body}</p>
              <p class="mt-4 text-sm text-muted">
                {s.industry} · <span class="text-ink">{s.product}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
