---
import SectionHeading from './SectionHeading.astro';
import ImageSlot from './ImageSlot.astro';

export type UseCase = {
  title: string;
  body: string;
  industry: string;
  product: string;
  intent: string;
};

interface Props {
  headingId?: string;
  cases: readonly UseCase[];
}

const { headingId = 'use-cases-heading', cases } = Astro.props;
const shown = cases.slice(0, 3);
---

<section class="section bg-white" aria-labelledby={headingId}>
  <div class="container-site">
    <SectionHeading
      id={headingId}
      eyebrow="Use cases"
      title="Situations owners bring to Falcon."
      lead="Generic situations. Not real clients or results."
    />
    <ul class="mt-12 grid gap-10 md:grid-cols-3">
      {
        shown.map((s) => (
          <li>
            <div class="media-zoom">
              <ImageSlot intent={s.intent} ratio="16 / 9" />
            </div>
            <h3 class="mt-6">{s.title}</h3>
            <p class="mt-3 text-ink-soft">{s.body}</p>
            <p class="mt-4 text-sm text-muted">
              {s.industry} · <span class="text-ink">{s.product}</span>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
