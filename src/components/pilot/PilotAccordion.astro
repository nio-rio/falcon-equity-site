---
import Icon from '@/components/Icon.astro';
import { splitInlineLinks } from '@/lib/inlineLinks';

export type PilotAccItem = {
  q: string;
  a?: string;
  bullets?: readonly string[];
};

interface Props {
  items: readonly PilotAccItem[];
  variant?: 'faq' | 'strategies';
  idPrefix: string;
}

const { items, variant = 'faq', idPrefix } = Astro.props;
---

<div class:list={['pilot-acc', variant === 'strategies' && 'pilot-acc--strategies']} data-accordion>
  {
    items.map((item, i) => (
      <div class="pilot-acc-item bx-acc-item" data-acc-item>
        <h3>
          <button
            type="button"
            class="pilot-acc-trigger"
            aria-expanded="false"
            aria-controls={`${idPrefix}-panel-${i}`}
            id={`${idPrefix}-trigger-${i}`}
            data-acc-trigger
          >
            <span>{item.q}</span>
            <span class="pilot-acc-icon" aria-hidden="true">
              <Icon name="chevron-down" size={16} />
            </span>
          </button>
        </h3>
        <div class="pilot-acc-panel" id={`${idPrefix}-panel-${i}`} role="region" aria-labelledby={`${idPrefix}-trigger-${i}`}>
          <div class="pilot-acc-panel-inner">
            {item.a && (
              <p>
                {splitInlineLinks(item.a).map((part) =>
                  part.href ? (
                    <a class="link" href={part.href}>
                      {part.text}
                    </a>
                  ) : (
                    part.text
                  ),
                )}
              </p>
            )}
            {item.bullets && item.bullets.length > 0 && (
              <ul>
                {item.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </div>
    ))
  }
</div>

<script>
  import { bindAccordions } from '@/scripts/accordion';
  bindAccordions();
</script>
