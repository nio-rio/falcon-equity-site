---
import PilotEyebrow from './PilotEyebrow.astro';

interface Props {
  id?: string;
  eyebrow?: string;
  answer: string;
  takeaways: readonly string[];
}

const { id = 'answer-heading', eyebrow = 'In short', answer, takeaways } = Astro.props;
---

<section class="pilot-section" aria-labelledby={id}>
  <div class="container-site">
    <div class="bx-grid">
      <div class="pilot-section-head bx-span-4 bx-md-full bx-lg-span-10">
        <PilotEyebrow>{eyebrow}</PilotEyebrow>
        <h2 id={id} class="sr-only">Direct answer</h2>
      </div>
      <p class="pilot-answer-lead bx-span-4 bx-lg-span-10">{answer}</p>
      {
        takeaways.length > 0 && (
          <ul class="pilot-answer-list bx-span-4 bx-lg-span-10">
            {takeaways.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>
