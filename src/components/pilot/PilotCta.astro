---
import { PRIMARY_PHONE } from '@/data/site';

interface Props {
  title?: string;
  body?: string;
  ctaLabel?: string;
}

const {
  title = 'Get funding today',
  body = 'One short application. A specialist reviews your file promptly. Many products fund within 24-48 hours of approval.',
  ctaLabel = 'Get Funding Today',
} = Astro.props;
---

<section class="pilot-cta" aria-labelledby="cta-heading">
  <div class="container-site">
    <div class="bx-grid">
      <div class="pilot-section-head bx-span-4 bx-lg-span-10">
        <h2 id="cta-heading">{title}</h2>
      </div>
      <div class="pilot-section-body bx-span-4 bx-lg-span-6 bx-lg-start-7">
        <p class="text-ink">{body}</p>
        <div class="pilot-cta-actions">
          <a href="/apply" class="btn-primary">{ctaLabel}</a>
          <a href={PRIMARY_PHONE.href} class="btn-outline-dark">{PRIMARY_PHONE.display}</a>
        </div>
      </div>
    </div>
  </div>
</section>
