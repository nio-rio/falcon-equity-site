---
import PilotEyebrow from './PilotEyebrow.astro';

export type FitItem = {
  title: string;
  body: string;
};

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  items: readonly FitItem[];
}

const { id = 'fit-heading', eyebrow = 'Fit', title, lead, items } = Astro.props;
---

<section class="pilot-section pilot-section--tint" aria-labelledby={id}>
  <div class="container-site">
    <div class="bx-grid">
      <div class="pilot-section-head bx-span-4 bx-md-full bx-lg-span-10">
        <PilotEyebrow>{eyebrow}</PilotEyebrow>
        <h2 id={id}>{title}</h2>
      </div>
      {
        lead && (
          <p class="pilot-section-body bx-span-4 bx-lg-span-6 bx-lg-start-7">{lead}</p>
        )
      }
      <ol class="pilot-fit-list bx-full">
        {
          items.map((item, i) => (
            <li class="pilot-fit-item">
              <p class="pilot-step-num">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="pilot-step-title">{item.title}</h3>
              <p class="pilot-step-body">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
