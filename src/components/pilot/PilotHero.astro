---
import Media from '@/components/Media.astro';
import PilotArrow from './PilotArrow.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  line1: string;
  line2: string;
  aside: string;
  captionTitle: string;
  captionBody: string;
  captionHref: string;
  captionLabel: string;
  image: ImageMetadata;
  imageAlt: string;
}

const { line1, line2, aside, captionTitle, captionBody, captionHref, captionLabel, image, imageAlt } = Astro.props;
---

<section class="pilot-hero pilot-on-dark" aria-labelledby="hero-heading">
  <div class="container-site">
    <div class="bx-grid pilot-hero-top">
      <h1 id="hero-heading" class="bx-span-4 bx-lg-span-8"><span class="pilot-hero-line">{line1}</span><span class="pilot-hero-line pilot-hero-line--offset">{line2}</span></h1>
      <p class="pilot-hero-aside bx-span-4 bx-lg-span-4 bx-lg-start-9">{aside}</p>
    </div>
    <div class="pilot-hero-media bx-full">
      <Media image={image} alt={imageAlt} intent={imageAlt} ratio="16 / 9" sizes="100vw" priority />
    </div>
    <div class="bx-grid pilot-hero-caption">
      <div class="pilot-section-head bx-span-4 bx-lg-span-6">
        <h2>{captionTitle}</h2>
      </div>
      <div class="pilot-section-body pilot-hero-caption-copy bx-span-4 bx-lg-start-8 bx-lg-span-5">
        <p>{captionBody}</p>
        <div class="pilot-section-cta">
          <PilotArrow href={captionHref} label={captionLabel} tone="light" />
        </div>
      </div>
    </div>
  </div>
</section>
