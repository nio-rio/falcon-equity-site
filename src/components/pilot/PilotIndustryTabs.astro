---
/**
 * BMACX `blackstone-v2/tabs` + featured-content (“The Latest from BMACX”).
 * Home Industries only. 12 industry tabs; desktop row scrolls, mobile dropdown.
 */
import Media from '@/components/Media.astro';
import PilotArrow from './PilotArrow.astro';
import { INDUSTRIES, INDUSTRY_PLACEHOLDERS } from '@/data/industries';
---

<section class="pilot-tabs" aria-labelledby="industries-heading">
  <div class="container-site">
    <div class="pilot-tabs-head">
      <h2 id="industries-heading">Sectors we fund.</h2>
      <p class="pilot-tabs-intro">
        We fund businesses across these twelve sectors, and others with steady revenue.
      </p>
    </div>

    <div class="pilot-tabs-nav">
      <div class="pilot-tabs-scroll">
        <div class="pilot-tabs-list" role="tablist" aria-label="Industries" aria-orientation="horizontal">
          {
            INDUSTRIES.map((ind, i) => (
              <button
                type="button"
                class:list={['pilot-tabs-tab', i === 0 && 'is-active']}
                role="tab"
                id={`industry-tab-${ind.slug}`}
                aria-controls={`industry-panel-${ind.slug}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-index={i}
              >
                {ind.name}
              </button>
            ))
          }
        </div>
      </div>

      <div class="pilot-tabs-dropwrap">
        <button
          type="button"
          class="pilot-tabs-drop"
          aria-expanded="false"
          aria-controls="industry-tab-menu"
          aria-haspopup="listbox"
        >
          <span class="pilot-tabs-drop-label">{INDUSTRIES[0].name}</span>
          <svg width="14" height="8" viewBox="0 0 14 8" aria-hidden="true">
            <path
              d="M7 8 1.35 2.29a.9.9 0 0 1 1.28-1.27L7 5.4l4.37-4.38a.9.9 0 1 1 1.28 1.27L7 8Z"
              fill="currentColor"
            />
          </svg>
        </button>
        <ul class="pilot-tabs-menu" id="industry-tab-menu" role="listbox" hidden>
          {
            INDUSTRIES.map((ind, i) => (
              <li role="presentation">
                <button type="button" role="option" data-index={i} aria-selected={i === 0 ? 'true' : 'false'}>
                  {ind.name}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="pilot-tabs-panels">
      {
        INDUSTRIES.map((ind, i) => (
          <div
            class:list={['pilot-tabs-panel', i === 0 && 'is-active']}
            role="tabpanel"
            id={`industry-panel-${ind.slug}`}
            aria-labelledby={`industry-tab-${ind.slug}`}
            hidden={i !== 0}
          >
            <div class="pilot-tabs-copy">
              <h3 class="pilot-tabs-title">{ind.name}</h3>
              <p class="pilot-tabs-body">{ind.blurb}</p>
              <PilotArrow href={`/industries/${ind.slug}`} label="Learn more" />
            </div>
            <div class="pilot-tabs-media">
              <Media
                intent={INDUSTRY_PLACEHOLDERS[ind.slug].hero.intent}
                alt={INDUSTRY_PLACEHOLDERS[ind.slug].hero.alt}
                labeled
                ratio="16 / 9"
                sizes="(min-width: 80em) 704px, 100vw"
              />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('.pilot-tabs');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.pilot-tabs-tab')];
    const panels = [...root.querySelectorAll<HTMLElement>('.pilot-tabs-panel')];
    const options = [...root.querySelectorAll<HTMLButtonElement>('.pilot-tabs-menu [role="option"]')];
    const drop = root.querySelector<HTMLButtonElement>('.pilot-tabs-drop');
    const dropLabel = root.querySelector<HTMLElement>('.pilot-tabs-drop-label');
    const menu = root.querySelector<HTMLElement>('.pilot-tabs-menu');
    const dropwrap = root.querySelector('.pilot-tabs-dropwrap');

    const list = root.querySelector<HTMLElement>('.pilot-tabs-list');
    let current = 0;

    const select = (index: number, { focusTab = false } = {}) => {
      current = index;
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.classList.toggle('is-active', on);
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
        if (on && focusTab) tab.focus();
      });
      const active = tabs[index];
      if (active && list) {
        const left = active.offsetLeft - (list.clientWidth - active.offsetWidth) / 2;
        list.scrollTo({ left: Math.max(0, left), behavior: 'smooth' });
      }
      panels.forEach((panel, i) => {
        const on = i === index;
        panel.hidden = !on;
        panel.classList.toggle('is-active', on);
      });
      options.forEach((opt, i) => {
        opt.setAttribute('aria-selected', i === index ? 'true' : 'false');
      });
      if (dropLabel) dropLabel.textContent = tabs[index]?.textContent?.trim() ?? '';
    };

    const closeMenu = () => {
      if (!drop || !menu) return;
      menu.hidden = true;
      drop.setAttribute('aria-expanded', 'false');
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        const key = event.key;
        let next = i;
        if (key === 'ArrowRight') next = (i + 1) % tabs.length;
        else if (key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        else if (key === 'Home') next = 0;
        else if (key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        select(next, { focusTab: true });
      });
    });

    const openMenu = () => {
      if (!menu || !drop) return;
      menu.hidden = false;
      drop.setAttribute('aria-expanded', 'true');
    };

    drop?.addEventListener('click', () => {
      if (!menu || !drop) return;
      if (menu.hidden) openMenu();
      else closeMenu();
    });

    options.forEach((opt, i) => {
      opt.addEventListener('click', () => {
        select(i);
        closeMenu();
        drop?.focus();
      });
    });

    document.addEventListener('click', (event) => {
      if (!dropwrap?.contains(event.target as Node)) closeMenu();
    });

    drop?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMenu();
        drop.focus();
      } else if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        openMenu();
        const target = event.key === 'ArrowUp' ? options[options.length - 1] : options[current] || options[0];
        target?.focus();
      }
    });

    menu?.addEventListener('keydown', (event) => {
      const key = event.key;
      if (key === 'Escape') {
        event.preventDefault();
        closeMenu();
        drop?.focus();
        return;
      }
      let next = options.findIndex((opt) => opt === document.activeElement);
      if (next < 0) next = current;
      if (key === 'ArrowDown') next = (next + 1) % options.length;
      else if (key === 'ArrowUp') next = (next - 1 + options.length) % options.length;
      else if (key === 'Home') next = 0;
      else if (key === 'End') next = options.length - 1;
      else return;
      event.preventDefault();
      options[next]?.focus();
    });
  }
</script>
