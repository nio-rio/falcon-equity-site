---
/**
 * BMACX featured-content panel + light-gray sector select (home Industries).
 * Sector picker at every breakpoint; panel is title + blurb + Learn more / 16:9 still.
 */
import Media from '@/components/Media.astro';
import PilotArrow from './PilotArrow.astro';
import PilotEyebrow from './PilotEyebrow.astro';
import { INDUSTRIES, INDUSTRY_PLACEHOLDERS } from '@/data/industries';
---

<section class="pilot-tabs" aria-labelledby="industries-heading" data-band="light" data-reveal-root>
  <div class="container-site">
    <div class="pilot-tabs-head">
      <div class="pilot-tabs-heading">
        <PilotEyebrow>Industries</PilotEyebrow>
        <h2 id="industries-heading" data-reveal>Sectors we fund.</h2>
      </div>
      <p class="pilot-tabs-intro" data-reveal>
        We fund businesses across these twelve sectors, and others with steady revenue.
      </p>
    </div>

    <div class="pilot-tabs-nav" data-reveal>
      <div class="pilot-tabs-dropwrap">
        <button
          type="button"
          class="pilot-tabs-drop"
          id="industry-select"
          aria-labelledby="industry-select-value"
          aria-expanded="false"
          aria-controls="industry-select-menu"
          aria-haspopup="listbox"
        >
          <span class="pilot-tabs-drop-label" id="industry-select-value">Select your sector</span>
          <svg width="14" height="8" viewBox="0 0 14 8" aria-hidden="true">
            <path
              d="M7 8 1.35 2.29a.9.9 0 0 1 1.28-1.27L7 5.4l4.37-4.38a.9.9 0 1 1 1.28 1.27L7 8Z"
              fill="currentColor"
            />
          </svg>
        </button>
        <ul
          class="pilot-tabs-menu"
          id="industry-select-menu"
          role="listbox"
          aria-labelledby="industry-select-value"
          hidden
        >
          {
            INDUSTRIES.map((ind, i) => (
              <li role="presentation">
                <button
                  type="button"
                  role="option"
                  id={`industry-option-${ind.slug}`}
                  data-index={i}
                  aria-selected="false"
                >
                  {ind.name}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="pilot-tabs-panels" data-reveal data-reveal-after>
      {
        INDUSTRIES.map((ind, i) => (
          <div
            class:list={['pilot-tabs-panel', i === 0 && 'is-active']}
            id={`industry-panel-${ind.slug}`}
            role="region"
            aria-labelledby={`industry-title-${ind.slug}`}
            hidden={i !== 0}
          >
            <div class="pilot-tabs-copy">
              <h3 class="pilot-tabs-title" id={`industry-title-${ind.slug}`}>{ind.name}</h3>
              <p class="pilot-tabs-body">{ind.blurb}</p>
              <PilotArrow href={`/industries/${ind.slug}`} label="Learn more" />
            </div>
            <div class="pilot-tabs-media">
              <Media
                intent={INDUSTRY_PLACEHOLDERS[ind.slug].hero.intent}
                alt={INDUSTRY_PLACEHOLDERS[ind.slug].hero.alt}
                labeled
                ratio="16 / 9"
                sizes="(min-width: 80em) 704px, 100vw"
              />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('.pilot-tabs');
  if (root) {
    const panels = [...root.querySelectorAll<HTMLElement>('.pilot-tabs-panel')];
    const options = [...root.querySelectorAll<HTMLButtonElement>('.pilot-tabs-menu [role="option"]')];
    const drop = root.querySelector<HTMLButtonElement>('.pilot-tabs-drop');
    const menu = root.querySelector<HTMLElement>('.pilot-tabs-menu');
    const dropwrap = root.querySelector('.pilot-tabs-dropwrap');
    const valueEl = root.querySelector<HTMLElement>('#industry-select-value');
    let current = 0;

    const select = (index: number) => {
      current = index;
      const name = options[index]?.textContent?.trim() ?? '';
      if (valueEl && name) valueEl.textContent = name;
      panels.forEach((panel, i) => {
        const on = i === index;
        panel.hidden = !on;
        panel.classList.toggle('is-active', on);
      });
      options.forEach((opt, i) => {
        opt.setAttribute('aria-selected', i === index ? 'true' : 'false');
      });
    };

    const closeMenu = () => {
      if (!drop || !menu) return;
      menu.hidden = true;
      drop.setAttribute('aria-expanded', 'false');
    };

    const openMenu = () => {
      if (!menu || !drop) return;
      menu.hidden = false;
      drop.setAttribute('aria-expanded', 'true');
    };

    drop?.addEventListener('click', () => {
      if (!menu) return;
      if (menu.hidden) openMenu();
      else closeMenu();
    });

    options.forEach((opt, i) => {
      opt.addEventListener('click', () => {
        select(i);
        closeMenu();
        drop?.focus();
      });
    });

    document.addEventListener('click', (event) => {
      if (!dropwrap?.contains(event.target as Node)) closeMenu();
    });

    dropwrap?.addEventListener('focusout', (event) => {
      if (!dropwrap.contains(event.relatedTarget as Node)) closeMenu();
    });

    drop?.addEventListener('keydown', (event) => {
      const key = event.key;
      if (key === 'Escape') {
        closeMenu();
        drop.focus();
        return;
      }
      if (key === 'ArrowDown' || key === 'ArrowUp' || key === 'Home' || key === 'End') {
        event.preventDefault();
        openMenu();
        let target = current;
        if (key === 'Home') target = 0;
        else if (key === 'End') target = options.length - 1;
        else if (key === 'ArrowDown') target = Math.min(current + 1, options.length - 1);
        options[target]?.focus();
      }
    });

    menu?.addEventListener('keydown', (event) => {
      const key = event.key;
      if (key === 'Escape') {
        event.preventDefault();
        closeMenu();
        drop?.focus();
        return;
      }
      if (key === 'Enter' || key === ' ') {
        const i = options.findIndex((opt) => opt === document.activeElement);
        if (i >= 0) {
          event.preventDefault();
          select(i);
          closeMenu();
          drop?.focus();
        }
        return;
      }
      let next = options.findIndex((opt) => opt === document.activeElement);
      if (next < 0) next = current;
      if (key === 'ArrowDown') next = (next + 1) % options.length;
      else if (key === 'ArrowUp') next = (next - 1 + options.length) % options.length;
      else if (key === 'Home') next = 0;
      else if (key === 'End') next = options.length - 1;
      else return;
      event.preventDefault();
      options[next]?.focus();
    });
  }
</script>
