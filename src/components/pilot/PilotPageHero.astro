---
import Media from '@/components/Media.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  intent?: string;
}

const { title, lead, image, imageAlt = '', intent = title } = Astro.props;
---

<section class="pilot-page-hero" aria-labelledby="page-hero-heading">
  <div class="container-site">
    <div class="bx-grid">
      <h1 id="page-hero-heading" class="bx-span-4 bx-lg-span-7">{title}</h1>
      {lead && <p class="pilot-page-hero-lead bx-span-4 bx-lg-span-5">{lead}</p>}
    </div>
    {
      (image || intent) && (
        <div class="pilot-page-hero-media">
          <Media
            image={image}
            alt={imageAlt}
            intent={intent}
            labeled={!image}
            ratio="16 / 9"
            sizes="100vw"
            priority
          />
        </div>
      )
    }
  </div>
</section>
