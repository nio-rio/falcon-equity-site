---
import PilotArrow from './PilotArrow.astro';
import PilotEyebrow from './PilotEyebrow.astro';

export type ProductListItem = {
  name: string;
  href: string;
  body: string;
};

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  items: readonly ProductListItem[];
}

const { id = 'products-heading', eyebrow = 'What we do', title, lead, items } = Astro.props;
---

<section class="pilot-section" aria-labelledby={id}>
  <div class="container-site">
    <div class="bx-grid">
      <div class="pilot-section-head bx-span-4 bx-md-full bx-lg-span-10">
        <PilotEyebrow>{eyebrow}</PilotEyebrow>
        <h2 id={id}>{title}</h2>
      </div>
      {
        lead && (
          <p class="pilot-section-body bx-span-4 bx-lg-span-6 bx-lg-start-7">{lead}</p>
        )
      }
      <ol class="pilot-product-list bx-full">
        {
          items.map((item, i) => (
            <li class="pilot-product-item">
              <p class="pilot-step-num">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="pilot-step-title">{item.name}</h3>
              <p class="pilot-step-body">{item.body}</p>
              <PilotArrow href={item.href} label={item.name} accessibleName={`${item.name} product`} />
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
