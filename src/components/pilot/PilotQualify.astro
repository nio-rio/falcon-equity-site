---
import PilotEyebrow from './PilotEyebrow.astro';
import PilotGlance, { type GlanceCell } from './PilotGlance.astro';
import { splitInlineLinks } from '@/lib/inlineLinks';

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  cells: readonly GlanceCell[];
  lookAt?: string;
  note?: string | readonly string[];
}

const { id = 'qualify-heading', eyebrow = 'Eligibility', title, cells, lookAt, note } = Astro.props;
const notes = note == null ? [] : typeof note === 'string' ? [note] : [...note];
---

<section class="pilot-section" aria-labelledby={id}>
  <div class="container-site">
    <div class="bx-grid">
      <div class="pilot-section-head bx-span-4 bx-md-full bx-lg-span-10">
        <PilotEyebrow>{eyebrow}</PilotEyebrow>
        <h2 id={id}>{title}</h2>
      </div>
    </div>
  </div>
  <PilotGlance cells={cells} labelledBy={id} variant="requirements" />
  {
    (lookAt || notes.length > 0) && (
      <div class="container-site">
        <div class="bx-grid">
          {lookAt && <p class="pilot-section-body bx-span-4 bx-lg-span-10">{lookAt}</p>}
          {notes.map((line) => (
            <p class="pilot-section-note bx-span-4 bx-lg-span-10">
              {splitInlineLinks(line).map((part) =>
                part.href ? (
                  <a class="link" href={part.href}>
                    {part.text}
                  </a>
                ) : (
                  part.text
                ),
              )}
            </p>
          ))}
        </div>
      </div>
    )
  }
</section>
