---
/**
 * Home stats — Blackstone Tactical Opportunities `.bx-stat-featured`.
 * Measured at 1440 / 1280; see docs/refs/bx-tac-opps-stats.md.
 * Styles live in `src/styles/pilot-stats.css` and travel with this component, so a
 * page that renders <PilotStats /> does not need the home page's whole stylesheet.
 */
import { compactStatValue } from '@/lib/statDisplay';
import '@/styles/pilot-stats.css';

export type PilotStat = {
  label: string;
  value: string;
};

interface Props {
  featured: PilotStat;
  side: PilotStat[];
}

const { featured, side } = Astro.props;
const featuredValue = compactStatValue(featured.label, featured.value);
const sideStats = side.slice(0, 2).map((stat) => ({
  label: stat.label,
  value: compactStatValue(stat.label, stat.value),
}));
---

<section class="pilot-stats" aria-label="Published figures" data-band="light" data-reveal-root>
  <div class="container-site">
    <div class="pilot-stats-grid">
      <div class="pilot-stats-feat">
        <p class="pilot-stats-feat-label" data-reveal-stat>{featured.label}</p>
        <p class="pilot-stats-feat-value" data-reveal-stat="value">{featuredValue}</p>
      </div>
      <div class="pilot-stats-sides">
        {
          sideStats.map((stat, i) => (
            <div class={`pilot-stats-side pilot-stats-side--${i + 1}`}>
              <p class="pilot-stats-side-label" data-reveal-stat>
                {stat.label}
              </p>
              <div class="pilot-stats-side-value">
                <p data-reveal-stat="value">{stat.value}</p>
                <span class="pilot-stats-rule" data-reveal-line aria-hidden="true" />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
