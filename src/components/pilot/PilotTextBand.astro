---
import PilotArrow from './PilotArrow.astro';
import PilotEyebrow from './PilotEyebrow.astro';

export type TextBandItem = {
  title: string;
  body: string;
};

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  items: readonly TextBandItem[];
  numbered?: boolean;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  id = 'band-heading',
  eyebrow,
  title,
  lead,
  items,
  numbered = true,
  ctaHref,
  ctaLabel,
} = Astro.props;
---

<section class="pilot-section" aria-labelledby={id}>
  <div class="container-site">
    <div class="bx-grid">
      <div class="pilot-section-head bx-span-4 bx-md-full bx-lg-span-10">
        {eyebrow && <PilotEyebrow>{eyebrow}</PilotEyebrow>}
        <h2 id={id}>{title}</h2>
      </div>
      {
        lead && (
          <p class="pilot-section-body bx-span-4 bx-lg-span-6 bx-lg-start-7">{lead}</p>
        )
      }
      <ul class:list={['pilot-text-band bx-full', numbered && 'pilot-text-band--numbered']}>
        {
          items.map((item, i) => (
            <li>
              {numbered && <p class="pilot-step-num">{String(i + 1).padStart(2, '0')}</p>}
              <h3 class="pilot-step-title">{item.title}</h3>
              <p class="pilot-step-body">{item.body}</p>
            </li>
          ))
        }
      </ul>
      {
        ctaHref && ctaLabel && (
          <div class="pilot-section-cta bx-span-4">
            <PilotArrow href={ctaHref} label={ctaLabel} />
          </div>
        )
      }
    </div>
  </div>
</section>
