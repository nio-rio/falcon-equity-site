---
import '@fontsource/manrope/300.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '@/styles/global.css';
import '@/styles/blackstone.css';
import SEO, { type SEOProps } from '@/components/SEO.astro';
import JsonLd from '@/components/JsonLd.astro';
import Header from '@/components/Header.astro';
import SiteCta from '@/components/SiteCta.astro';
import Footer from '@/components/Footer.astro';
import { organizationSchema, webPageSchema } from '@/lib/schema';
import { SITE } from '@/data/site';
import { cleanPath } from '@/lib/paths';

interface Props extends SEOProps {
  schema?: Record<string, unknown>[];
}

const { schema = [], ...seo } = Astro.props;
const path = cleanPath(Astro.url.pathname);
const isHome = path === '/';
const pageName = seo.title
  ? seo.title.includes('|')
    ? seo.title
    : `${seo.title} | ${SITE.name}`
  : `${SITE.name} | Fast Funding in 24–48 Hours`;
const jsonLd = [
  organizationSchema(),
  ...(seo.noindex ? [] : [webPageSchema(path, pageName)]),
  ...schema,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#14101f" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/AtGambit-Light.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/AtGambit-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Archivo-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Falcon Equity Group Blog" href="/rss.xml" />
    <SEO {...seo} />
    <JsonLd data={jsonLd} />
    <slot name="head" />
  </head>
  <body class:list={['flex min-h-screen flex-col', isHome && 'is-home']}>
    <a
      href="#main"
      class="sr-only z-[100] bg-ink px-5 py-3 font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >Skip to main content</a
    >
    <Header />
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <SiteCta />
    <Footer />
  </body>
</html>
