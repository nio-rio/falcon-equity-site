---
import BaseLayout from './BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { breadcrumbSchema } from '@/lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  lastUpdated?: string;
}

const { title, description, path, lastUpdated } = Astro.props;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: title, path },
];
---

<BaseLayout title={title} description={description} schema={[breadcrumbSchema(crumbs)]}>
  <PageHero eyebrow="Legal" title={title} breadcrumbs={crumbs} lead={lastUpdated && `Last updated: ${lastUpdated}`} />
  <section class="bg-white py-16 sm:py-20">
    <div
      class="container-site prose prose-lg max-w-3xl prose-headings:font-display prose-headings:text-brand prose-a:text-brand prose-strong:text-ink"
    >
      <slot />
    </div>
  </section>
</BaseLayout>
