---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SERVICES } from '@/data/services';
---

<BaseLayout title="Page Not Found" description="The page you are looking for could not be found." noindex>
  <section class="border-b border-line bg-white">
    <div class="container-site py-16 md:py-24">
      <h1>Page not found.</h1>
      <p class="mt-4 max-w-xl text-ink-soft">The page has moved or does not exist.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn-primary">Home</a>
        <a href="/apply" class="btn-outline-dark">Apply</a>
      </div>
    </div>
  </section>
  <section class="section bg-white" aria-labelledby="popular-heading">
    <div class="container-site max-w-4xl">
      <h2 id="popular-heading">Pages</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          SERVICES.map((s) => (
            <li>
              <a href={`/services/${s.slug}`} class="link">
                {s.name}
              </a>
            </li>
          ))
        }
        <li><a href="/resources/loan-calculator" class="link">Loan calculator</a></li>
        <li><a href="/contact" class="link">Contact</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
