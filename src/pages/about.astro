---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ImageSlot from '@/components/ImageSlot.astro';
import QuoteSplit from '@/components/QuoteSplit.astro';
import ArrowCta from '@/components/ArrowCta.astro';
import CtaBand from '@/components/CtaBand.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Principles from '@/components/Principles.astro';
import { TEAM_ROLES, VALUES } from '@/data/content';
import { SITE } from '@/data/site';
import { breadcrumbSchema } from '@/lib/schema';
import dwight from '@/assets/images/dwight-holly.webp';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about' },
];

const founderSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.founder.name,
  jobTitle: SITE.founder.title,
  worksFor: { '@id': `${SITE.url}/#organization` },
};

const values = VALUES.map((v) => ({ title: v.name, body: v.body }));
---

<BaseLayout
  title="About Us"
  description="Falcon Equity Group is a New York City business funding firm with 15 years of experience and $100M+ in funding deployed. Meet founder Dwight Holly and the teams behind each file."
  schema={[breadcrumbSchema(crumbs), founderSchema]}
>
  <PageHero title="About" lead="We’re more than a funding provider. We’re your partner.">
    <div class="page-hero-media">
      <QuoteSplit
        quote="“Falcon Equity Group empowers your business with fast, tailored funding solutions, expertly navigating the complex financial landscape to ensure your wealth works for you.”"
        name={SITE.founder.name}
        role={SITE.founder.title}
        image={dwight}
        imageAlt="Portrait of Dwight Holly, Founder and CFO of Falcon Equity Group"
      />
      {/* Dwight should confirm the attribution before launch. */}
    </div>
  </PageHero>

  <section class="section bg-white" aria-labelledby="people-cta-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="bx-span-4 lg:bx-span-6">
          <h2 id="people-cta-heading" class="sr-only">Our people</h2>
          <ArrowCta href="#people-heading" label="Learn more about our people" />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="people-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="bx-span-4 lg:bx-span-6">
          <Eyebrow>Our people</Eyebrow>
          <h2 id="people-heading" class="mt-4">The people of Falcon.</h2>
        </div>
        {
          TEAM_ROLES.map((title) => (
            <div class="bx-span-2 md:bx-span-2 lg:bx-span-3">
              <ImageSlot intent="staff headshot, even studio light" ratio="3 / 4" />
              <p class="mt-4 min-h-[1.5em] font-medium text-ink">
                <Fragment set:html="<!-- real staff name -->" />
              </p>
              <p class="mt-1 text-sm text-muted">{title}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Principles id="values-heading" eyebrow="Values" title="Our values" items={values} />

  <CtaBand />
</BaseLayout>
