---
/**
 * `/about` — About Falcon Equity Group.
 *
 * Copy contract: `falcon-page-drafts/resources-and-firm-content.md` §5 (approved 22 Oct 2026),
 * ten bands in the order written there. Facts come from the data layer only:
 * STATS, SERVICES, INDUSTRIES, SITE — nothing retyped, and the 98% approval rate stays on the
 * home page. Donors for each band are named in the stylesheet header (`src/styles/about.css`);
 * the plan row-by-row table is `docs/about-structure-plan.md`.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Media from '@/components/Media.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Button040 from '@/components/Button040.astro';
import ArrowCta from '@/components/ArrowCta.astro';
import { PAGE_DISCLOSURE } from '@/data/disclosure';
import { SERVICES } from '@/data/services';
import { INDUSTRIES } from '@/data/industries';
import { SITE, STATS } from '@/data/site';
import founderPortrait from '@/assets/images/dwight-holly.webp';
import '@/styles/about.css';

const statByLabel = (label: string) => {
  const found = STATS.find((s) => s.label === label);
  if (!found) throw new Error(`STATS is missing "${label}" — the About page reads its figures from there.`);
  return found;
};
const featuredStat = statByLabel('Funding deployed');
const sideStats = [statByLabel('Years of experience'), statByLabel('Businesses helped')];

/** Product order from the copy contract; every figure below is read out of SERVICES. */
const PRODUCTS: { slug: string; note: string }[] = [
  { slug: 'merchant-cash-advance', note: 'Fastest to fund, and the most expensive.' },
  { slug: 'business-line-of-credit', note: 'Draw what you need and pay for only what you use.' },
  { slug: 'business-term-loan', note: 'One lump sum for a defined project.' },
  { slug: 'collateral-asset-loans', note: 'Against equipment, vehicles, commercial real estate or other business assets.' },
  { slug: 'invoice-factoring-tool', note: 'Against invoices you have already earned.' },
  { slug: 'consolidation-of-positions', note: 'Several daily or weekly payments replaced by one position.' },
  { slug: 'decentralized-business-financing', note: 'Crypto onboarding and custodial services, scoped per file.' },
];
const products = PRODUCTS.map(({ slug, note }) => {
  const service = SERVICES.find((s) => s.slug === slug);
  if (!service) throw new Error(`SERVICES is missing "${slug}" — the About page reads its ranges from there.`);
  return {
    name: service.name,
    spec:
      slug === 'decentralized-business-financing'
        ? 'Scoped per file · no published amounts'
        : `${service.amounts} · ${service.terms}`,
    note,
    href: slug === 'decentralized-business-financing' ? null : `/services/${slug}`,
  };
});

const takeaways = [
  'New York based, with one specialist assigned to each file rather than a call queue.',
  'Seven products, so the recommendation follows the use of proceeds instead of one product being sold to everyone.',
  'Many products fund within 24-48 hours of approval; real-estate secured loans take longer.',
  'Every file is underwritten individually. Approval is never guaranteed.',
];

/** Titles only, no photographs and no biographies until real names are approved. */
const peopleTitles = [
  'Senior Funding Advisor',
  'Funding Advisor',
  'Underwriting Manager',
  'Senior Underwriter',
  'Underwriter',
  'Client Success Lead',
  'Client Success Manager',
  'Placement Specialist',
  'Operations Analyst',
  'Operations Manager',
  'ISO Relationship Manager',
  'Broker Desk Lead',
  'Consolidation Specialist',
  'Digital Assets Specialist',
  'Credit Analyst',
  'Funding Coordinator',
  'Compliance Analyst',
];

const values = [
  { name: 'Vision', body: 'We look at the whole file, not a single score.' },
  { name: 'Speed', body: 'Decisions in hours. Many products fund within 24-48 hours of approval.' },
  { name: 'Precision', body: 'The product and the size should match the use of proceeds.' },
  { name: 'Partnership', body: 'Long relationships over one-off transactions.' },
];

const differences = [
  {
    title: 'One specialist per file',
    body: 'The person who reads your application is the person who calls you, and the same name stays on the file after funding.',
  },
  {
    title: 'Seven products, one application',
    body: 'Speed, a revolving gap, an asset, an unpaid invoice and stacked payments each have a different instrument. You are not pushed into the only product a lender sells.',
  },
  {
    title: 'Revenue first, credit second',
    body: 'Bank activity and time in business decide most files; a credit score matters most on term loans and consolidation.',
  },
  {
    title: 'Digital asset capability',
    body: 'Crypto onboarding and custodial services sit alongside the debt products, for businesses holding digital assets.',
  },
];

const sectors = INDUSTRIES.map((industry) => ({ name: industry.name, href: industry.href }));

const address = `${SITE.address.street}, ${SITE.address.city}, ${SITE.address.region} ${SITE.address.postalCode}`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Our Firm', item: `${SITE.url}/about` },
    { '@type': 'ListItem', position: 3, name: 'About', item: `${SITE.url}/about` },
  ],
};
---

<BaseLayout
  title="About"
  description="A New York business funding firm: 15 years, $100M+ deployed and 300+ businesses helped. Seven products from $5,000, with many funding in 24-48 hours."
  disclosure={PAGE_DISCLOSURE}
  schema={[breadcrumbSchema]}
>
  <Fragment slot="head">
    <script is:inline>
      (function () {
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          document.documentElement.classList.add('has-js');
          window.setTimeout(function () {
            if (!window.__pilotRevealReady) document.documentElement.classList.remove('has-js');
          }, 2500);
        } catch (e) {}
      })();
    </script>
  </Fragment>

  <!-- 1. Hero — TF-00 header + TF-01 still. The lead sits in the right-hand columns. -->
  <section class="abt-hero" aria-labelledby="page-hero-heading" data-band="light" data-abt-section="hero" data-reveal-root>
    <div class="container-site">
      <div class="abt-shell abt-hero-head" data-reveal>
        <h1 id="page-hero-heading" class="abt-hero-title">About Falcon Equity Group</h1>
        <p class="abt-hero-lead">We're more than a funding provider. We're your partner.</p>
      </div>
      <div class="abt-hero-media" data-reveal-media>
        <Media
          labeled
          intent="Lower Manhattan office windows looking toward the harbour, morning light"
          ratio="16 / 9"
          priority
          sizes="(min-width: 80em) 1264px, (min-width: 64em) 1136px, (min-width: 48em) 688px, 100vw"
        />
      </div>
    </div>
  </section>

  <!-- 2. Answer first — the 51-word answer, with four takeaways beside it. -->
  <section class="abt-answer" aria-labelledby="answer-heading" data-band="light" data-abt-section="answer" data-reveal-root>
    <div class="container-site">
      <div class="abt-shell abt-answer-grid">
        <div class="abt-answer-copy" data-reveal>
          <Eyebrow>The short answer</Eyebrow>
          <h2 id="answer-heading" class="sr-only">What Falcon Equity Group is</h2>
          <p class="abt-answer-text">
            Falcon Equity Group is a business funding firm based at 11 Broadway in New York. In 15 years it has
            deployed more than $100M to 300+ businesses, offering seven products from $5,000 to $5,000,000: merchant
            cash advances, lines of credit, term loans, invoice factoring, consolidation, asset-backed loans and
            digital asset services.
          </p>
        </div>
        <ul class="abt-takeaways" data-reveal>
          {takeaways.map((line) => <li class="abt-takeaway">{line}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 3. By the numbers — FAL-01: one featured figure, two side figures. -->
  <section class="abt-stats" aria-label="By the numbers" data-band="light" data-abt-section="stats" data-reveal-root>
    <div class="container-site">
      <div class="abt-shell abt-stats-grid">
        <div class="abt-stat-feat" data-reveal>
          <p class="abt-stat-feat-label">{featuredStat.label}</p>
          <p class="abt-stat-feat-value" data-reveal-stat="value">{featuredStat.value}</p>
        </div>
        <div class="abt-stat-sides" data-reveal>
          {
            sideStats.map((stat) => (
              <div class="abt-stat-side">
                <p class="abt-stat-side-label">{stat.label}</p>
                <p class="abt-stat-side-value" data-reveal-stat="value">{stat.value}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 4. What we do — OP-01 roster: 4 tracks of 244, 96 / 64 gaps, name over spec. -->
  <section class="abt-products" aria-labelledby="products-heading" data-band="light" data-abt-section="products" data-reveal-root>
    <div class="container-site">
      <div class="abt-shell abt-band-head" data-reveal>
        <div class="abt-block-head">
          <Eyebrow>What we do</Eyebrow>
          <h2 id="products-heading">Seven ways to fund a business.</h2>
        </div>
        <p class="abt-band-lead">
          One application goes to a specialist who matches the product to the need: speed, a repeating gap, an asset,
          an unpaid invoice or a set of stacked payments.
        </p>
      </div>
      <ul class="abt-roster" data-reveal>
        {
          products.map((product) => (
            <li class="abt-roster-item">
              {product.href ? (
                <a class="abt-roster-link" href={product.href}>
                  <span class="abt-roster-name">{product.name}</span>
                </a>
              ) : (
                <span class="abt-roster-name">{product.name}</span>
              )}
              <p class="abt-roster-spec">{product.spec}</p>
              <p class="abt-roster-note">{product.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. Founder — FAL-03: 3:4 portrait, the live site's quote, credit, one line. -->
  <section class="abt-founder" aria-labelledby="founder-heading" data-band="light" data-abt-section="founder" data-reveal-root>
    <div class="container-site">
      <div class="abt-shell abt-founder-grid">
        <div class="abt-founder-media" data-reveal>
          <Media
            image={founderPortrait}
            intent={`Portrait of ${SITE.founder.name}, ${SITE.founder.title}`}
            alt={`${SITE.founder.name}, ${SITE.founder.title} of ${SITE.name}`}
            ratio="3 / 4"
            sizes="(min-width: 80em) 380px, (min-width: 64em) 30vw, 22rem"
            widths={[320, 480, 560, 760]}
            fallbackFormat="webp"
            quality={72}
          />
        </div>
        <div class="abt-founder-copy" data-reveal>
          <h2 id="founder-heading" class="sr-only">From the founder</h2>
          <blockquote class="abt-founder-quote">
            “Falcon Equity Group empowers your business with fast, tailored funding solutions, expertly navigating the
            complex financial landscape to ensure your wealth works for you.”
          </blockquote>
          <p class="abt-founder-credit">{SITE.founder.name}, {SITE.founder.title}</p>
          <p class="abt-founder-line">{SITE.founder.bio}.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Our people — OP-01 again, titles only. -->
  <section class="abt-people" aria-labelledby="people-heading" data-band="light" data-abt-section="people" data-reveal-root>
    <div class="container-site">
      <div class="abt-shell abt-band-head" data-reveal>
        <div class="abt-block-head">
          <Eyebrow>Our people</Eyebrow>
          <h2 id="people-heading">The people behind each file.</h2>
        </div>
        <p class="abt-people-body">
          A file moves through specialists rather than a queue: a funding advisor, an underwriter and a client success
          manager who stays with you after funding.
        </p>
      </div>
      <ul class="abt-roster" data-reveal>
        {
          peopleTitles.map((title) => (
            <li class="abt-roster-item">
              <span class="abt-roster-name">{title}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 7. Values — TF-05 titled prose, four instead of three. -->
  <section class="abt-values" aria-labelledby="values-heading" data-band="light" data-abt-section="values" data-reveal-root>
    <div class="container-site">
      <div class="abt-shell abt-band-head" data-reveal>
        <div class="abt-block-head">
          <Eyebrow>Values</Eyebrow>
          <h2 id="values-heading">What we hold to.</h2>
        </div>
      </div>
      <div class="abt-values-grid" data-reveal>
        {
          values.map((value) => (
            <article>
              <h3 class="abt-value-name">{value.name}</h3>
              <p class="abt-value-body">{value.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 8. Who we fund — TF-03 rows, re-cut as a four-column link grid off INDUSTRIES. -->
  <section class="abt-sectors" aria-labelledby="sectors-heading" data-band="light" data-abt-section="sectors" data-reveal-root>
    <div class="container-site">
      <div class="abt-shell abt-band-head" data-reveal>
        <div class="abt-block-head">
          <Eyebrow>Industries</Eyebrow>
          <h2 id="sectors-heading">Who we fund.</h2>
        </div>
        <p class="abt-band-lead">
          We fund operating businesses in twelve sectors, and others with steady revenue. There is no
          restricted-industry or restricted-state list. The work is the same in each: read the file, match the product
          to the use of proceeds, and say so when a product is the wrong instrument.
        </p>
      </div>
      <ul class="abt-sector-grid" data-reveal>
        {
          sectors.map((sector) => (
            <li class="abt-sector">
              <a class="abt-sector-link" href={sector.href}>
                <span>{sector.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="abt-sectors-cta" data-reveal>
        <ArrowCta href="/industries" label="See industry funding" />
      </div>
    </div>
  </section>

  <!-- 9. How we're different — APM-01 numbered columns, four instead of three. -->
  <section class="abt-different" aria-labelledby="different-heading" data-band="light" data-abt-section="different" data-reveal-root>
    <div class="container-site">
      <div class="abt-shell abt-band-head" data-reveal>
        <div class="abt-block-head">
          <Eyebrow>Why Falcon</Eyebrow>
          <h2 id="different-heading">What a rate table cannot show.</h2>
        </div>
      </div>
      <div class="abt-diff-grid" data-reveal>
        {
          differences.map((item, i) => (
            <article>
              <p class="abt-diff-num">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="abt-diff-title">{item.title}</h3>
              <p class="abt-diff-body">{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 10. Where we are — address, email, phones, one Apply. -->
  <section class="abt-contact" aria-labelledby="contact-heading" data-band="light" data-abt-section="contact" data-reveal-root>
    <div class="container-site">
      <div class="abt-shell abt-contact-grid">
        <div class="abt-contact-copy" data-reveal>
          <Eyebrow>Contact</Eyebrow>
          <h2 id="contact-heading">Talk to a specialist.</h2>
        </div>
        <dl class="abt-contact-list" data-reveal>
          <div class="abt-contact-row">
            <dt class="abt-contact-label">Office</dt>
            <dd class="abt-contact-value">{address}</dd>
          </div>
          <div class="abt-contact-row">
            <dt class="abt-contact-label">Email</dt>
            <dd class="abt-contact-value"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
          </div>
          <div class="abt-contact-row">
            <dt class="abt-contact-label">{SITE.phones.direct.label}</dt>
            <dd class="abt-contact-value"><a href={SITE.phones.direct.href}>{SITE.phones.direct.display}</a></dd>
          </div>
          <div class="abt-contact-row">
            <dt class="abt-contact-label">{SITE.phones.fax.label}</dt>
            <dd class="abt-contact-value">{SITE.phones.fax.display}</dd>
          </div>
        </dl>
        <div class="abt-contact-cta" data-reveal>
          <Button040 href="/apply" label="Get funding today" variant="dark" />
          <ArrowCta href="/#services" label="See all services" />
        </div>
      </div>
    </div>
  </section>

  <script>
    import '@/scripts/scroll-in';
  </script>
</BaseLayout>
