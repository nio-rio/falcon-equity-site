---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ImageSlot from '@/components/ImageSlot.astro';
import CtaBand from '@/components/CtaBand.astro';
import { TEAM_ROLES, VALUES } from '@/data/content';
import { SITE } from '@/data/site';
import { breadcrumbSchema } from '@/lib/schema';
import dwight from '@/assets/images/dwight-holly.webp';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about' },
];

const founderSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.founder.name,
  jobTitle: SITE.founder.title,
  worksFor: { '@id': `${SITE.url}/#organization` },
};
---

<BaseLayout
  title="About Us"
  description="Falcon Equity Group is a New York City business funding firm with 15 years of experience and $100M+ in funding deployed. Meet founder Dwight Holly and the teams behind each file."
  schema={[breadcrumbSchema(crumbs), founderSchema]}
>
  <PageHero
    title="About"
    lead="11 Broadway, Lower Manhattan. 15 years. $100M+ deployed. 300+ businesses funded."
    breadcrumbs={crumbs}
  />

  <section class="section bg-white" aria-labelledby="story-heading">
    <div class="container-site grid gap-16 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-6">
        <SectionHeading id="story-heading" eyebrow="The firm" title="From Lower Manhattan." />
        <div class="mt-6 space-y-5 text-ink-soft">
          <p>
            For 15 years Falcon has funded businesses from 11 Broadway. More than $100M deployed. 300+ businesses helped.
          </p>
          <p>
            Named for the peregrine falcon: see the file clearly, decide, follow through. A specialist stays with the
            relationship after funds land.
          </p>
        </div>
      </div>
      <div class="lg:col-span-6">
        <ImageSlot intent="11 Broadway entrance, Lower Manhattan, daylight" ratio="4 / 3" />
      </div>
    </div>
    <div class="container-site mt-16">
      <ul class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          VALUES.map((v) => (
            <li>
              <h3>{v.name}</h3>
              <p class="mt-2 text-ink-soft">{v.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section bg-tint" aria-labelledby="founder-heading">
    <div class="container-site">
      <SectionHeading id="founder-heading" eyebrow="Leadership" title="Dwight Holly, Founder and CFO." />
      <article class="mt-12 grid gap-10 md:grid-cols-12 md:items-center">
        <div class="md:col-span-4">
          <Image
            src={dwight}
            alt="Portrait of Dwight Holly, Founder and CFO of Falcon Equity Group"
            widths={[360, 562]}
            sizes="(min-width: 768px) 33vw, 100vw"
            loading="eager"
            class="block aspect-[3/4] w-full object-cover object-top"
          />
        </div>
        <div class="md:col-span-8 md:pl-4">
          <div class="space-y-4 text-ink-soft">
            <p>
              Dwight Holly founded Falcon to give owners what traditional lenders often do not: speed, clarity and someone who
              understands how businesses run.
            </p>
            <p>
              Under his leadership the firm has 15 years in business funding and has deployed more than $100M, from same-day
              approvals to consolidation.
            </p>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="team-heading">
    <div class="container-site">
      <SectionHeading id="team-heading" eyebrow="The team" title="People on the file." />
      <ul class="mt-12 grid gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {
          TEAM_ROLES.map((title) => (
            <li>
              <ImageSlot intent="staff headshot, even studio light" ratio="3 / 4" />
              <p class="mt-4 min-h-[1.5em] font-medium text-ink">
                <Fragment set:html="<!-- real staff name -->" />
              </p>
              <p class="mt-1 text-sm text-muted">{title}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
