---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ImageSlot from '@/components/ImageSlot.astro';
import CtaBand from '@/components/CtaBand.astro';
import { TEAM_ROLES, VALUES } from '@/data/content';
import { SITE, STATS } from '@/data/site';
import { breadcrumbSchema } from '@/lib/schema';
import dwight from '@/assets/images/dwight-holly.webp';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about' },
];

const founderSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.founder.name,
  jobTitle: SITE.founder.title,
  worksFor: { '@id': `${SITE.url}/#organization` },
};

const founderStats = STATS.filter((s) => ['$100M+', '15', '300+'].includes(s.value));
---

<BaseLayout
  title="About Us"
  description="Falcon Equity Group is a New York City business funding firm with 15 years of experience and $100M+ in funding deployed. Meet founder Dwight Holly and the teams behind each file."
  schema={[breadcrumbSchema(crumbs), founderSchema]}
>
  <PageHero title="About" lead="We’re more than a funding provider. We’re your partner." />

  <section class="section bg-white" aria-labelledby="founder-heading">
    <div class="container-site max-w-4xl">
      <SectionHeading id="founder-heading" eyebrow="Founder" title="From the founder." />
      <figure class="mt-8">
        <blockquote>
          <p class="founder-quote">
            <!-- Dwight to write and approve -->
            “[Founder statement to come.]”
          </p>
        </blockquote>
        <figcaption class="mt-8 text-ink-soft">
          {SITE.founder.name}, {SITE.founder.title}
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="leadership-heading">
    <div class="container-site">
      <SectionHeading id="leadership-heading" eyebrow="Leadership" title={SITE.founder.name} />
      <p class="mt-3 text-ink-soft">{SITE.founder.title}</p>
      <article class="mt-12 grid gap-10 md:grid-cols-12 md:items-start">
        <div class="md:col-span-4">
          <Image
            src={dwight}
            alt="Portrait of Dwight Holly, Founder and CFO of Falcon Equity Group"
            widths={[360, 562]}
            sizes="(min-width: 768px) 33vw, 100vw"
            loading="eager"
            class="block aspect-[3/4] w-full object-cover object-top"
          />
        </div>
        <div class="md:col-span-8 md:pl-4">
          <p class="text-ink-soft">{SITE.founder.bio}</p>
          <ul class="mt-10 grid gap-8 sm:grid-cols-3">
            {
              founderStats.map((s) => (
                <li>
                  <p class="font-display text-4xl font-light text-ink">{s.value}</p>
                  <p class="mt-2 text-sm text-muted">{s.label}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="people-heading">
    <div class="container-site">
      <SectionHeading id="people-heading" eyebrow="Our people" title="The people of Falcon." />
      <ul class="mt-12 grid gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {
          TEAM_ROLES.map((title) => (
            <li>
              <ImageSlot intent="staff headshot, even studio light" ratio="3 / 4" />
              <p class="mt-4 min-h-[1.5em] font-medium text-ink">
                <Fragment set:html="<!-- real staff name -->" />
              </p>
              <p class="mt-1 text-sm text-muted">{title}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="values-heading">
    <div class="container-site">
      <SectionHeading id="values-heading" eyebrow="Values" title="Our values" />
      <ul class="mt-12 grid gap-10 sm:grid-cols-2">
        {
          VALUES.map((v) => (
            <li>
              <h3>{v.name}</h3>
              <p class="mt-3 text-ink-soft">{v.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .founder-quote {
    font-weight: 300;
    font-size: clamp(1.75rem, 2.5vw + 1rem, 2.5rem);
    line-height: 1.15;
    color: var(--color-ink);
  }
</style>
