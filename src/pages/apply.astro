---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactLine from '@/components/ContactLine.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import { SITE } from '@/data/site';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Apply', path: '/apply' },
];
const phones = [SITE.phones.office, SITE.phones.direct, SITE.phones.fax];
---

<BaseLayout
  title="Apply for Business Funding"
  description="Apply online for business funding with Falcon Equity Group. One short application. A specialist reviews your file promptly. Many products fund within 24-48 hours of approval."
  schema={[breadcrumbSchema(crumbs)]}
>
  <section class="section bg-white">
    <div class="container-site">
      <div class="bx-grid">
        <div class="bx-span-4 bx-lg-span-8 bx-lg-start-3 text-center">
          <h1>Apply</h1>
          <p class="section-lead mt-5">
            One short application. A specialist reviews your file promptly. Many products fund within 24-48 hours of approval.
          </p>
        </div>
        <div class="bx-span-4 bx-lg-span-8 bx-lg-start-3 text-center">
          <Eyebrow align="center">Application</Eyebrow>
          <h2 id="form-heading" class="mt-4">Funding application form</h2>
        </div>
        <div class="bx-span-4 bx-lg-span-8 bx-lg-start-3">
          <div class="jotform-embed min-h-[40rem] bg-white p-3 sm:p-6">
            <script type="text/javascript" src="https://form.jotform.com/jsform/252856411020144" is:inline></script>
          </div>
          <noscript>
            <p class="p-6">
              Our application form requires JavaScript. Please enable it, or
              <a class="link" href="https://form.jotform.com/252856411020144">open the application form directly</a>.
            </p>
          </noscript>
        </div>
        <ul class="bx-span-4 bx-lg-span-8 bx-lg-start-3 flex flex-col items-center gap-3 text-[15px]">
          {
            phones.map((p) => (
              <li>
                <ContactLine icon="phone" href={p.href}>
                  {p.label}: {p.display}
                </ContactLine>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
