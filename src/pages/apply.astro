---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactLine from '@/components/ContactLine.astro';
import { SITE } from '@/data/site';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Apply', path: '/apply' },
];
const phones = [SITE.phones.office, SITE.phones.direct, SITE.phones.fax];
---

<BaseLayout
  title="Apply for Business Funding"
  description="Apply online for business funding with Falcon Equity Group. One short application, a dedicated specialist and funding in as little as 24-48 hours."
  schema={[breadcrumbSchema(crumbs)]}
>
  <section class="section bg-tint">
    <div class="container-site max-w-3xl text-center">
      <h1>Apply</h1>
    </div>
    <div class="container-site mt-12 max-w-4xl">
      <h2 id="form-heading" class="sr-only">Funding application form</h2>
      <div class="jotform-embed min-h-[40rem] bg-white p-3 sm:p-6">
        <script type="text/javascript" src="https://form.jotform.com/jsform/252856411020144" is:inline></script>
      </div>
      <noscript>
        <p class="p-6">
          Our application form requires JavaScript. Please enable it, or
          <a class="link" href="https://form.jotform.com/252856411020144">open the application form directly</a>.
        </p>
      </noscript>
    </div>
    <div class="container-site mt-12 max-w-3xl">
      <ul class="flex flex-col items-center gap-3 text-[15px]">
        {
          phones.map((p) => (
            <li>
              <ContactLine icon="phone" href={p.href} class="hover:text-accent">
                {p.label}: {p.display}
              </ContactLine>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
