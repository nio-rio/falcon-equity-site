---
/**
 * One page per published guide: /blog/<slug>.
 *
 * Layout from blackstone.com/insights/article/…, measured live 23 Oct 2026 at
 * 1440 and 390 (numbers in the header comment of src/styles/blog-article.css):
 *
 *   title 784 wide (columns 1-10), 48/72 at 1440 and 32/48 at 390
 *   media (16:9) directly under the title, in the same 784 slot
 *   body 704 wide (columns 1-9), 18/27
 *   right rail 304 wide (columns 13-16), sticky, modules separated by hairlines
 *
 * The reference's rail carries category + date, an author, a "Watch on YouTube"
 * CTA, a newsletter signup and share icons. Ling, 23 Oct: *"On the right, change
 * watch on youtube and the subscribe part to a CTA, that basically says Falcon
 * provide fast business funding. and a button: see your options."* So the rail is
 * category + date, then one Falcon CTA panel — no author (nobody to credit, and
 * CLAUDE.md forbids inventing people) and no share row.
 */
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button040 from '@/components/Button040.astro';
import Media from '@/components/Media.astro';
import { PAGE_DISCLOSURE } from '@/data/disclosure';
import { SITE } from '@/data/site';
import { formatDate, getPublishedPosts } from '@/lib/blog';
import { articleSchema, breadcrumbSchema } from '@/lib/schema';
import '@/styles/blog-article.css';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const { title, category, date, updated, description, cover, coverAlt, seoTitle, author } = post.data;

const documentTitle = seoTitle ?? `${title} | Falcon Equity Group`;

/* Rail share row — the reference's five targets, print first. */
const pageUrl = `${SITE.url}/blog/${post.id}`;
const shareLinks = [
  {
    label: 'Share on LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`,
  },
  {
    label: 'Share on X',
    href: `https://x.com/intent/post?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(title)}`,
  },
  {
    label: 'Share on Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`,
  },
  {
    label: 'Share by email',
    href: `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(pageUrl)}`,
  },
];

const schema = [
  articleSchema({
    title,
    description,
    slug: post.id,
    date,
    updated,
    author,
    image: cover?.src,
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog' },
    { name: title, path: `/blog/${post.id}` },
  ]),
];
---

<BaseLayout title={documentTitle} description={description} schema={schema} disclosure={PAGE_DISCLOSURE} type="article">
  <article class="art-band" data-band="light">
    <div class="container-site art-layout">
      <div class="art-main">
        <header class="art-head">
          {/* The rail is hidden below 80em, and the reference hides its own
              category/date there too — so print them under the title on small
              screens, or a reader never sees the date at all. */}
          <p class="art-meta">
            <span class="art-meta-category">{category}</span>
            <span class="art-meta-sep" aria-hidden="true">·</span>
            <time datetime={date.toISOString()}>{formatDate(date)}</time>
          </p>
          <h1 class="art-h1">{title}</h1>
        </header>

        {
          cover && (
            <div class="art-media">
              <Media
                image={cover}
                alt={coverAlt}
                intent={coverAlt || `Illustration for ${title}`}
                ratio="16 / 9"
                sizes="(min-width: 80em) 784px, 100vw"
                priority
              />
            </div>
          )
        }

        <div class="art-prose">
          <Content />
        </div>
      </div>

      <aside class="art-rail" aria-label="About Falcon Equity Group">
        <div class="art-rail-inner">
          <div class="art-rail-meta">
            <p class="art-rail-category">{category}</p>
            <p class="art-rail-date">
              <time datetime={date.toISOString()}>{formatDate(date)}</time>
            </p>
          </div>

          {/* Company as the author — there is no byline to credit, and inventing
              a person is off-limits (CLAUDE.md). */}
          <div class="art-rail-author">
            <img
              class="art-rail-avatar"
              src={SITE.logo}
              alt=""
              width="40"
              height="40"
              loading="lazy"
              decoding="async"
            />
            <div class="art-rail-author-text">
              <p class="art-rail-author-name">Falcon Equity Group</p>
              <p class="art-rail-author-role">Business funding</p>
            </div>
          </div>

          <div class="art-rail-cta">
            <p class="art-rail-cta-eyebrow">Small business funding</p>
            <p class="art-rail-cta-text">
              Ask Falcon Equity about a funding solution for your business.
            </p>
            <a class="art-rail-button" href="/#services">
              <span class="art-rail-button-label">See your options</span>
              {/* The reference's icon on hover: the circle fills white, the arrow
                  flips to ink, the whole thing scales to 1.2. */}
              <svg class="art-rail-button-icon" viewBox="0 0 40 40" aria-hidden="true">
                <circle class="art-rail-button-fill" cx="20" cy="20" r="18.4"></circle>
                <circle
                  class="art-rail-button-ring"
                  cx="20"
                  cy="20"
                  r="18.4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.2"></circle>
                <path
                  class="art-rail-button-arrow"
                  d="M14.5 20h10.2M20.8 15.2 25.6 20l-4.8 4.8"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>

          <div class="art-rail-share">
            <button type="button" class="art-share" data-share-print aria-label="Print this page">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M7 9V3.75h10V9"></path>
                <path d="M7 18H5.25A2.25 2.25 0 0 1 3 15.75v-4.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v4.5A2.25 2.25 0 0 1 18.75 18H17"></path>
                <rect x="7" y="13.75" width="10" height="6.5" rx="0.8"></rect>
              </svg>
            </button>
            <span class="art-share-rule" aria-hidden="true"></span>
            {
              shareLinks.map((link, index) => (
                <a
                  class="art-share"
                  href={link.href}
                  aria-label={link.label}
                  target={index === shareLinks.length - 1 ? undefined : '_blank'}
                  rel={index === shareLinks.length - 1 ? undefined : 'noopener'}
                >
                  {index === 0 && (
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"></path>
                    </svg>
                  )}
                  {index === 1 && (
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.59-6.64 7.59H.47l8.6-9.83L0 1.15h7.59l5.25 6.93 6.06-6.93zm-1.29 19.49h2.04L6.49 3.24H4.3l13.31 17.4z"></path>
                    </svg>
                  )}
                  {index === 2 && (
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M24 12.07C24 5.44 18.63.07 12 .07S0 5.44 0 12.07c0 5.99 4.39 10.95 10.13 11.85v-8.38H7.08v-3.47h3.05V9.43c0-3.01 1.79-4.67 4.53-4.67 1.31 0 2.69.24 2.69.24v2.95h-1.51c-1.49 0-1.96.93-1.96 1.87v2.25h3.33l-.53 3.47h-2.8v8.38C19.61 23.02 24 18.06 24 12.07z"></path>
                    </svg>
                  )}
                  {index === 3 && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <rect x="2.75" y="5" width="18.5" height="14" rx="1.5"></rect>
                      <path d="m3.6 6.6 8.4 5.9 8.4-5.9"></path>
                    </svg>
                  )}
                </a>
              ))
            }
          </div>
        </div>
      </aside>
    </div>
  </article>

  <script>
    /* The print button in the rail — the reference's first share control. */
    document.querySelectorAll('[data-share-print]').forEach((button) => {
      button.addEventListener('click', () => window.print());
    });
  </script>
</BaseLayout>
