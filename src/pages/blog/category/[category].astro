---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import BlogIndex from '@/components/BlogIndex.astro';
import BlogCategoryIntro from '@/components/BlogCategoryIntro.astro';
import InsightsCta from '@/components/InsightsCta.astro';
import { categorySlug, getPublishedPosts, type Post } from '@/lib/blog';
import { BLOG_CATEGORIES, BLOG_CATEGORY_DESCRIPTION, type BlogCategory } from '@/data/blog';
import { breadcrumbSchema } from '@/lib/schema';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  const used = BLOG_CATEGORIES.filter((c) => posts.some((p) => p.data.category === c));
  return used.map((category) => {
    const categoryPosts = posts.filter((p) => p.data.category === category);
    return {
      params: { category: categorySlug(category) },
      props: { category, posts: categoryPosts, categories: used },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  category: BlogCategory;
  posts: Post[];
  categories: BlogCategory[];
}

const { category, posts, categories } = Astro.props;
const slug = categorySlug(category);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog' },
  { name: category, path: `/blog/category/${slug}` },
];
const thin = posts.length < 2;
---

<BaseLayout
  title={`${category} Articles`}
  description={BLOG_CATEGORY_DESCRIPTION[category]}
  noindex={thin}
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero title={category}>
    <div class="category-intro mt-6 max-w-3xl space-y-4 text-ink-soft">
      <BlogCategoryIntro category={category} />
    </div>
    <BlogIndex posts={posts} categories={categories} activeCategory={category} />
  </PageHero>
  <InsightsCta
    eyebrow="Apply for funding"
    title="Get funding today"
    ctaLabel="Apply"
  />
</BaseLayout>
