---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import BlogIndex from '@/components/BlogIndex.astro';
import CtaBand from '@/components/CtaBand.astro';
import { getPublishedPosts } from '@/lib/blog';
import { BLOG_CATEGORIES } from '@/content.config';
import { breadcrumbSchema } from '@/lib/schema';

const posts = await getPublishedPosts();
const used = new Set(posts.map((p) => p.data.category));
const categories = BLOG_CATEGORIES.filter((c) => used.has(c));
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog' },
];
---

<BaseLayout
  title="The Falcon Brief: Business Funding Blog"
  description="Practical, plain-English guides on working capital, merchant cash advances, consolidation, factoring and getting funded fast."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    eyebrow="The Falcon Brief"
    title="Sharper funding decisions."
    lead="Plain-English guides on working capital, consolidation and getting funded fast, from the team at Falcon Equity Group."
    breadcrumbs={crumbs}
  />
  <BlogIndex posts={posts} categories={categories} />
  <CtaBand />
</BaseLayout>
