---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import BlogIndex from '@/components/BlogIndex.astro';
import InsightsCta from '@/components/InsightsCta.astro';
import { getPublishedPosts } from '@/lib/blog';
import { BLOG_CATEGORIES } from '@/data/blog';
import { breadcrumbSchema } from '@/lib/schema';

const posts = await getPublishedPosts();
const used = new Set(posts.map((p) => p.data.category));
const categories = BLOG_CATEGORIES.filter((c) => used.has(c));
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog' },
];
---

<BaseLayout
  title="Business Funding Guides"
  description="Guides from Falcon Equity Group on getting approved, comparing funding options, reading costs and rates, and managing cash flow and stacked debt."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero title="Blog" lead="Short guides on getting approved, comparing options, costs, and cash flow.">
    <div class="page-hero-media">
      <BlogIndex posts={posts} categories={categories} filterable />
    </div>
  </PageHero>
  <InsightsCta
    eyebrow="Apply for funding"
    title="Get funding today"
    ctaLabel="Apply"
  />
</BaseLayout>
