---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import BlogIndex from '@/components/BlogIndex.astro';
import CtaBand from '@/components/CtaBand.astro';
import { getPublishedPosts } from '@/lib/blog';
import { BLOG_CATEGORIES } from '@/content.config';
import { breadcrumbSchema } from '@/lib/schema';

const posts = await getPublishedPosts();
const used = new Set(posts.map((p) => p.data.category));
const categories = BLOG_CATEGORIES.filter((c) => used.has(c));
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog' },
];
---

<BaseLayout
  title="The Falcon Brief"
  description="Guides on working capital, merchant cash advances, consolidation, factoring and getting funded."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero title="The Falcon Brief" lead="Short guides on working capital, consolidation and getting funded." breadcrumbs={crumbs} />
  <BlogIndex posts={posts} categories={categories} />
  <CtaBand />
</BaseLayout>
