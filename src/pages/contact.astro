---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { SITE } from '@/data/site';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact' },
];
const phones = [SITE.phones.office, SITE.phones.direct, SITE.phones.fax];
---

<BaseLayout
  title="Contact"
  description="Contact Falcon Equity Group at 11 Broadway Suite 615, New York, NY. Call +1 (917) 645-3826 or email information@falconequity.ai."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Contact"
    lead="Call, email or visit the New York office. To discuss a file, apply online."
    breadcrumbs={crumbs}
  />

  <section class="section bg-white" aria-labelledby="contact-details-heading">
    <div class="container-site grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 id="contact-details-heading">Details</h2>
        <dl class="mt-8 divide-y divide-line border-y border-line">
          <div class="grid gap-1 py-4 sm:grid-cols-3">
            <dt class="text-muted">Email</dt>
            <dd class="sm:col-span-2">
              <a href={`mailto:${SITE.email}`} class="hover:text-accent">{SITE.email}</a>
            </dd>
          </div>
          {
            phones.map((p) => (
              <div class="grid gap-1 py-4 sm:grid-cols-3">
                <dt class="text-muted">{p.label}</dt>
                <dd class="sm:col-span-2">
                  <a href={p.href} class="hover:text-accent">{p.display}</a>
                </dd>
              </div>
            ))
          }
          <div class="grid gap-1 py-4 sm:grid-cols-3">
            <dt class="text-muted">Office</dt>
            <dd class="sm:col-span-2">
              <a href={SITE.address.mapUrl} target="_blank" rel="noopener">
                {SITE.address.street}, {SITE.address.city}, {SITE.address.region} {SITE.address.postalCode}
                <span class="sr-only"> (opens Google Maps in a new tab)</span>
              </a>
            </dd>
          </div>
          <div class="grid gap-1 py-4 sm:grid-cols-3">
            <dt class="text-muted">X</dt>
            <dd class="sm:col-span-2">
              <a href={SITE.social.x} class="hover:text-accent" target="_blank" rel="noopener">
                {SITE.social.xHandle}<span class="sr-only"> (opens in a new tab)</span>
              </a>
            </dd>
          </div>
        </dl>
      </div>
      <aside class="lg:col-span-5" aria-labelledby="contact-cta-heading">
        <h2 id="contact-cta-heading">Apply</h2>
        <p class="mt-4 text-ink-soft">The shortest path to a review is the online application.</p>
        <a href="/apply" class="btn-primary mt-6">Apply</a>
        <p class="mt-6 text-sm text-muted">
          Or call <a href={SITE.phones.direct.href} class="text-ink underline">{SITE.phones.direct.display}</a>.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>
