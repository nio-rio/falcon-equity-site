---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ContactPoints from '@/components/ContactPoints.astro';
import ContactLine from '@/components/ContactLine.astro';
import ImageSlot from '@/components/ImageSlot.astro';
import { SITE } from '@/data/site';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact' },
];
---

<BaseLayout
  title="Contact"
  description="Contact Falcon Equity Group at 11 Broadway Suite 615, New York, NY. Call +1 (917) 645-3826 or email information@falconequity.ai."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Contact"
    lead="Call, email or visit the New York office. To discuss a file, apply online."
  />

  <section class="section bg-white" aria-labelledby="contact-details-heading">
    <div class="container-site">
      <SectionHeading id="contact-details-heading" eyebrow="Contact" title="Details" />
      <div class="mt-12">
        <ContactPoints />
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="contact-apply-heading">
    <div class="container-site grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <ImageSlot intent="map of Lower Manhattan around 11 Broadway" ratio="16 / 9" />
      </div>
      <div class="lg:col-span-5">
        <p class="eyebrow">Application</p>
        <h2 id="contact-apply-heading" class="mt-3">Apply</h2>
        <p class="mt-4 text-ink-soft">
          One short application. A specialist reviews your file promptly. Many products fund within 24-48 hours of approval.
        </p>
        <a href="/apply" class="btn-primary mt-6">Get Funding Today</a>
        <p class="mt-6">
          <ContactLine icon="phone" href={SITE.phones.direct.href} class="hover:text-accent">
            {SITE.phones.direct.display}
          </ContactLine>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
