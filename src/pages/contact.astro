---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ContactPoints from '@/components/ContactPoints.astro';
import ContactLine from '@/components/ContactLine.astro';
import ImageSlot from '@/components/ImageSlot.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import { SITE } from '@/data/site';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact' },
];
---

<BaseLayout
  title="Contact"
  description="Contact Falcon Equity Group at 11 Broadway Suite 615, New York, NY. Call +1 (917) 645-3826 or email information@falconequity.ai."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Contact"
    lead="Call, email or visit the New York office. To discuss a file, apply online."
  />

  <section class="section bg-white" aria-labelledby="contact-details-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="bx-full">
          <Eyebrow>Contact</Eyebrow>
          <h2 id="contact-details-heading" class="mt-4">Details</h2>
        </div>
        <div class="bx-span-4 bx-lg-span-12">
          <ContactPoints />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="contact-apply-heading">
    <div class="container-site">
      <div class="bx-grid items-center">
        <div class="bx-span-4 bx-lg-span-6">
          <ImageSlot intent="map of Lower Manhattan around 11 Broadway" ratio="16 / 9" />
        </div>
        <div class="bx-span-4 bx-lg-span-5 bx-lg-start-8">
          <Eyebrow>Application</Eyebrow>
          <h2 id="contact-apply-heading" class="mt-4">Apply</h2>
          <p class="section-lead mt-5">
            One short application. A specialist reviews your file promptly. Many products fund within 24-48 hours of approval.
          </p>
          <a href="/apply" class="btn-primary mt-6">Get Funding Today</a>
          <p class="mt-6">
            <ContactLine icon="phone" href={SITE.phones.direct.href}>
              {SITE.phones.direct.display}
            </ContactLine>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
