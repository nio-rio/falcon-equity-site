---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ContactPoints from '@/components/ContactPoints.astro';
import ContactLine from '@/components/ContactLine.astro';
import Media from '@/components/Media.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import ArrowCta from '@/components/ArrowCta.astro';
import { SITE } from '@/data/site';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact' },
];
---

<BaseLayout
  title="Contact Us"
  description="Contact Falcon Equity Group at 11 Broadway Suite 615, New York, NY. Call +1 (917) 245-5277 or email information@falconequity.ai to reach the office."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Contact"
    lead="Call, email or visit the New York office. To discuss a file, apply online."
  />

  <section class="section bg-white" aria-labelledby="contact-details-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="section-head bx-span-4 bx-lg-span-10">
          <Eyebrow>Contact</Eyebrow>
          <h2 id="contact-details-heading">Details</h2>
        </div>
        <div class="bx-full">
          <ContactPoints />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="contact-apply-heading">
    <div class="container-site">
      <div class="bx-grid items-center">
        <div class="bx-span-4 bx-lg-span-6">
          <Media labeled intent="map of Lower Manhattan around 11 Broadway" ratio="16 / 9" />
        </div>
        <div class="section-stack bx-span-4 bx-lg-span-5 bx-lg-start-8">
          <div class="section-head">
            <Eyebrow>Application</Eyebrow>
            <h2 id="contact-apply-heading">Apply</h2>
          </div>
          <div class="section-body">
            <p>
              One short application. A specialist reviews your file promptly. Many products fund within 24-48 hours of approval.
            </p>
            <div class="mt-6">
              <ArrowCta href="/apply" label="Get Funding Today" />
            </div>
            <p class="mt-6">
              <ContactLine icon="phone" href={SITE.phones.direct.href}>
                {SITE.phones.direct.display}
              </ContactLine>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
