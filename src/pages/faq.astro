---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import FaqList from '@/components/FaqList.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import { FAQS } from '@/data/content';
import { SERVICES } from '@/data/services';
import { breadcrumbSchema, faqSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: '/faq' },
];
const productFaqs = SERVICES.map((s) => ({ service: s, faqs: s.faqs }));
---

<BaseLayout
  title="FAQ"
  description="Answers about Falcon Equity Group business funding: speed, requirements, credit, consolidation and each product."
  schema={[breadcrumbSchema(crumbs), faqSchema(FAQS)]}
>
  <PageHero title="FAQ" lead="General questions first, then by product." />

  <section class="section bg-white" aria-labelledby="general-faq-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="section-head bx-span-4 bx-lg-span-10">
          <Eyebrow>FAQ</Eyebrow>
          <h2 id="general-faq-heading">General</h2>
        </div>
        <div class="section-body bx-span-4 bx-lg-span-6 bx-lg-start-7">
          <FaqList faqs={FAQS} idPrefix="general" />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="product-faq-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="section-head bx-span-4 bx-lg-span-10">
          <Eyebrow>Products</Eyebrow>
          <h2 id="product-faq-heading">By product</h2>
        </div>
        <div class="section-body bx-span-4 bx-lg-span-6 bx-lg-start-7 space-y-12">
          {
            productFaqs.map(({ service, faqs }) => (
              <div>
                <h3>
                  <a href={`/services/${service.slug}`} class="hover:underline">
                    {service.name}
                  </a>
                </h3>
                <div class="mt-5">
                  <FaqList faqs={faqs} idPrefix={service.slug} />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
