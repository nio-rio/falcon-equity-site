---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import { FAQS } from '@/data/content';
import { SERVICES } from '@/data/services';
import { breadcrumbSchema, faqSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: '/faq' },
];
const productFaqs = SERVICES.map((s) => ({ service: s, faqs: s.faqs }));
---

<BaseLayout
  title="FAQ"
  description="Answers about Falcon Equity Group business funding: speed, requirements, credit, consolidation and each product."
  schema={[breadcrumbSchema(crumbs), faqSchema(FAQS)]}
>
  <PageHero title="FAQ" lead="General questions first, then by product." />

  <section class="section bg-white" aria-labelledby="general-faq-heading">
    <div class="container-site max-w-4xl">
      <h2 id="general-faq-heading">General</h2>
      <div class="mt-8"><FaqList faqs={FAQS} /></div>
    </div>
  </section>

  <section class="section bg-tint" aria-labelledby="product-faq-heading">
    <div class="container-site max-w-4xl">
      <h2 id="product-faq-heading">By product</h2>
      <div class="mt-8 space-y-12">
        {
          productFaqs.map(({ service, faqs }) => (
            <div>
              <h3>
                <a href={`/services/${service.slug}`} class="hover:underline">
                  {service.name}
                </a>
              </h3>
              <div class="mt-5">
                <FaqList faqs={faqs} />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
