---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PilotPageHero from '@/components/pilot/PilotPageHero.astro';
import PilotAnswer from '@/components/pilot/PilotAnswer.astro';
import PilotIntent from '@/components/pilot/PilotIntent.astro';
import PilotProcess from '@/components/pilot/PilotProcess.astro';
import PilotDocs from '@/components/pilot/PilotDocs.astro';
import PilotQualify from '@/components/pilot/PilotQualify.astro';
import PilotEyebrow from '@/components/pilot/PilotEyebrow.astro';
import PilotAccordion from '@/components/pilot/PilotAccordion.astro';
import PilotTrust from '@/components/pilot/PilotTrust.astro';
import { WHEN_TO_APPLY } from '@/data/content';
import { PAGE_DISCLOSURE } from '@/data/disclosure';
import { STANDARD_STEPS } from '@/data/services';
import { breadcrumbSchema } from '@/lib/schema';
import '@/styles/pilot.css';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'How it works', path: '/how-it-works' },
];

const faqs = [
  {
    q: 'How long does approval take?',
    a: 'Decisions usually move within hours once a file is complete. Many products fund within 24-48 hours of approval, and real-estate secured loans typically take longer. Approval is not guaranteed.',
  },
  {
    q: 'Do I apply separately for each product?',
    a: 'No. One application covers the file, and your specialist recommends the product that fits — a line of credit for a repeating gap, an advance for speed, an asset loan for equipment.',
  },
  {
    q: 'Will applying affect my credit?',
    a: 'Ask your specialist how your file will be reviewed before any credit check is run. The process is explained up front.',
  },
  {
    q: 'What if I already have advances open?',
    a: 'List each lender, amount, date and remaining balance. [Consolidation of Positions](/services/consolidation-of-positions) can combine several positions into one payment; the [stacked advances guide](/blog/consolidation-of-positions-stacked-advances) explains the trade-offs.',
  },
  {
    q: 'What if I am earlier than three months in business?',
    a: 'Most products need operating history. [Credit Repair & Loan Prep](/resources/credit-repair-loan-prep) exists to get a thinner file ready before an application.',
  },
  {
    q: 'What happens after I sign?',
    a: 'Funds are sent to the business account confirmed on your voided check. Your agreement sets the repayment schedule, and one specialist stays with the file if anything needs adjusting afterwards.',
  },
  {
    q: 'Are there industries or states you cannot fund?',
    a: 'No. Falcon keeps no restricted-industry or restricted-state list, so an application is judged on the business rather than its sector or location. Underwriting and approval still apply.',
  },
  {
    q: 'What does it cost?',
    a: 'Falcon charges a 0% agreement fee. Any product-specific cost is set out in your agreement before you sign, and no specific rate is published on this site.',
  },
];
---

<BaseLayout
  title="How it works"
  description="How Falcon Equity Group reviews a business funding application, from the documents we ask for through underwriting, and how approved files are funded."
  schema={[breadcrumbSchema(crumbs)]}
  disclosure={PAGE_DISCLOSURE}
>
  <PilotPageHero
    title="How it works"
    lead="One short application. A specialist reviews your file. Funds can land within 24-48 hours of approval."
    intent="Desk with a closed folder and a calculator, natural light."
    imageAlt="Desk with a closed folder and a calculator, natural light."
    ctaHref="/apply"
    ctaLabel="Start an application"
  />

  <PilotAnswer
    answer="You apply once, online, with six months of business bank statements and basic business details. A funding specialist reviews the file, asks for anything missing and walks you through the products that fit. Once approved and signed, many products fund within 24-48 hours."
    takeaways={[
      'One application covers all seven products; you do not apply to each separately.',
      'A specialist reads the file and matches the product to the use of proceeds.',
      'Have six months of statements, photo ID, a voided check and a debt schedule ready.',
      'Approval is never guaranteed, and timing depends on how fast documents arrive.',
    ]}
  />

  <PilotIntent
    title="What do you need the funding for?"
    lead="The use of proceeds decides the product more often than the amount does. Pick the closest match."
    items={[
      {
        title: WHEN_TO_APPLY[0].title,
        body: WHEN_TO_APPLY[0].body,
        hint: 'Usually a term loan or a line of credit.',
        href: '/services/business-term-loan',
      },
      {
        title: WHEN_TO_APPLY[1].title,
        body: WHEN_TO_APPLY[1].body,
        hint: 'Usually a line of credit.',
        href: '/services/business-line-of-credit',
      },
      {
        title: WHEN_TO_APPLY[2].title,
        body: WHEN_TO_APPLY[2].body,
        hint: 'Often an advance or a line of credit.',
        href: '/services/merchant-cash-advance',
      },
      {
        title: WHEN_TO_APPLY[3].title,
        body: WHEN_TO_APPLY[3].body,
        hint: 'Usually a line of credit.',
        href: '/services/business-line-of-credit',
      },
    ]}
  />

  <PilotProcess
    title="How you get approved."
    steps={[
      {
        title: STANDARD_STEPS[0].title,
        body: STANDARD_STEPS[0].body,
        note: 'Takes about ten minutes with the four documents below to hand.',
      },
      {
        title: STANDARD_STEPS[1].title,
        body: STANDARD_STEPS[1].body,
        note: 'You get a call about which product fits, at what amount, and on what terms.',
      },
      {
        title: STANDARD_STEPS[2].title,
        body: STANDARD_STEPS[2].body,
        note: 'You sign once, and funds go to the business account named on your voided check.',
      },
    ]}
  />

  <PilotDocs
    title="What do you need to apply?"
    lead="Four documents cover most files. Some products ask for one more."
    items={[
      {
        title: 'Six months of business bank statements',
        body: 'Complete PDFs from the business account, not screenshots or partial months.',
      },
      {
        title: 'A government-issued photo ID',
        body: 'For the owner or signing officer on the application.',
      },
      {
        title: 'A voided check from the business account',
        body: 'This confirms the account that would receive funds.',
      },
      {
        title: 'A debt schedule',
        body: 'Each open advance or loan with lender, amount, date and remaining balance.',
      },
    ]}
    also="Also requested by some products: an equipment quote or invoice for asset-backed funding, or a list of open invoices for factoring."
    extra="The application also asks about: bankruptcy and tax liens, prior advances, ownership percentage and co-borrowers. Answering fully is what keeps a file moving."
  />

  <PilotQualify
    title="Who does Falcon fund?"
    cells={[
      { value: '3+ months; most products start at 3–6 months', label: 'Time in business' },
      { value: '$10K+ in consistent deposits', label: 'Monthly revenue' },
      { value: '550+ for term loans and consolidation; revenue-based products weigh credit less', label: 'Credit' },
      { value: 'Six months, complete PDFs', label: 'Bank statements' },
    ]}
    lookAt="What we look at, in plain terms: how long you have been operating, what lands in the business account each month, whether deposits are steady or lumpy, any open advances and their payment schedule, and — for loan products — credit."
    note={[
      'These are published criteria, not a promise. Final decisions are made in underwriting and approval is never guaranteed.',
      'No restricted industries or states: Falcon has no restricted-industry or restricted-state list. Underwriting looks at the business, not the geography.',
    ]}
  />

  <section class="pilot-section" aria-labelledby="hiw-faq-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="pilot-section-head bx-span-4 bx-md-full bx-lg-span-10">
          <PilotEyebrow>FAQ</PilotEyebrow>
          <h2 id="hiw-faq-heading">Application questions</h2>
        </div>
        <div class="pilot-section-body bx-span-4 bx-lg-span-6 bx-lg-start-7">
          <PilotAccordion items={faqs} idPrefix="hiw-faq" />
        </div>
      </div>
    </div>
  </section>

  <PilotTrust human="A specialist, not a call queue. Call the direct line and ask for the funding desk." />
</BaseLayout>
