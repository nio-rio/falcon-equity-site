---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PilotHero from '@/components/pilot/PilotHero.astro';
import PilotStats from '@/components/pilot/PilotStats.astro';
import PilotLinkList from '@/components/pilot/PilotLinkList.astro';
import PilotTestimonial from '@/components/pilot/PilotTestimonial.astro';
import PilotIndustryTabs from '@/components/pilot/PilotIndustryTabs.astro';
import PilotNews from '@/components/pilot/PilotNews.astro';
import { getHomeServices } from '@/data/services';
import { STATS } from '@/data/site';
import { getPublicPosts } from '@/lib/blog';
import heroFalcon from '@/assets/images/hero-falcon.png';
import '@/styles/pilot.css';

const homeServices = getHomeServices();
const published = await getPublicPosts();
const insightIds = [
  '24-48-hour-funding-checklist',
  'merchant-cash-advance-vs-business-term-loan',
  'bridging-a-slow-season',
];
const insights = insightIds
  .map((id) => published.find((post) => post.id === id))
  .filter((post): post is (typeof published)[number] => Boolean(post));

const fundingTime = STATS.find((s) => s.label === 'Average funding time')!;
const deployed = STATS.find((s) => s.label === 'Funding deployed')!;
const approval = STATS.find((s) => s.label === 'Approval for qualified applicants')!;
---

<BaseLayout description="Business funding from New York City. Merchant cash advances, lines of credit, term loans, invoice factoring and consolidation, with funding in as little as 24-48 hours.">
  <PilotHero
    line1="Fuel Success with"
    line2="Fast Funding"
    aside="Unlock rapid financial solutions tailored to your business needs."
    captionTitle="Apply to get same-day funding"
    captionBody="One short application. A specialist reviews your file promptly. Many products fund within 24-48 hours of approval."
    captionHref="/apply"
    captionLabel="Apply for funding"
    image={heroFalcon}
    imageAlt="Peregrine falcon in profile"
  />

  <PilotStats
    featured={{ label: deployed.label, value: deployed.value }}
    side={[
      { label: fundingTime.label, value: fundingTime.value },
      { label: approval.label, value: approval.value },
    ]}
  />

  <PilotLinkList
    eyebrow="Services"
    title="How we can bring you victory."
    items={homeServices.map((s) => ({
      href: s.href,
      name: s.name,
      teaser: s.teaser,
      rangeLine: s.rangeLine,
    }))}
  />

  <PilotTestimonial />

  <PilotIndustryTabs />

  <PilotNews posts={insights} />
</BaseLayout>
