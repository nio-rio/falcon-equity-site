---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Media from '@/components/Media.astro';
import StatsBar from '@/components/StatsBar.astro';
import CtaBand from '@/components/CtaBand.astro';
import Testimonials from '@/components/Testimonials.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import ArrowCta from '@/components/ArrowCta.astro';
import CircleArrow from '@/components/CircleArrow.astro';
import { getHomeServices, STANDARD_STEPS } from '@/data/services';
import heroFalcon from '@/assets/images/hero-falcon.jpg';

const homeServices = getHomeServices();
---

<BaseLayout description="Business funding from New York City. Merchant cash advances, lines of credit, term loans, invoice factoring and consolidation, with funding in as little as 24-48 hours.">
  <section class="home-hero on-dark" aria-labelledby="hero-heading">
    <div class="container-site">
      <div class="bx-grid home-hero-top">
        <h1 id="hero-heading" class="bx-span-4 bx-lg-span-7">
          <span class="home-hero-line1">Fuel success with</span>
          <span class="home-hero-line2">fast funding</span>
        </h1>
        <p class="home-hero-aside bx-span-4 bx-lg-span-4 bx-lg-start-9">We move at your pace.</p>
      </div>
      <div class="home-hero-media bx-full">
        <Media
          image={heroFalcon}
          alt="A peregrine falcon launching from a branch with its wings spread wide"
          intent="peregrine falcon launching from a branch"
          ratio="16 / 9"
          sizes="100vw"
          priority
        />
      </div>
      <div class="bx-grid home-hero-below">
        <div class="section-head bx-span-4 bx-lg-span-10">
          <h2>Apply to get same-day funding</h2>
        </div>
        <div class="section-body home-hero-below-copy bx-span-4 bx-lg-span-6 bx-lg-start-7">
          <p>One short application. A specialist reviews your file promptly. Many products fund within 24-48 hours of approval.</p>
          <div class="section-cta">
            <ArrowCta href="/apply" label="Learn more" tone="light" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <StatsBar />

  <section class="section bg-tint" aria-labelledby="services-heading" id="services">
    <div class="container-site">
      <div class="bx-grid">
        <div class="section-head bx-span-4 bx-lg-span-10">
          <Eyebrow>Services</Eyebrow>
          <h2 id="services-heading">How we can bring you victory.</h2>
        </div>
        <div class="section-body bx-span-4 bx-lg-span-6 bx-lg-start-7">
          <ul class="explore-list">
            {
              homeServices.map((s) => (
                <li>
                  <a class="explore-row" href={s.href}>
                    <span class="explore-row-copy">
                      <span class="explore-row-title">{s.name}</span>
                      <span class="explore-row-meta">{s.rangeLine}</span>
                    </span>
                    <CircleArrow />
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="section-cta">
            <ArrowCta href="/services" label="Learn more" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <Testimonials />

  <section class="section bg-tint" aria-labelledby="process-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="section-head bx-span-4 bx-lg-span-10">
          <Eyebrow>Process</Eyebrow>
          <h2 id="process-heading">How you get approved.</h2>
        </div>
        {
          STANDARD_STEPS.map((step, i) => (
            <div class="bx-span-4 bx-lg-span-4">
              <p class="process-num">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="process-title">{step.title}</h3>
              <p class="process-body">{step.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
