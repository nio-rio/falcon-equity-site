---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import FlightPathCard from '@/components/FlightPathCard.astro';
import StatsBar from '@/components/StatsBar.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import { SERVICES } from '@/data/services';
import { INDUSTRIES } from '@/data/industries';
import { CLIENT_STORIES, FAQS, HOW_IT_WORKS, QUALIFY, WHEN_TO_APPLY, WHY_FALCON } from '@/data/content';
import { PRIMARY_PHONE } from '@/data/site';
import { faqSchema } from '@/lib/schema';
import heroFalcon from '@/assets/images/hero-falcon.jpg';

const homeFaqs = FAQS.slice(0, 6);
---

<BaseLayout
  description="Fast business funding from New York City. Merchant cash advances, lines of credit, term loans, invoice factoring and consolidation, with funding in as little as 24–48 hours."
  schema={[faqSchema(homeFaqs)]}
>
  <!-- 1. Hero -->
  <section class="on-dark relative isolate overflow-hidden bg-brand-darker text-white" aria-labelledby="hero-heading">
    <div class="absolute inset-y-0 right-0 -z-10 w-full lg:w-[58%]">
      <Image
        src={heroFalcon}
        alt="A peregrine falcon launching from a branch with its wings spread wide"
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 1024px) 58vw, 100vw"
        class="hero-img h-full w-full object-cover object-[60%_35%]"
        priority
      />
      <div
        class="absolute inset-0 bg-gradient-to-r from-brand-darker via-brand-darker/75 to-brand/30 mix-blend-normal lg:via-brand-darker/40"
        aria-hidden="true"
      >
      </div>
      <div class="absolute inset-0 bg-brand/35 mix-blend-multiply" aria-hidden="true"></div>
      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-brand-darker to-transparent" aria-hidden="true"></div>
    </div>

    <div class="container-site grid items-center gap-12 pt-16 pb-20 sm:pt-24 lg:grid-cols-12 lg:pt-28 lg:pb-28">
      <div class="lg:col-span-7">
        <p class="eyebrow animate-rise text-lilac-deep">Fast business funding · New York City</p>
        <h1 id="hero-heading" class="animate-rise mt-4 text-5xl leading-[1.02] font-semibold sm:text-7xl">
          Capital for businesses that <em class="text-lilac-deep not-italic">play to win.</em>
        </h1>
        <p class="animate-rise mt-6 max-w-xl text-lg leading-relaxed text-lilac-200 sm:text-xl [animation-delay:120ms]">
          See the opportunity. Strike first. Get $5,000 to $5,000,000 in funding, often in as little as 24–48 hours.
        </p>
        <div class="animate-rise mt-9 flex flex-col gap-3 sm:flex-row [animation-delay:200ms]">
          <a href="/apply" class="btn-accent px-8! py-4! text-lg!">Apply Now <Icon name="arrow-right" size={20} /></a>
          <a href={PRIMARY_PHONE.href} class="btn-outline-light px-8! py-4! text-lg!">
            <Icon name="phone" size={20} /> {PRIMARY_PHONE.display}
          </a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-lilac-200">
          <li class="flex items-center gap-2"><Icon name="check" size={16} class="text-lilac-deep" /> Same-day approvals</li>
          <li class="flex items-center gap-2"><Icon name="check" size={16} class="text-lilac-deep" /> Seven funding products</li>
          <li class="flex items-center gap-2"><Icon name="check" size={16} class="text-lilac-deep" /> Dedicated specialist</li>
        </ul>
      </div>
      <div class="animate-dive flex justify-center lg:col-span-5 lg:justify-end [animation-delay:250ms]">
        <FlightPathCard />
      </div>
    </div>
  </section>

  <!-- 2. Stats -->
  <StatsBar />

  <!-- 3. Why Falcon -->
  <section class="bg-white py-20 sm:py-24" aria-labelledby="why-heading">
    <div class="container-site">
      <SectionHeading
        id="why-heading"
        eyebrow="Why Falcon"
        title="Built for speed. Engineered to win."
        lead="The falcon is the fastest hunter on earth. It sees the opportunity first and strikes with precision. That is how we fund."
      />
      <ul class="mt-12 grid gap-px overflow-hidden rounded-3xl border border-lilac-200 bg-lilac-200 sm:grid-cols-2 lg:grid-cols-3">
        {
          WHY_FALCON.map((w) => (
            <li class="bg-white p-7">
              <Icon name={w.icon} class="text-brand" size={28} />
              <h3 class="mt-4 font-sans text-lg font-semibold text-ink">{w.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">{w.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. How it works -->
  <section class="bg-lilac py-20 sm:py-24" aria-labelledby="how-heading">
    <div class="container-site">
      <SectionHeading id="how-heading" eyebrow="How it works" title="Three moves to your next win." align="center" />
      <ol class="mt-14 grid gap-6 md:grid-cols-3">
        {
          HOW_IT_WORKS.map((step, i) => (
            <li class="card relative">
              <span class="font-serif text-5xl font-semibold text-lilac-deep" aria-hidden="true">
                0{i + 1}
              </span>
              <h3 class="mt-3 text-2xl font-semibold text-brand">
                <span class="sr-only">Step {i + 1}: </span>
                {step.title}
              </h3>
              <p class="mt-3 leading-relaxed text-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="mt-10 text-center">
        <a href="/apply" class="btn-primary">Start your application <Icon name="arrow-right" size={18} /></a>
      </div>
    </div>
  </section>

  <!-- 5. Do you qualify -->
  <section class="bg-white py-20 sm:py-24" aria-labelledby="qualify-heading">
    <div class="container-site grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-4">
        <SectionHeading
          id="qualify-heading"
          eyebrow="Do you qualify?"
          title="Ready to win? Here’s what it takes."
          lead="Most Falcon products start with these four basics. Requirements vary by product, and every file gets a real review."
        />
        <a href="/apply" class="btn-primary mt-8">Check in 60 seconds <Icon name="arrow-right" size={18} /></a>
      </div>
      <ul class="grid gap-5 sm:grid-cols-2 lg:col-span-8">
        {
          QUALIFY.map((q) => (
            <li class="card">
              <div class="flex items-center justify-between">
                <span class="grid h-11 w-11 place-items-center rounded-2xl bg-lilac text-brand">
                  <Icon name={q.icon} />
                </span>
                <span class="rounded-full bg-brand px-3 py-1 text-sm font-semibold text-white">{q.value}</span>
              </div>
              <h3 class="mt-5 font-sans text-lg font-semibold text-ink">{q.title}</h3>
              <p class="mt-1.5 text-[15px] text-muted">{q.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 6. When should you apply -->
  <section class="on-dark bg-brand-dark py-20 text-white sm:py-24" aria-labelledby="when-heading">
    <div class="container-site">
      <SectionHeading
        id="when-heading"
        eyebrow="When should you apply?"
        title="Win the next move. We’ll fund it."
        tone="dark"
      />
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          WHEN_TO_APPLY.map((w) => (
            <li class="rounded-3xl border border-white/10 bg-white/5 p-7">
              <Icon name={w.icon} class="text-lilac-deep" size={28} />
              <h3 class="mt-5 text-xl font-semibold">{w.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-lilac-200">{w.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 7. Funding options -->
  <section class="bg-lilac py-20 sm:py-24" aria-labelledby="services-heading" id="services">
    <div class="container-site">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading
          id="services-heading"
          eyebrow="Funding options"
          title="Your winning lineup."
          lead="Seven ways to fund your business, each matched to a different kind of move."
        />
        <a href="/services" class="btn-outline-dark shrink-0">Compare all options</a>
      </div>
      <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          SERVICES.map((s, i) => (
            <li class:list={[i === SERVICES.length - 1 && 'lg:col-span-3 lg:[&>article]:max-w-none']}>
              <ServiceCard service={s} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 8. Industries -->
  <section class="bg-white py-20 sm:py-24" aria-labelledby="industries-heading">
    <div class="container-site">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading
          id="industries-heading"
          eyebrow="Industries"
          title="Built to win in your industry."
          lead="We fund businesses across virtually every sector. Here are twelve we know especially well."
        />
        <a href="/industries" class="btn-outline-dark shrink-0">Explore industries</a>
      </div>
      <ul class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {
          INDUSTRIES.map((ind) => (
            <li class="flex items-center gap-3 rounded-2xl border border-lilac-200 p-4 sm:p-5">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-lilac text-brand">
                <Icon name={ind.icon} size={20} />
              </span>
              <span class="text-[15px] leading-snug font-semibold text-ink">{ind.name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 9. Client stories -->
  <section class="bg-lilac py-20 sm:py-24" aria-labelledby="stories-heading">
    <div class="container-site">
      <SectionHeading
        id="stories-heading"
        eyebrow="Client wins"
        title="How Falcon funding can play out."
        lead="These are illustrative examples based on common situations in each industry. They are not real client testimonials."
      />
      <ul class="mt-12 grid gap-6 lg:grid-cols-3">
        {
          CLIENT_STORIES.map((s) => (
            <li class="card flex flex-col">
              <p class="inline-flex w-fit items-center gap-1.5 rounded-full bg-lilac px-3 py-1 text-xs font-semibold text-brand">
                Illustrative example
              </p>
              <h3 class="mt-4 text-xl leading-snug font-semibold text-brand">{s.title}</h3>
              <p class="mt-3 flex-1 leading-relaxed text-muted">{s.body}</p>
              <p class="mt-6 border-t border-lilac-200 pt-4 text-sm text-muted">
                {s.industry} · <span class="font-semibold text-ink">{s.product}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 10. FAQ -->
  <section class="bg-white py-20 sm:py-24" aria-labelledby="faq-heading">
    <div class="container-site grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading id="faq-heading" eyebrow="FAQ" title="Straight answers, fast." />
        <a href="/faq" class="link mt-6 inline-block">See all FAQs</a>
      </div>
      <div class="lg:col-span-8">
        <FaqList faqs={homeFaqs} />
      </div>
    </div>
  </section>

  <!-- 11. Final CTA -->
  <CtaBand />
</BaseLayout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-img {
      animation: hero-in 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
    @keyframes hero-in {
      from {
        transform: scale(1.08) translateY(-12px);
        opacity: 0.4;
      }
      to {
        transform: none;
        opacity: 1;
      }
    }
  }
</style>
