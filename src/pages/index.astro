---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StatsBar from '@/components/StatsBar.astro';
import CtaBand from '@/components/CtaBand.astro';
import Testimonials from '@/components/Testimonials.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import ArrowCta from '@/components/ArrowCta.astro';
import CircleArrow from '@/components/CircleArrow.astro';
import { getHomeServices, STANDARD_STEPS } from '@/data/services';
import heroFalcon from '@/assets/images/hero-falcon.jpg';

const homeServices = getHomeServices();
---

<BaseLayout description="Business funding from New York City. Merchant cash advances, lines of credit, term loans, invoice factoring and consolidation, with funding in as little as 24-48 hours.">
  <section class="home-hero on-dark" aria-labelledby="hero-heading">
    <div class="container-site">
      <div class="bx-grid home-hero-top">
        <h1 id="hero-heading" class="bx-span-4 lg:bx-span-7">
          Fuel success
          <span class="home-hero-line2">with fast funding</span>
        </h1>
        <p class="home-hero-aside bx-span-4 lg:bx-span-4 lg:bx-start-9">We move at your pace.</p>
      </div>
      <div class="home-hero-media bx-full">
        <Image
          src={heroFalcon}
          alt="A peregrine falcon launching from a branch with its wings spread wide"
          widths={[640, 960, 1280, 1920, 2400]}
          sizes="100vw"
          class="h-full w-full object-cover object-[60%_30%]"
          priority
        />
      </div>
      <div class="bx-grid home-hero-below">
        <h2 class="bx-span-4 lg:bx-span-6">Apply to get same-day funding</h2>
        <div class="home-hero-below-copy bx-span-4 lg:bx-span-5 lg:bx-start-8">
          <p>One short application. A specialist reviews your file promptly. Many products fund within 24-48 hours of approval.</p>
          <ArrowCta href="/apply" label="Learn more" tone="light" />
        </div>
      </div>
    </div>
  </section>

  <StatsBar />

  <section class="section bg-tint" aria-labelledby="services-heading" id="services">
    <div class="container-site">
      <div class="bx-grid">
        <div class="bx-span-4 lg:bx-span-5">
          <Eyebrow>Services</Eyebrow>
          <h2 id="services-heading" class="mt-4">How we can bring you victory.</h2>
        </div>
        <ul class="explore-list bx-span-4 lg:bx-span-6 lg:bx-start-7">
          {
            homeServices.map((s) => (
              <li>
                <a class="explore-row" href={s.href}>
                  <span class="explore-row-copy">
                    <span class="explore-row-title">{s.name}</span>
                    <span class="explore-row-meta">{s.rangeLine}</span>
                  </span>
                  <CircleArrow />
                </a>
              </li>
            ))
          }
        </ul>
        <div class="bx-span-4 lg:bx-span-4 lg:bx-start-2">
          <ArrowCta href="/services" label="Learn more" />
        </div>
      </div>
    </div>
  </section>

  <Testimonials />

  <section class="section bg-tint" aria-labelledby="process-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="bx-span-4 lg:bx-span-6">
          <Eyebrow>Process</Eyebrow>
          <h2 id="process-heading" class="mt-4">How you get approved.</h2>
        </div>
        {
          STANDARD_STEPS.map((step, i) => (
            <div class="bx-span-4 lg:bx-span-4">
              <p class="process-num">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-4">{step.title}</h3>
              <p class="mt-3 text-ink-soft">{step.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .process-num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    font-weight: 300;
    color: var(--color-muted);
  }
</style>
