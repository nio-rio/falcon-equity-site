---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StatsBar from '@/components/StatsBar.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import Testimonials from '@/components/Testimonials.astro';
import { getHomeServices, STANDARD_STEPS } from '@/data/services';
import { PRIMARY_PHONE } from '@/data/site';
import Icon from '@/components/Icon.astro';
import heroFalcon from '@/assets/images/hero-falcon.jpg';

const homeServices = getHomeServices();
---

<BaseLayout description="Business funding from New York City. Merchant cash advances, lines of credit, term loans, invoice factoring and consolidation, with funding in as little as 24-48 hours.">
  <section class="home-hero on-dark" aria-labelledby="hero-heading">
    <div class="home-hero-media">
      <Image
        src={heroFalcon}
        alt="A peregrine falcon launching from a branch with its wings spread wide"
        widths={[640, 960, 1280, 1920, 2400]}
        sizes="100vw"
        class="absolute inset-0 h-full w-full object-cover object-[60%_30%]"
        priority
      />
      <div class="absolute inset-0 bg-black/45" aria-hidden="true"></div>
    </div>
    <div class="home-hero-copy">
      <div class="container-site">
        <h1 id="hero-heading">Fuel success with fast funding</h1>
        <p class="lead">
          We move at your pace. One short application. A specialist reviews your file promptly. Many products fund within 24-48 hours of approval.
        </p>
        <div class="mt-6">
          <a href="/apply" class="btn-on-dark">Apply to get same-day funding</a>
          <a href={PRIMARY_PHONE.href} class="ml-5 inline-flex items-center gap-2 text-base text-white/90 underline-offset-4 hover:underline">
            <Icon name="phone" size={16} />
            {PRIMARY_PHONE.display}
          </a>
        </div>
      </div>
    </div>
  </section>

  <StatsBar />

  <section class="section bg-tint" aria-labelledby="services-heading" id="services">
    <div class="container-site">
      <SectionHeading id="services-heading" title="Our services" />
      <ul class="bento-grid">
        {
          homeServices.map((s) => (
            <li class={`bento-cell bento-cell--${s.area}`}>
              <ServiceCard href={s.href} name={s.name} teaser={s.teaser} rangeLine={s.rangeLine} featured={s.featured} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Testimonials />

  <section class="section bg-tint" aria-labelledby="process-heading">
    <div class="container-site">
      <SectionHeading id="process-heading" title="How a file moves." />
      <ol class="process-grid">
        {
          STANDARD_STEPS.map((step, i) => (
            <li class="process-card">
              <p class="process-num">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-4">{step.title}</h3>
              <p class="mt-3 text-ink-soft">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
  }

  .bento-cell {
    display: flex;
    min-width: 0;
  }

  .bento-cell :global(.bento-card) {
    width: 100%;
  }

  @media (min-width: 768px) {
    .bento-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }

    .bento-cell--f1,
    .bento-cell--f2 {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-template-areas:
        'f1 f1 a'
        'b c d'
        'e f2 f2';
    }

    .bento-cell--f1 {
      grid-area: f1;
    }
    .bento-cell--a {
      grid-area: a;
    }
    .bento-cell--b {
      grid-area: b;
    }
    .bento-cell--c {
      grid-area: c;
    }
    .bento-cell--d {
      grid-area: d;
    }
    .bento-cell--e {
      grid-area: e;
    }
    .bento-cell--f2 {
      grid-area: f2;
    }
  }

  .process-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    list-style: none;
    margin-top: 3rem;
    padding: 0;
  }

  @media (min-width: 768px) {
    .process-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .process-card {
    background: #fff;
    padding: 2rem;
  }

  .process-num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    font-weight: 300;
    color: var(--color-muted);
  }
</style>

