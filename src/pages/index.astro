---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StatsBar from '@/components/StatsBar.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceBlock from '@/components/ServiceBlock.astro';
import ImageSlot from '@/components/ImageSlot.astro';
import CtaBand from '@/components/CtaBand.astro';
import { SERVICES } from '@/data/services';
import { CLIENT_STORIES, HOW_IT_WORKS } from '@/data/content';
import { PRIMARY_PHONE } from '@/data/site';
import Icon from '@/components/Icon.astro';
import heroFalcon from '@/assets/images/hero-falcon.jpg';

const storyImages = [
  'auto parts counter, daylight, empty of people',
  'open agricultural yard, late afternoon',
  'landscaping equipment in a yard, morning',
];
---

<BaseLayout description="Business funding from New York City. Merchant cash advances, lines of credit, term loans, invoice factoring and consolidation, with funding in as little as 24-48 hours.">
  <section class="home-hero on-dark" aria-labelledby="hero-heading">
    <div class="home-hero-media">
      <Image
        src={heroFalcon}
        alt="A peregrine falcon launching from a branch with its wings spread wide"
        widths={[640, 960, 1280, 1920, 2400]}
        sizes="100vw"
        class="absolute inset-0 h-full w-full object-cover object-[60%_30%]"
        priority
      />
      <div class="absolute inset-0 bg-black/45" aria-hidden="true"></div>
    </div>
    <div class="home-hero-copy">
      <div class="container-site">
        <h1 id="hero-heading">Capital for businesses that play to win.</h1>
        <p class="lead">
          Capital from $5,000 to $20,000,000. Many products fund within 24-48 hours of approval.
        </p>
        <div class="mt-6">
          <a href="/apply" class="btn-on-dark">Apply</a>
          <a href={PRIMARY_PHONE.href} class="ml-5 inline-flex items-center gap-2 text-base text-white/90 underline-offset-4 hover:underline">
            <Icon name="phone" size={16} />
            {PRIMARY_PHONE.display}
          </a>
        </div>
      </div>
    </div>
  </section>

  <StatsBar />

  <section class="section bg-white" aria-labelledby="services-heading" id="services">
    <div class="container-site">
      <SectionHeading id="services-heading" title="Our services" />
      <div class="mt-12 max-w-4xl">
        {SERVICES.map((s) => <ServiceBlock service={s} />)}
      </div>
    </div>
  </section>

  <section class="section bg-tint" aria-labelledby="how-heading">
    <div class="container-site grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <ImageSlot intent="specialist reviewing a file at a desk, warm light" ratio="4 / 5" />
      </div>
      <div class="lg:col-span-7">
        <SectionHeading
          id="how-heading"
          eyebrow="Process"
          title="How a file moves."
          lead="The same sequence for every product."
        />
        <ol class="mt-10 grid gap-8">
          {
            HOW_IT_WORKS.map((step, i) => (
              <li>
                <h3>
                  <span class="sr-only">Step {i + 1}: </span>
                  {step.title}
                </h3>
                <p class="mt-2 text-ink-soft">{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="stories-heading">
    <div class="container-site">
      <SectionHeading
        id="stories-heading"
        eyebrow="Illustrative examples"
        title="Situations owners bring to Falcon."
        lead="Generic situations. Not real clients or results."
      />
      <ul class="mt-12 grid gap-10 lg:grid-cols-3">
        {
          CLIENT_STORIES.map((s, i) => (
            <li>
              <ImageSlot intent={storyImages[i] ?? 'empty storefront, daylight'} ratio="16 / 9" />
              <h3 class="mt-6">{s.title}</h3>
              <p class="mt-3 text-ink-soft">{s.body}</p>
              <p class="mt-4 text-sm text-muted">
                {s.industry} · <span class="text-ink">{s.product}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
