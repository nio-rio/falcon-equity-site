---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StatsBar from '@/components/StatsBar.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import { SERVICES } from '@/data/services';
import { CLIENT_STORIES, HOW_IT_WORKS } from '@/data/content';
import { PRIMARY_PHONE } from '@/data/site';
import heroFalcon from '@/assets/images/hero-falcon.jpg';
---

<BaseLayout description="Business funding from New York City. Merchant cash advances, lines of credit, term loans, invoice factoring and consolidation, with funding in as little as 24-48 hours.">
  <section class="home-hero on-dark" aria-labelledby="hero-heading">
    <div class="home-hero-media">
      <Image
        src={heroFalcon}
        alt="A peregrine falcon launching from a branch with its wings spread wide"
        widths={[640, 960, 1280, 1920, 2400]}
        sizes="100vw"
        class="absolute inset-0 h-full w-full object-cover object-[60%_30%]"
        priority
      />
      <div class="absolute inset-0 bg-black/45" aria-hidden="true"></div>
    </div>
    <div class="home-hero-copy">
      <div class="container-site">
        <h1 id="hero-heading">Capital for businesses that play to win.</h1>
        <p class="lead">
          Capital from $5,000 to $20,000,000. Many products fund within 24-48 hours of approval.
        </p>
        <div class="mt-6">
          <a href="/apply" class="btn-on-dark">Apply</a>
          <a href={PRIMARY_PHONE.href} class="ml-5 inline-block text-base text-white/90 underline-offset-4 hover:underline">
            {PRIMARY_PHONE.display}
          </a>
        </div>
      </div>
    </div>
  </section>

  <StatsBar />

  <section class="section bg-white" aria-labelledby="services-heading" id="services">
    <div class="container-site">
      <SectionHeading
        id="services-heading"
        eyebrow="What we do"
        title="Seven funding products."
        lead="Amounts, terms and speed vary by file."
      />
      <ul class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          SERVICES.map((s) => (
            <li>
              <ServiceCard service={s} />
            </li>
          ))
        }
      </ul>
      <p class="mt-10">
        <a href="/services" class="link">Compare amounts, terms and requirements</a>
      </p>
    </div>
  </section>

  <section class="section bg-tint" aria-labelledby="how-heading">
    <div class="container-site">
      <SectionHeading
        id="how-heading"
        eyebrow="Process"
        title="How a file moves."
        lead="The same sequence for every product."
      />
      <ol class="mt-12 grid gap-8 md:grid-cols-3">
        {
          HOW_IT_WORKS.map((step, i) => (
            <li class="border-t border-line pt-6">
              <h3>
                <span class="sr-only">Step {i + 1}: </span>
                {step.title}
              </h3>
              <p class="mt-3 text-ink-soft">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="stories-heading">
    <div class="container-site">
      <SectionHeading
        id="stories-heading"
        eyebrow="Illustrative examples"
        title="Situations owners bring to Falcon."
        lead="Generic situations. Not real clients or results."
      />
      <ul class="mt-12 grid gap-8 lg:grid-cols-3">
        {
          CLIENT_STORIES.map((s) => (
            <li class="border-t border-line pt-6">
              <h3>{s.title}</h3>
              <p class="mt-3 text-ink-soft">{s.body}</p>
              <p class="mt-6 text-sm text-muted">
                {s.industry} · <span class="text-ink">{s.product}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
