---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import { INDUSTRIES } from '@/data/industries';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Industries', path: '/industries' },
];
---

<BaseLayout
  title="Industries"
  description="Falcon Equity Group funds retail, transportation, restaurants, real estate, healthcare, construction, e-commerce, auto services, manufacturing, professional services, education and hospitality."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Industries"
    lead="We fund businesses across these twelve sectors, and others with steady revenue."
  >
    <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        INDUSTRIES.map((ind) => (
          <li class="h-full">
            <a href={`/industries/${ind.slug}`} class="industry-card tile-card">
              <Icon name={ind.icon} size={28} class="text-ink" />
              <h3 class="mt-5">{ind.name}</h3>
              <p class="mt-3 text-ink-soft">{ind.uses.join(', ')}.</p>
            </a>
          </li>
        ))
      }
    </ul>
  </PageHero>

  <CtaBand />
</BaseLayout>

<style>
  .industry-card {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .industry-card:hover h3,
  .industry-card:focus-visible h3 {
    color: var(--color-accent);
  }

  .industry-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
  }
</style>
