---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import { INDUSTRIES } from '@/data/industries';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Industries', path: '/industries' },
];
---

<BaseLayout
  title="Industries"
  description="Falcon Equity Group funds retail, transportation, restaurants, real estate, healthcare, construction, e-commerce, auto services, manufacturing, professional services, education and hospitality."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Industries"
    lead="We fund businesses across these twelve sectors, and others with steady revenue."
  />

  <section class="section bg-tint" aria-labelledby="industries-list-heading">
    <div class="container-site">
      <h2 id="industries-list-heading" class="sr-only">Industries we serve</h2>
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          INDUSTRIES.map((ind) => (
            <li class="tile-card">
              <Icon name={ind.icon} size={28} class="text-accent" />
              <h3 class="mt-5">{ind.name}</h3>
              <p class="mt-3 text-ink-soft">{ind.uses.join(', ')}.</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
