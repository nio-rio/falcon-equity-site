---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import { INDUSTRIES } from '@/data/industries';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Industries', path: '/industries' },
];
---

<BaseLayout
  title="Industries"
  description="Falcon Equity Group funds retail, transportation, restaurants, real estate, healthcare, construction, e-commerce, auto services, manufacturing, professional services, education and hospitality."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Industries"
    lead="We fund businesses across these twelve sectors, and others with steady revenue."
    breadcrumbs={crumbs}
  />

  <section class="section bg-white" aria-labelledby="industries-list-heading">
    <div class="container-site">
      <h2 id="industries-list-heading" class="sr-only">Industries we serve</h2>
      <ul class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          INDUSTRIES.map((ind) => (
            <li class="border-t border-line pt-6">
              <h3>{ind.name}</h3>
              <p class="mt-3 text-ink-soft">{ind.blurb}</p>
              <ul class="mt-4 space-y-1 text-[15px] text-muted">
                {ind.uses.map((u) => (
                  <li>{u}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
      <p class="mt-12 text-ink-soft">
        Not listed? <a href="/contact" class="link">Contact us</a>.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
