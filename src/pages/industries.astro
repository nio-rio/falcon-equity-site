---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ImageSlot from '@/components/ImageSlot.astro';
import CtaBand from '@/components/CtaBand.astro';
import { INDUSTRIES, INDUSTRY_PLACEHOLDERS } from '@/data/industries';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Industries', path: '/industries' },
];
---

<BaseLayout
  title="Industries"
  description="Falcon Equity Group funds retail, transportation, restaurants, real estate, healthcare, construction, e-commerce, auto services, manufacturing, professional services, education and hospitality."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Industries"
    lead="We fund businesses across these twelve sectors, and others with steady revenue."
  >
    <ul class="bx-grid page-hero-media">
      {
        INDUSTRIES.map((ind) => (
          <li class="bx-span-4 lg:bx-span-4">
            <a href={`/industries/${ind.slug}`} class="industry-card group">
              <div class="media-zoom">
                <ImageSlot
                  labeled
                  intent={INDUSTRY_PLACEHOLDERS[ind.slug].hero.intent}
                  alt={INDUSTRY_PLACEHOLDERS[ind.slug].hero.alt}
                  ratio="16 / 9"
                />
              </div>
              <h3 class="mt-5">
                <span class="link-draw">{ind.name}</span>
              </h3>
              <p class="mt-3 text-ink-soft">{ind.uses.join(', ')}.</p>
            </a>
          </li>
        ))
      }
    </ul>
  </PageHero>

  <CtaBand />
</BaseLayout>

<style>
  .industry-card {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .industry-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
  }
</style>
