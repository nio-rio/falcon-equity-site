---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import FaqList from '@/components/FaqList.astro';
import PostCard from '@/components/PostCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import ImageSlot from '@/components/ImageSlot.astro';
import ExploreList from '@/components/ExploreList.astro';
import ArrowCta from '@/components/ArrowCta.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import StatementBand from '@/components/StatementBand.astro';
import Principles from '@/components/Principles.astro';
import FeatureSplit from '@/components/FeatureSplit.astro';
import { INDUSTRIES, INDUSTRY_PLACEHOLDERS, type Industry } from '@/data/industries';
import { SERVICES } from '@/data/services';
import { getPublishedPosts } from '@/lib/blog';
import { breadcrumbSchema, faqSchema } from '@/lib/schema';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return INDUSTRIES.map((industry) => {
    const matched = posts.filter((post) => post.data.industry === industry.slug);
    const extras = (industry.relatedPostIds ?? [])
      .map((id) => posts.find((post) => post.id === id))
      .filter((post): post is (typeof posts)[number] => {
        if (!post) return false;
        return !matched.some((m) => m.id === post.id);
      });
    return {
      params: { slug: industry.slug },
      props: {
        industry,
        related: [...matched, ...extras].slice(0, 3),
      },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  industry: Industry;
  related: Awaited<ReturnType<typeof getPublishedPosts>>;
}

const { industry, related } = Astro.props;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Industries', path: '/industries' },
  { name: industry.name, path: `/industries/${industry.slug}` },
];
const placeholders = INDUSTRY_PLACEHOLDERS[industry.slug];
const products = industry.products.map((item) => {
  const service = SERVICES.find((s) => s.slug === item.slug);
  if (!service) throw new Error(`Unknown service slug on industry page: ${item.slug}`);
  const amounts = service.spec?.amounts ?? service.amounts;
  const terms = service.spec?.terms ?? service.terms;
  return {
    name: service.name,
    href: `/services/${service.slug}`,
    figures: `${amounts}, ${terms}`,
    copy: item.copy,
    image: service.image,
  };
});
const bandItems = industry.uses.map((title) => ({ title }));
const principles = industry.useCases.slice(0, 3).map((item) => ({ title: item.title, body: item.body }));
const accordionItems = industry.needs.map((need) => ({ q: need.title, a: need.body }));
const explore = INDUSTRIES.filter((item) => item.slug !== industry.slug).map((item) => ({
  href: `/industries/${item.slug}`,
  title: item.name,
  meta: item.uses[0],
}));
---

<BaseLayout
  title={industry.seoTitle}
  description={industry.seoDescription}
  schema={[breadcrumbSchema(crumbs), faqSchema(industry.faqs)]}
>
  <PageHero title={industry.h1} lead={industry.subtitle}>
    {
      industry.note && (
        <p class="page-hero-lead mt-6 max-w-3xl">{industry.note}</p>
      )
    }
    <div class="page-hero-media">
      <ImageSlot
        labeled
        intent={placeholders.hero.intent}
        alt={placeholders.hero.alt}
        ratio="16 / 9"
      />
    </div>
  </PageHero>

  <StatementBand
    items={bandItems}
    intent={placeholders.needs.intent}
  />

  <section class="section bg-white" aria-labelledby="needs-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="bx-span-4 bx-lg-span-4">
          <Eyebrow>Common funding needs</Eyebrow>
          <h2 id="needs-heading" class="mt-4">Where capital usually goes first.</h2>
        </div>
        <div class="bx-span-4 bx-lg-span-8">
          <FaqList faqs={accordionItems} idPrefix={`${industry.slug}-needs`} />
        </div>
      </div>
    </div>
  </section>

  <FeatureSplit
    id="products-intro-heading"
    eyebrow="Best-fit products"
    title="Which Falcon product matches the job."
    intent={placeholders.setting.intent}
  >
    <p class="section-lead">
      Model payments with the <a href="/resources/loan-calculator" class="link">loan calculator</a>, or
      <a href="/apply" class="link">apply</a> to talk with a specialist.
    </p>
  </FeatureSplit>

  <section class="section bg-white" aria-labelledby="products-intro-heading">
    <div class="container-site">
      <div class="bx-grid">
        {
          products.map((product) => (
            <div class="bx-span-4 bx-lg-span-4">
              <a href={product.href} class="group block">
                <div class="media-zoom">
                  <Image
                    src={product.image}
                    alt=""
                    widths={[480, 800]}
                    sizes="(min-width: 1024px) 33vw, 100vw"
                    class="aspect-[16/9] w-full object-cover"
                  />
                </div>
                <h3 class="mt-5">
                  <span class="link-draw">{product.name}</span>
                </h3>
              </a>
              <p class="mt-3 text-sm font-medium text-ink">{product.figures}</p>
              <p class="mt-3 text-ink-soft">{product.copy}</p>
              <p class="mt-5">
                <ArrowCta href={product.href} label="Learn more" />
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Principles
    id="use-cases-heading"
    eyebrow="Use cases"
    title="Situations owners bring to Falcon."
    items={principles}
  />

  <section class="section bg-white" aria-labelledby="industry-faq-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="bx-span-4 bx-lg-span-4">
          <Eyebrow>FAQ</Eyebrow>
          <h2 id="industry-faq-heading" class="mt-4">{`${industry.name} questions`}</h2>
        </div>
        <div class="bx-span-4 bx-lg-span-8">
          <FaqList faqs={industry.faqs} idPrefix={`${industry.slug}-faq`} />
        </div>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section bg-tint" aria-labelledby="related-heading">
        <div class="container-site">
          <div class="bx-grid">
            <div class="bx-full">
              <Eyebrow>Related</Eyebrow>
              <h2 id="related-heading" class="mt-4">Related articles</h2>
            </div>
            {related.map((post) => (
              <div class="bx-span-4 bx-lg-span-4">
                <PostCard post={post} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <ExploreList heading="Explore more industries" headingId="explore-industries" items={explore} />

  <CtaBand />
</BaseLayout>
