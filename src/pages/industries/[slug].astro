---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FaqList from '@/components/FaqList.astro';
import PostCard from '@/components/PostCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import ImageSlot from '@/components/ImageSlot.astro';
import { INDUSTRIES, INDUSTRY_PLACEHOLDERS, type Industry } from '@/data/industries';
import { SERVICES } from '@/data/services';
import { getPublishedPosts } from '@/lib/blog';
import { breadcrumbSchema, faqSchema } from '@/lib/schema';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return INDUSTRIES.map((industry) => {
    const matched = posts.filter((post) => post.data.industry === industry.slug);
    const extras = (industry.relatedPostIds ?? [])
      .map((id) => posts.find((post) => post.id === id))
      .filter((post): post is (typeof posts)[number] => Boolean(post) && !matched.some((m) => m.id === post.id));
    return {
      params: { slug: industry.slug },
      props: {
        industry,
        related: [...matched, ...extras].slice(0, 3),
      },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  industry: Industry;
  related: Awaited<ReturnType<typeof getPublishedPosts>>;
}

const { industry, related } = Astro.props;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Industries', path: '/industries' },
  { name: industry.name, path: `/industries/${industry.slug}` },
];
const placeholders = INDUSTRY_PLACEHOLDERS[industry.slug];
const products = industry.products.map((item) => {
  const service = SERVICES.find((s) => s.slug === item.slug);
  if (!service) throw new Error(`Unknown service slug on industry page: ${item.slug}`);
  const amounts = service.spec?.amounts ?? service.amounts;
  const terms = service.spec?.terms ?? service.terms;
  return {
    name: service.name,
    href: `/services/${service.slug}`,
    figures: `${amounts}, ${terms}`,
    copy: item.copy,
  };
});
---

<BaseLayout
  title={industry.seoTitle}
  description={industry.seoDescription}
  schema={[breadcrumbSchema(crumbs), faqSchema(industry.faqs)]}
>
  <PageHero title={industry.h1} lead={industry.subtitle}>
    {
      industry.note && (
        <p class="mt-6 max-w-2xl text-ink-soft">{industry.note}</p>
      )
    }
    <div class="mt-10">
      <ImageSlot
        labeled
        intent={placeholders.hero.intent}
        alt={placeholders.hero.alt}
        ratio="16 / 9"
      />
    </div>
  </PageHero>

  <section class="section bg-white" aria-labelledby="needs-heading">
    <div class="container-site">
      <SectionHeading id="needs-heading" eyebrow="Common funding needs" title="Where capital usually goes first." />
      <div class="mt-10">
        <ImageSlot
          labeled
          intent={placeholders.needs.intent}
          alt={placeholders.needs.alt}
          ratio="16 / 9"
        />
      </div>
      <ol class="mt-12 grid gap-10 md:grid-cols-2">
        {
          industry.needs.map((need, i) => (
            <li>
              <p class="text-sm font-medium text-muted">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-3">{need.title}</h3>
              <p class="mt-3 text-ink-soft">{need.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section bg-tint" aria-labelledby="products-heading">
    <div class="container-site">
      <SectionHeading
        id="products-heading"
        eyebrow="Best-fit products"
        title="Which Falcon product matches the job."
      />
      <ul class="mt-12 grid gap-6 md:grid-cols-3">
        {
          products.map((product) => (
            <li class="bg-white p-8">
              <h3>
                <a href={product.href} class="link">{product.name}</a>
              </h3>
              <p class="mt-3 text-sm font-medium text-ink">{product.figures}</p>
              <p class="mt-3 text-ink-soft">{product.copy}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-ink-soft">
        Model payments with the <a href="/resources/loan-calculator" class="link">loan calculator</a>, or
        <a href="/apply" class="link">apply</a> to talk with a specialist.
      </p>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="use-cases-heading">
    <div class="container-site">
      <SectionHeading
        id="use-cases-heading"
        eyebrow="Use cases"
        title="Situations owners bring to Falcon."
        lead="Generic situations. Not real clients or results."
      />
      <div class="mt-10">
        <ImageSlot
          labeled
          intent={placeholders.setting.intent}
          alt={placeholders.setting.alt}
          ratio="16 / 9"
        />
      </div>
      <ul class="mt-12 grid gap-10 md:grid-cols-3">
        {
          industry.useCases.map((useCase) => (
            <li>
              <h3>{useCase.title}</h3>
              <p class="mt-3 text-ink-soft">{useCase.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="industry-faq-heading">
    <div class="container-site grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading id="industry-faq-heading" eyebrow="FAQ" title={`${industry.name} questions`} />
      </div>
      <div class="lg:col-span-8">
        <FaqList faqs={industry.faqs} />
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section bg-tint" aria-labelledby="related-heading">
        <div class="container-site">
          <SectionHeading id="related-heading" eyebrow="Related" title="Related articles" />
          <ul class="mt-12 grid gap-8 md:grid-cols-3">
            {related.map((post) => (
              <li>
                <PostCard post={post} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>
