---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Media from '@/components/Media.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import CircleArrow from '@/components/CircleArrow.astro';
import { PAGE_DISCLOSURE } from '@/data/disclosure';
import { SERVICES } from '@/data/services';
import { getPublicPosts } from '@/lib/blog';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/schema';
import '@/styles/mca.css';
import '@/styles/retail.css';

/**
 * Retail industry page. Copy contract: nio rio Notion
 * "Retail industry page – content outline (stage 1)".
 *
 * Band sources, per Ling 22 Oct 2026:
 * 1 hero .................. TF-00 header + PE-02 glance strip + TF-01 still
 * 2 answer ................ blackstone.com home "Private wealth" band (measured
 *                           from Ling's screenshot: claim cols 1-5, panel cols
 *                           9-16 at 624px, row pitch ~153px, 80px inner pad)
 * 3 situations ............ PLACEHOLDER — Ling's component lands here
 * 4 products .............. the service pages' "When X isn't the right fit" band
 *                           (mca-cards--3: title, body, link + arrow)
 * blog .................... the service pages' blog slider
 * faq ..................... the service pages' FAQ band
 *
 * Figures come from SERVICES (live #services spec) — never re-typed here.
 */

const product = (slug: string) => {
  const found = SERVICES.find((s) => s.slug === slug && s.spec);
  if (!found) throw new Error(`Retail page: missing spec for ${slug}`);
  return found;
};

const loc = product('business-line-of-credit');
const mca = product('merchant-cash-advance');
const collateral = product('collateral-asset-loans');

/**
 * Section 3 — the situations behind the expanding pills. Product names and the
 * amount/term ranges are read from SERVICES so the figures stay word for word
 * from the live #services spec; nothing numeric is typed here.
 */
const svc = (slug: string) => {
  const found = SERVICES.find((s) => s.slug === slug && s.spec);
  if (!found) throw new Error(`Retail page: missing spec for ${slug}`);
  return found;
};

const situationSeeds = [
  {
    if: 'You place the holiday order in July and pay for it in August',
    means: 'Cash leaves the account months before the season pays it back.',
    slug: 'business-line-of-credit',
    why: 'Draw what each order needs, repay as the stock sells, draw again next season.',
  },
  {
    if: 'A supplier offers a bulk price or an early-pay discount that expires this week',
    means: 'The saving is real, but only if the cash is on hand now.',
    slug: 'merchant-cash-advance',
    why: 'The fastest product to fund; you repay from sales rather than a fixed monthly bill.',
  },
  {
    if: 'Card sales are strong, but settlement runs behind rent and payroll in a slow month',
    means: 'The money exists, it just has not landed yet.',
    slug: 'merchant-cash-advance',
    why: 'Repayment moves with your daily or weekly sales, so quiet weeks cost less.',
  },
  {
    if: 'You need refrigeration, shelving, POS, security or a delivery van',
    means: "A one-time purchase a single month's margin cannot cover.",
    slug: 'collateral-asset-loans',
    why: 'What you buy secures the loan, and the term matches how long it keeps earning.',
  },
  {
    if: 'You need seasonal staff on the floor weeks before the traffic arrives',
    means: 'Payroll is a fixed cost against sales that have not started.',
    slug: 'business-line-of-credit',
    why: 'Draw for the hire-up, repay it from the peak-season sales.',
  },
  {
    if: 'You are opening a second store or finishing a build-out with a known end date',
    means: 'The spend lands now; the sales build over the following year.',
    slug: 'business-term-loan',
    why: 'One fixed monthly payment, sized to what the new store should do.',
  },
  {
    if: 'Your wholesale or trade customers pay you on 30–60 day terms',
    means: "You made the sale, but you are financing your customer's float.",
    slug: 'invoice-factoring-tool',
    why: 'Turns outstanding business-to-business invoices into cash now.',
  },
  {
    if: "Two or three advances from last season still take a bite out of every day's sales",
    means: 'Stacked payments are how a good month turns into a bad one.',
    slug: 'consolidation-of-positions',
    why: 'Pays off the positions you have and rolls them into one payment sized to your sales.',
  },
];

const situations = situationSeeds.map((seed) => {
  const service = svc(seed.slug);
  const terms = service.spec!.terms;
  return {
    ...seed,
    product: service.name,
    range: `${service.spec!.amounts} · ${terms.charAt(0).toLowerCase()}${terms.slice(1)}`,
  };
});

const retailProducts = [
  {
    service: loc,
    fit: 'The default for a repeating buying cycle. Draw what each order needs, repay as the stock sells, and keep the facility for next season.',
  },
  {
    service: mca,
    fit: 'For card-heavy stores that need money quickly and cannot wait on a bank. Repayment follows sales, but it costs more than a line of credit, so use it for short, high-turn purchases rather than planned buying.',
  },
  {
    service: collateral,
    fit: 'For the assets behind the shop — refrigeration, fixtures, POS hardware or a delivery van. A fixed term spreads the cost over the years the equipment keeps working.',
  },
];

const published = await getPublicPosts();
/** Published, retail-relevant posts only, most relevant first. Drafts stay out. */
const RETAIL_BLOG_IDS = [
  'bridging-a-slow-season',
  'equipment-financing-break-even',
  'what-your-bank-statements-say',
  'how-to-read-a-factor-rate',
  '24-48-hour-funding-checklist',
] as const;
const blogSlides = RETAIL_BLOG_IDS.map((id) => published.find((post) => post.id === id)).filter(
  (post): post is (typeof published)[number] => Boolean(post),
);

const faqs = [
  {
    q: 'What can a retail business use funding for?',
    a: "Stock, seasonal payroll, a supplier's early-pay discount, store fit-outs and equipment such as refrigeration, shelving, POS or a delivery vehicle. Falcon does not restrict the use of proceeds to one category.",
  },
  {
    q: 'How much can a retail store borrow?',
    a: '$5,000 to $5,000,000 depending on the product. A line of credit runs $10,000 – $500,000, an advance $5,000 – $5,000,000, and a collateral loan $10,000 – $1,000,000. The final number depends on your sales, your time in business and your bank activity.',
  },
  {
    q: 'Is a line of credit or a cash advance better for inventory?',
    a: 'If you buy on a repeating cycle, a line of credit is usually cheaper and reusable. An advance is faster to qualify for but costs more, so it fits a one-off, short-turn purchase rather than a planned seasonal buy.',
  },
  {
    q: 'Can I get funding if most of my sales are on cards?',
    a: 'Yes. Card-heavy stores are a common fit for a merchant cash advance, where repayment is a share of sales rather than a fixed monthly payment.',
  },
  {
    q: 'How fast can funding land before a holiday order?',
    a: "Many products fund within 24-48 hours of approval. Timing depends on how quickly you send documents, so start before the supplier's deadline rather than on it.",
  },
  {
    q: 'What does it cost?',
    a: 'Falcon charges a 0% agreement fee. For a sales-linked product, the total amount you are selling and the percentage of sales that goes toward it are both spelled out on the agreement before you sign. No specific rate is published here, because it depends on your file.',
  },
  {
    q: 'What do I need to apply?',
    a: 'Six months of business bank statements, a photo ID, a voided check, a list of any current advances or loans, and a quote or invoice for equipment.',
  },
];

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Industries', path: '/#industries-heading' },
    { name: 'Retail business loans', path: '/industries/retail' },
  ]),
  faqSchema(faqs),
  ...retailProducts.map(({ service }) =>
    serviceSchema({ name: service.name, summary: service.summary, slug: service.slug }),
  ),
];

const metaDescription =
  'Retail business loans for inventory, seasonal payroll and store fit-outs. A line of credit up to $500,000, advances up to $5,000,000, and equipment loans. 0% agreement fee.';
---

<BaseLayout
  title="Retail business loans"
  description={metaDescription}
  schema={schema}
  disclosure={PAGE_DISCLOSURE}
>
  <Fragment slot="head">
    <script is:inline>
      (function () {
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          document.documentElement.classList.add('has-js');
          window.setTimeout(function () {
            if (!window.__pilotRevealReady) document.documentElement.classList.remove('has-js');
          }, 2500);
        } catch (e) {}
      })();
    </script>
  </Fragment>

  {/* 1 page header — blackstone.com/financial-advisors: H1 cols 1-9, standfirst
       cols 12-16, no stats, no CTA in the reference. Header still below, as a
       placeholder until Ling sends the hero photograph. */}
  <section class="ret-hero" aria-labelledby="page-hero-heading" data-band="light" data-ret-section="header" data-reveal-root>
    <div class="container-site">
      <div class="ret-grid ret-hero-grid">
        <h1 id="page-hero-heading" class="ret-h1" data-reveal>Retail business loans</h1>
        <p class="ret-body ret-standfirst" data-reveal>
          Stock the shelves before the money comes back. Funding that moves with your selling season, not against it.
        </p>
        <a class="arrow-cta ret-hero-apply" href="/apply" data-reveal>
          <span class="arrow-cta-label">Apply for funding</span>
          <CircleArrow />
        </a>
        <div class="ret-hero-media" data-reveal>
          <Media
            labeled
            intent="stocked shop shelves seen from the aisle, boxes still on the floor"
            ratio="5 / 2"
            sizes="(min-width: 90em) 1264px, (min-width: 64em) 1136px, 100vw"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  {/* 3 what's your case — a mirror of the old "In short" band: list on the
       left in the FAQ idiom, the matching Falcon product on the right. Radius 0
       and no child fills anywhere; the only rules are the row hairlines in the
       list. The open row reveals its folded line ("cash leaves the account…")
       and swaps the right column to that row's product. */}
  <section class="ret-band ret-band--dark ret-case" aria-labelledby="situations-heading" data-band="dark" data-ret-section="situations" data-reveal-root data-case-root>
    <div class="container-site">
      <div class="ret-case-grid">
        <div class="ret-case-side">
        <div class="ret-case-head" data-reveal>
          <Eyebrow>What's your case?</Eyebrow>
          <h2 id="situations-heading" class="ret-case-claim">Which funding fits your store right now?</h2>
        </div>

        <div class="ret-case-detail" data-case-detail aria-live="polite">
          {
            situations.map((item, i) => (
              <div class:list={['ret-case-product', i === 0 && 'is-active']} data-case-product hidden={i !== 0}>
                <h3 class="ret-case-name">{item.product}</h3>
                <p class="ret-case-why">{item.why}</p>
                <dl class="ret-case-facts">
                  <div>
                    <dt>Range</dt>
                    <dd>{item.range.split(' · ')[0]}</dd>
                  </div>
                  <div>
                    <dt>Term</dt>
                    <dd>{item.range.split(' · ')[1]}</dd>
                  </div>
                </dl>
                <a class="ret-case-link" href={`/services/${item.slug}`}>
                  <span>See {item.product}</span>
                  <CircleArrow />
                </a>
              </div>
            ))
          }
        </div>
        </div>

        <ul class="ret-case-list" data-reveal>
          {
            situations.map((item, i) => (
              <li class:list={['ret-case-item', i === 0 && 'is-open']} data-case-item>
                <h3>
                  <button
                    type="button"
                    class="ret-case-trigger"
                    id={`ret-case-trigger-${i}`}
                    aria-expanded={i === 0 ? 'true' : 'false'}
                    aria-controls={`ret-case-panel-${i}`}
                    data-case-trigger
                    data-case-index={i}
                  >
                    <span class="ret-case-question">{item.if}</span>
                    <span class="ret-case-caret" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="10" viewBox="0 0 18 10" fill="none">
                        <path d="M1 1L9 9L17 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </button>
                </h3>
                <div class="ret-case-panel" id={`ret-case-panel-${i}`} role="region" aria-labelledby={`ret-case-trigger-${i}`}>
                  <div class="ret-case-panel-inner">
                    <p class="ret-case-means">{item.means}</p>
                    {/* Narrow screens have no right-hand column, so the product
                        travels with the row instead. */}
                    <p class="ret-case-inline">
                      <a href={`/services/${item.slug}`}>{item.product}</a>
                      <span aria-hidden="true">·</span>
                      <span>{item.range}</span>
                    </p>
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* 4 three products — the service pages' "When X isn't the right fit" band:
       three cards, title + one line + link with arrow. */}
  <section class="ret-band ret-products-band" aria-labelledby="products-heading" data-band="light" data-ret-section="products" data-reveal-root>
    <div class="container-site">
      <div class="mca-shell">
        <div class="mca-block-head" data-reveal>
          <Eyebrow>Products</Eyebrow>
          <h2 id="products-heading">Three ways to fund a retail business</h2>
        </div>
      </div>
      <div class="mca-shell mca-cards mca-cards--3" data-reveal>
        {
          retailProducts.map(({ service, fit }) => (
            <article class="mca-card">
              <h3 class="mca-card-title">{service.name}</h3>
              <p class="mca-card-body">{fit}</p>
              <a class="mca-card-link" href={`/services/${service.slug}`}>
                <span class="mca-card-link-label">See {service.name}</span>
                <span class="mca-card-link-icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <path d="M14 19L21 12L14 5" stroke="currentColor" stroke-width="2" stroke-miterlimit="10" />
                    <path d="M21 12H2" stroke="currentColor" stroke-width="2" stroke-miterlimit="10" />
                  </svg>
                </span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* blog — the service pages' blog slider (same component, retail posts) */}
  <section class="ret-band ret-blog-band" aria-label="From the blog" data-band="light" data-ret-section="blog" data-reveal-root>
    <div class="container-site">
      <div
        class="mca-blog-slider"
        data-ret-blog-slider
        data-autoplay="true"
        data-autoplay-duration="5000"
        data-reveal
        role="region"
        aria-roledescription="carousel"
        aria-label="Retail funding articles"
        tabindex="0"
      >
        <div class="mca-shell mca-blog-split">
          <div class="mca-blog-copy">
            <Eyebrow>From the blog</Eyebrow>
            <div class="mca-blog-copy-slides">
              {
                blogSlides.map((post, i) => (
                  <div
                    class:list={['mca-blog-copy-slide', i === 0 && 'is-active']}
                    data-mca-blog-copy-slide
                    role="group"
                    aria-roledescription="slide"
                    aria-label={`${i + 1} of ${blogSlides.length}`}
                    aria-hidden={i === 0 ? 'false' : 'true'}
                  >
                    <h2 class="mca-blog-title" data-mca-blog-title>{post.data.title}</h2>
                    <a class="mca-card-link" href={`/blog/${post.id}`}>
                      <span class="mca-card-link-label">Read the article</span>
                      <span class="mca-card-link-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none">
                          <path d="M14 19L21 12L14 5" stroke="currentColor" stroke-width="2" stroke-miterlimit="10" />
                          <path d="M21 12H2" stroke="currentColor" stroke-width="2" stroke-miterlimit="10" />
                        </svg>
                      </span>
                    </a>
                  </div>
                ))
              }
            </div>
            {
              blogSlides.length > 1 && (
                <div class="mca-blog-controls">
                  <button type="button" class="mca-blog-arrow" data-mca-blog-prev aria-label="Previous article">
                    <span class="mca-blog-arrow-icon" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none">
                        <path d="M10 19L3 12L10 5" stroke="currentColor" stroke-width="2" stroke-miterlimit="10" />
                        <path d="M3 12H21" stroke="currentColor" stroke-width="2" stroke-miterlimit="10" />
                      </svg>
                    </span>
                  </button>
                  <button type="button" class="mca-blog-arrow" data-mca-blog-next aria-label="Next article">
                    <span class="mca-blog-arrow-icon" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none">
                        <path d="M14 19L21 12L14 5" stroke="currentColor" stroke-width="2" stroke-miterlimit="10" />
                        <path d="M21 12H2" stroke="currentColor" stroke-width="2" stroke-miterlimit="10" />
                      </svg>
                    </span>
                  </button>
                </div>
              )
            }
          </div>
          <div class="mca-blog-media">
            {
              blogSlides.map((post, i) => (
                <div
                  class:list={['mca-blog-media-slide', i === 0 && 'is-active']}
                  data-mca-blog-media-slide
                  aria-hidden={i === 0 ? 'false' : 'true'}
                  data-mca-blog-img
                >
                  <Media
                    image={post.data.cover}
                    alt={post.data.coverAlt || post.data.title}
                    intent={post.data.coverAlt || post.data.title}
                    labeled={!post.data.cover}
                    ratio="16 / 9"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    sizes="(min-width: 90em) 704px, (min-width: 80em) 632px, (min-width: 48em) 688px, 100vw"
                  />
                </div>
              ))
            }
          </div>
        </div>
        <p class="sr-only" aria-live="polite" data-mca-blog-live></p>
      </div>
    </div>
  </section>

  {/* faq — the service pages' FAQ band */}
  <section class="ret-band ret-faq-band" aria-labelledby="faq-heading" data-band="light" data-ret-section="faq" data-reveal-root>
    <div class="container-site">
      <div class="mca-shell mca-faq-head" data-reveal>
        <div class="mca-block-head">
          <Eyebrow>FAQ</Eyebrow>
          <h2 id="faq-heading">Retail funding questions</h2>
        </div>
      </div>
      <div class="mca-shell">
        <div class="mca-faq-list" data-accordion data-reveal>
          {
            faqs.map((item, i) => (
              <div class="mca-faq-item" data-acc-item>
                <h3>
                  <button
                    type="button"
                    class="mca-faq-trigger"
                    aria-expanded="false"
                    aria-controls={`ret-faq-panel-${i}`}
                    id={`ret-faq-trigger-${i}`}
                    data-acc-trigger
                  >
                    <span>{item.q}</span>
                    <span class="mca-faq-caret" aria-hidden="true">
                      <span class="mca-faq-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="8" viewBox="0 0 18 10" fill="none" class="mca-faq-caret-svg">
                          <path d="M1 1L9 9L17 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                    </span>
                  </button>
                </h3>
                <div class="mca-acc-panel" id={`ret-faq-panel-${i}`} role="region" aria-labelledby={`ret-faq-trigger-${i}`}>
                  <div class="mca-acc-inner">
                    <p>{item.a}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <script>
    import { bindAccordions } from '@/scripts/accordion';
    import { bindMcaBlogSlider } from '@/scripts/mca-blog-slider';
    import { bindRetailCase } from '@/scripts/retail-case';
    import '@/scripts/scroll-in';
    bindAccordions();
    bindMcaBlogSlider();
    bindRetailCase();
  </script>
</BaseLayout>
