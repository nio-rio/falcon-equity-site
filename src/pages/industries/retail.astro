---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Media from '@/components/Media.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import CircleArrow from '@/components/CircleArrow.astro';
import { PAGE_DISCLOSURE } from '@/data/disclosure';
import { SERVICES } from '@/data/services';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/schema';
import '@/styles/retail.css';

/**
 * Retail industry page. Copy contract: nio rio Notion
 * "Retail industry page – content outline (stage 1)".
 * Structure: docs/retail-structure-plan-v2.md — every band names the measured
 * section id it was built from (docs/section-library-live/LIBRARY.md).
 * Figures come from SERVICES (live #services spec) — never re-typed here.
 */

const product = (slug: string) => {
  const found = SERVICES.find((s) => s.slug === slug && s.spec);
  if (!found) throw new Error(`Retail page: missing spec for ${slug}`);
  return found;
};

const loc = product('business-line-of-credit');
const mca = product('merchant-cash-advance');
const collateral = product('collateral-asset-loans');

const glance = [
  { value: 'Up to $5,000,000', label: "Across Falcon's funding products" },
  { value: '24-48 hours', label: 'Average funding time after approval' },
  { value: '0% agreement fee', label: 'Any product-specific cost is set out before you sign' },
  { value: '300+ businesses', label: 'Funded by Falcon to date' },
];

const answerLead =
  'Retail businesses borrow to buy stock before the season, cover payroll through slow months, and fit out the store. Falcon funds retail with a business line of credit for repeating inventory orders, a merchant cash advance for fast cash that repays from sales, and collateral loans for fixtures and equipment. Amounts run from $5,000 to $5,000,000.';

const takeaways = [
  "The order you place in July is paid for before December's sales arrive. Funding has to match that gap, not the calendar year.",
  'Match the term to the life of what you bought: stock turns in weeks, refrigeration earns for a decade.',
  'If most of your sales are on cards, you can repay out of sales instead of a fixed monthly bill.',
  "Size the buy from last year's sell-through, not from the largest amount you were approved for.",
];

const pressures = [
  {
    title: 'Stock bought months before it sells',
    body: 'The holiday order is placed in July and paid in August. The sales land in November and December.',
  },
  {
    title: 'A price change or a discount that expires',
    body: "A tariff change, a factory minimum or a supplier's early-pay offer all reward having the cash on the day, not in six weeks.",
  },
  {
    title: 'The gap between a slow month and a good one',
    body: 'Rent, payroll, insurance and card fees arrive whether the store is busy or not.',
  },
  {
    title: 'Fixtures, refrigeration, POS and security',
    body: "One-time purchases that a single month's margin cannot absorb.",
  },
];

const year = [
  {
    period: 'January – February',
    title: 'Stock is paid for and being marked down',
    body: "Returns and clearance clear the shelves at a discount while the next season's orders are already being planned.",
  },
  {
    period: 'March – June',
    title: 'The second inventory payment lands before the summer traffic',
    body: "Spring reset and summer stock are bought on last year's numbers, before this year's customers show up.",
  },
  {
    period: 'July – September',
    title: 'The holiday order is paid, the seasonal staff are hired',
    body: "The year's largest inventory payment goes out weeks or months before the year's largest sales come in.",
  },
  {
    period: 'October – December',
    title: 'The sales arrive, the cash lags',
    body: 'Card settlements trail the sale, and shelves need restocking while the money is still in transit.',
  },
];

const situations = [
  {
    if: 'You place the holiday order in July and pay for it in August',
    means: 'Cash leaves the account months before the season pays it back',
    product: loc,
    why: 'Draw what each order needs, repay as the stock sells, draw again next season',
    range: `${loc.spec!.amounts} · ${loc.spec!.terms.toLowerCase()}`,
  },
  {
    if: 'A supplier offers a bulk price or an early-pay discount that expires this week',
    means: 'The saving is real, but only if the cash is on hand now',
    product: mca,
    why: 'The fastest product to fund; you repay from sales rather than a fixed monthly bill',
    range: `${mca.spec!.amounts} · ${mca.spec!.terms}`,
  },
  {
    if: 'Card sales are strong, but settlement runs behind rent and payroll in a slow month',
    means: 'The money exists, it just has not landed yet',
    product: mca,
    why: 'Repayment moves with your daily or weekly sales, so quiet weeks cost less',
    range: `${mca.spec!.amounts} · ${mca.spec!.terms}`,
  },
  {
    if: 'You are opening a second store or finishing a build-out with a known end date',
    means: 'The spend lands now; the sales build over the following year',
    product: SERVICES.find((s) => s.slug === 'business-term-loan')!,
    why: 'One fixed monthly payment over 6 – 36 months, sized to what the new store should do',
    range: 'From the Business Term Loan page',
  },
  {
    if: 'You need refrigeration, shelving, POS, security or a delivery van',
    means: "A one-time purchase a single month's margin cannot cover",
    product: collateral,
    why: 'What you buy secures the loan, and the term matches how long it keeps earning',
    range: `${collateral.spec!.amounts} · ${collateral.spec!.terms}`,
  },
  {
    if: 'Your wholesale or trade customers pay you on 30–60 day terms',
    means: 'You made the sale, but you are financing your customer\u2019s float',
    product: SERVICES.find((s) => s.slug === 'invoice-factoring-tool')!,
    why: 'Turns outstanding business-to-business invoices into cash now',
    range: 'From the Invoice Factoring Tool page',
  },
  {
    if: "Two or three advances from last season still take a bite out of every day's sales",
    means: 'Stacked payments are how a good month turns into a bad one',
    product: SERVICES.find((s) => s.slug === 'consolidation-of-positions')!,
    why: 'Pays off the positions you have and rolls them into one payment sized to your sales',
    range: 'From the Consolidation of Positions page',
  },
  {
    if: 'You need seasonal staff on the floor weeks before the traffic arrives',
    means: 'Payroll is a fixed cost against sales that have not started',
    product: loc,
    why: 'Draw for the hire-up, repay it from the peak-season sales',
    range: `${loc.spec!.amounts} · ${loc.spec!.terms.toLowerCase()}`,
  },
];

const retailProducts = [
  {
    service: loc,
    fit: 'The default for a repeating buying cycle. Draw what each order needs, repay as the stock sells, and keep the facility for next season.',
    intent: 'stockroom shelves stacked with boxed inventory',
  },
  {
    service: mca,
    fit: 'For card-heavy stores that need money quickly and cannot wait on a bank. Repayment follows sales, but it costs more than a line of credit, so use it for short, high-turn purchases rather than planned buying.',
    intent: 'card payment terminal on a shop counter',
  },
  {
    service: collateral,
    fit: 'For the assets behind the shop — refrigeration, fixtures, POS hardware or a delivery van. A fixed term spreads the cost over the years the equipment keeps working.',
    intent: 'refrigerated display cases along a grocery aisle',
  },
];

const exits = [
  {
    title: 'If you sell to other businesses and wait on invoices',
    body: 'That is a collections problem rather than a sales problem. Invoice factoring is built for it.',
    linkLabel: 'Invoice Factoring Tool',
    href: '/services/invoice-factoring-tool',
    read: '/blog/invoice-factoring-vs-ar-financing',
    readLabel: 'Invoice factoring vs AR financing',
  },
  {
    title: 'If you are already carrying more than one advance',
    body: 'Adding another position on top is what turns a manageable month into a bad one. Consolidation pays the existing positions down and rolls them into one payment.',
    linkLabel: 'Consolidation of Positions',
    href: '/services/consolidation-of-positions',
    read: '/blog/consolidation-of-positions-stacked-advances',
    readLabel: 'Consolidating stacked advances',
  },
  {
    title: 'If the money is for a planned expansion with a fixed finish date',
    body: 'A term loan prices a known project better than a sales-linked product, because the repayment does not move with a season you have not traded yet.',
    linkLabel: 'Business Term Loan',
    href: '/services/business-term-loan',
    read: '/blog/merchant-cash-advance-vs-business-term-loan',
    readLabel: 'MCA vs business term loan',
  },
];

const cases = [
  {
    title: 'Stocking the holiday quarter',
    body: 'A boutique draws on its line of credit in late summer to place holiday orders, then pays the balance down from November and December sales.',
  },
  {
    title: "Taking a supplier's early-pay discount",
    body: 'A hardware store uses a short draw to pay a supplier invoice early and keeps the discount, which can be worth more than the cost of that draw for the period.',
  },
  {
    title: 'Refitting the sales floor',
    body: 'A specialty grocer finances new refrigerated cases and a POS upgrade over a fixed term, so the purchase does not eat its operating cash.',
  },
];

const faqs = [
  {
    q: 'What can a retail business use funding for?',
    a: "Stock, seasonal payroll, a supplier's early-pay discount, store fit-outs and equipment such as refrigeration, shelving, POS or a delivery vehicle. Falcon does not restrict the use of proceeds to one category.",
  },
  {
    q: 'How much can a retail store borrow?',
    a: '$5,000 to $5,000,000 depending on the product. A line of credit runs $10,000 – $500,000, an advance $5,000 – $5,000,000, and a collateral loan $10,000 – $1,000,000. The final number depends on your sales, your time in business and your bank activity.',
  },
  {
    q: 'Is a line of credit or a cash advance better for inventory?',
    a: 'If you buy on a repeating cycle, a line of credit is usually cheaper and reusable. An advance is faster to qualify for but costs more, so it fits a one-off, short-turn purchase rather than a planned seasonal buy.',
  },
  {
    q: 'Can I get funding if most of my sales are on cards?',
    a: 'Yes. Card-heavy stores are a common fit for a merchant cash advance, where repayment is a share of sales rather than a fixed monthly payment.',
  },
  {
    q: 'How fast can funding land before a holiday order?',
    a: "Many products fund within 24-48 hours of approval. Timing depends on how quickly you send documents, so start before the supplier's deadline rather than on it.",
  },
  {
    q: 'What does it cost?',
    a: 'Falcon charges a 0% agreement fee. For a sales-linked product, the total amount you are selling and the percentage of sales that goes toward it are both spelled out on the agreement before you sign. No specific rate is published here, because it depends on your file.',
  },
  {
    q: 'What do I need to apply?',
    a: 'Six months of business bank statements, a photo ID, a voided check, a list of any current advances or loans, and a quote or invoice for equipment.',
  },
];

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Industries', path: '/#industries-heading' },
    { name: 'Retail business loans', path: '/industries/retail' },
  ]),
  faqSchema(faqs),
  ...retailProducts.map(({ service }) =>
    serviceSchema({ name: service.name, summary: service.summary, slug: service.slug }),
  ),
];

const metaDescription =
  'Retail business loans for inventory, seasonal payroll and store fit-outs. A line of credit up to $500,000, advances up to $5,000,000, and equipment loans. 0% agreement fee.';
---

<BaseLayout
  title="Retail business loans"
  description={metaDescription}
  schema={schema}
  disclosure={PAGE_DISCLOSURE}
>
  <Fragment slot="head">
    <script is:inline>
      (function () {
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          document.documentElement.classList.add('has-js');
          window.setTimeout(function () {
            if (!window.__pilotRevealReady) document.documentElement.classList.remove('has-js');
          }, 2500);
        } catch (e) {}
      })();
    </script>
  </Fragment>

  <nav class="ret-crumbs" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="ret-crumbs-list">
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><span aria-current="false">Industries</span></li>
        <li aria-hidden="true">/</li>
        <li><span aria-current="page">Retail</span></li>
      </ol>
    </div>
  </nav>

  {/* 1 page header (TF-00) · 2 glance figures (IR-00 / PE-02) · 3 header still (TF-01) */}
  <section class="ret-hero" aria-labelledby="page-hero-heading" data-band="light" data-ret-section="header" data-reveal-root>
    <div class="container-site">
      <div class="ret-grid ret-hero-grid">
        <h1 id="page-hero-heading" class="ret-h1" data-reveal>Retail business loans</h1>
        <p class="ret-body ret-standfirst" data-reveal>
          Stock the shelves before the money comes back. Funding that moves with your selling season, not against it.
        </p>
        <a class="arrow-cta ret-hero-apply" href="/apply" data-reveal>
          <span class="arrow-cta-label">Apply for funding</span>
          <CircleArrow />
        </a>
        <div class="ret-glance" data-reveal>
          {
            glance.map((item) => (
              <div class="ret-glance-cell">
                <p class="ret-glance-value">{item.value}</p>
                <p class="ret-glance-label">{item.label}</p>
              </div>
            ))
          }
        </div>
        <div class="ret-hero-media" data-reveal>
          <Media
            labeled
            intent="stocked shop shelves seen from the aisle, boxes still on the floor"
            ratio="16 / 9"
            sizes="(min-width: 90em) 1264px, (min-width: 64em) 1136px, 100vw"
          />
        </div>
      </div>
    </div>
  </section>

  {/* 4 answer first — TF-02: dark band, claim left, answer + numbered rows right */}
  <section class="ret-band ret-band--dark ret-answer" aria-labelledby="answer-heading" data-band="dark" data-ret-section="answer" data-reveal-root>
    <div class="container-site">
      <div class="ret-grid">
        <div class="ret-answer-head" data-reveal>
          <Eyebrow>In short</Eyebrow>
          <h2 id="answer-heading" class="ret-claim">How retail businesses use Falcon.</h2>
        </div>
        <div class="ret-answer-side" data-reveal>
          <p class="ret-body ret-answer-lead">{answerLead}</p>
          <ol class="ret-takeaways">
            {
              takeaways.map((item, i) => (
                <li class="ret-takeaway">
                  <span class="ret-takeaway-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  {/* 5 four cash pressures — TF-05: titled prose columns, no card chrome */}
  <section class="ret-band ret-cash" aria-labelledby="cash-heading" data-band="light" data-ret-section="cash" data-reveal-root>
    <div class="container-site">
      <div class="ret-grid">
        <div class="ret-cash-head" data-reveal>
          <Eyebrow>What it costs you</Eyebrow>
          <h2 id="cash-heading" class="ret-claim">Four things eat a retailer's cash</h2>
          <p class="ret-body ret-cash-intro">
            None of this is a spending problem. It is a timing problem — the money goes out months before it comes
            back.
          </p>
        </div>
        <div class="ret-values">
          {
            pressures.map((item) => (
              <article class="ret-value" data-reveal>
                <h3 class="ret-value-title">{item.title}</h3>
                <p class="ret-body ret-body--sm">{item.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* 6 the retail year — TF-03 / PE-05 row geometry, chevrons dropped */}
  <section class="ret-band ret-band--tint ret-year" aria-labelledby="year-heading" data-band="light" data-ret-section="year" data-reveal-root>
    <div class="container-site">
      <div class="ret-grid">
        <div class="ret-year-head" data-reveal>
          <Eyebrow>Why timing matters</Eyebrow>
          <h2 id="year-heading" class="ret-claim">Your year has four cash moments</h2>
          <p class="ret-body ret-year-intro">
            Retail cash flow is not flat. These are the four points where the money and the sales drift apart.
          </p>
        </div>
        <div class="ret-year-rows">
          {
            year.map((item) => (
              <article class="ret-year-row" data-reveal>
                <p class="ret-label ret-period">{item.period}</p>
                <h3 class="ret-year-title">{item.title}</h3>
                <p class="ret-body ret-body--sm ret-year-body">{item.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* 7 which funding fits — no donor section; our own table in the library's conventions */}
  <section class="ret-band ret-situation" aria-labelledby="situation-heading" data-band="light" data-ret-section="situation" data-reveal-root>
    <div class="container-site">
      <div class="ret-grid">
        <div class="ret-situation-head" data-reveal>
          <Eyebrow>Find your situation</Eyebrow>
          <h2 id="situation-heading" class="ret-claim">Which funding fits your store right now?</h2>
          <p class="ret-body ret-situation-intro">
            Most owners arrive with a sentence, not a product. Find the sentence that sounds like your month.
          </p>
        </div>
        <div class="ret-table-shell" data-reveal>
          <div class="r-table-wrap">
            <table class="r-table ret-situation-table">
              <caption class="sr-only">Retail situations and the Falcon product that fits each one</caption>
              <thead>
                <tr>
                  <th scope="col">If this is your situation</th>
                  <th scope="col">What it means for your cash</th>
                  <th scope="col">Falcon product</th>
                  <th scope="col">Why that one</th>
                  <th scope="col">Range</th>
                </tr>
              </thead>
              <tbody>
                {
                  situations.map((row) => (
                    <tr>
                      <th scope="row">{row.if}</th>
                      <td data-label="What it means">{row.means}</td>
                      <td data-label="Product">
                        <a class="ret-inline-link" href={`/services/${row.product.slug}`}>{row.product.name}</a>
                      </td>
                      <td data-label="Why that one">{row.why}</td>
                      <td data-label="Range">{row.range}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 8 three products — PE-04 card + BMX-03 spec block, closed by one line */}
  <section class="ret-band ret-band--stacked ret-products" aria-labelledby="products-heading" data-band="light" data-ret-section="products" data-reveal-root>
    <div class="container-site">
      <div class="ret-grid">
        <div class="ret-products-head" data-reveal>
          <Eyebrow>Products</Eyebrow>
          <h2 id="products-heading" class="ret-claim">Three ways to fund a retail business</h2>
          <p class="ret-body ret-products-intro">Same application, same specialist — three different shapes of money.</p>
        </div>
        <div class="ret-product-list">
          {
            retailProducts.map(({ service, fit, intent }) => (
              <article class="ret-product" data-reveal>
                <div class="ret-product-media">
                  <Media
                    labeled
                    intent={intent}
                    ratio="16 / 9"
                    sizes="(min-width: 80em) 400px, (min-width: 64em) 33vw, 100vw"
                  />
                </div>
                <h3 class="ret-product-title">{service.name}</h3>
                <p class="ret-body ret-body--sm">{fit}</p>
                <dl class="ret-spec">
                  <div class="ret-spec-row">
                    <dt>Who it's for</dt>
                    <dd>{service.whoFor}</dd>
                  </div>
                  <div class="ret-spec-row">
                    <dt>Amounts</dt>
                    <dd>{service.spec!.amounts}</dd>
                  </div>
                  <div class="ret-spec-row">
                    <dt>Terms</dt>
                    <dd>{service.spec!.terms}</dd>
                  </div>
                  <div class="ret-spec-row">
                    <dt>Requirements</dt>
                    <dd>{service.spec!.requirements.join(' · ')}</dd>
                  </div>
                </dl>
                <a class="arrow-cta ret-product-link" href={`/services/${service.slug}`}>
                  <span class="arrow-cta-label">See {service.name}</span>
                  <CircleArrow />
                </a>
              </article>
            ))
          }
        </div>

        {/* Requirements are deliberately not repeated here: each card above carries its
            own Requirements row (verbatim spec) and the product page carries the full set.
            Only the no-restricted line stays — nothing else on the page says it. */}
        <div class="ret-products-note" data-reveal>
          <p class="ret-need-note">
            No restricted industries or states: Falcon has no restricted-industry or restricted-state list. Underwriting
            looks at the business, not the sector or the geography.
          </p>
          <p class="ret-need-links">
            <a class="ret-inline-link" href="/blog/24-48-hour-funding-checklist">The 24-48 hour funding checklist</a>
            <a class="ret-inline-link" href="/blog/what-your-bank-statements-say">What your bank statements say</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* 9 not the right fit — APM-09 two-column link grid */}
  <section class="ret-band ret-band--tint ret-fit" aria-labelledby="fit-heading" data-band="light" data-ret-section="fit" data-reveal-root>
    <div class="container-site">
      <div class="ret-grid">
        <div class="ret-fit-head" data-reveal>
          <Eyebrow>Not the right fit</Eyebrow>
          <h2 id="fit-heading" class="ret-claim">If none of these sounds like your month, it may be a different product.</h2>
        </div>
        <div class="ret-exit-list">
          {
            exits.map((item) => (
              <article class="ret-exit" data-reveal>
                <h3 class="ret-exit-title">{item.title}</h3>
                <p class="ret-body ret-body--sm">{item.body}</p>
                <div class="ret-exit-links">
                  <a class="arrow-cta" href={item.href}>
                    <span class="arrow-cta-label">{item.linkLabel}</span>
                    <CircleArrow />
                  </a>
                  <a class="ret-read" href={item.read}>Read: {item.readLabel}</a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* 10 three files in practice — BMX-03…06 stat card, figure slot holds the number */}
  <section class="ret-band ret-cases" aria-labelledby="cases-heading" data-band="light" data-ret-section="cases" data-reveal-root>
    <div class="container-site">
      <div class="ret-grid">
        <div class="ret-cases-head" data-reveal>
          <Eyebrow>How it looks in practice</Eyebrow>
          <h2 id="cases-heading" class="ret-claim">Three retail files, three shapes of money</h2>
        </div>
        <div class="ret-case-list">
          {
            cases.map((item, i) => (
              <article class="ret-case" data-reveal>
                <p class="ret-case-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
                <h3 class="ret-case-title">{item.title}</h3>
                <p class="ret-body ret-body--sm">{item.body}</p>
              </article>
            ))
          }
        </div>
        <div class="ret-read-next" data-reveal>
          <p class="ret-label">Read next</p>
          <a class="ret-inline-link" href="/blog/bridging-a-slow-season">Bridging a slow season</a>
          <a class="ret-inline-link" href="/blog/equipment-financing-break-even">Equipment financing break-even</a>
        </div>
      </div>
    </div>
  </section>

  {/* 11 FAQ — APM-08 / BMX-09: heading left, accordion rows right */}
  <section class="ret-band ret-faq" aria-labelledby="faq-heading" data-band="light" data-ret-section="faq" data-reveal-root>
    <div class="container-site">
      <div class="ret-grid">
        <div class="ret-faq-head" data-reveal>
          <Eyebrow>FAQ</Eyebrow>
          <h2 id="faq-heading" class="ret-claim">Retail funding questions</h2>
        </div>
        <div class="ret-faq-list" data-accordion data-reveal>
          {
            faqs.map((item, i) => (
              <div class="ret-faq-item" data-acc-item>
                <h3>
                  <button
                    type="button"
                    class="ret-faq-trigger"
                    aria-expanded="false"
                    aria-controls={`ret-faq-panel-${i}`}
                    id={`ret-faq-trigger-${i}`}
                    data-acc-trigger
                  >
                    <span>{item.q}</span>
                    <span class="ret-faq-caret" aria-hidden="true">
                      <span class="ret-faq-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="8" viewBox="0 0 18 10" fill="none" class="ret-faq-caret-svg">
