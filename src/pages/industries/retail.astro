---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PilotPageHero from '@/components/pilot/PilotPageHero.astro';
import PilotAnswer from '@/components/pilot/PilotAnswer.astro';
import PilotGlance from '@/components/pilot/PilotGlance.astro';
import PilotWhatWeDo from '@/components/pilot/PilotWhatWeDo.astro';
import PilotEyebrow from '@/components/pilot/PilotEyebrow.astro';
import PilotAccordion from '@/components/pilot/PilotAccordion.astro';
import PilotTextBand from '@/components/pilot/PilotTextBand.astro';
import PilotQualify from '@/components/pilot/PilotQualify.astro';
import PilotTrust from '@/components/pilot/PilotTrust.astro';
import ResponsiveTable from '@/components/ResponsiveTable.astro';
import { INDUSTRIES } from '@/data/industries';
import { getService } from '@/data/services';
import { PAGE_DISCLOSURE } from '@/data/disclosure';
import { breadcrumbSchema, faqSchema } from '@/lib/schema';
import '@/styles/pilot.css';

const industry = INDUSTRIES.find((item) => item.slug === 'retail');
if (!industry) throw new Error('Retail industry is missing');

const loc = getService('business-line-of-credit');
const mca = getService('merchant-cash-advance');
const collateral = getService('collateral-asset-loans');
if (!loc?.spec || !mca?.spec || !collateral?.spec) throw new Error('Retail product specs are missing');

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Industries', path: '/industries' },
  { name: industry.name, path: `/industries/${industry.slug}` },
];

const faqs = [
  {
    q: 'What do I need to apply for a retail business loan?',
    a: 'Usually several months of business bank statements, basic business and owner details, and a vendor quote or invoice if equipment is involved.',
  },
  {
    q: 'Is a line of credit or a cash advance better for inventory?',
    a: 'If you buy on a repeating cycle, a line of credit is usually cheaper and reusable. A cash advance is faster to qualify for but costs more, so it fits one-off, short-turn purchases rather than a planned seasonal buy.',
  },
  {
    q: 'How much can a retail store borrow?',
    a: `It depends on the product. A line of credit runs ${loc.spec.amounts}, an advance ${mca.spec.amounts}, and collateral or asset loans ${collateral.spec.amounts}. Final amounts depend on underwriting.`,
  },
  {
    q: 'What if most of my sales are seasonal?',
    a: 'Underwriters read the pattern in your statements, so explain it up front rather than letting a quiet month look like a decline. A line of credit drawn before the season is usually cheaper than an advance taken during it.',
  },
  {
    q: 'How fast can funding land?',
    a: 'Many products fund within 24-48 hours of approval. Timing depends on how quickly you provide documents, and approval is not guaranteed.',
  },
  {
    q: 'Can I finance the fixtures instead of borrowing cash?',
    a: `Yes, if the purchase comes with a vendor quote or invoice. Collateral and asset loans carry ${collateral.spec.terms} terms, which suits equipment that stays in service for years.`,
  },
];
---

<BaseLayout
  title={industry.seoTitle}
  description={industry.seoDescription}
  schema={[breadcrumbSchema(crumbs), faqSchema(faqs)]}
  disclosure={PAGE_DISCLOSURE}
>
  <PilotPageHero
    title={industry.h1}
    lead={industry.subtitle}
    intent="Closed shopfront with stock visible through the window, shot from the street."
    imageAlt="Closed shopfront with stock visible through the window, shot from the street."
    ctaHref="/apply"
    ctaLabel="Apply for funding"
  />

  <PilotAnswer
    answer="Retail businesses fund stock, staffing and fit-outs with three products: a business line of credit for repeating inventory cycles, a sales-based advance for fast, short-term cash, and collateral or asset loans for fixtures and vehicles. Amounts run from $5,000 to $5,000,000 depending on the product. Many products fund within 24-48 hours of approval."
    takeaways={[
      'A line of credit suits a repeating buying cycle: draw for each order, repay as the stock sells, draw again next season.',
      'A merchant cash advance is quicker to qualify for but costs more, so keep it to short purchases with fast sell-through.',
      'Match the repayment term to the life of what you buy — a walk-in cooler outlives one holiday season, a stock order does not.',
      'Size the order from last year’s sell-through, not from the maximum amount you were approved for.',
    ]}
  />

  <PilotGlance
    cells={[
      { value: mca.spec.amounts, label: 'Amounts across the three products' },
      { value: mca.spec.terms, label: 'Shortest product term' },
      { value: '24-48 hours', label: 'Funding after approval, many products' },
      { value: '3+ months in business', label: 'Minimum for an advance; 6+ for a line or asset loan' },
    ]}
  />

  <section class="pilot-section" aria-labelledby="products-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="pilot-section-head bx-span-4 bx-md-full bx-lg-span-10">
          <PilotEyebrow>Products</PilotEyebrow>
          <h2 id="products-heading">Which funding product fits a retail business?</h2>
        </div>
        <p class="pilot-section-body bx-span-4 bx-lg-span-6 bx-lg-start-7">
          Retail has three recurring shapes of problem. Each maps to one product.
        </p>
        <div class="bx-full">
          <ResponsiveTable
            caption="Retail funding products by need"
            labelledBy="products-heading"
            headers={['The need', 'The product', 'Why it fits']}
            rows={[
              [
                'Stock you will reorder every season',
                { href: '/services/business-line-of-credit', text: loc.name },
                'Draw per purchase order, repay as it sells, reuse the facility next season',
              ],
              [
                'Cash within days, mostly card sales',
                { href: '/services/merchant-cash-advance', text: mca.name },
                'Approval looks at revenue and bank activity, and repayment follows sales',
              ],
              [
                'Refrigeration, fixtures, POS or a van',
                { href: '/services/collateral-asset-loans', text: collateral.name },
                'A fixed term spreads the cost across the years the asset keeps earning',
              ],
            ]}
          />
          <p class="pilot-section-note">
            Already carrying several advances? Consolidation of Positions combines positions into one payment — see
            <a class="link" href="/services/consolidation-of-positions">Consolidation of Positions</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="pilot-section" aria-labelledby="detail-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="pilot-section-head bx-span-4 bx-md-full bx-lg-span-10">
          <PilotEyebrow>Product detail</PilotEyebrow>
          <h2 id="detail-heading">What each one costs and requires.</h2>
        </div>
        <div class="pilot-section-body bx-span-4 bx-lg-span-6 bx-lg-start-7">
          <PilotAccordion
            variant="strategies"
            idPrefix="retail-spec"
            items={[
              {
                q: loc.name,
                a: `The default for a repeating inventory cycle. Draw what each order needs, repay as the stock sells, keep the facility for next season. [See ${loc.name}](/services/business-line-of-credit).`,
                bullets: [
                  `Who it's for: ${loc.spec.whoFor}`,
                  `Amounts: ${loc.spec.amounts}`,
                  `Terms: ${loc.spec.terms}`,
                  `Requirements: ${loc.spec.requirements.join(' · ')}`,
                ],
              },
              {
                q: mca.name,
                a: `For card-heavy stores that need cash quickly and cannot wait on a bank. Repayment follows sales, but it costs more than a line of credit, so use it for short, high-turn purchases rather than planned buying. [See ${mca.name}](/services/merchant-cash-advance).`,
                bullets: [
                  `Who it's for: ${mca.spec.whoFor}`,
                  `Amounts: ${mca.spec.amounts}`,
                  `Terms: ${mca.spec.terms}`,
                  `Requirements: ${mca.spec.requirements.join(' · ')}`,
                ],
              },
              {
                q: collateral.name,
                a: `For the assets behind the shop: refrigeration, fixtures, POS hardware or a delivery van. A fixed term spreads the cost over the years the equipment keeps working. [See ${collateral.name}](/services/collateral-asset-loans).`,
                bullets: [
                  `Who it's for: ${collateral.spec.whoFor}`,
                  `Amounts: ${collateral.spec.amounts}`,
                  `Terms: ${collateral.spec.terms}`,
                  `Requirements: ${collateral.spec.requirements.join(' · ')}`,
                ],
              },
            ]}
          />
        </div>
      </div>
    </div>
  </section>

  <PilotWhatWeDo
    id="needs-heading"
    eyebrow="Funding needs"
    title="Where does retail capital go first?"
    lead="Retail cash leaves the account months before the season pays it back. These are the four places it goes."
    items={[
      {
        title: 'Inventory bought long before it sells',
        body: 'Holiday and back-to-school orders are placed and paid for in advance, so the cash is gone well before the revenue arrives.',
      },
      {
        title: "A vendor's early-pay discount",
        body: 'Ordering in volume or paying a wholesaler early lowers unit cost, but only if the cash is on hand while the offer stands.',
      },
      {
        title: 'Seasonal staffing',
        body: 'Extra hands for peak weeks are hired and paid before peak sales land.',
      },
      {
        title: 'Fixtures, POS and security',
        body: "Refrigeration, shelving, terminals and cameras are one-time purchases that a single month's margin cannot absorb.",
      },
    ]}
    intent="holiday inventory cartons stacked in a stockroom"
    imageAlt="Placeholder for stacked inventory boxes in a retail stockroom"
  />

  <PilotTextBand
    id="use-cases-heading"
    eyebrow="Use cases"
    title="Situations owners bring to Falcon."
    items={[
      {
        title: 'Stocking the holiday quarter',
        body: 'A boutique draws on its line of credit in late summer to place holiday orders, then pays the balance down from November and December sales.',
      },
      {
        title: 'Taking an early-pay discount',
        body: 'A hardware store uses a short draw to pay a supplier invoice early and keeps the discount, which can outweigh the cost of the draw for that period.',
      },
      {
        title: 'Refitting the sales floor',
        body: 'A specialty grocer finances new refrigerated cases and a POS upgrade over a fixed term, so the purchase does not eat its operating cash.',
      },
    ]}
  />

  <PilotQualify
    title="What does a retail business need to qualify?"
    cells={[
      {
        value: '3+ months for an advance; 6+ months for a line of credit or asset loan',
        label: 'Time in business',
      },
      { value: '$10K+ in consistent deposits', label: 'Monthly revenue' },
      { value: 'Six months, complete PDFs, for most files', label: 'Bank statements' },
      { value: 'A vendor quote or invoice, for asset-backed funding', label: 'Equipment purchase' },
    ]}
    note="Most files need six months of business bank statements, photo ID, a voided check and a debt schedule. Falcon has no restricted-industry or restricted-state list. See the [24–48 hour funding checklist](/blog/24-48-hour-funding-checklist)."
  />

  <section class="pilot-section" aria-labelledby="retail-faq-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="pilot-section-head bx-span-4 bx-md-full bx-lg-span-10">
          <PilotEyebrow>FAQ</PilotEyebrow>
          <h2 id="retail-faq-heading">Retail funding questions</h2>
        </div>
        <div class="pilot-section-body bx-span-4 bx-lg-span-6 bx-lg-start-7">
          <PilotAccordion items={faqs} idPrefix="retail-faq" />
        </div>
      </div>
    </div>
  </section>

  <PilotTrust />
</BaseLayout>
