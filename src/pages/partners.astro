---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import ImageSlot from '@/components/ImageSlot.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import { SITE } from '@/data/site';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Partners', path: '/partners' },
];

const audiences = [
  {
    icon: 'handshake',
    title: 'Brokers',
    body: 'A full product set for your clients, from merchant cash advances to consolidation.',
  },
  {
    icon: 'users',
    title: 'ISOs',
    body: 'Responsive underwriting and clear communication on every file.',
  },
  {
    icon: 'landmark',
    title: 'Funders and lenders',
    body: 'Access to qualified business owners across a wide range of industries.',
  },
];
---

<BaseLayout
  title="Partners"
  description="Partner with Falcon Equity Group. We work with brokers, ISOs and funders to deliver fast, well-matched business funding."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Partners"
    lead="Brokers, ISOs and funders. Fast decisions. The right product for the file."
  />

  <section class="section bg-white" aria-labelledby="who-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="bx-full">
          <Eyebrow>Partners</Eyebrow>
          <h2 id="who-heading" class="mt-4">Who we partner with</h2>
        </div>
        {
          audiences.map((a) => (
            <div class="tile-card bx-span-4 bx-lg-span-4">
              <Icon name={a.icon} size={28} class="text-ink" />
              <h3 class="mt-5">{a.title}</h3>
              <p class="mt-3 text-ink-soft">{a.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="featured-heading">
    <div class="container-site">
      <div class="bx-grid items-center">
        <div class="bx-span-4 bx-lg-span-5">
          <ImageSlot intent="handshake across a conference table, warm light" ratio="4 / 3" />
        </div>
        <div class="bx-span-4 bx-lg-span-6 bx-lg-start-7">
          <img src={SITE.partner.logo} alt="Cardiff logo" width="416" height="94" loading="lazy" decoding="async" class="h-auto w-full max-w-[16rem]" />
          <Eyebrow>Featured</Eyebrow>
          <h2 id="featured-heading" class="mt-4">Cardiff</h2>
          <p class="section-lead mt-5">
            Cardiff expands the options available to business owners. Their products are subject to Cardiff’s terms and approval.
          </p>
          <a href={SITE.partner.url} class="btn-primary mt-6" target="_blank" rel="noopener sponsored">
            Visit Cardiff<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cta text-ink" aria-labelledby="partner-cta-heading">
    <div class="container-site section">
      <div class="bx-grid items-end">
        <div class="bx-span-4 bx-lg-span-6">
          <h2 id="partner-cta-heading">Work with Falcon</h2>
          <p class="mt-5 text-ink">Email a short note about your firm and the clients you serve.</p>
        </div>
        <div class="cta-band-actions bx-span-4 bx-lg-span-5 bx-lg-start-8">
          <a href={`mailto:${SITE.email}?subject=Partnership%20inquiry`} class="btn-primary">Email us</a>
          <a href={SITE.phones.office.href} class="btn-outline-dark">{SITE.phones.office.display}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
