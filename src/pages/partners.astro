---
/**
 * `/partners` — brokers, ISOs, funding partners and service partners.
 *
 * Copy: the 23 Oct 2026 partners contract, verbatim. Twelve bands, in its order:
 *
 *    1  hero ............... TF-00 header + TF-01 still, no CTA
 *    2  in short ........... TF-02 rows-beside-a-claim, on white
 *    3  partner types ...... TF-05 3-up titled prose, no chrome
 *    4  product shelf ...... PWS-10 dark link list, seven rows
 *    5  submission ......... BMX-10 title left, rows right, on white
 *    6  the shared client .. TF-02 dark claim band, four rows (one more than the donor)
 *    7  speed .............. APM-01 three numbered columns + one STATS figure
 *    8  our partners ....... PE-04 card row, rendered from src/data/partners.ts
 *    8b Cardiff ............ BXCI-06 featured split, logo in place of the still
 *    9  become a partner ... HOME-07 heading left, two text columns right (no form)
 *   10  FAQ ................ APM-08 / PWS-09 via the shared FaqList + FAQPage schema
 *   11  CTA ................ SiteCta, static variant (heading + email + direct line)
 *
 * Figures come from the data layer only: amounts, speeds and terms from SERVICES,
 * the three steps from STANDARD_STEPS, the funding-time figure from STATS, contact
 * from SITE. Nothing on this page publishes a rate, the approval figure or a
 * consolidation-savings figure. Plan: docs/partners-structure-plan.md.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Media from '@/components/Media.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Button040 from '@/components/Button040.astro';
import ArrowCta from '@/components/ArrowCta.astro';
import CircleArrow from '@/components/CircleArrow.astro';
import FaqList from '@/components/FaqList.astro';
import SiteCta from '@/components/SiteCta.astro';
import { PAGE_DISCLOSURE } from '@/data/disclosure';
import { SITE, STATS } from '@/data/site';
import { getService, STANDARD_STEPS } from '@/data/services';
import { PARTNERS, BECOME_A_PARTNER } from '@/data/partners';
import { breadcrumbSchema, faqSchema } from '@/lib/schema';
import heroStill from '@/assets/images/hero-falcon.webp';
import '@/styles/partners.css';

const PARTNER_SUBJECT = 'Partner enquiry';
const PARTNER_MAILTO = `mailto:${SITE.email}?subject=${encodeURIComponent(PARTNER_SUBJECT)}`;
const DIRECT = SITE.phones.direct;
const CARDIFF = PARTNERS.find((p) => p.name === SITE.partner.name);
if (!CARDIFF) throw new Error('src/data/partners.ts is missing Cardiff — the Cardiff band reads it from there.');
const OUTBOUND_REL = 'noopener sponsored';

const TAKEAWAYS = [
  'one desk contact per partner, not a queue',
  'seven products on one application, so a file is never re-pitched product by product',
  'no restricted-industry or restricted-state list; underwriting still decides',
  'a complete file gets a same-day read, and the desk says plainly when a file is not placeable',
];

const PARTNER_TYPES = [
  {
    title: 'Brokers and ISOs',
    body: 'You talk to owners all day and you have already read the statements before you send them. Submit once; the answer covers every product Falcon can place, not just the one you asked about.',
  },
  {
    // TODO(client): confirm the funding-partner programme. Card and wording approved as written.
    title: 'Funding partners',
    body: 'Lenders, funds and syndicators who take positions Falcon does not hold itself.',
  },
  {
    title: 'Service partners',
    body: 'Firms that get an owner ready rather than fund them. Cardiff is one: a small-business financing marketplace whose application Falcon links to for products such as business credit cards.',
  },
];

/**
 * Row labels are the contract's; every figure is read from SERVICES. A product with no
 * `speed` in the data layer shows its published terms instead — no speed is invented.
 * Decentralized Business Financing has no /services page, so it links where home does.
 */
const SHELF_ROWS = [
  { slug: 'merchant-cash-advance', label: 'Merchant Cash Advance' },
  { slug: 'business-line-of-credit', label: 'Business Line of Credit' },
  { slug: 'business-term-loan', label: 'Business Term Loan' },
  { slug: 'collateral-asset-loans', label: 'Collateral & Asset Loans' },
  { slug: 'invoice-factoring-tool', label: 'Invoice Factoring' },
  { slug: 'consolidation-of-positions', label: 'Consolidation of Positions' },
  { slug: 'decentralized-business-financing', label: 'Decentralized Business Financing' },
].map(({ slug, label }) => {
  const service = getService(slug);
  if (!service) throw new Error(`SERVICES is missing "${slug}" — the partners product shelf reads it from there.`);
  return {
    label,
    href: slug === 'decentralized-business-financing' ? '/#services' : `/services/${slug}`,
    amounts: service.amounts,
    second: service.speed ? { name: 'Speed', value: service.speed } : { name: 'Terms', value: service.terms },
  };
});

const DOCUMENTS = [
  {
    name: 'Six months of business bank statements',
    note: 'complete PDFs, every page, every account the business runs money through.',
  },
  { name: 'Government-issued photo ID', note: 'for the signing owner.' },
  { name: 'A voided check', note: 'from the business account that will receive funds.' },
  {
    name: 'A debt schedule',
    note: 'listing every open advance or loan: lender, amount, date taken, remaining balance.',
  },
];

const COMMITMENTS = [
  {
    title: 'Full cost before signature.',
    body: 'Falcon charges a 0% agreement fee and rates are competitive. The complete cost of the position is shown to the owner before they sign, and no rate is quoted on this page.',
  },
  {
    title: 'One application, one specialist.',
    body: 'The owner is not handed to a queue, and the partner keeps the same contact from first file onward.',
  },
  {
    title: 'No invented restrictions.',
    body: 'Falcon keeps no restricted-industry list and no restricted-state list, so an owner is judged on the business rather than its sector or ZIP code. Underwriting and approval still apply.',
  },
  {
    title: 'A reason with every no.',
    body: 'When a file is declined, the owner and the partner get the reason and what would change it — not silence.',
  },
];

const PARTNER_LINES = [
  'the owner completes one short online application, and you get a copy of what was submitted.',
  'anything missing is asked for in one message, not four, and the specialist says which product fits.',
  'funds can arrive in as little as 24–48 hours after approval.',
];
const STEPS = STANDARD_STEPS.map((step, i) => ({ ...step, partner: PARTNER_LINES[i] }));

const fundingTime = STATS.find((s) => s.label === 'Average funding time');
if (!fundingTime) throw new Error('STATS is missing "Average funding time" — the speed band reads it from there.');

const FAQS = [
  {
    q: 'Do you accept broker and ISO submissions?',
    a: 'Yes. Send the file to information@falconequity.ai with the subject "Partner enquiry", using the document list above. One application covers all seven products, and the desk tells you which one fits.',
  },
  {
    q: 'What is an ISO, in Falcon’s terms?',
    a: 'An Independent Sales Organization introduces business owners to a lender and helps assemble the file. Falcon treats an ISO the same as a broker: one desk contact, one application, the same answer on whether the file is placeable.',
  },
  {
    q: 'Is there a restricted-industry or restricted-state list?',
    a: 'No. Falcon keeps neither list, so a file is judged on the business rather than its sector or location. Underwriting and approval still apply.',
  },
  {
    q: 'Who is my contact?',
    a: 'One specialist is assigned to each partner relationship and stays on it. Use the direct line and ask for the partner desk.',
  },
  {
    q: 'How do I become a Falcon partner?',
    a: 'Email information@falconequity.ai with "Partner enquiry" in the subject, or call the direct line. Say what you place and who you place it for. The desk reads one file, tells you what Falcon can and cannot place, and agrees terms before anything is submitted.',
  },
];

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Our Firm', path: '/about' },
    { name: 'Partners', path: '/partners' },
  ]),
  faqSchema(FAQS),
];
---

<BaseLayout
  title="Partners | Brokers, ISOs and funding partners | Falcon Equity Group"
  description="Send one file to one desk. Seven products from $5,000 to $5,000,000, no restricted-industry or restricted-state list, a 0% agreement fee, and a straight answer on whether a file is placeable."
  disclosure={PAGE_DISCLOSURE}
  schema={schema}
>
  <Fragment slot="head">
    <script is:inline>
      (function () {
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          document.documentElement.classList.add('has-js');
          window.setTimeout(function () {
            if (!window.__pilotRevealReady) document.documentElement.classList.remove('has-js');
          }, 2500);
        } catch (e) {}
      })();
    </script>
  </Fragment>

  <!-- 1. Hero — TF-00 header + TF-01 still: eyebrow + H1 in tracks 1-7, lead in 12-16, one 5:2 still. No CTA. -->
  <section
    class="ptn-hero"
    aria-labelledby="page-hero-heading"
    data-band="light"
    data-ptn-section="hero"
    data-reveal-root
    data-reveal-stagger="0"
    data-reveal-duration="0.55"
  >
    <div class="container-site">
      <div class="ptn-shell ptn-hero-head" data-reveal>
        <div class="ptn-hero-title-block">
          <Eyebrow>Partners</Eyebrow>
          <h1 id="page-hero-heading" class="ptn-hero-title">One desk. Seven products. An answer on the first file.</h1>
        </div>
        <p class="ptn-hero-lead">
          Falcon works with brokers, ISOs and funding partners who read a file before they send it. One specialist
          stays on the relationship, and the answer is honest — placeable, or not.
        </p>
      </div>
      <div class="ptn-hero-media" data-reveal-media>
        <Media
          image={heroStill}
          intent="Placeholder still: a peregrine falcon on a branch. Replace with an approved partners still (no people)."
          alt="A peregrine falcon perched on a twisted bare branch, looking back over its shoulder, against a dark background of soft gold light."
          ratio="5 / 2"
          priority
          sizes="(min-width: 90em) 1264px, (min-width: 80em) 1136px, (min-width: 48em) 688px, 100vw"
        />
      </div>
    </div>
  </section>

  <!-- 2. In short — TF-02 on white: the direct answer as the claim, four takeaways beside it. -->
  <section class="ptn-short" aria-label="In short" data-band="light" data-ptn-section="in-short" data-reveal-root>
    <div class="container-site">
      <div class="ptn-shell ptn-split">
        <div class="ptn-split-head" data-reveal>
          <Eyebrow>In short</Eyebrow>
          <p class="ptn-answer">
            Falcon Equity Group is a New York business lender that works with brokers, ISOs and funding partners. A
            partner submits one application for any of seven products, from $5,000 to $5,000,000, at a 0% agreement
            fee. There is no restricted-industry or restricted-state list. One specialist owns the relationship and
            answers on the file.
          </p>
        </div>
        <ul class="ptn-takeaways" data-reveal>
          {TAKEAWAYS.map((item) => <li class="ptn-takeaway">{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 3. Partner types — TF-05 3-up titled prose on the house 1/5 · 6/6 · 12/5 split. -->
  <section class="ptn-types" aria-labelledby="types-heading" data-band="light" data-ptn-section="types" data-reveal-root>
    <div class="container-site">
      <div class="ptn-block-head" data-reveal>
        <Eyebrow>Partner types</Eyebrow>
        <h2 id="types-heading">Three kinds of partner.</h2>
        <p class="ptn-lede">If you are not sure which one you are, send the file anyway and the desk will tell you.</p>
      </div>
      <div class="ptn-three" data-reveal>
        {
          PARTNER_TYPES.map((type) => (
            <article class="ptn-three-item">
              <h3 class="ptn-card-title">{type.title}</h3>
              <p class="ptn-card-body">{type.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Product shelf — PWS-10 dark link list: seven titled rows, each a real route. -->
  <section
    class="ptn-shelf on-dark"
    aria-labelledby="shelf-heading"
    data-band="dark"
    data-ptn-section="shelf"
    data-reveal-root
  >
    <div class="container-site">
      <div class="ptn-block-head" data-reveal>
        <Eyebrow>Product shelf</Eyebrow>
        <h2 id="shelf-heading">One application covers all seven.</h2>
        <p class="ptn-lede">
          A broker should not have to learn seven intake forms. One application, and the desk matches the product to
          the need.
        </p>
      </div>
      <ul class="ptn-shelf-list" data-reveal>
        {
          SHELF_ROWS.map((row) => (
            <li class="ptn-shelf-item">
              <a class="ptn-shelf-link" href={row.href}>
                <span class="ptn-shelf-name">
                  <span class="link-draw">{row.label}</span>
                </span>
                <span class="ptn-shelf-figures">
                  <span class="ptn-shelf-figure">
                    <span class="ptn-shelf-figure-label">Amount</span>
                    <span class="ptn-shelf-figure-value">{row.amounts}</span>
                  </span>
                  <span class="ptn-shelf-figure">
                    <span class="ptn-shelf-figure-label">{row.second.name}</span>
                    <span class="ptn-shelf-figure-value">{row.second.value}</span>
                  </span>
                </span>
                <CircleArrow class="ptn-shelf-arrow" />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="ptn-note ptn-note--on-dark" data-reveal>
        Amounts and speeds are the published figures on each product page. Every deal is underwritten on the file, so
        nothing here is a promise for a specific owner. Consolidation carries no published turnaround because the plan
        depends on the positions being replaced.
      </p>
    </div>
  </section>

  <!-- 5. Submission — BMX-10 on white: title left, four document rows right, two paragraphs under the rows. -->
  <section class="ptn-send" aria-labelledby="send-heading" data-band="light" data-ptn-section="submission" data-reveal-root>
    <div class="container-site">
      <div class="ptn-shell ptn-split">
        <div class="ptn-split-head" data-reveal>
          <Eyebrow>Submission</Eyebrow>
          <h2 id="send-heading">What to send with a file.</h2>
        </div>
        <div class="ptn-split-body" data-reveal>
          <dl class="ptn-docs">
            {
              DOCUMENTS.map((doc) => (
                <div class="ptn-doc">
                  <dt class="ptn-doc-name">{doc.name}</dt>
                  <dd class="ptn-doc-note">{doc.note}</dd>
                </div>
              ))
            }
          </dl>
          <p class="ptn-body">
            One more item per product: an equipment quote or invoice for asset-backed funding, or the open invoices and
            a customer list for factoring. A complete file is the difference between a same-day answer and a week of
            email — most delays are a missing statement page, not a decision.
          </p>
          <p class="ptn-body">
            If the file is not placeable, say so and send the one thing that would change it: six more months of
            statements, a cleaner deposit pattern, or a smaller first position. That answer is faster for you than a
            decline two days later.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. The shared client — TF-02 dark: claim + lede left, four numbered rows right. -->
  <section
    class="ptn-client on-dark"
    aria-labelledby="client-heading"
    data-band="dark"
    data-ptn-section="shared-client"
    data-reveal-root
  >
    <div class="container-site">
      <div class="ptn-shell ptn-split">
        <div class="ptn-split-head" data-reveal>
          <Eyebrow>The shared client</Eyebrow>
          <h2 id="client-heading">The owner signs, so the owner gets the truth.</h2>
          <p class="ptn-lede">A referral is a reputation. Here is what Falcon commits to on every file a partner sends.</p>
        </div>
        <ol class="ptn-commitments" data-reveal>
          {
            COMMITMENTS.map((item, i) => (
              <li class="ptn-commitment">
                <span class="ptn-commitment-num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="ptn-card-title">{item.title}</h3>
                  <p class="ptn-card-body">{item.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- 7. Speed — APM-01: three numbered columns (STANDARD_STEPS verbatim) + one partner line each, then the STATS figure. -->
  <section class="ptn-speed" aria-labelledby="speed-heading" data-band="light" data-ptn-section="speed" data-reveal-root>
    <div class="container-site">
      <div class="ptn-block-head" data-reveal>
        <Eyebrow>Speed</Eyebrow>
        <h2 id="speed-heading">Same day, where the file allows it.</h2>
        <p class="ptn-lede">
          The products that fund same day are the ones with the shortest document list. That is not a coincidence — it
          is the file, not the queue.
        </p>
      </div>
      <ol class="ptn-three ptn-steps" data-reveal>
        {
          STEPS.map((step, i) => (
            <li class="ptn-three-item ptn-step">
              <span class="ptn-step-num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="ptn-card-title">{step.title}</h3>
              <p class="ptn-card-body">{step.body}</p>
              <p class="ptn-step-partner">
                <span class="ptn-step-partner-label">For the partner:</span> {step.partner}
              </p>
            </li>
          ))
        }
      </ol>
      <p class="ptn-stat" data-reveal>
        <span class="ptn-stat-value">{fundingTime.value}</span>
        <span class="ptn-stat-label">{fundingTime.label}</span>
      </p>
    </div>
  </section>

  <!-- 8. Our partners — PE-04 card row from src/data/partners.ts. Partners fill from the left;
       the "Become a partner" text tile always takes the last track, so one partner still reads
       as a deliberate pair of bookends rather than a half-built row. -->
  <section class="ptn-row" aria-labelledby="row-heading" data-band="light" data-ptn-section="partners" data-reveal-root>
    <div class="container-site">
      <div class="ptn-block-head" data-reveal>
        <Eyebrow>Our partners</Eyebrow>
        <h2 id="row-heading">The firms we work with.</h2>
        <p class="ptn-lede">
          Cardiff is our first signed partner. The row is built to take more — lenders, funds and service firms that
          cover what Falcon does not do alone. Every mark appears only after written permission, and each partner gets
          one plain line, not a sales pitch.
        </p>
      </div>
      <ul class="ptn-tiles" data-reveal>
        {
          PARTNERS.map((partner) => (
            <li class="ptn-tile ptn-tile--partner">
              {partner.logo ? (
                <img
                  class="ptn-tile-logo"
                  src={partner.logo}
                  alt={partner.name}
                  width={partner.logoSize?.width}
                  height={partner.logoSize?.height}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <p class="ptn-tile-name">{partner.name}</p>
              )}
              <p class="ptn-tile-type">{partner.type}</p>
              <p class="ptn-tile-line">{partner.line}</p>
              {partner.url && (
                <a
                  class="arrow-cta ptn-tile-link"
                  href={partner.url}
                  {...(partner.external ? { target: '_blank', rel: OUTBOUND_REL } : {})}
                >
                  <span class="arrow-cta-label link-draw">Visit {partner.name}</span>
                  <CircleArrow />
                </a>
              )}
            </li>
          ))
        }
        <li class="ptn-tile ptn-tile--become">
          <a class="ptn-tile-become-link" href={BECOME_A_PARTNER.href}>
            <span class="ptn-tile-become-title">{BECOME_A_PARTNER.title}</span>
            <span class="ptn-tile-line">{BECOME_A_PARTNER.line}</span>
            <CircleArrow class="ptn-tile-become-arrow" />
          </a>
        </li>
      </ul>
      <p class="ptn-note" data-reveal>
        We are actively adding partners in three areas: lenders and funds that take positions Falcon does not hold,
        service firms that get an owner loan-ready, and the software owners already run their books on.
      </p>
    </div>
  </section>

  <!-- 8b. Cardiff — BXCI-06 featured split on the Lilac band: the logo stands where the still would, copy right. -->
  <section
    class="ptn-cardiff"
    aria-labelledby="cardiff-heading"
    data-band="light"
    data-ptn-section="cardiff"
    data-reveal-root
  >
    <div class="container-site">
      <div class="ptn-shell ptn-cardiff-grid">
        <div class="ptn-cardiff-mark" data-reveal>
          <img
            class="ptn-cardiff-logo"
            src={CARDIFF.logo}
            alt={`${CARDIFF.name} logo`}
            width={CARDIFF.logoSize?.width}
            height={CARDIFF.logoSize?.height}
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="ptn-cardiff-copy" data-reveal>
          <Eyebrow>Service partner</Eyebrow>
          <h2 id="cardiff-heading">Cardiff.</h2>
          <p class="ptn-body">
            Cardiff is a small-business financing marketplace and a Falcon partner. Its application covers products
            Falcon does not place, business credit cards among them. The link below is Falcon’s partner link.
          </p>
          <a class="arrow-cta ptn-cardiff-link" href={CARDIFF.url} target="_blank" rel={OUTBOUND_REL}>
            <span class="arrow-cta-label link-draw">Open Cardiff’s application</span>
            <CircleArrow />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Become a partner — HOME-07 dark: heading left, the two text columns + contact rows right. No form. -->
  <section
    class="ptn-become on-dark"
    id="become-a-partner"
    aria-labelledby="become-heading"
    data-band="dark"
    data-ptn-section="become"
    data-reveal-root
  >
    <div class="container-site">
      <div class="ptn-shell ptn-split">
        <div class="ptn-split-head" data-reveal>
          <Eyebrow>Partner enquiries</Eyebrow>
          <h2 id="become-heading">Start with one file.</h2>
        </div>
        <div class="ptn-split-body" data-reveal>
          <div class="ptn-become-cols">
            <div>
              <h3 class="ptn-card-title">What to send</h3>
              <p class="ptn-card-body">
                your firm name and contact, the products you place, the typical file size you work with, and the
                markets you cover. One redacted file is enough; an NDA is fine.
              </p>
            </div>
            <div>
              <h3 class="ptn-card-title">What happens next</h3>
              <p class="ptn-card-body">
                the desk reads the first file, tells you what Falcon can and cannot place, and agrees commercial terms
                before anything is submitted.
              </p>
            </div>
          </div>
          <dl class="ptn-contact">
            <div class="ptn-contact-row">
              <dt class="ptn-contact-label">Email</dt>
              <dd class="ptn-contact-value"><a href={PARTNER_MAILTO}>{SITE.email}</a></dd>
            </div>
            <div class="ptn-contact-row">
              <dt class="ptn-contact-label">Subject</dt>
              <dd class="ptn-contact-value">{PARTNER_SUBJECT}</dd>
            </div>
            <div class="ptn-contact-row">
              <dt class="ptn-contact-label">{DIRECT.label}</dt>
              <dd class="ptn-contact-value"><a href={DIRECT.href}>{DIRECT.display}</a></dd>
            </div>
          </dl>
          <p class="ptn-become-close">
            If the fit is right, your logo joins the row above with one line about what you do — and the desk stays
            yours.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 10. FAQ — the shared FaqList (PWS-09 shape: five rows) + FAQPage schema. -->
  <section class="ptn-faq" aria-labelledby="faq-heading" data-band="light" data-ptn-section="faq" data-reveal-root>
    <div class="container-site">
      <div class="ptn-block-head" data-reveal>
        <Eyebrow>FAQ</Eyebrow>
        <h2 id="faq-heading">Partner questions.</h2>
      </div>
      <FaqList items={FAQS} idPrefix="ptn" class="ptn-faq-list" data-reveal />
    </div>
  </section>

  <!-- 11. CTA — the sitewide band, static variant. Nothing sits beside the buttons. -->
  <SiteCta
    slot="cta"
    heading="Send the first file."
    body="One desk, seven products, and a straight answer on whether a file is placeable."
  >
    <Fragment slot="actions">
      <Button040 href={PARTNER_MAILTO} label="Email the partner desk" variant="light" />
      <ArrowCta href={DIRECT.href} label={`Direct line ${DIRECT.display}`} tone="light" />
    </Fragment>
  </SiteCta>

  <script>
    import { bindAccordions } from '@/scripts/accordion';
    import '@/scripts/scroll-in';

    bindAccordions();
