---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CtaBand from '@/components/CtaBand.astro';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Credit Repair & Loan Prep', path: '/resources/credit-repair-loan-prep' },
];

const programs = [
  {
    group: 'Business credit programs',
    lead: 'Build a business credit profile lenders will review.',
    items: [
      { name: 'Business Funding Prep', body: 'Business and personal credit monitoring, disputes and tradeline strategy.' },
      { name: 'Credit Ready Business', body: 'Repair, vendor tradelines and PAYDEX score growth.' },
      { name: 'Startup Capital Prep', body: 'New LLC or S-Corp formation with personal credit improvement.' },
      { name: 'SBA & Term Loan Prep', body: 'FICO SBSS improvement and underwriting prep for SBA 7(a) and bank term loans.' },
      { name: 'MBE, Veteran & WOSB Prep', body: 'Certification plus a credit preparation package.' },
      { name: 'Federal Contracting Prep', body: 'SAM registration, including 8(a) guidance.' },
    ],
  },
  {
    group: 'Personal credit programs',
    lead: 'Strengthen the personal file behind the business.',
    items: [
      { name: 'Mortgage & Loan Prep', body: 'Includes 90 days of certified FICO professional service.' },
      { name: 'Student Loan & Credit Plan', body: 'Consolidation and refinance strategies with personal credit repair.' },
      { name: 'The Inquirer', body: 'Personal credit monitoring, bureau tracking and dispute support.' },
    ],
  },
];

const reasons = [
  'One-on-one work with a Credit and Lending specialist',
  'Bureau-direct disputes with Experian, Equifax, TransUnion and Dun & Bradstreet',
  'Tradeline strategy for PAYDEX and FICO SBSS',
  'A free consultation to start',
  'Information stays confidential',
];

const steps = [
  { title: 'Consultation', body: 'A free review of personal and business credit.' },
  { title: 'Plan', body: 'A roadmap aimed at the financing you need.' },
  { title: 'Repair', body: 'Disputes, tradelines and FICO SBSS work.' },
  { title: 'Fund', body: 'When the file is ready, we place it with a lender.' },
];
---

<BaseLayout
  title="Credit Repair & Loan Prep"
  description="Improve business and personal credit and get loan-ready. Free consultation."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Credit Repair & Loan Prep"
    lead="Credit work for owners who need a stronger file before they apply."
    breadcrumbs={crumbs}
  />

  {
    programs.map((p, gi) => (
      <section class="section bg-tint" aria-labelledby={`program-${gi}`}>
        <div class="container-site">
          <SectionHeading id={`program-${gi}`} title={p.group} lead={p.lead} />
          <ul class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {p.items.map((item) => (
              <li class="tile-card">
                <h3>{item.name}</h3>
                <p class="mt-3 text-ink-soft">{item.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="section bg-white" aria-labelledby="why-program-heading">
    <div class="container-site grid gap-12 lg:grid-cols-2">
      <div>
        <SectionHeading id="why-program-heading" title="What is included" />
        <ul class="mt-8 space-y-3">
          {
            reasons.map((r) => (
              <li class="text-ink-soft">{r}</li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2>How it works</h2>
        <ol class="mt-8 space-y-6">
          {
            steps.map((s) => (
              <li>
                <h3>{s.title}</h3>
                <p class="mt-1 text-ink-soft">{s.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <CtaBand title="Credit consultation" body="A free call to review the file and the financing you need." />
</BaseLayout>
