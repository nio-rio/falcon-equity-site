---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import UseCases from '@/components/UseCases.astro';
import StepTimeline from '@/components/StepTimeline.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import { CREDIT_PREP_USE_CASES } from '@/data/content';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Credit Repair & Loan Prep', path: '/resources/credit-repair-loan-prep' },
];

const programs = [
  {
    group: 'Business credit programs',
    lead: 'Build a business credit profile lenders will review.',
    items: [
      { name: 'Business Funding Prep', body: 'Business and personal credit monitoring, disputes and tradeline strategy.' },
      { name: 'Credit Ready Business', body: 'Repair, vendor tradelines and PAYDEX score growth.' },
      { name: 'Startup Capital Prep', body: 'New LLC or S-Corp formation with personal credit improvement.' },
      { name: 'Term Loan Prep', body: 'FICO SBSS improvement and underwriting prep for bank term loans.' },
      { name: 'MBE, Veteran & WOSB Prep', body: 'Certification plus a credit preparation package.' },
      { name: 'Federal Contracting Prep', body: 'SAM registration and small-business certification guidance.' },
    ],
  },
  {
    group: 'Personal credit programs',
    lead: 'Strengthen the personal file behind the business.',
    items: [
      { name: 'Mortgage & Loan Prep', body: 'Includes 90 days of certified FICO professional service.' },
      { name: 'Student Loan & Credit Plan', body: 'Consolidation and refinance strategies with personal credit repair.' },
      { name: 'The Inquirer', body: 'Personal credit monitoring, bureau tracking and dispute support.' },
    ],
  },
];

const reasons = [
  'One-on-one work with a Credit and Lending specialist',
  'Bureau-direct disputes with Experian, Equifax, TransUnion and Dun & Bradstreet',
  'Tradeline strategy for PAYDEX and FICO SBSS',
  'A free consultation to start',
  'Information stays confidential',
];

const steps = [
  { title: 'Consultation', body: 'A free 1-on-1 review of your personal and business credit.' },
  { title: 'Custom Plan', body: 'A roadmap aimed at the financing you need.' },
  { title: 'Active Repair', body: 'Disputes, tradelines and FICO SBSS work.' },
  { title: 'Get Funded', body: 'When the file is ready, we place it with a lender.' },
];
---

<BaseLayout
  title="Credit Repair & Loan Prep"
  description="Improve business and personal credit and get loan-ready. Free consultation."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Credit Repair & Loan Prep"
    lead="Improve your credit standing and obtain the financing that's right for you."
  />

  {
    programs.map((p, gi) => (
      <section class="section bg-white" aria-labelledby={`program-${gi}`}>
        <div class="container-site">
          <div class="bx-grid">
            <div class="section-head bx-span-4 bx-lg-span-10">
              <Eyebrow>{p.group.startsWith('Business') ? 'Business' : 'Personal'}</Eyebrow>
              <h2 id={`program-${gi}`}>{p.group}</h2>
            </div>
            <p class="section-body bx-span-4 bx-lg-span-6 bx-lg-start-7">{p.lead}</p>
            <div class="bx-full">
              <div class="bx-grid">
                {p.items.map((item) => (
                  <div class="tile-card bx-span-4 bx-lg-span-4">
                    <h3>{item.name}</h3>
                    <p class="mt-3 text-ink-soft">{item.body}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="section bg-white" aria-labelledby="why-program-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="section-head bx-span-4 bx-lg-span-10">
          <Eyebrow>Why</Eyebrow>
          <h2 id="why-program-heading">Why clients choose this program</h2>
        </div>
        <ul class="section-body bx-span-4 bx-lg-span-6 bx-lg-start-7 space-y-3">
          {
            reasons.map((r) => (
              <li class="text-ink-soft">{r}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="how-program-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="section-head bx-span-4 bx-lg-span-8 bx-lg-start-3 text-center">
          <Eyebrow align="center">Process</Eyebrow>
          <h2 id="how-program-heading">How it works</h2>
        </div>
        <div class="bx-span-4 bx-lg-span-8 bx-lg-start-3">
          <div class="mt-8">
            <StepTimeline steps={steps} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <UseCases cases={CREDIT_PREP_USE_CASES} />

  <CtaBand title="Credit consultation" body="A free call to review the file and the financing you need." ctaLabel="Apply" />
</BaseLayout>
