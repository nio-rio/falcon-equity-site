---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Loan Calculator', path: '/resources/loan-calculator' },
];

const calculatorSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Business Loan Calculator',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  url: 'https://falconequity.ai/resources/loan-calculator',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<BaseLayout
  title="Business Loan Calculator"
  description="Estimate monthly payments and total cost for business loans. Calculate financing options based on revenue, credit, and product type with Falcon Equity Group."
  schema={[breadcrumbSchema(crumbs), calculatorSchema]}
>
  <PageHero
    title="Business Loan Calculator"
    lead="Estimate monthly payments and total cost. Actual offers depend on revenue, credit, and product type."
  >
    <div class="lc-wrap" id="loan-calc">
      <div class="lc-grid">
        <div class="lc-inputs">
          <div class="lc-field">
            <div class="lc-row">
              <label class="lc-label" for="lc-amount">Loan Amount</label>
              <span class="lc-value" id="lc-amount-out"></span>
            </div>
            <input class="lc-range" type="range" id="lc-amount" min="5000" max="1000000" step="1000" value="100000" />
            <div class="lc-minmax"><span>$5K</span><span>$1M</span></div>
          </div>
          <div class="lc-field">
            <div class="lc-row">
              <label class="lc-label" for="lc-term">Term</label>
              <span class="lc-value" id="lc-term-out"></span>
            </div>
            <input class="lc-range" type="range" id="lc-term" min="3" max="120" step="1" value="24" />
            <div class="lc-minmax"><span>3 mo</span><span>120 mo</span></div>
          </div>
          <div class="lc-field">
            <div class="lc-row">
              <label class="lc-label" for="lc-apr">Estimated APR</label>
              <span class="lc-value" id="lc-apr-out"></span>
            </div>
            <input class="lc-range" type="range" id="lc-apr" min="5" max="60" step="0.5" value="18" />
            <div class="lc-minmax"><span>5%</span><span>60%</span></div>
          </div>
        </div>

        <div class="lc-results" aria-live="polite">
          <p class="lc-res-label">Estimated Monthly Payment</p>
          <p class="lc-payment"><span id="lc-payment">$0</span><span class="lc-per">/ mo</span></p>
          <div class="lc-split">
            <div>
              <p class="lc-res-label">Total Repayment</p>
              <p class="lc-small" id="lc-total">$0</p>
            </div>
            <div>
              <p class="lc-res-label">Total Interest</p>
              <p class="lc-small" id="lc-interest">$0</p>
            </div>
          </div>
          <div class="lc-cta-space"></div>
          <a class="btn-primary lc-btn" href="/apply">Get Funding Today</a>
          <p class="lc-note">Estimates only. Final terms based on underwriting.</p>
        </div>
      </div>
    </div>
  </PageHero>

  <CtaBand />
</BaseLayout>

<style>
  .lc-wrap {
    margin-top: 3rem;
  }

  .lc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .lc-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .lc-inputs {
    padding: 28px;
    background: #fff;
  }

  .lc-field + .lc-field {
    margin-top: 28px;
  }

  .lc-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 14px;
    gap: 1rem;
  }

  .lc-label,
  .lc-value {
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.2;
    color: var(--color-ink);
    margin: 0;
  }

  .lc-value {
    font-variant-numeric: tabular-nums;
  }

  .lc-minmax {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--color-muted);
    margin-top: 8px;
  }

  .lc-range {
    appearance: none;
    width: 100%;
    height: 6px;
    margin: 0;
    border: 0;
    padding: 0;
    outline: none;
    cursor: pointer;
    background: linear-gradient(
      to right,
      var(--color-ink) 0%,
      var(--color-ink) var(--fill, 0%),
      var(--color-line) var(--fill, 0%),
      var(--color-line) 100%
    );
  }

  .lc-range::-webkit-slider-thumb {
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--color-ink);
  }

  .lc-range::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--color-ink);
  }

  .lc-results {
    display: flex;
    flex-direction: column;
    padding: 28px;
    background: var(--color-featured);
    color: #fff;
  }

  .lc-res-label {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.8);
  }

  .lc-payment {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(44px, 6vw, 60px);
    line-height: 1;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }

  .lc-per {
    margin-left: 6px;
    font-family: var(--font-sans);
    font-size: 16px;
    color: rgb(255 255 255 / 0.8);
  }

  .lc-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.2);
  }

  .lc-small {
    margin: 0;
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.2;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }

  .lc-cta-space {
    flex: 1;
    min-height: 28px;
  }

  .lc-btn {
    width: 100%;
  }

  .lc-note {
    margin-top: 14px;
    text-align: center;
    font-size: 12px;
    color: rgb(255 255 255 / 0.8);
  }
</style>

<script>
  const root = document.getElementById('loan-calc');
  if (root) {
    const amount = root.querySelector<HTMLInputElement>('#lc-amount')!;
    const term = root.querySelector<HTMLInputElement>('#lc-term')!;
    const apr = root.querySelector<HTMLInputElement>('#lc-apr')!;
    const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

    const fill = (el: HTMLInputElement) => {
      el.style.setProperty('--fill', `${((Number(el.value) - Number(el.min)) / (Number(el.max) - Number(el.min))) * 100}%`);
    };

    const calc = () => {
      const P = Number(amount.value);
      const n = Number(term.value);
      const r = Number(apr.value) / 100 / 12;
      const monthly = r === 0 ? P / n : (P * r) / (1 - Math.pow(1 + r, -n));
      const total = monthly * n;
      root.querySelector('#lc-amount-out')!.textContent = usd.format(P);
      root.querySelector('#lc-term-out')!.textContent = `${n} months`;
      root.querySelector('#lc-apr-out')!.textContent = `${Number(apr.value).toFixed(1)}%`;
      root.querySelector('#lc-payment')!.textContent = usd.format(monthly);
      root.querySelector('#lc-total')!.textContent = usd.format(total);
      root.querySelector('#lc-interest')!.textContent = usd.format(total - P);
      [amount, term, apr].forEach(fill);
    };

    [amount, term, apr].forEach((el) => el.addEventListener('input', calc));
    calc();
  }
</script>
