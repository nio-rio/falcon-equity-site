---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import ConsolidationExample from '@/components/ConsolidationExample.astro';
import { SERVICES, type Service } from '@/data/services';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/schema';

export const getStaticPaths = (() => SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: service.name, path: `/services/${service.slug}` },
];
const isConsolidation = service.slug === 'consolidation-of-positions';
const isDigital = service.slug === 'decentralized-business-financing';
---

<BaseLayout
  title={service.seoTitle}
  description={service.seoDescription}
  schema={[breadcrumbSchema(crumbs), serviceSchema(service), faqSchema(service.faqs)]}
>
  <PageHero title={service.name} lead={service.intro} breadcrumbs={crumbs} />

  <section class="section bg-white" aria-labelledby="details-heading">
    <div class="container-site grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <SectionHeading id="details-heading" eyebrow="At a glance" title={service.headline} />
        <dl class="mt-10 grid gap-8 sm:grid-cols-2">
          <div class="border-t border-line pt-5 sm:col-span-2">
            <dt class="text-sm text-muted">Amounts</dt>
            <dd class="mt-1 font-medium text-ink">{service.amounts}</dd>
          </div>
          <div class:list={['border-t border-line pt-5', !service.speed && 'sm:col-span-2']}>
            <dt class="text-sm text-muted">Terms</dt>
            <dd class="mt-1 font-medium text-ink">{service.terms}</dd>
          </div>
          {
            service.speed && (
              <div class="border-t border-line pt-5">
                <dt class="text-sm text-muted">Speed</dt>
                <dd class="mt-1 font-medium text-ink">{service.speed}</dd>
              </div>
            )
          }
          <div class="border-t border-line pt-5 sm:col-span-2">
            <dt class="text-sm text-muted">Who it is for</dt>
            <dd class="mt-1 text-ink">{service.whoFor}</dd>
          </div>
        </dl>
        {
          service.options && service.options.length > 1 && (
            <div class="mt-12 overflow-x-auto border-t border-line pt-8" role="region" aria-labelledby="options-heading" tabindex="0">
              <h3 id="options-heading">Options</h3>
              <table class="mt-6 w-full min-w-[32rem] text-left text-[15px]">
                <caption class="sr-only">{service.name} options with amounts, speed and terms</caption>
                <thead class="border-b border-line text-ink">
                  <tr>
                    <th scope="col" class="py-3 pr-5 font-medium">Option</th>
                    <th scope="col" class="py-3 pr-5 font-medium">Amounts</th>
                    <th scope="col" class="py-3 pr-5 font-medium">Speed</th>
                    <th scope="col" class="py-3 font-medium">Terms</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-line">
                  {service.options.map((o) => (
                    <tr>
                      <th scope="row" class="py-3 pr-5 font-medium text-ink">{o.name}</th>
                      <td class="py-3 pr-5">{o.amounts}</td>
                      <td class="py-3 pr-5">{o.speed ?? 'Ask your specialist'}</td>
                      <td class="py-3">{o.terms ?? 'Ask your specialist'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="mt-3 text-sm text-muted">Speeds are typical after approval and a signed agreement. Rates are quoted individually.</p>
            </div>
          )
        }
        <h3 class="mt-12">{isDigital ? 'What we offer' : 'Typical uses'}</h3>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {
            service.idealUses.map((u) => (
              <li class="border-t border-line pt-3 text-ink">{u}</li>
            ))
          }
        </ul>
      </div>
      <aside class="lg:col-span-5" aria-labelledby="requirements-heading">
        <div class="border-t border-line pt-8 lg:sticky lg:top-24">
          <h3 id="requirements-heading">Typical requirements</h3>
          <ul class="mt-6 space-y-4">
            {
              service.requirements.map((r) => (
                <li class="border-t border-line pt-3 text-ink-soft">{r}</li>
              ))
            }
          </ul>
          <p class="mt-6 text-sm text-muted">
            Requirements are typical. Every file is reviewed individually, and approval is not guaranteed.
          </p>
        </div>
      </aside>
    </div>
  </section>

  {
    isConsolidation && (
      <section class="section bg-tint" aria-labelledby="example-heading">
        <div class="container-site">
          <SectionHeading
            id="example-heading"
            eyebrow="Illustration"
            title="What consolidation can look like."
            lead="Falcon clients save 30-50% on average on daily or weekly payments. The figures below are hypothetical."
          />
          <div class="mt-10">
            <ConsolidationExample />
          </div>
        </div>
      </section>
    )
  }

  <section class="section bg-white" aria-labelledby="service-faq-heading">
    <div class="container-site grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading id="service-faq-heading" eyebrow="FAQ" title={`${service.shortName} questions`} />
      </div>
      <div class="lg:col-span-8">
        <FaqList faqs={service.faqs} />
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
