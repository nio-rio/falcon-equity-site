---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ImageSlot from '@/components/ImageSlot.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import UseCases from '@/components/UseCases.astro';
import ConsolidationExample from '@/components/ConsolidationExample.astro';
import { SERVICES, type Service } from '@/data/services';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/schema';

const SERVICE_PHOTO: Record<string, string> = {
  'collateral-asset-loans': 'commercial equipment on a warehouse floor, daylight',
  'business-line-of-credit': 'small-business office with open ledgers, warm light',
  'merchant-cash-advance': 'busy retail counter with a card terminal, warm light',
  'business-term-loan': 'storefront interior after opening, morning light',
  'invoice-factoring-tool': 'shipping dock with packed pallets, daylight',
  'consolidation-of-positions': 'desk with stacked statements, even light',
  'decentralized-business-financing': 'quiet office workstation with two screens, cool light',
};

export const getStaticPaths = (() => SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: service.name, path: `/services/${service.slug}` },
];
const isConsolidation = service.slug === 'consolidation-of-positions';
const typicalUse = service.idealUses.slice(0, 4);
const useCases = service.useCases.map((c) => ({ ...c, product: service.name }));
---

<BaseLayout
  title={service.seoTitle}
  description={service.seoDescription}
  schema={[breadcrumbSchema(crumbs), serviceSchema(service), faqSchema(service.faqs)]}
>
  <PageHero title={service.name} />

  <section class="section bg-white" aria-labelledby="details-heading">
    <div class="container-site grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <ImageSlot
          intent={SERVICE_PHOTO[service.slug] ?? 'empty commercial interior, daylight'}
          ratio="16 / 9"
          class="mb-10"
        />
        <h2 id="details-heading" class="service-deck">{service.intro}</h2>
        {
          service.options && service.options.length > 1 && (
            <div class="mt-12 overflow-x-auto" role="region" aria-labelledby="options-heading" tabindex="0">
              <h3 id="options-heading">Options</h3>
              <table class="service-table mt-6 w-full min-w-[32rem] text-left">
                <caption class="sr-only">{service.name} options with amounts, speed and terms</caption>
                <thead class="text-ink">
                  <tr>
                    <th scope="col" class="font-medium">Option</th>
                    <th scope="col" class="font-medium">Amounts</th>
                    <th scope="col" class="font-medium">Speed</th>
                    <th scope="col" class="font-medium">Terms</th>
                  </tr>
                </thead>
                <tbody>
                  {service.options.map((o) => (
                    <tr>
                      <th scope="row" class="font-medium text-ink">{o.name}</th>
                      <td>{o.amounts}</td>
                      <td>{o.speed ?? 'Ask your specialist'}</td>
                      <td>{o.terms ?? 'Ask your specialist'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="mt-3 text-sm text-muted">Speeds are typical after approval and a signed agreement. Rates are quoted individually.</p>
            </div>
          )
        }
        <h3 class="mt-12">Typical use</h3>
        <ul class="typical-use mt-5">
          {typicalUse.map((u) => <li>{u}</li>)}
        </ul>
      </div>
      <aside class="lg:col-span-5" aria-labelledby="requirements-heading">
        <div class="bg-tint p-8 lg:sticky lg:top-24">
          <h3 id="requirements-heading">Typical requirements</h3>
          <ul class="mt-6 space-y-3">
            {
              service.requirements.map((r) => (
                <li class="text-ink-soft">{r}</li>
              ))
            }
          </ul>
          <p class="mt-6 text-sm text-muted">
            Requirements are typical. Every file is reviewed individually, and approval is not guaranteed.
          </p>
        </div>
      </aside>
    </div>
  </section>

  {
    isConsolidation && (
      <section class="section bg-white" aria-labelledby="example-heading">
        <div class="container-site">
          <SectionHeading
            id="example-heading"
            eyebrow="Illustration"
            title="What consolidation can look like."
            lead="Falcon clients save 30-50% on average on daily or weekly payments. The figures below are hypothetical."
          />
          <div class="mt-10">
            <ConsolidationExample />
          </div>
        </div>
      </section>
    )
  }

  <UseCases cases={useCases} />

  <section class="section bg-white" aria-labelledby="service-faq-heading">
    <div class="container-site grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading id="service-faq-heading" eyebrow="FAQ" title={`${service.shortName} questions`} />
      </div>
      <div class="lg:col-span-8">
        <FaqList faqs={service.faqs} />
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .service-deck {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: inherit;
    line-height: 1.55;
    color: var(--color-ink-soft);
    text-wrap: pretty;
    letter-spacing: normal;
  }

  .typical-use {
    list-style: disc;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.75rem;
    font-size: inherit;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }

  .service-table {
    font-size: inherit;
    line-height: 1.55;
    border-collapse: collapse;
  }

  .service-table th,
  .service-table td {
    border: 1px solid var(--color-line);
    padding: 0.75rem 1rem;
    vertical-align: top;
  }
</style>
