---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import ConsolidationExample from '@/components/ConsolidationExample.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { SERVICES, type Service } from '@/data/services';
import { PRIMARY_PHONE } from '@/data/site';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/schema';

export const getStaticPaths = (() => SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: service.name, path: `/services/${service.slug}` },
];
const others = SERVICES.filter((s) => s.slug !== service.slug).slice(0, 3);
const isConsolidation = service.slug === 'consolidation-of-positions';
const isDigital = service.slug === 'decentralized-business-financing';
---

<BaseLayout
  title={service.seoTitle}
  description={service.seoDescription}
  schema={[breadcrumbSchema(crumbs), serviceSchema(service), faqSchema(service.faqs)]}
>
  <PageHero eyebrow={service.name} title={service.headline} lead={service.intro} breadcrumbs={crumbs}>
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a href="/apply" class="btn-accent">Apply Now <Icon name="arrow-right" size={18} /></a>
      <a href={PRIMARY_PHONE.href} class="btn-outline-light"><Icon name="phone" size={18} /> {PRIMARY_PHONE.display}</a>
    </div>
  </PageHero>

  <section class="bg-white py-20" aria-labelledby="details-heading">
    <div class="container-site grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <SectionHeading id="details-heading" eyebrow="At a glance" title={`${service.name} details`} />
        <dl class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl bg-lilac p-6">
            <dt class="text-sm text-muted">Amounts</dt>
            <dd class="mt-1 font-serif text-2xl font-semibold text-brand">{service.amounts}</dd>
          </div>
          <div class="rounded-2xl bg-lilac p-6">
            <dt class="text-sm text-muted">Terms</dt>
            <dd class="mt-1 font-serif text-2xl font-semibold text-brand">{service.terms}</dd>
          </div>
          <div class="rounded-2xl border border-lilac-200 p-6 sm:col-span-2">
            <dt class="text-sm text-muted">Who it’s for</dt>
            <dd class="mt-1 text-lg font-semibold text-ink">{service.whoFor}</dd>
          </div>
        </dl>
        <h3 class="mt-12 text-2xl font-semibold text-brand">{isDigital ? 'What we offer' : 'Ideal for'}</h3>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {
            service.idealUses.map((u) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 rounded-full bg-lilac p-1 text-brand">
                  <Icon name="check" size={16} strokeWidth={2.5} />
                </span>
                <span class="text-ink">{u}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <aside class="lg:col-span-5" aria-labelledby="requirements-heading">
        <div class="on-dark sticky top-28 rounded-3xl bg-brand p-8 text-white">
          <h3 id="requirements-heading" class="text-2xl font-semibold">Requirements</h3>
          <ul class="mt-6 space-y-4">
            {
              service.requirements.map((r) => (
                <li class="flex items-start gap-3">
                  <Icon name="badge-check" class="mt-0.5 shrink-0 text-lilac-deep" />
                  <span>{r}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-6 text-sm text-lilac-200">
            Requirements are typical. Every file is reviewed individually, and approval is not guaranteed.
          </p>
          <a href="/apply" class="btn-accent mt-8 w-full">Start your application</a>
        </div>
      </aside>
    </div>
  </section>

  {
    isConsolidation && (
      <section class="bg-lilac py-20" aria-labelledby="example-heading">
        <div class="container-site">
          <SectionHeading
            id="example-heading"
            eyebrow="See the difference"
            title="What consolidation can look like."
            lead="Falcon clients save 30%–50% on average on daily or weekly payments. Here is a simple, hypothetical example."
          />
          <div class="mt-10">
            <ConsolidationExample />
          </div>
        </div>
      </section>
    )
  }

  <section class:list={['py-20', isConsolidation ? 'bg-white' : 'bg-lilac']} aria-labelledby="steps-heading">
    <div class="container-site">
      <SectionHeading id="steps-heading" eyebrow="How it works" title="Three moves to your next win." />
      <ol class="mt-10 grid gap-6 md:grid-cols-3">
        {
          service.steps.map((step, i) => (
            <li class="card">
              <span class="font-serif text-4xl font-semibold text-lilac-deep" aria-hidden="true">
                0{i + 1}
              </span>
              <h3 class="mt-3 text-xl font-semibold text-brand">
                <span class="sr-only">Step {i + 1}: </span>
                {step.title}
              </h3>
              <p class="mt-2 leading-relaxed text-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bg-white py-20" aria-labelledby="service-faq-heading">
    <div class="container-site grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading id="service-faq-heading" eyebrow="FAQ" title={`${service.shortName} questions`} />
      </div>
      <div class="lg:col-span-8">
        <FaqList faqs={service.faqs} />
      </div>
    </div>
  </section>

  <section class="bg-lilac py-20" aria-labelledby="more-heading">
    <div class="container-site">
      <SectionHeading id="more-heading" eyebrow="Explore more" title="Other ways to fund your win." />
      <ul class="mt-10 grid gap-6 md:grid-cols-3">
        {
          others.map((s) => (
            <li>
              <ServiceCard service={s} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
