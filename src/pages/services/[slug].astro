---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import UseCases from '@/components/UseCases.astro';
import ConsolidationExample from '@/components/ConsolidationExample.astro';
import ExploreList from '@/components/ExploreList.astro';
import ArrowCta from '@/components/ArrowCta.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import StatementBand from '@/components/StatementBand.astro';
import Principles from '@/components/Principles.astro';
import FeatureSplit from '@/components/FeatureSplit.astro';
import ServiceSpec from '@/components/ServiceSpec.astro';
import { SERVICES, type Service } from '@/data/services';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/schema';

export const getStaticPaths = (() => SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: service.name, path: `/services/${service.slug}` },
];
const isConsolidation = service.slug === 'consolidation-of-positions';
const useCases = service.useCases.slice(0, 3).map((c) => ({ ...c, product: service.name }));
const stats = [
  { label: 'Typical amounts', value: service.spec?.amounts ?? service.amounts },
  { label: 'Terms', value: service.spec?.terms ?? service.terms },
  { label: 'Funding speed', value: service.speed ?? 'Ask your specialist' },
];
const bandItems = (service.options && service.options.length > 1
  ? service.options.map((o) => ({
      title: o.name,
      body: [o.amounts, o.terms].filter(Boolean).join(' · '),
    }))
  : service.idealUses.slice(0, 4).map((title) => ({ title }))
);
const principles = service.idealUses.slice(0, 3).map((title) => ({ title }));
const accordionItems =
  service.options && service.options.length > 1
    ? service.options.map((o) => ({
        q: o.name,
        a: [o.amounts, o.speed, o.terms].filter(Boolean).join('. '),
      }))
    : service.faqs;
const explore = SERVICES.filter((s) => s.slug !== service.slug).map((s) => ({
  href: `/services/${s.slug}`,
  title: s.name,
  meta: s.rangeLine,
}));
---

<BaseLayout
  title={service.seoTitle}
  description={service.seoDescription}
  schema={[breadcrumbSchema(crumbs), serviceSchema(service), faqSchema(service.faqs)]}
>
  <PageHero title={service.name} lead={service.headline}>
    <div class="page-hero-media">
      <Image
        src={service.image}
        alt=""
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        class="aspect-[16/9] w-full object-cover"
        priority
      />
    </div>
  </PageHero>

  <section class="section bg-white" aria-label="Typical figures">
    <div class="container-site">
      <dl class="bx-grid">
        {
          stats.map((stat) => (
            <div class="stat-cell bx-span-2 bx-md-span-2 bx-lg-span-4">
              <dd>{stat.value}</dd>
              <dt>{stat.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <StatementBand image={service.image} items={bandItems} />

  <section class="section bg-white" aria-labelledby="service-acc-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="bx-span-4 bx-lg-span-4">
          <Eyebrow>{service.options && service.options.length > 1 ? 'Options' : 'FAQ'}</Eyebrow>
          <h2 id="service-acc-heading" class="mt-4">
            {service.options && service.options.length > 1 ? `${service.shortName} options` : `${service.shortName} questions`}
          </h2>
        </div>
        <div class="bx-span-4 bx-lg-span-8">
          <FaqList faqs={accordionItems} idPrefix={`${service.slug}-acc`} />
        </div>
      </div>
    </div>
  </section>

  <FeatureSplit id="details-heading" eyebrow="Overview" title={service.intro} image={service.image}>
    {service.spec && <ServiceSpec spec={service.spec} />}
    <p class="mt-8">
      <ArrowCta href="/apply" label="Apply for this product" />
    </p>
  </FeatureSplit>

  <Principles id="uses-heading" eyebrow="Typical use" title={service.headline} items={principles} />

  {
    isConsolidation && (
      <section class="section bg-white" aria-labelledby="example-heading">
        <div class="container-site">
          <div class="bx-grid">
            <div class="bx-full">
              <Eyebrow>Illustration</Eyebrow>
              <h2 id="example-heading" class="mt-4">What consolidation can look like.</h2>
              <p class="section-lead mt-5">
                Falcon clients save 30-50% on average on daily or weekly payments. The figures below are hypothetical.
              </p>
            </div>
            <div class="bx-span-4 bx-lg-span-12">
              <ConsolidationExample />
            </div>
          </div>
        </div>
      </section>
    )
  }

  <UseCases cases={useCases} />

  {
    service.options && service.options.length > 1 && (
      <section class="section bg-white" aria-labelledby="service-faq-heading">
        <div class="container-site">
          <div class="bx-grid">
            <div class="bx-span-4 bx-lg-span-4">
              <Eyebrow>FAQ</Eyebrow>
              <h2 id="service-faq-heading" class="mt-4">{`${service.shortName} questions`}</h2>
            </div>
            <div class="bx-span-4 bx-lg-span-8">
              <FaqList faqs={service.faqs} idPrefix={`${service.slug}-faq`} />
            </div>
          </div>
        </div>
      </section>
    )
  }

  <ExploreList heading="Explore more" headingId="explore-services" items={explore} />

  <CtaBand />
</BaseLayout>
