---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import ConsolidationExample from '@/components/ConsolidationExample.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { SERVICES, type Service } from '@/data/services';
import { PRIMARY_PHONE } from '@/data/site';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/schema';

export const getStaticPaths = (() => SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: service.name, path: `/services/${service.slug}` },
];
const others = SERVICES.filter((s) => s.slug !== service.slug).slice(0, 3);
const isConsolidation = service.slug === 'consolidation-of-positions';
const isDigital = service.slug === 'decentralized-business-financing';
---

<BaseLayout
  title={service.seoTitle}
  description={service.seoDescription}
  schema={[breadcrumbSchema(crumbs), serviceSchema(service), faqSchema(service.faqs)]}
>
  <PageHero eyebrow={service.name} title={service.headline} lead={service.intro} breadcrumbs={crumbs}>
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a href="/apply" class="btn-primary">Apply Now</a>
      <a href={PRIMARY_PHONE.href} class="btn-outline-dark">{PRIMARY_PHONE.display}</a>
    </div>
  </PageHero>

  <section class="bg-white py-20" aria-labelledby="details-heading">
    <div class="container-site grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <SectionHeading id="details-heading" eyebrow="At a glance" title={`${service.name} details`} />
        <dl class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="border-t border-line pt-5 sm:col-span-2">
            <dt class="text-sm text-muted">Amounts</dt>
            <dd class="mt-1 font-display text-2xl font-semibold tracking-tight">{service.amounts}</dd>
          </div>
          <div class:list={['border-t border-line pt-5', !service.speed && 'sm:col-span-2']}>
            <dt class="text-sm text-muted">Terms</dt>
            <dd class="mt-1 font-display text-2xl font-semibold tracking-tight">{service.terms}</dd>
          </div>
          {
            service.speed && (
              <div class="border-t border-line pt-5">
                <dt class="text-sm text-muted">Speed</dt>
                <dd class="mt-1 font-display text-xl font-semibold tracking-tight">{service.speed}</dd>
              </div>
            )
          }
          <div class="border-t border-line pt-5 sm:col-span-2">
            <dt class="text-sm text-muted">Who it’s for</dt>
            <dd class="mt-1 text-lg font-semibold text-ink">{service.whoFor}</dd>
          </div>
        </dl>
        {
          service.options && service.options.length > 1 && (
            <>
              <h3 id="options-heading" class="mt-12 text-2xl font-bold text-brand">Options</h3>
              <div class="mt-5 overflow-x-auto rounded-2xl border border-line" role="region" aria-labelledby="options-heading" tabindex="0">
                <table class="w-full min-w-[32rem] text-left text-[15px]">
                  <caption class="sr-only">{service.name} options with amounts, speed and terms</caption>
                  <thead class="bg-white text-brand">
                    <tr>
                      <th scope="col" class="px-5 py-3 font-semibold">Option</th>
                      <th scope="col" class="px-5 py-3 font-semibold">Amounts</th>
                      <th scope="col" class="px-5 py-3 font-semibold">Speed</th>
                      <th scope="col" class="px-5 py-3 font-semibold">Terms</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-line">
                    {service.options.map((o) => (
                      <tr>
                        <th scope="row" class="px-5 py-3 font-semibold text-ink">{o.name}</th>
                        <td class="px-5 py-3">{o.amounts}</td>
                        <td class="px-5 py-3">{o.speed ?? 'Ask your specialist'}</td>
                        <td class="px-5 py-3">{o.terms ?? 'Ask your specialist'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="mt-3 text-sm text-muted">Speeds are typical after approval and a signed agreement. Rates are quoted individually.</p>
            </>
          )
        }
        <h3 class="mt-12 text-2xl font-semibold text-brand">{isDigital ? 'What we offer' : 'Ideal for'}</h3>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {
            service.idealUses.map((u) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 rounded-full bg-white p-1 text-brand">
                  <Icon name="check" size={16} strokeWidth={2.5} />
                </span>
                <span class="text-ink">{u}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <aside class="lg:col-span-5" aria-labelledby="requirements-heading">
        <div class="sticky top-28 border-t border-line pt-8">
          <h3 id="requirements-heading" class="text-2xl font-semibold">Requirements</h3>
          <ul class="mt-6 space-y-4">
            {
              service.requirements.map((r) => (
                <li class="border-t border-line pt-3 text-muted">{r}</li>
              ))
            }
          </ul>
          <p class="mt-6 text-sm text-muted">
            Requirements are typical. Every file is reviewed individually, and approval is not guaranteed.
          </p>
          <a href="/apply" class="btn-primary mt-8">Start your application</a>
        </div>
      </aside>
    </div>
  </section>

  {
    isConsolidation && (
      <section class="bg-white py-20" aria-labelledby="example-heading">
        <div class="container-site">
          <SectionHeading
            id="example-heading"
            eyebrow="See the difference"
            title="What consolidation can look like."
            lead="Falcon clients save 30%–50% on average on daily or weekly payments. Here is a simple, hypothetical example."
          />
          <div class="mt-10">
            <ConsolidationExample />
          </div>
        </div>
      </section>
    )
  }

  <section class:list={['py-20', isConsolidation ? 'bg-white' : 'bg-white']} aria-labelledby="steps-heading">
    <div class="container-site">
      <SectionHeading id="steps-heading" eyebrow="How it works" title="Three moves to your next win." />
      <ol class="mt-10 grid gap-6 md:grid-cols-3">
        {
          service.steps.map((step, i) => (
            <li>
              <span class="font-display text-sm font-semibold tracking-[0.2em] text-accent" aria-hidden="true">
                0{i + 1}
              </span>
              <h3 class="mt-3 text-xl font-semibold">
                <span class="sr-only">Step {i + 1}: </span>
                {step.title}
              </h3>
              <p class="mt-2 leading-relaxed text-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bg-white py-20" aria-labelledby="service-faq-heading">
    <div class="container-site grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading id="service-faq-heading" eyebrow="FAQ" title={`${service.shortName} questions`} />
      </div>
      <div class="lg:col-span-8">
        <FaqList faqs={service.faqs} />
      </div>
    </div>
  </section>

  <section class="bg-white py-20" aria-labelledby="more-heading">
    <div class="container-site">
      <SectionHeading id="more-heading" eyebrow="Explore more" title="Other ways to fund your win." />
      <ul class="mt-10 grid gap-6 md:grid-cols-3">
        {
          others.map((s) => (
            <li>
              <ServiceCard service={s} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
