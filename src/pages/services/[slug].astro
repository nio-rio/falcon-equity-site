---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceSpec from '@/components/ServiceSpec.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import UseCases from '@/components/UseCases.astro';
import ConsolidationExample from '@/components/ConsolidationExample.astro';
import ResponsiveTable from '@/components/ResponsiveTable.astro';
import ExploreList from '@/components/ExploreList.astro';
import ArrowCta from '@/components/ArrowCta.astro';
import { SERVICES, type Service } from '@/data/services';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/schema';

export const getStaticPaths = (() => SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: service.name, path: `/services/${service.slug}` },
];
const isConsolidation = service.slug === 'consolidation-of-positions';
const typicalUse = service.idealUses.slice(0, 4);
const useCases = service.useCases.slice(0, 3).map((c) => ({ ...c, product: service.name }));
const stats = [
  { label: 'Typical amounts', value: service.spec?.amounts ?? service.amounts },
  { label: 'Terms', value: service.spec?.terms ?? service.terms },
  { label: 'Funding speed', value: service.speed ?? 'Ask your specialist' },
];
const explore = SERVICES.filter((s) => s.slug !== service.slug).map((s) => ({
  href: `/services/${s.slug}`,
  title: s.name,
  meta: s.rangeLine,
}));
---

<BaseLayout
  title={service.seoTitle}
  description={service.seoDescription}
  schema={[breadcrumbSchema(crumbs), serviceSchema(service), faqSchema(service.faqs)]}
>
  <PageHero title={service.name} lead={service.headline} />

  <section class="bg-white">
    <div class="container-site pb-4">
      <Image
        src={service.image}
        alt=""
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        class="service-hero-image aspect-[16/9] w-full object-cover"
        priority
      />
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="details-heading">
    <div class="container-site">
      <dl class="stat-row">
        {
          stats.map((stat) => (
            <div>
              <dd>{stat.value}</dd>
              <dt>{stat.label}</dt>
            </div>
          ))
        }
      </dl>

      <div class="mt-16 grid gap-16 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="eyebrow">Overview</p>
          <h2 id="details-heading" class="service-deck mt-3">{service.intro}</h2>
        </div>
        <div class="lg:col-span-5 flex items-end">
          <ArrowCta href="/apply" label="Apply for this product" />
        </div>
        {
          service.spec && (
            <div class="min-w-0 w-full lg:col-span-12">
              <ServiceSpec spec={service.spec} />
            </div>
          )
        }
        <div class="lg:col-span-7">
          {
            service.options && service.options.length > 1 && (
              <div>
                <h3 id="options-heading">Options</h3>
                <ResponsiveTable
                  class="mt-6"
                  labelledBy="options-heading"
                  caption={`${service.name} options with amounts, speed and terms`}
                  headers={['Option', 'Amounts', 'Speed', 'Terms']}
                  rows={service.options.map((o) => [
                    o.name,
                    o.amounts,
                    o.speed ?? 'Ask your specialist',
                    o.terms ?? 'Ask your specialist',
                  ])}
                />
                <p class="mt-3 text-sm text-muted">Speeds are typical after approval and a signed agreement. Rates are quoted individually.</p>
              </div>
            )
          }
          <h3 class:list={[service.options && service.options.length > 1 && 'mt-12']}>Typical use</h3>
          <ul class="typical-use mt-5">
            {typicalUse.map((u) => <li>{u}</li>)}
          </ul>
        </div>
        <aside class="lg:col-span-5" aria-labelledby="requirements-heading">
          <div class="bg-tint p-8 lg:sticky lg:top-24">
            <h3 id="requirements-heading">Typical requirements</h3>
            <ul class="mt-6 space-y-3">
              {
                service.requirements.map((r) => (
                  <li class="text-ink-soft">{r}</li>
                ))
              }
            </ul>
            <p class="mt-6 text-sm text-muted">
              Requirements are typical. Every file is reviewed individually, and approval is not guaranteed.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {
    isConsolidation && (
      <section class="section bg-white" aria-labelledby="example-heading">
        <div class="container-site">
          <SectionHeading
            id="example-heading"
            eyebrow="Illustration"
            title="What consolidation can look like."
            lead="Falcon clients save 30-50% on average on daily or weekly payments. The figures below are hypothetical."
          />
          <div class="mt-10">
            <ConsolidationExample />
          </div>
        </div>
      </section>
    )
  }

  <UseCases cases={useCases} />

  <section class="section bg-white" aria-labelledby="service-faq-heading">
    <div class="container-site grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading id="service-faq-heading" eyebrow="FAQ" title={`${service.shortName} questions`} />
      </div>
      <div class="lg:col-span-8">
        <FaqList faqs={service.faqs} />
      </div>
    </div>
  </section>

  <ExploreList heading="Explore more" headingId="explore-services" items={explore} />

  <CtaBand />
</BaseLayout>

<style>
  .service-hero-image {
    display: block;
    border-radius: 0;
  }

  .service-deck {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: inherit;
    line-height: 1.55;
    color: var(--color-ink-soft);
    text-wrap: pretty;
    letter-spacing: normal;
  }

  .typical-use {
    list-style: disc;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.75rem;
    font-size: inherit;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }
</style>
