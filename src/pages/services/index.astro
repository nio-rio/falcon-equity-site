---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceBlock from '@/components/ServiceBlock.astro';
import CtaBand from '@/components/CtaBand.astro';
import { SERVICES, rangeAmount } from '@/data/services';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
];
---

<BaseLayout
  title="Business Funding Services"
  description="Compare Falcon Equity Group's seven business funding options: collateral loans, lines of credit, merchant cash advances, term loans, invoice factoring, consolidation and digital asset financing."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Services"
    lead="Seven products. Figures below are typical. Rates are quoted individually. Approval is not guaranteed."
  />

  <section class="section bg-white" aria-labelledby="options-heading">
    <div class="container-site">
      <SectionHeading id="options-heading" eyebrow="Options" title="Funding options" />
      <ul class="service-list mt-12 flex flex-col">
        {
          SERVICES.map((s) => (
            <li>
              <ServiceBlock service={s} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section bg-tint" aria-labelledby="compare-heading">
    <div class="container-site">
      <SectionHeading id="compare-heading" eyebrow="Compare" title="Compare options" />
      <div class="mt-12 overflow-x-auto" role="region" aria-labelledby="compare-heading" tabindex="0">
        <table class="service-table w-full min-w-[52rem] text-left">
          <caption class="sr-only">Compare Falcon’s seven funding products by amount, term, speed and typical use</caption>
          <thead class="text-ink">
            <tr>
              <th scope="col" class="font-medium">Product</th>
              <th scope="col" class="font-medium">Amount range</th>
              <th scope="col" class="font-medium">Term</th>
              <th scope="col" class="font-medium">Funding speed</th>
              <th scope="col" class="font-medium">Best for</th>
              <th scope="col" class="font-medium"><span class="sr-only">Link</span></th>
            </tr>
          </thead>
          <tbody>
            {
              SERVICES.map((s) => (
                <tr>
                  <th scope="row" class="font-medium text-ink">{s.name}</th>
                  <td>{rangeAmount(s)}</td>
                  <td>{s.terms}</td>
                  <td>{s.speed ?? '—'}</td>
                  <td>{s.bestFor}</td>
                  <td>
                    <a href={`/services/${s.slug}`} class="link">Learn more</a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-sm text-muted">Figures are typical. Rates are quoted individually. Approval is not guaranteed.</p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .service-list > li + li {
    border-top: 1px solid var(--color-line);
  }

  .service-table {
    font-size: inherit;
    line-height: 1.55;
    border-collapse: collapse;
  }

  .service-table th,
  .service-table td {
    border: 1px solid var(--color-line);
    padding: 0.75rem 1rem;
    vertical-align: top;
  }
</style>
