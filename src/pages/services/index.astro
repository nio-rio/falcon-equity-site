---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ServiceBlock from '@/components/ServiceBlock.astro';
import ChartTable from '@/components/ChartTable.astro';
import CtaBand from '@/components/CtaBand.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import { SERVICES, rangeAmount } from '@/data/services';
import { parseUsdMax } from '@/lib/money';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
];

const chartSeries = SERVICES.flatMap((s) => {
  const value = parseUsdMax(s.amounts);
  if (value == null) return [];
  return [{ label: s.shortName, value, display: s.amounts }];
});
---

<BaseLayout
  title="Business Funding Services"
  description="Compare Falcon Equity Group's seven business funding options: collateral loans, lines of credit, merchant cash advances, term loans, invoice factoring, consolidation and digital asset financing."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Services"
    lead="Seven products. Figures below are typical. Rates are quoted individually. Approval is not guaranteed."
  />

  <section class="section bg-white" aria-labelledby="options-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="bx-full">
          <Eyebrow>Options</Eyebrow>
          <h2 id="options-heading" class="mt-4">Funding options</h2>
        </div>
        <ul class="service-list bx-span-4 bx-lg-span-12">
          {
            SERVICES.map((s) => (
              <li>
                <ServiceBlock service={s} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="compare-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="bx-full">
          <Eyebrow>Compare</Eyebrow>
          <h2 id="compare-heading" class="mt-4">Compare options</h2>
        </div>
        <div class="bx-span-4 bx-lg-span-12">
          <ChartTable
            labelledBy="compare-heading"
            caption="Compare Falcon’s seven funding products by amount, term, speed and typical use"
            headers={['Product', 'Amount range', 'Term', 'Funding speed', 'Best for', '']}
            rows={SERVICES.map((s) => [
              s.name,
              rangeAmount(s),
              s.terms,
              s.speed ?? '—',
              s.bestFor,
              { href: `/services/${s.slug}`, text: 'Learn more' },
            ])}
            chart={{
              title: 'Typical maximum amounts',
              note: 'Bars show the top of each published amount range. Digital asset financing is tailored and is not plotted. Figures are typical. Rates are quoted individually. Approval is not guaranteed.',
              series: chartSeries,
            }}
          />
          <p class="mt-3 text-sm text-muted">Figures are typical. Rates are quoted individually. Approval is not guaranteed.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .service-list,
  .service-list > li {
    min-width: 0;
    width: 100%;
  }

  .service-list > li + li {
    border-top: 1px solid var(--color-line);
  }
</style>
