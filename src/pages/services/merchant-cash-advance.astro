---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Media from '@/components/Media.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Button040 from '@/components/Button040.astro';
import { PAGE_DISCLOSURE } from '@/data/disclosure';
import '@/styles/mca.css';

const facts = [
  {
    label: "Who It's For",
    value: 'Businesses that bring in $10K+ a month and have been open at least 3 months.',
  },
  {
    label: 'Typical Amounts',
    value: '$5,000 – $5,000,000',
  },
  {
    label: 'Terms',
    value: '3 – 18 months',
  },
];

const requirements = [
  'At least 3 months in business',
  '$10K+ in monthly sales',
  'An active business bank account',
];

const helps = [
  {
    title: 'Buying inventory while the price is good',
    body: "When a supplier offers a deal or a limited lot, you can pay for it now and cover the cost from the sales that inventory brings in. Often the same day you're approved.",
  },
  {
    title: 'Getting through a slow season',
    body: 'Payroll, rent and insurance keep coming when work slows down. This covers the gap until your busy season is back.',
  },
  {
    title: 'Paying for a marketing push',
    body: 'Ads cost money before they bring any in. This lets you start a campaign ahead of your busy stretch and cover it from the sales it creates.',
  },
  {
    title: "Fixing equipment that can't wait",
    body: "When a repair or replacement can't wait until you've saved up, this gets it done now and takes the cost out of your sales.",
  },
];

const fitItems = [
  {
    title: 'Skip it if the cost is planned and repeats',
    body: 'Rent, payroll and regular inventory orders fit a line of credit better: you draw what you need and only pay for what you use.',
  },
  {
    title: "Skip it if you're buying something that lasts",
    body: 'Equipment, vehicles and fixtures earn for years, so an equipment or asset loan spreads the cost over that time.',
  },
  {
    title: "Skip it if you're already carrying more than one advance",
    body: 'Adding another daily payment on top of the ones you already have is how businesses get into trouble.',
  },
];

const steps = [
  {
    num: '01',
    title: 'Apply in minutes',
    body: 'Fill out one short online application. Tell us what your business does and how much you need.',
    note: 'You provide: six months of business bank statements, a photo ID, a voided check and a list of any current advances or loans.',
    intent: 'Abstract still for the apply step, no people',
  },
  {
    num: '02',
    title: 'Talk to a specialist',
    body: "A Falcon specialist reviews your file, asks for anything that's missing and walks you through your options.",
    note: "You get: a call about the amount, the share of sales you'd pay and the timing, before anything is signed.",
    intent: 'Abstract still for the specialist step, no people',
  },
  {
    num: '03',
    title: 'Approve and get funded',
    body: "Once you're approved, review and sign your agreement. Funding can happen the same day.",
    note: "You see: the total amount you're selling and the percentage of sales that goes toward it, both spelled out on the agreement.",
    intent: 'Abstract still for the funding step, no people',
  },
];

const faqs = [
  {
    q: 'Is a merchant cash advance a loan?',
    a: "No. You're selling a share of your future sales for cash today. Instead of one fixed payment a month, you pay a set percentage of your daily or weekly sales, under the agreement you sign.",
  },
  {
    q: 'How much can I get?',
    a: "$5,000 – $5,000,000. The amount depends on your monthly sales, how long you've been open and your bank activity. The final number is confirmed once your file is reviewed.",
  },
  {
    q: 'What does it cost?',
    a: "Falcon charges a 0% agreement fee. Pricing is shown as two numbers before you sign: the total amount you're selling and the percentage of sales that goes toward it. Both depend on your file, so there's no single rate published here.",
  },
  {
    q: 'How fast can I get funded?',
    a: "It depends on how quickly you send your documents. Once you're approved and have signed, funding can happen the same day.",
  },
  {
    q: 'Does my credit score matter?',
    a: 'Your sales and bank activity carry the most weight. Your credit score is part of the picture, not the whole decision, and your specialist reviews your full profile. Approval is never guaranteed.',
  },
  {
    q: 'How do the payments work?',
    a: "A set percentage of your daily or weekly sales goes toward the purchase, as spelled out in the agreement you sign. You'll see that percentage and the total amount before you commit.",
  },
  {
    q: 'What do I need to apply?',
    a: 'Six months of business bank statements, a government-issued photo ID, a voided check and a list of any open advances or loans.',
  },
];
---

<BaseLayout title="Merchant Cash Advance" disclosure={PAGE_DISCLOSURE}>
  <Fragment slot="head">
    <script is:inline>
      (function () {
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          document.documentElement.classList.add('has-js');
          window.setTimeout(function () {
            if (!window.__pilotRevealReady) document.documentElement.classList.remove('has-js');
          }, 2500);
        } catch (e) {}
      })();
    </script>
  </Fragment>

  <section class="mca-hero" aria-labelledby="page-hero-heading" data-band="light" data-mca-section="hero">
    <div class="container-site">
      <div class="mca-shell mca-hero-grid">
        <h1 id="page-hero-heading" class="mca-hero-title">Merchant Cash Advance</h1>
        <p class="mca-hero-lead">
          A merchant cash advance is money now in exchange for a share of your future sales. It's a purchase of
          future receivables, not a loan, so what you pay follows how your business is doing.
        </p>
      </div>
    </div>
  </section>

  <section class="mca-band mca-facts" aria-label="Term facts" data-band="light" data-mca-section="facts" data-reveal-root>
    <div class="mca-ir-frame" data-reveal>
      <div class="mca-facts-cta">
        <Button040 href="/apply" label="Apply for funding" variant="dark" />
      </div>
      <div class="mca-stat-grid">
        {
          facts.map((fact) => (
            <div class="mca-stat">
              <p class="mca-stat-label">{fact.label}</p>
              <p class="mca-stat-value">{fact.value}</p>
            </div>
          ))
        }
        {
          requirements.map((item) => (
            <div class="mca-stat">
              <p class="mca-stat-label">Requirements</p>
              <p class="mca-stat-value">{item}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mca-band mca-helps" aria-labelledby="helps-heading" data-band="light" data-mca-section="helps" data-reveal-root>
    <div class="container-site">
      <div class="mca-shell mca-helps-head" data-reveal>
        <div class="mca-block-head">
          <Eyebrow>What it helps</Eyebrow>
          <h2 id="helps-heading">When a cash advance is the right fit.</h2>
        </div>
      </div>
      <div class="mca-shell mca-helps-split" data-reveal>
        <div class="mca-helps-image">
          <Media
            labeled
            intent="Abstract still of inventory, sales or equipment, no people"
            ratio="3 / 4"
            sizes="(min-width: 90em) 624px, (min-width: 64em) 688px, 100vw"
          />
        </div>
        <div class="mca-helps-list">
          {
            helps.map((item) => (
              <article class="mca-help">
                <h3 class="mca-help-title">{item.title}</h3>
                <p class="mca-help-body">{item.body}</p>
              </article>
            ))
          }
        </div>
      </div>
      <div class="mca-shell" data-reveal>
        <div class="mca-cta mca-cta--after">
          <Button040 href="/apply" label="Apply for funding" variant="dark" />
        </div>
      </div>
    </div>
  </section>

  <section class="mca-band mca-fit" aria-labelledby="fit-heading" data-band="light" data-mca-section="fit" data-reveal-root>
    <div class="container-site">
      <div class="mca-shell mca-fit-head" data-reveal>
        <div class="mca-block-head">
          <Eyebrow>Not for these situations</Eyebrow>
          <h2 id="fit-heading">When a cash advance isn't the right fit.</h2>
        </div>
        <p class="mca-block-lead">
          A cash advance is the fastest money you can get, and usually the most expensive. Here are three situations
          where a different product fits better.
        </p>
      </div>
      <div class="mca-shell mca-cards mca-cards--3" data-reveal>
        {
          fitItems.map((item) => (
            <article class="mca-card">
              <h3 class="mca-card-title">{item.title}</h3>
              <p class="mca-card-body">{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mca-band mca-process" aria-labelledby="process-heading" data-band="light" data-mca-section="process" data-reveal-root>
    <div class="container-site">
      <div class="mca-shell mca-process-head" data-reveal>
        <div class="mca-block-head">
          <Eyebrow>Process</Eyebrow>
          <h2 id="process-heading">How it works, from the first bank statement to signed paperwork.</h2>
        </div>
      </div>
      <div class="mca-shell mca-cards mca-cards--stills" data-reveal>
        {
          steps.map((step) => (
            <article class="mca-card mca-step">
              <p class="mca-step-num">{step.num}</p>
              <h3 class="mca-card-title">{step.title}</h3>
              <p class="mca-card-body">{step.body}</p>
              <Media labeled intent={step.intent} ratio="16 / 9" sizes="(min-width: 1024px) 30vw, 100vw" />
              <p class="mca-card-body mca-step-note">{step.note}</p>
            </article>
          ))
        }
      </div>
      <div class="mca-shell" data-reveal>
        <div class="mca-cta mca-cta--after">
          <Button040 href="/apply" label="Apply for funding" variant="dark" />
        </div>
      </div>
    </div>
  </section>

  <section class="mca-band mca-faq on-dark" aria-labelledby="mca-faq-heading" data-band="dark" data-mca-section="faq" data-reveal-root>
    <div class="container-site">
      <div class="mca-shell mca-faq-head" data-reveal>
        <div class="mca-block-head">
          <Eyebrow>FAQ</Eyebrow>
          <h2 id="mca-faq-heading">Cash advance questions</h2>
        </div>
      </div>
      <div class="mca-shell">
      <div class="mca-faq-list" data-accordion data-reveal>
        {
          faqs.map((item, i) => (
            <div class="mca-faq-item" data-acc-item>
              <h3>
                <button
                  type="button"
                  class="mca-faq-trigger"
                  aria-expanded="false"
                  aria-controls={`mca-faq-panel-${i}`}
                  id={`mca-faq-trigger-${i}`}
                  data-acc-trigger
                >
                  <span>{item.q}</span>
                  <span class="mca-faq-caret" aria-hidden="true">
                    <span class="mca-faq-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="8" viewBox="0 0 18 10" fill="none" class="mca-faq-caret-svg">
                        <path d="M1 1L9 9L17 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                    </span>
                  </span>
                </button>
              </h3>
              <div class="mca-acc-panel" id={`mca-faq-panel-${i}`} role="region" aria-labelledby={`mca-faq-trigger-${i}`}>
                <div class="mca-acc-inner">
                  <p>{item.a}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
      </div>
    </div>
  </section>

  <script>
    import { bindAccordions } from '@/scripts/accordion';
    import '@/scripts/scroll-in';
    bindAccordions();
  </script>
</BaseLayout>
