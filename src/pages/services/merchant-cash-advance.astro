---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PilotPageHero from '@/components/pilot/PilotPageHero.astro';
import PilotAnswer from '@/components/pilot/PilotAnswer.astro';
import PilotGlance from '@/components/pilot/PilotGlance.astro';
import PilotWhatWeDo from '@/components/pilot/PilotWhatWeDo.astro';
import PilotEyebrow from '@/components/pilot/PilotEyebrow.astro';
import PilotAccordion from '@/components/pilot/PilotAccordion.astro';
import PilotFit from '@/components/pilot/PilotFit.astro';
import PilotProcess from '@/components/pilot/PilotProcess.astro';
import PilotTrust from '@/components/pilot/PilotTrust.astro';
import { getService, STANDARD_STEPS } from '@/data/services';
import { PAGE_DISCLOSURE } from '@/data/disclosure';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/schema';
import '@/styles/pilot.css';

const service = getService('merchant-cash-advance');
if (!service || !service.spec) throw new Error('Merchant Cash Advance spec is missing');

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: service.name, path: `/services/${service.slug}` },
];

const spec = service.spec;

const uses = [
  {
    title: 'Seizing a time-sensitive inventory deal',
    body: "An advance based on future sales can fund an inventory buy while the supplier's price still stands, often the same day after approval.",
  },
  {
    title: 'Bridging a slow season',
    body: 'Payroll, rent and insurance still run in the off-season. A working-capital bridge covers that stretch until peak work returns.',
  },
  {
    title: 'Funding a marketing push',
    body: 'Revenue-based capital can fund a campaign before a busy stretch, when the spend lands ahead of the sales it creates.',
  },
  {
    title: 'Covering urgent repairs or replacements',
    body: 'Use this when a repair or replacement cannot wait on retained earnings.',
  },
];

const faqs = [
  {
    q: 'Is a merchant cash advance a loan?',
    a: 'No. An MCA is a purchase of future receivables. Instead of a fixed loan payment, remittances are based on your sales under the terms of your agreement.',
  },
  {
    q: 'How much can I get?',
    a: `${spec.amounts}. The amount depends on your monthly revenue, time in business and bank activity, and final figures are set in underwriting.`,
  },
  {
    q: 'How fast can I get funded?',
    a: 'Timing depends on how quickly documents are provided. Once you are approved and the agreement is signed, merchant cash advances can fund the same day.',
  },
  {
    q: 'What can I use the funds for?',
    a: 'Inventory, payroll and rent through a slow stretch, a marketing push, or a repair that cannot wait. Your specialist will confirm the use fits the product before you sign.',
  },
  {
    q: 'Does my credit score matter?',
    a: 'Revenue and bank activity carry the most weight, but your specialist will review your full profile. Approval is never guaranteed.',
  },
  {
    q: 'How is the remittance collected?',
    a: 'As an agreed share of your daily or weekly sales, under the agreement you sign. The percentage and total purchased amount are disclosed before you commit.',
  },
  {
    q: 'What do I need to apply?',
    a: 'Six months of business bank statements, a government-issued photo ID, a voided check and a schedule of any open advances or loans. See the [24–48 hour funding checklist](/blog/24-48-hour-funding-checklist).',
  },
];
---

<BaseLayout
  title={service.seoTitle}
  description={service.seoDescription}
  schema={[breadcrumbSchema(crumbs), serviceSchema(service), faqSchema(faqs)]}
  disclosure={PAGE_DISCLOSURE}
>
  <PilotPageHero
    title={service.name}
    lead={service.headline}
    image={service.image}
    imageAlt="Card terminal and till on a shop counter, close crop."
    intent={`${service.name} still`}
    ctaHref="/apply"
    ctaLabel="Apply for this product"
  />

  <PilotAnswer
    answer="A merchant cash advance is a purchase of future receivables, not a loan. A business with $10K+ in monthly revenue and 3+ months in operation receives a lump sum from $5,000 to $5,000,000, then repays it through an agreed share of sales over 3 to 18 months."
    takeaways={[
      'It is not a loan: you sell a portion of future receivables, so repayment moves with your sales rather than a fixed instalment.',
      'Revenue and bank activity carry more weight than a credit score, which is why a newer or thinner file can still qualify.',
      'It is the fastest product here and the most expensive; use it for short needs that produce revenue.',
      'A line of credit is cheaper for planned or repeating costs — compare before you sign.',
    ]}
  />

  <PilotGlance
    cells={[
      { value: spec.amounts, label: 'Amounts' },
      { value: spec.terms, label: 'Terms' },
      { value: 'Same day', label: 'Funding after approval and signature' },
      { value: '3+ months in business', label: 'Minimum, with $10K+ monthly revenue' },
    ]}
  />

  <PilotWhatWeDo
    eyebrow="What we do"
    title="What is a merchant cash advance?"
    lead="A merchant cash advance converts a share of future sales into cash today. You receive a lump sum, then remit an agreed percentage of daily or weekly sales until the purchased amount is delivered. It is a purchase of receivables, not a loan, so there is no fixed instalment schedule."
    items={uses}
    intent="MCA what-we-do portrait"
  />

  <section class="pilot-section" aria-labelledby="overview-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="pilot-section-head bx-span-4 bx-md-full bx-lg-span-10">
          <PilotEyebrow>Terms</PilotEyebrow>
          <h2 id="overview-heading">What you can expect.</h2>
        </div>
        <div class="pilot-section-body bx-span-4 bx-lg-span-6 bx-lg-start-7">
          <PilotAccordion
            variant="strategies"
            idPrefix="mca-terms"
            items={[
              { q: 'Typical amounts', a: `${spec.amounts}. Final amounts depend on underwriting.` },
              {
                q: 'Terms',
                a: `${spec.terms}. Remittances follow your sales under the agreement, not a fixed loan payment.`,
              },
              { q: 'Requirements', a: spec.requirements.join(' · ') },
              {
                q: 'How remittance works',
                a: 'You remit an agreed share of sales until the purchased amount is delivered. It is not a loan.',
              },
              { q: "Who it's for", a: spec.whoFor },
              {
                q: 'What it costs',
                a: 'Your specialist discloses the total purchased amount and the remittance percentage before you sign. No rate or factor rate is published on this site.',
              },
            ]}
          />
        </div>
      </div>
    </div>
  </section>

  <PilotFit
    title="When this is not the right product."
    lead="A cash advance is the fastest option and the most expensive. Three cases where something else fits better."
    items={[
      {
        title: 'The cost is a planned, repeating one',
        body: 'Rent, payroll cycles and inventory bought on a schedule suit a line of credit, where you draw what you need and pay for what you use.',
      },
      {
        title: 'The purchase is an asset',
        body: 'Equipment, vehicles and fixtures have a working life, so a collateral or asset loan spreads the cost over the years they earn.',
      },
      {
        title: 'You are already carrying several advances',
        body: 'Stacking a new position on top of existing daily payments is how files get into trouble. Consolidation of Positions exists for that case.',
      },
    ]}
  />

  <PilotProcess
    title="How you get approved."
    steps={[
      {
        title: STANDARD_STEPS[0].title,
        body: STANDARD_STEPS[0].body,
        note: 'You provide: six months of business bank statements, photo ID, a voided check and a debt schedule.',
      },
      {
        title: STANDARD_STEPS[1].title,
        body: STANDARD_STEPS[1].body,
        note: 'You get: a call about amounts, remittance and timing before anything is signed.',
      },
      {
        title: STANDARD_STEPS[2].title,
        body: STANDARD_STEPS[2].body,
        note: 'You see: the total purchased amount and the remittance percentage on the agreement.',
      },
    ]}
  />

  <section class="pilot-section" aria-labelledby="mca-faq-heading">
    <div class="container-site">
      <div class="bx-grid">
        <div class="pilot-section-head bx-span-4 bx-md-full bx-lg-span-10">
          <PilotEyebrow>FAQ</PilotEyebrow>
          <h2 id="mca-faq-heading">Cash advance questions</h2>
        </div>
        <div class="pilot-section-body bx-span-4 bx-lg-span-6 bx-lg-start-7">
          <PilotAccordion items={faqs} idPrefix="mca-faq" />
        </div>
      </div>
    </div>
  </section>

  <PilotTrust />
</BaseLayout>
